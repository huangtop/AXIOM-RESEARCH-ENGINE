{
  "schema_version": "automation-config.v030.8.4",
  "version": "V030.8.4",
  "failure_policy": "stop_on_required_failure",
  "state_machine": {
    "states": [
      "pending",
      "running",
      "completed",
      "failed",
      "skipped",
      "interrupted"
    ],
    "persist_before_stage": true,
    "persist_after_stage": true
  },
  "stages": [
    {
      "name": "incremental_refresh_plan",
      "argv": [
        "python",
        "scripts/plan_incremental_refresh.py"
      ],
      "required": true,
      "supports_strict": false,
      "expected_report": "data/generated/automation/latest_incremental_plan.json"
    },
    {
      "name": "production_refresh",
      "argv": [
        "python",
        "scripts/refresh_production_population.py",
        "--config",
        "config/production_refresh.v030.7.2.json"
      ],
      "required": true,
      "supports_strict": true,
      "expected_report": "data/generated/production_refresh/refresh_report.json",
      "run_if_report": {
        "path": "data/generated/automation/latest_incremental_plan.json",
        "field": "mode",
        "field_in": [
          "full",
          "targeted"
        ]
      }
    },
    {
      "name": "provider_delivery_reconciliation",
      "argv": [
        "python",
        "scripts/reconcile_provider_deliveries.py"
      ],
      "required": true,
      "supports_strict": true,
      "expected_report": "data/generated/production_refresh/provider_delivery_reconciliation.json"
    }
  ]
}
