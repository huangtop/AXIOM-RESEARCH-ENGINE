    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "During the years ended December 31, 2025 and 2024, we incurred approximately $2,443,194 and $2,300,948, respectively, in research, development and manufacturing operations costs, which include research and development incurred in customizing products for customers, as well as manufacturing costs incurred while developing our product lines and manufacturing process.",
        "start_character": 13499,
        "end_character": 13866
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We anticipate that while these large manufacturers may continue to dominate the market with their silicon-based products, thin film manufacturers will likely capture an increasingly larger share of the market.",
        "start_character": 11387,
        "end_character": 11596
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We intend to continue to invest in research and development in order to provide near term improvements to our manufacturing process (including to reduce costs) and products (including improve technology to increase power), as well as to identify next generation technologies relevant to both our existing and potential new markets.",
        "start_character": 13167,
        "end_character": 13498
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We manufacture our products by affixing a thin CIGS layer to a flexible, plastic substrate using a large format, roll-to-roll process that permits us to fabricate our flexible PV modules in an integrated sequential operation.",
        "start_character": 3376,
        "end_character": 3601
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "By applying CIGS to a flexible plastic substrate, we have developed a PV module that is efficient, lightweight and flexible;",
        "start_character": 7836,
        "end_character": 7960
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In so doing, we are able to reduce or eliminate an entire back end processing step, saving time as well as labor and manufacturing costs relative to our competitors.",
        "start_character": 9394,
        "end_character": 9559
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also believe our use of a flexible, plastic substrate provides us significant cost advantages because it enables us to employ monolithic integration techniques on larger components, which we believe are unavailable to manufacturers who use flexible, metal substrates.",
        "start_character": 6438,
        "end_character": 6708
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also plan to continue to take advantage of research and development contracts to fund a portion of this development.",
        "start_character": 13867,
        "end_character": 13986
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe our choice of substrate material further differentiates us from other thin-film PV manufacturers.",
        "start_character": 6135,
        "end_character": 6243
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have the ability to manufacture PV modules for different markets and for customized applications without altering our production processes.",
        "start_character": 8230,
        "end_character": 8372
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We operate in these target markets because they have highly specialized needs for power generation and offer attractive pricing due to the significant technological requirements.",
        "start_character": 742,
        "end_character": 920
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-117839",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-117839-ad7c97a4eae42e8d",
        "accession_number": "0001193125-26-117839",
        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "As the only company, to our knowledge, focused on the commercial production of PV modules using CIGS on a flexible, plastic substrate with monolithic integration, we believe we have the opportunity to address the aerospace and other weight-sensitive markets with transformational high quality, value added product applications.",
        "start_character": 6852,
        "end_character": 7179
      }
    ]
  },
