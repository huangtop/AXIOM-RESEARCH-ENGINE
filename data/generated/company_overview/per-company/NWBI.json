        "accession_number": "0001471265-26-000008",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To minimize our risk of loan write-offs, we have developed policies and procedures outlining our underwriting guidelines across all loan types.",
