    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Generally speaking, we have three product development objectives across the organization: (i) develop innovative new implant and bracing systems that enable surgeons to advance the field of pediatric orthopedics and allow us to focus on categories of the pediatric orthopedic market we are not currently addressing;",
        "start_character": 42284,
        "end_character": 42599
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2022, we acquired MD Ortho, a manufacturer of orthopedic clubfoot products, and Pega Medical, a medical device company which sells a portfolio of trauma and deformity correction devices for children, including the Fassier-Duval Telescopic Intramedullary System designed to treat osteogenesis imperfecta.",
        "start_character": 3119,
        "end_character": 3425
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2025, we had a limited launch of a new Titanium HA Pin offering to support both Orthex® and Drive systems, designed to improve fatigue life and increase flexibility to promote rapid bone healing.",
        "start_character": 48756,
        "end_character": 48954
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to our core product offering, we offer enabling technologies that complements our core products, which allows us to better serve the children's hospitals in which we sell.",
        "start_character": 40735,
        "end_character": 40918
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In most cases, we have redundant manufacturing capabilities for each of our products.",
        "start_character": 57678,
        "end_character": 57763
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In the future, we expect to expand our product offering to address additional categories of the pediatric orthopedic market, such as active growing implants for early onset scoliosis, limb length discrepancies and other orthopedic trauma and deformity applications.",
        "start_character": 11308,
        "end_character": 11573
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Specifically, we have partnered with the World Pediatric Project, to whom we provide surgical products and treatment for children in developing countries, some of whom are flown to the United States for surgery.",
        "start_character": 62521,
        "end_character": 62732
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Therefore, we utilize surgeon input when developing products and clinical education programs.",
        "start_character": 53048,
        "end_character": 53141
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "This system will leverage existing instrumentation where possible and we anticipate having the most comprehensive small canal offering available on the market at launch.",
        "start_character": 44733,
        "end_character": 44902
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To date, we have not experienced significant difficulty obtaining the materials necessary to meet demand for our products, and we believe manufacturing capacity is sufficient to meet global market demand for our products for the foreseeable future.",
        "start_character": 57764,
        "end_character": 58012
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To support our international distribution organization, we have hired a number of regional market managers, whose product and clinical expertise deepens our relationships with both surgeons and our distributors.",
        "start_character": 51322,
        "end_character": 51533
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001425450-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001425450-26-000013-ef7cc3e00ba865d3",
        "accession_number": "0001425450-26-000013",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We address this unmet market need and sell the broadest product offering specifically designed for children with orthopedic conditions.",
