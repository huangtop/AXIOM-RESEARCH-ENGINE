    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Since 2014 we have used partner-initiated programs to develop and validate our platform, fund the build-out of our infrastructure, and create a diversified portfolio of royalties and other downstream stakes in future antibody medicines being developed by our partners.",
        "start_character": 5975,
        "end_character": 6243
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The investments we have made in our capabilities and capacity for business development enable us to connect with, and credibly pursue, an increasing number of therapeutic ideas in our industry.",
        "start_character": 51945,
        "end_character": 52138
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also aim to continue developing our intellectual property portfolio.",
        "start_character": 81955,
        "end_character": 82026
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have developed an expansive patent portfolio with claims related to multiple aspects of our discovery and development capabilities, beginning with our first patent applications exclusively licensed from UBC in 2013.",
        "start_character": 66102,
        "end_character": 66320
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As an example, we discovered two antibody medicines for patients with COVID-19 (which received emergency use authorization in 2020 and 2022), which we believe was one of the most competitive and time-sensitive drug development efforts in history.",
        "start_character": 23754,
        "end_character": 24000
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As such, we are subject to many regulations, including those governing our laboratory facilities, drug manufacturing, clinical trials, and businesses in the private sector more generally.",
        "start_character": 83692,
        "end_character": 83879
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Cognizant of the specific challenges that characterize biotechnology as a sector, we specialize in addressing hard but tractable antibody discovery and development problems and avoid high-risk science projects.",
        "start_character": 41919,
        "end_character": 42129
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2025, we advanced two drug candidates, ABCL635 and ABCL575, into clinical trials and two development candidates, ABCL688 and ABCL386, into IND-enabling activities (Table 1).",
        "start_character": 10302,
        "end_character": 10478
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2025, we completed construction of our 130,000-square-foot clinical manufacturing facility in Vancouver and initiated activities at the site.",
        "start_character": 5424,
        "end_character": 5568
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In alignment with our focus on developing potential first-in-class medicines, we presently do not anticipate developing ABCL575 past Phase 1 as a monotherapy.",
        "start_character": 15864,
        "end_character": 16022
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In general, we seek to develop medicines where we have confidence in the science;",
        "start_character": 44668,
        "end_character": 44749
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001703057-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001703057-26-000012-d0e481203323ee27",
        "accession_number": "0001703057-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In late 2023, with our platform near complete, we committed to transitioning from a partnership model to a clinical-stage biotechnology company developing our own pipeline of drug candidates.",
        "start_character": 9168,
        "end_character": 9359
      }
    ]
