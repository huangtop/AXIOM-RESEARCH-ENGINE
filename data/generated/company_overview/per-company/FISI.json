        "accession_number": "0001193125-26-098467",
        "filing_date": "2026-03-09",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe this focus allows us to be more responsive to our customers’ needs and provide a high level of personal service that differentiates us from larger competitors, resulting in long-standing and broad-based banking relationships.",
