        "end_character": 24852
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-098467",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-098467-ef1739ddb26b1d86",
        "accession_number": "0001193125-26-098467",
        "filing_date": "2026-03-09",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide a wide range of banking and financial services to individuals, municipalities and businesses through a network of 48 offices and an extensive ATM network throughout Western and Central New York.",
