        "accession_number": "0001193125-26-098467",
        "filing_date": "2026-03-09",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We generally compete with other financial service providers on factors such as level of customer service, responsiveness to customer needs, availability and pricing of products, and geographic location.",
        "start_character": 17047,
        "end_character": 17249
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-098467",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-098467-ef1739ddb26b1d86",
        "accession_number": "0001193125-26-098467",
        "filing_date": "2026-03-09",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We have implemented a program to provide financial products and services to legal cannabis-related businesses and partner with other financial institutions who provide such services.",
