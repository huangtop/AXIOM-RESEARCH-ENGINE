        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell certain one-to-four family residential mortgages to the secondary mortgage market and typically retain the right to service the mortgages.",
        "start_character": 26633,
        "end_character": 26779
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-098467",
