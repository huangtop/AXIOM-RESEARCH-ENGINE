        "accession_number": "0001193125-26-098467",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As part of our compensation philosophy, we believe that we must offer and maintain market competitive total rewards programs for our employees in order to attract and retain superior talent.",
        "start_character": 10669,
        "end_character": 10859
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-098467",
