    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As is common in early-stage companies with limited operating histories, we are subject to risks and uncertainties such as our ability to develop and commercialize our products;",
        "start_character": 6038,
        "end_character": 6214
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In automotive, we expect Tier 1 partners to add value through industrialization, manufacturing, integration, sales, marketing, product liability management, and warranty support.",
        "start_character": 3589,
        "end_character": 3767
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In the Non-Automotive market, we anticipate using the same supply chain to manufacture through global contract manufacturers, and we will sell our products primarily through system integrator channel partners that may integrate our lidar sensor and software as part of a larger solution for an end customer.",
        "start_character": 31684,
        "end_character": 31991
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Since the launch of our ApolloTM product in 2024, we have seen renewed and growing interest from non‑automotive customers across a broad range of sectors, and we have entered into multiple customer engagements and development programs.",
        "start_character": 10868,
        "end_character": 11103
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Through these collaborations, we are able to extend the functionality of our products, accelerate deployment cycles, and address diverse customer requirements without developing separate hardware variants.",
        "start_character": 16422,
        "end_character": 16627
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We anticipate that our direct engagement with OEMs will continue during earlier stages of development in order to understand product requirements and support integration, but that commercial pathways for high‑volume programs will ultimately be driven through Tier‑1 partners.",
        "start_character": 30482,
        "end_character": 30757
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that our modular, patented design, our embedded deterministic artificial intelligence, which is inherently enabled by our unique product, and our strong R&D capabilities will enable us to remain a technology leader in the lidar market.",
        "start_character": 26595,
        "end_character": 26841
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to companies focused solely on lidar, we may also face competition from current or potential partners and customers that are developing lidar systems internally.",
        "start_character": 25905,
        "end_character": 26078
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also rely on trade secrets, design and manufacturing know-how, continuing technological innovations, and licensing and exclusivity opportunities to maintain and improve our competitive position.",
        "start_character": 28605,
        "end_character": 28802
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are a provider of physical AI sensing solutions built on high-performance, active lidar systems for vehicle autonomy, advanced driver-assistance systems (ADAS), robotic vision and a range of Non-Automotive applications.",
        "start_character": 25,
        "end_character": 247
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that our competitive advantage and our success depend in part upon our ability to develop and protect both our intellectual property and our technology.",
        "start_character": 28067,
        "end_character": 28230
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008858",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008858-e054606bef5bdfa0",
        "accession_number": "0001437749-26-008858",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We expect that lidar will be a required sensing solution across many end markets, and we intend to be one of the leading solutions providers in these spaces.",
        "start_character": 5880,
        "end_character": 6037
      }
    ]
  },
