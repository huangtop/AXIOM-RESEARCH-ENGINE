        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Additionally, we designed our solar tracker offerings to minimize steel content, to require no specialized tools and to reduce labor hours needed for installation and maintenance.",
        "start_character": 32545,
        "end_character": 32724
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120372",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120372-ff1b0cbfc24f4c49",
