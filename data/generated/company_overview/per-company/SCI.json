        "end_character": 20732
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007695",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007695-154aa9bf7b764f88",
        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, we look for opportunities to acquire land for future cemetery development in certain of our largest markets.",
        "start_character": 28425,
        "end_character": 28547
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007695",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007695-154aa9bf7b764f88",
        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Adjacent to this site on land owned by the Company, we are developing a new corporate headquarters building comprising approximately 250,000 square feet of office space.",
        "start_character": 13345,
        "end_character": 13514
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007695",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007695-154aa9bf7b764f88",
        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As the largest deathcare company in North America, we leverage our unparalleled scale by developing our sales organization and optimizing and responsibly deploying digital innovation throughout our network.",
        "start_character": 21380,
        "end_character": 21586
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007695",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007695-154aa9bf7b764f88",
        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "From private high-end family estates, many of which capture incredible views and custom architectural features, to nicely landscaped hedge estates, we continue to develop property selections that resonate with our customers.",
