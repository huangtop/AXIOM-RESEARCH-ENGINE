        "end_character": 10870
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007695",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007695-154aa9bf7b764f88",
        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are North America’s largest provider of deathcare products and services, with a network of funeral service locations and cemeteries unequaled in geographic scale and reach.",
        "start_character": 25,
        "end_character": 200
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007695",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007695-154aa9bf7b764f88",
        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We have an unparalleled network of funeral service locations and cemeteries that offers high quality products and services at prices that are competitive with local competing funeral service locations, cemeteries, and retail locations.",
        "start_character": 14903,
        "end_character": 15138
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007695",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007695-154aa9bf7b764f88",
        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell cemetery property and funeral and cemetery merchandise and services at the time of need and on a preneed basis.",
        "start_character": 1054,
        "end_character": 1173
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007695",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007695-154aa9bf7b764f88",
        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We sponsor community events and seminars to educate and provide guidance around preplanning both funeral and cemetery services and merchandise.",
