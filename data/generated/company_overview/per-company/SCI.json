        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For cemetery merchandise and services, we have developed relevant products such as customized cemetery property offerings, and specialized graveside service options.",
        "start_character": 19211,
        "end_character": 19376
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007695",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007695-154aa9bf7b764f88",
        "accession_number": "0001628280-26-007695",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also sell cemetery property interment rights and funeral and cemetery merchandise and services whereby a customer contractually agrees to the terms of certain products and services to be delivered and performed in the future.",
