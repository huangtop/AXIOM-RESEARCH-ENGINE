        "offering_role": "service",
        "confidence": 0.96,
        "statement": "At December 31, 2025, we operated 1,485 funeral service locations and 500 cemeteries (including 312 funeral service/cemetery combination locations), which are geographically diversified across 44 states, eight Canadian provinces, the District of Columbia, and Puerto Rico.",
        "start_character": 201,
        "end_character": 473
