        "provenance_id": "provenance:SEC-FILING-0001062993-25-013312-3d51839ac6bed39c",
        "accession_number": "0001062993-25-013312",
        "filing_date": "2025-07-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are currently producing various models of EV Stars and BEAST Type D school buses with contract manufacturers in Asia, in our school bus manufacturing facility in West Virginia, and with final assembly at Riverside, CA.",
