        "filing_date": "2025-07-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Some of the key differences between our company and many of our competitors in the heavy-duty bus market is that we use a clean sheet design to offer customers purpose-built solutions.",
        "start_character": 33483,
        "end_character": 33667
      },
      {
