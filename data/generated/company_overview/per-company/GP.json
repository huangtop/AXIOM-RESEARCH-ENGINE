        "filing_date": "2025-07-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that the underlying battery cells are a commodity and consequently have designed our products to take full advantage of the best batteries that are available at the time we manufacture our products.",
        "start_character": 27079,
        "end_character": 27288
      },
      {
