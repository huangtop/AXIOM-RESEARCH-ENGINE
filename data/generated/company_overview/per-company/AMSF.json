        "provenance_id": "provenance:SEC-FILING-0001193125-26-082513-83d6a1b00f43ec90",
        "accession_number": "0001193125-26-082513",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a result, we believe we have the opportunity to increase market penetration in each of the states in which we currently operate.",
        "start_character": 7793,
        "end_character": 7924
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082513",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-082513-83d6a1b00f43ec90",
        "accession_number": "0001193125-26-082513",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Based on our 40-year history of insuring employers engaged in hazardous industries, we have developed industry specific risk analysis and rating tools that support our underwriters in risk selection and pricing.",
        "start_character": 4703,
        "end_character": 4914
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082513",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-082513-83d6a1b00f43ec90",
