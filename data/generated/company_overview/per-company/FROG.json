        "accession_number": "0001193125-26-051382",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We designed our products to integrate with each other natively, with a unified user interface, as well as integrate easily with AI agents and other technologies via our MCP server.",
        "start_character": 16001,
        "end_character": 16181
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051382",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051382-a40cfabbdefe46a4",
