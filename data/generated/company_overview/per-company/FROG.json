        "end_character": 51190
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051382",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051382-a40cfabbdefe46a4",
        "accession_number": "0001193125-26-051382",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are agnostic to the types of technologies a software developer or IT operator may choose to use, which we believe provides us with a competitive advantage.",
        "start_character": 21381,
        "end_character": 21539
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051382",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051382-a40cfabbdefe46a4",
        "accession_number": "0001193125-26-051382",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe JFrog uniquely unites AI-powered development with DevSecOps best practices to create a universal software supply chain across an organization.",
        "start_character": 10522,
        "end_character": 10675
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051382",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051382-a40cfabbdefe46a4",
        "accession_number": "0001193125-26-051382",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We designed JFrog Artifactory to be the only software package repository that an organization needs.",
        "start_character": 16410,
        "end_character": 16510
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051382",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051382-a40cfabbdefe46a4",
        "accession_number": "0001193125-26-051382",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We strive to make software developers, security teams, AI/MLOps teams, and IT operators more efficient, effective, and productive, and create champions of JFrog in the process.",
        "start_character": 20397,
        "end_character": 20573
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051382",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051382-a40cfabbdefe46a4",
        "accession_number": "0001193125-26-051382",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "Additionally, we are committed to workplace safety and security through office maintenance, employee training, and emergency protocols.",
        "start_character": 53037,
        "end_character": 53172
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051382",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051382-a40cfabbdefe46a4",
