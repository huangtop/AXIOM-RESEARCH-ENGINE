        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have an unwavering commitment to the software developer, AI/MLOps teams, security teams, and IT operator communities, and demonstrate this commitment by offering varying forms of free access to our products in addition to the paid subscriptions described above.",
        "start_character": 28169,
        "end_character": 28433
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051382",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051382-a40cfabbdefe46a4",
        "accession_number": "0001193125-26-051382",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We intend to continue to invest in our research and development capabilities to extend our platform and products.",
        "start_character": 45378,
        "end_character": 45491
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051382",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051382-a40cfabbdefe46a4",
