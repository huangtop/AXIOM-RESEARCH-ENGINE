        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe these manufacturing efforts could position Kodiak for potential market share capture if tarcocimab and KSI-501 are approved.",
        "start_character": 7641,
        "end_character": 7776
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-134887",
