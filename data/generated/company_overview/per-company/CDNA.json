      },
      {
        "business_evidence_id": "business-evidence:SEC-0001217234-26-000018",
        "provenance_id": "provenance:SEC-FILING-0001217234-26-000018-b1644712376ace82",
        "accession_number": "0001217234-26-000018",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We develop and provide diagnostic testing services for solid organ transplant recipients, hematopoietic stem cell transplant recipients and recipients of cell therapies.",
        "start_character": 8982,
        "end_character": 9151
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001217234-26-000018",
        "provenance_id": "provenance:SEC-FILING-0001217234-26-000018-b1644712376ace82",
        "accession_number": "0001217234-26-000018",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We develop, manufacture, market and sell products that increase the chance of successful transplants by facilitating a better match between a solid organ or stem cell donor and a recipient, and help provide post-transplant surveillance.",
        "start_character": 22169,
        "end_character": 22405
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001217234-26-000018",
        "provenance_id": "provenance:SEC-FILING-0001217234-26-000018-b1644712376ace82",
        "accession_number": "0001217234-26-000018",
        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "we similarly have regional structure that includes country managers in Western Europe, and distributors we work with outside of Western Europe to service the needs of our transplant center customers globally.",
