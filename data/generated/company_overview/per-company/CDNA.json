        "accession_number": "0001217234-26-000018",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe solutions selling into the same transplant center increases the adoption and adherence to our diagnostic products and allows us to lower our revenue acquisition costs over time.",
