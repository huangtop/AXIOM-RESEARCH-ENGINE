        "end_character": 3321
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001217234-26-000018",
        "provenance_id": "provenance:SEC-FILING-0001217234-26-000018-b1644712376ace82",
        "accession_number": "0001217234-26-000018",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that it is critical to attract, develop and retain employees with the experience, knowledge, expertise and vision capable of not only operating, but also excelling, in this complex and competitive business environment, including competing against larger competitors and developing and commercializing new products, new and improved technologies and new applications for our existing technologies.",
