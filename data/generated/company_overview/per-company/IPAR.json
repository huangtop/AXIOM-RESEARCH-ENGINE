        "filing_date": "2026-03-10",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In addition, we are the registered owner of several trademarks for fragrance and beauty products, including:",
        "start_character": 69053,
        "end_character": 69161
      },
      {
