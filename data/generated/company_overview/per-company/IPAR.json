        "accession_number": "0001753926-26-000464",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We compete with an original strategy, regular and methodical development of quality fragrances for a growing portfolio of internationally renowned brand names.",
        "start_character": 64818,
        "end_character": 64977
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001753926-26-000464",
