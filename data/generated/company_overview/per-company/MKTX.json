        "end_character": 12887
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-067009",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-067009-3d56c65b0f86c540",
        "accession_number": "0001193125-26-067009",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe this provides a valued service for our constituents and enhances our brand awareness and stature within the financial community.",
        "start_character": 47146,
        "end_character": 47285
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-067009",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-067009-3d56c65b0f86c540",
