        "end_character": 8969
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-067009",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-067009-3d56c65b0f86c540",
        "accession_number": "0001193125-26-067009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we own, or have filed applications for, the rights to trade names, copyrights, domain names and service marks that we use in the marketing of products and services to clients.",
        "start_character": 53918,
        "end_character": 54106
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-067009",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-067009-3d56c65b0f86c540",
