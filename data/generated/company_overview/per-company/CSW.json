        "end_character": 23074
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001624794-26-000027",
        "provenance_id": "provenance:SEC-FILING-0001624794-26-000027-5ea712493c7d2334",
        "accession_number": "0001624794-26-000027",
        "filing_date": "2026-05-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also actively monitor the competitive landscape and develop new products and modify existing products in our research and development (“R&D”) labs co-located with our manufacturing sites in Cle Elum, Washington;",
