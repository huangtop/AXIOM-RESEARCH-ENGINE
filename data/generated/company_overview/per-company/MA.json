        "accession_number": "0001141391-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We focus on business outcomes and combine our proprietary data and insights with our marketing expertise to create innovative solutions that span the entire customer lifecycle, from brand design and product adoption to customer retention and portfolio optimization.",
