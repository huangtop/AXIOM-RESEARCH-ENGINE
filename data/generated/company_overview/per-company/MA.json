        "end_character": 26063
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001141391-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001141391-26-000013-9e2b0b6bc5a5e34b",
        "accession_number": "0001141391-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also offer solutions designed to enable businesses or governments to make invoiced payments to businesses with whom they have a trusted relationship for goods and services.",
