        "end_character": 24833
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001544522-26-000036",
        "provenance_id": "provenance:SEC-FILING-0001544522-26-000036-242ca0781f13a4a0",
        "accession_number": "0001544522-26-000036",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Virtually every jurisdiction in which we operate has established or is in the process of establishing data security and privacy legal frameworks with which we or our customers must comply.",
