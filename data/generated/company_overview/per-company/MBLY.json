        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We and our vehicle development partners will then market these vehicles and systems through business-to-business channels into a range of transportation network operators, with announced demand-side customers including Deutsche Bahn, Beep, Holo / Ruter, Lyft and others.",
        "start_character": 34126,
        "end_character": 34396
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-014300",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-014300-fd30bf23b6d50016",
