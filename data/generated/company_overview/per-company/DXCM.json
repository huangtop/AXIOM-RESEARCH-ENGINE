        "accession_number": "0001093557-26-000027",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To complement our direct sales efforts, we have entered into distribution arrangements in North America and several international markets that allow distributors to sell our products.",
        "start_character": 31893,
        "end_character": 32076
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001093557-26-000027",
        "provenance_id": "provenance:SEC-FILING-0001093557-26-000027-29ebaafbc8b5fab0",
