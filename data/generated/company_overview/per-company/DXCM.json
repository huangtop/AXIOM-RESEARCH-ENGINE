      },
      {
        "business_evidence_id": "business-evidence:SEC-0001093557-26-000027",
        "provenance_id": "provenance:SEC-FILING-0001093557-26-000027-29ebaafbc8b5fab0",
        "accession_number": "0001093557-26-000027",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We primarily manufacture our products at our manufacturing facilities in Mesa, Arizona and Penang, Malaysia.",
        "start_character": 37562,
        "end_character": 37670
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001093557-26-000027",
