        "filing_date": "2026-02-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are focused on continued improvement of our customers’ experience with our products, services and solutions, including through the digital transformation of our offerings, and on enhancing the services offered to our customers.",
        "start_character": 2227,
        "end_character": 2457
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-055516",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-055516-73160617331bc633",
