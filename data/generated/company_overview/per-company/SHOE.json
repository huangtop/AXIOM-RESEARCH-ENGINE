    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have implemented a third-party hosted order management system designed to our specifications, which has enabled us to meet the complex demands of omnichannel fulfillment and has positioned us to further scale our e-commerce capabilities as our business grows.",
        "start_character": 12648,
        "end_character": 12910
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We operate a retail-focused business model designed to deliver a differentiated footwear shopping experience featuring national name brands.",
        "start_character": 223,
        "end_character": 363
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell broadly across the family footwear channel, with meaningful distribution among type of customer (men, women and children), product category (athletics and non-athletics), and age (senior citizens to infants).",
        "start_character": 17229,
        "end_character": 17445
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "By fulfilling e-commerce orders principally from store-level inventory and overhead, we are able to minimize out-of-stocks, offer customers an expanded online assortment and leverage existing store infrastructure.",
        "start_character": 13083,
        "end_character": 13296
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Since the acquisition of Shoe Station in Fiscal 2021, we have been evaluating customer analytics and market data and developing strategies to expand the Shoe Station banner.",
        "start_character": 6343,
        "end_character": 6516
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are committed to providing a personalized, seamless customer experience across all channels, and management believes that our ongoing omnichannel initiatives are aligned with changing consumer behavior.",
        "start_character": 12145,
        "end_character": 12350
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are dedicated to attracting, developing, maintaining and supporting an inclusive workforce that includes individuals with a wide range of backgrounds, life experiences and cultures.",
        "start_character": 23755,
        "end_character": 23939
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have a demonstrated track record of selling branded footwear, including Nike, Skechers, Crocs, adidas, Puma, HEYDUDE, HOKA, Birkenstock, Converse and Brooks, and of generating profits without incurring debt.",
        "start_character": 572,
        "end_character": 782
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have built an employee-centric, customer-focused organization designed to compete at the highest levels in the retail industry.",
        "start_character": 23322,
        "end_character": 23452
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "As previously disclosed, we believe that a national expansion opportunity exists in markets where the customer and/or market characteristics align better with our Shoe Station concept, rather than our Shoe Carnival concept.",
        "start_character": 6895,
        "end_character": 7118
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "During Fiscal 2024, we completed a 10-store in-market test, where we closed underperforming Shoe Carnival stores and opened new Shoe Station stores in those markets.",
        "start_character": 7119,
        "end_character": 7284
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126279",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126279-43e43ad95ffb830c",
        "accession_number": "0001193125-26-126279",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "Many of our competitors are significantly larger than we are in terms of Net Sales, and many can access the capital markets with greater speed and efficiency than we can.",
        "start_character": 23114,
        "end_character": 23284
      }
    ]
