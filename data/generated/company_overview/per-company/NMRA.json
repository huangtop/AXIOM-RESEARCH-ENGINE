        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are subject to certain research and development milestone timeline obligations and have agreed to use commercially reasonable efforts to obtain regulatory approvals and to commercialize the licensed products.",
