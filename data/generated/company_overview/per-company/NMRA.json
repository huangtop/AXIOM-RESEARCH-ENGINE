        "accession_number": "0001193125-26-130388",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Under each Amgen License, we are solely responsible for the research, development, manufacturing and commercialization of the licensed products.",
        "start_character": 22963,
        "end_character": 23107
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-130388",
