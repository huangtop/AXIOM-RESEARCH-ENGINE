        "accession_number": "0001193125-26-130388",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are obligated to use commercially reasonable efforts to develop, manufacture, obtain regulatory approval, and commercialize at least one licensed product under each Amgen License.",
        "start_character": 23108,
        "end_character": 23290
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-130388",
