        "accession_number": "0001193125-26-130388",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Until a specified period of time following the achievement of the first successful Phase 2 clinical trial for any licensed product, if we choose to sell, transfer, sublicense or divest rights to a licensed product in certain major markets, Amgen has a time-limited, exclusive right of first negotiation to enter into an agreement with us for such rights.",
        "start_character": 22488,
        "end_character": 22842
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-130388",
