        "filing_date": "2026-03-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As we further develop our product candidates, we plan to identify additional novel candidates for patent protection that may potentially enhance commercial success, including pursuit of claims directed to new therapeutic indications.",
        "start_character": 44604,
        "end_character": 44837
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-106251",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-106251-e1188444132b3df5",
