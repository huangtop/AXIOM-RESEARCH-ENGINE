        "confidence": 0.96,
        "statement": "As of the date of this Annual Report, we are the owner of all the patents and patent applications that are material to our business.",
        "start_character": 45438,
        "end_character": 45570
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-106251",
