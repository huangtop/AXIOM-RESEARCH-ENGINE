        "end_character": 144104
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-106251",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-106251-e1188444132b3df5",
        "accession_number": "0001193125-26-106251",
        "filing_date": "2026-03-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For our product candidates, we generally pursue patent protection covering compositions of matter, methods of manufacture and methods of use.",
        "start_character": 44462,
        "end_character": 44603
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-106251",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-106251-e1188444132b3df5",
        "accession_number": "0001193125-26-106251",
        "filing_date": "2026-03-13",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In addition to regulations in the United States, we are subject to a variety of regulations in other jurisdictions governing, among other things, research and development, clinical trials, testing, manufacturing, safety, efficacy, quality control, labeling, packaging, storage, record keeping, distribution, reporting, export and import, advertising, marketing and other promotional practices involving pharmaceutical products as well as authorization, approval and post-approval monitoring and reporting of our products.",
        "start_character": 215956,
        "end_character": 216477
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-106251",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-106251-e1188444132b3df5",
        "accession_number": "0001193125-26-106251",
        "filing_date": "2026-03-13",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Pursuant to the arrangement, logistics service providers provide delivery services in a safe and timely manner pursuant to our requirements, while we are responsible for the quality of goods.",
        "start_character": 137801,
        "end_character": 137992
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-106251",
