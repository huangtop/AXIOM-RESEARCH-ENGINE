        "accession_number": "0001193125-26-131747",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Under consignment contracts, we own the fuel product until sold to the final customer and we are responsible for the pricing of the fuel to the end customer.",
        "start_character": 3048,
        "end_character": 3205
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-131747",
