        "accession_number": "0001193125-26-131747",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "ARKO Parent’s environmental department maintains direct interaction with federal, state and local environmental agencies across all jurisdictions in which we operate so that we remain informed of regulatory developments and to promote compliance with evolving environmental standards.",
