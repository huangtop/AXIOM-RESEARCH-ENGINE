        "accession_number": "0001193125-26-174971",
        "filing_date": "2026-04-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through our timely, efficient, and reliable home delivery approach, we provide modern households with cost-effective options for fresh produce and food items, while exceeding user expectations with exceptional service.",
