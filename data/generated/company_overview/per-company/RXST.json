        "accession_number": "0001193125-26-071775",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have intentionally pursued a vertically integrated manufacturing strategy offering critical advantages, including control over our product quality and rapid product iteration using strong R&D and quality groups.",
