        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In the U.S., we primarily sell our LAL products to ambulatory surgical centers (“ASCs”) and occasionally to hospitals.",
        "start_character": 52998,
        "end_character": 53116
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071775",
