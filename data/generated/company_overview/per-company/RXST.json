        "accession_number": "0001193125-26-071775",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are required to manufacture our products in compliance with the FDA’s Quality Management System Regulation (“QMSR”) (21 CFR Part 820 incorporating ISO 13485:2016), replacing the former Quality System Regulation.",
        "start_character": 46395,
        "end_character": 46609
      },
      {
