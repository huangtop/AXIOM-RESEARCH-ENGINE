        "end_character": 6857
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001802974-25-000048",
        "provenance_id": "provenance:SEC-FILING-0001802974-25-000048-9340ed8ba4c44471",
        "accession_number": "0001802974-25-000048",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We sell both pre-ripe and ripened avocados, and with our network of ripening facilities, we can adjust the level of ripeness to the needs of our customers.",
        "start_character": 1825,
        "end_character": 1980
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001802974-25-000048",
        "provenance_id": "provenance:SEC-FILING-0001802974-25-000048-9340ed8ba4c44471",
        "accession_number": "0001802974-25-000048",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "We do not have long-term supply contracts with our customers and focus instead on building strong, long-term relationships based on product quality and specifications, on-time delivery and customer support and service.",
