    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In connection with this line of business, we have developed proprietary software for servicing Accounts, which we believe enables law firms to service Accounts efficiently and profitably.",
        "start_character": 19221,
        "end_character": 19408
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We conduct this business through a wholly owned subsidiary, US Digital, which we formed in 2021 to develop and operate our Bitcoin mining business.",
        "start_character": 3989,
        "end_character": 4136
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We conduct this business through our wholly owned subsidiary, US Digital, a Florida limited liability company, which we formed in 2021 to develop and operate our Bitcoin mining business.",
        "start_character": 610,
        "end_character": 796
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "All of the machines we purchased this year were manufactured by Bitmain, one of the preeminent manufacturers of Bitcoin mining rigs.",
        "start_character": 31226,
        "end_character": 31358
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Currently, we do not use a formula or specific methodology to determine whether or when we will sell Bitcoin that we hold, or the number of Bitcoins we will sell.",
        "start_character": 6526,
        "end_character": 6688
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Historically, we have been able to manage our supply chains effectively, but global supply chains continue to be constrained, and from time-to-time experience substantial increases in shipping costs and logistical delays as we make efforts to ensure timely delivery of equipment.",
        "start_character": 31422,
        "end_character": 31701
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "The majority of miners we operate and expect to operate once received are the miners manufactured by Bitmain, including the S19J-Pro, S19 XP, S21 and S21 Immersion models.",
        "start_character": 30880,
        "end_character": 31051
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "This overall strategy also contemplates that we may periodically sell Bitcoin for general corporate purposes or in connection with strategies that generate tax benefits in accordance with applicable law, enter into additional capital raising transactions, including those that could be collateralized by its Bitcoin holdings, and consider pursuing strategies to create income streams or otherwise generate funds using our Bitcoin holdings.",
        "start_character": 2160,
        "end_character": 2599
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that developments in Bitcoin mining have created an opportunity for us to deploy capital and conduct large-scale mining operations in the United States.",
        "start_character": 3825,
        "end_character": 3988
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We continue to monitor emerging developments in this area.",
        "start_character": 33088,
        "end_character": 33146
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We currently sell the majority of the Bitcoin we mine and utilize hot wallets to hold this Bitcoin immediately prior to selling for working capital purposes.",
        "start_character": 12236,
        "end_character": 12393
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133333",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133333-c5f8a6114f3f5d8e",
        "accession_number": "0001193125-26-133333",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We may sell or leverage our Bitcoin to support operational needs and strategic initiatives.",
        "start_character": 421,
        "end_character": 512
      }
    ]
