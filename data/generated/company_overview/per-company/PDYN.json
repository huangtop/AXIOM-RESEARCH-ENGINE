    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As our products are highly complex, we want to ensure that we continue to develop new systems and solutions to address new markets and use-cases and thereby grow our business.",
        "start_character": 38600,
        "end_character": 38775
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Because Palladyne IQ is designed to be hardware agnostic so as to work with most industrial robots being sold today, we expect that this product can benefit a wide variety of industries such as industrial manufacturing, defense, infrastructure maintenance and repair, energy and aerospace and aviation, among others.",
        "start_character": 15713,
        "end_character": 16029
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "By combining our manufacturing and engineering design services with our software and hardware products, we are able to offer comprehensive, vertically integrated solutions to customers.",
        "start_character": 25161,
        "end_character": 25346
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "On November 14, 2023, we announced a pivot in business strategy to prioritize the development and commercialization of our AI/ML Foundational Technology and suspend further commercialization efforts on hardware robotics products.",
        "start_character": 49254,
        "end_character": 49483
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our competitor base may change as other companies introduce products that provide solutions to the same problems addressed by our products or we develop new functionality or products that overlap with current or future products offered by others.",
        "start_character": 36912,
        "end_character": 37158
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our products are in various stages of development and early commercialization, and we expect to continue product development, quality and assurance testing, debugging and similar activities as we seek continuous improvement and to bring products to market successfully.",
        "start_character": 26284,
        "end_character": 26553
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our sales and marketing efforts include engaging with potential customers with which we built relationships through our previous hardware efforts, contacting potential customers that we believe could benefit from our products, working with manufacturers of robotic systems and systems integrators to offer our products along with theirs to end users, building brand and product capability awareness through targeted activities such as attending trade shows, increasing our presence in social media channels, increasing public relations, increasing earned media, and engaging in speakerships, blogs and white papers.",
        "start_character": 29631,
        "end_character": 30246
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Similarly, we believe we can leverage these capabilities for the design and production of our own autonomous platforms and products.",
        "start_character": 25499,
        "end_character": 25631
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through our hardware product development efforts over many years, including our related software development efforts, we have developed a significant amount of advanced technology and understanding of robotic systems that we are leveraging to develop and commercialize our AI/ML Foundational Technology and related products.",
        "start_character": 50000,
        "end_character": 50324
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a U.S.-based technology company developing and offering embodied artificial intelligence (\"AI\") software and collaborative autonomy solutions, advanced avionics, unmanned aerial vehicles (\"UAVs\"), advanced UAV engineering services and precision-manufactured components for defense and commercial/industrial markets.",
        "start_character": 942,
        "end_character": 1264
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are focused on commercializing Palladyne IQ, SwarmOS/Pilot and IntelliSwarm, as well as growing our avionics, engineering services and manufacturing businesses.",
        "start_character": 26554,
        "end_character": 26717
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-092443",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-092443-15e0ebf48a2aef30",
        "accession_number": "0001193125-26-092443",
        "filing_date": "2026-03-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe that our competitors provide solutions for more broadly applicable use cases, while our engineering services provide solutions for nonstandard or specialized products or use cases where more generic competitor solutions are less suitable.",
        "start_character": 34118,
        "end_character": 34367
      }
    ]
