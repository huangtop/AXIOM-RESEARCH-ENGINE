        "end_character": 14241
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001521332-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001521332-26-000009-6736c71ab066d6db",
        "accession_number": "0001521332-26-000009",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have established a worldwide design and manufacturing footprint with a regional service model that enables us to efficiently and effectively serve our global customers from best cost countries.",
        "start_character": 10782,
        "end_character": 10978
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001521332-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001521332-26-000009-6736c71ab066d6db",
        "accession_number": "0001521332-26-000009",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have organized our business into three distinct segments, which enable us to develop technology solutions and manufacture highly-engineered products that enable our customers to best address these secular trends:",
        "start_character": 8578,
        "end_character": 8793
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001521332-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001521332-26-000009-6736c71ab066d6db",
        "accession_number": "0001521332-26-000009",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We operate 139 major manufacturing facilities and 11 major technical centers utilizing a regional service model that enables us to efficiently and effectively serve our global customers from best cost countries.",
        "start_character": 6699,
        "end_character": 6910
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001521332-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001521332-26-000009-6736c71ab066d6db",
        "accession_number": "0001521332-26-000009",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell our products and services to the major global OEMs in every region of the world.",
        "start_character": 25483,
        "end_character": 25571
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001521332-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001521332-26-000009-6736c71ab066d6db",
        "accession_number": "0001521332-26-000009",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Our standard safety management system is aligned with ISO 45001, and we are committed to ensuring all our manufacturing sites are ISO 45001 certified by 2026.",
