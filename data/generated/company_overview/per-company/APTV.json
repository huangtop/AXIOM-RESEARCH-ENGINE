        "accession_number": "0001521332-26-000009",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We aim to continue developing leading edge technology focused on addressing these trends, and apply that technology toward products with sustainable margins that enable our customers to produce distinctive market-leading products.",
