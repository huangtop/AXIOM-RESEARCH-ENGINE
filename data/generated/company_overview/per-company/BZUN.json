        "confidence": 0.96,
        "statement": "Customer Satisfaction: We provide customer service operations for our brand partners and establish dedicated customer service teams tailored to each partner’s needs.",
        "start_character": 114988,
        "end_character": 115153
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047177",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047177-df909dab3415938a",
