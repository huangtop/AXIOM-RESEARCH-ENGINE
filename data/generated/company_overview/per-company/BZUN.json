        "filing_date": "2026-04-23",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Except for the arbitration proceeding described above, we are not currently a party to, nor are we aware of, any other legal proceeding, investigation or claim which, in the opinion of our management, is likely to have a material adverse effect on our business, financial condition or results of operations.",
        "start_character": 122673,
        "end_character": 122980
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047177",
