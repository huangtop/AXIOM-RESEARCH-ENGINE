    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Despite uncertainties posed by a changing regulatory landscape, we remain committed to maintaining innovative and responsible business practices in markets pertaining to data center developers and operators for HPC tenants.",
        "start_character": 39034,
        "end_character": 39257
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "From time to time, we may also look to sell individual assets that we do not consider to be core to our business and growth strategy.",
        "start_character": 4280,
        "end_character": 4413
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Simultaneously, we believe this continued growth occurs in the face of a power shortfall, which we believe makes our valuable portfolio of data center sites and our ability to continue sourcing and developing sites a key strategic advantage in a competitive landscape.",
        "start_character": 25818,
        "end_character": 26086
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe our insurance program is aligned with prevailing industry standards and market practices for comparable assets and similar companies and reflects a risk management approach appropriate for our portfolio;",
        "start_character": 46913,
        "end_character": 47127
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe we have the following strengths that give us a competitive advantage in the data center development and operations business, and position us as a preferred partner for hyperscalers seeking new capacity in power-constrained markets.",
        "start_character": 24395,
        "end_character": 24637
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We define our principal competitors as other data center developers, HPC infrastructure providers and publicly traded bitcoin miners that have diversified into the HPC services industry.",
        "start_character": 36809,
        "end_character": 36995
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have a portfolio of electrical power assets that was developed to allow us to profitably mine bitcoin.",
        "start_character": 22377,
        "end_character": 22482
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We monitor legislative and regulatory developments and seek expert advice as appropriate to ensure our business practices align with the evolving legal and regulatory framework.",
        "start_character": 38856,
        "end_character": 39033
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, we acquired two sites in 2025 that expanded our total development pipeline to approximately 3.4 GW of site capacity.",
        "start_character": 4720,
        "end_character": 4850
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In November 2025, we purchased a majority interest in a joint venture entity to develop a new HPC site in West Texas capable of providing 1-GW, referred to as Colchis (the “Colchis Site”), under which we expect to hold a majority equity interest subject to final lease and development terms.",
        "start_character": 7782,
        "end_character": 8073
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, we have developed and continue to refine certain proprietary trade secrets and software applications to enhance the profitability and operational effectiveness of our data center operations and may continue to develop those applications or others in the future.",
        "start_character": 45360,
        "end_character": 45634
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819989-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001819989-26-000009-8116bbe1eaa8c2ef",
        "accession_number": "0001819989-26-000009",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In particular, we have been able to identify sites in certain markets that had not yet seen significant hyperscale data center development, such as West Texas, where we could secure land and site control on more favorable terms than in more established data center markets.",
        "start_character": 32826,
        "end_character": 33099
      }
    ]
  },
