        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "The \"off-highway\" business principally includes the sale and servicing of power systems directly to customers in the commercial, defense, mining, maritime, power generation, and energy solutions sectors from 20 facilities we operate across Australia and New Zealand.",
        "start_character": 35549,
        "end_character": 35815
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012830",
