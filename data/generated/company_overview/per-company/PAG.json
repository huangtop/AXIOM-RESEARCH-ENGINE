        "filing_date": "2026-02-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer roadside remote service for certain repairs and provide 24/7 technician support for breakdown/emergency service in select locations.",
        "start_character": 30350,
        "end_character": 30496
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012830",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012830-e6eb233998015cdf",
