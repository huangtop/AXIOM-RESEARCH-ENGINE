        "accession_number": "0001193125-26-104189",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that BHB is uniquely positioned to ensure seamless sourcing, manufacture and sale of its affordable, high-quality family of cannabinoid brands to target the diverse health and wellness needs and preferences of their consumers.",
        "start_character": 46977,
        "end_character": 47214
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-104189",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-104189-30bc32dc90606c64",
        "accession_number": "0001193125-26-104189",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that Pure Sunfarms is the leading low-cost, high-quality producer in the Canadian market and its low-cost structure, primarily driven by economies of scale and large-scale greenhouse experience, is sustainable and provides a competitive industry advantage.",
        "start_character": 11494,
        "end_character": 11761
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-104189",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-104189-30bc32dc90606c64",
        "accession_number": "0001193125-26-104189",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have leveraged our expertise as a pioneer in CEA to contribute meaningfully to the development of the global legal cannabis industry.",
        "start_character": 504,
        "end_character": 640
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-104189",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-104189-30bc32dc90606c64",
        "accession_number": "0001193125-26-104189",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We seek to protect our proprietary packaging designs through design patent filings in key markets.",
        "start_character": 102462,
        "end_character": 102560
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-104189",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-104189-30bc32dc90606c64",
