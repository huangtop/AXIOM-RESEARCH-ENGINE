        "provenance_id": "provenance:SEC-FILING-0001193125-26-104189-30bc32dc90606c64",
        "accession_number": "0001193125-26-104189",
        "filing_date": "2026-03-12",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "From our sustainably sourced inputs and sustainable growing methods to our use of clean energy and other innovative technologies, we are proud to bring sustenance and wellbeing to our consumers in a way that is ethical and responsible to the planet.",
        "start_character": 4389,
        "end_character": 4638
