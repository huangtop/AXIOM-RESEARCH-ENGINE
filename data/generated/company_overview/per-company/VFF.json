        "provenance_id": "provenance:SEC-FILING-0001193125-26-104189-30bc32dc90606c64",
        "accession_number": "0001193125-26-104189",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "In 2017, we expanded from produce, leveraging our considerable knowledge, to the emerging legal cannabis and health and wellness market.",
