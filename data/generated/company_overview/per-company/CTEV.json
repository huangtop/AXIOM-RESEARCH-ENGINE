        "end_character": 23311
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001793229-26-000017",
        "provenance_id": "provenance:SEC-FILING-0001793229-26-000017-9387e2464b16b97c",
        "accession_number": "0001793229-26-000017",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are also required to provide access to contracts, books and records pertaining to services performed in connection with federal or state agency contracts.",
