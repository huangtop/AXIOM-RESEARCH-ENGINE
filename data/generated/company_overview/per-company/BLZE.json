        "end_character": 1931
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-016395",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-016395-679338ddc035ed7f",
        "accession_number": "0001628280-26-016395",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "We continue to evolve our go-to-market strategy to focus on high-value customers with enterprise-scale workloads.",
