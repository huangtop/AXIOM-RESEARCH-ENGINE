        "end_character": 8620
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-017908",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-017908-a1ba1ed255080a91",
        "accession_number": "0001628280-26-017908",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As part of our growth strategy, we are looking to grow by pursuing development and acquisition opportunities.",
        "start_character": 51766,
        "end_character": 51875
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-017908",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-017908-a1ba1ed255080a91",
