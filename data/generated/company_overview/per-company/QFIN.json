    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Because we take credit risks and provide guarantee services under credit-driven services and currently do not take credit risks under platform services, the gross fees charged under credit-driven services are generally higher than the fees charged under platform services.",
        "start_character": 33845,
        "end_character": 34117
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For ICE, as we provide financial institution partners intelligent marketing services, we mainly conduct preliminary credit screening of prospective borrowers during the credit line approval stage, therefore participating in fewer steps in the loan lifecycle than we do under credit-driven services and our capital-light model.",
        "start_character": 25730,
        "end_character": 26056
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "For loans facilitated under ICE, we also provided limited collection services to a small portion of financial institution partners based on their special requests.",
        "start_character": 34280,
        "end_character": 34443
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Fuzhou Financing Guarantee, through which we provide guarantee services to our financial institution partners, has obtained the financing guarantee certificate granted by competent government authorities to conduct financing guarantee business in June 2018.",
        "start_character": 123213,
        "end_character": 123470
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In August 2019, we launched the Intelligence Credit Engine (ICE), an open platform that offers financial institution partners intelligent marketing services.",
        "start_character": 4618,
        "end_character": 4775
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In July 2019, we completed a follow-on public offering of ADSs by certain selling shareholders.",
        "start_character": 4162,
        "end_character": 4257
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In the instance where we provide guarantee services, the guarantee services are provided throughout the loan tenor.",
        "start_character": 24055,
        "end_character": 24170
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Leveraging our sophisticated machine learning models and data analytics capabilities, we provide a comprehensive suite of technology services to assist financial institutions, consumers, and SMEs in the loan lifecycle, ranging from borrower acquisition, preliminary credit assessment, fund matching and post-facilitation services, with Qifu Jietiao app as our primary user interface.",
        "start_character": 9959,
        "end_character": 10342
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Risk Factors—Risks Related to Our Business and Industry—We face increasing competition, and if we do not compete effectively, our operating results could be harmed” for more information about the market where we operate and the competition we face.",
        "start_character": 67553,
        "end_character": 67801
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Risk Factors—Risks Related to Our Business and Industry—We need to engage guarantee companies to provide credit enhancement or additional comfort to our financial institution partners, and we recognize guarantee liabilities for accounting purposes.",
        "start_character": 20923,
        "end_character": 21171
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Shanghai Financing Guarantee (before its financing guarantee license was canceled upon its voluntary application), through which we provided guarantee services to our financial institution partners, obtained the financing guarantee certificate granted by competent government authorities to conduct financing guarantee business in January 2019.",
        "start_character": 123471,
        "end_character": 123815
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-049501",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-049501-46d7301633caeed9",
        "accession_number": "0001104659-26-049501",
        "filing_date": "2026-04-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Since 2023, we started to offer end-to-end technology solutions, including user acquisition, risk management, credit operation and post-facilitation services to financial institutions based on on-premise deployment, SaaS or hybrid model, which we refer to as total technology solutions.",
        "start_character": 18404,
        "end_character": 18690
      }
    ]
  },
