        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that our success and future growth depends greatly on our ability to attract, develop and retain top talent.",
        "start_character": 41212,
        "end_character": 41331
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007972",
