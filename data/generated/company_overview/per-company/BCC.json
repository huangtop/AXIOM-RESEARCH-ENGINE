        "provenance_id": "provenance:SEC-FILING-0001328581-26-000006-8ae37c99af800ef9",
        "accession_number": "0001328581-26-000006",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The building materials distribution markets in which we operate are fragmented, and we compete in each of our geographic and product markets with national, regional, and local distributors.",
