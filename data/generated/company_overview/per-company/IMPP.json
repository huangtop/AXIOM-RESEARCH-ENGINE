        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Under EPA regulations we are required to obtain a CWA permit to discharge ballast water and other wastewaters incidental to the normal operation of our vessels if we operate within the three mile territorial waters or inland waters of the United States.",
        "start_character": 49608,
        "end_character": 49861
      },
      {
