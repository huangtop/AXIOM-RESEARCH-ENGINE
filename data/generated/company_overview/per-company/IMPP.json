        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Any passage of climate control initiatives by the IMO, the EU or the individual countries in which we operate that limit greenhouse gas emissions from vessels could require us to limit our operations or make significant financial expenditures that we cannot predict with certainty at this time.",
        "start_character": 57663,
        "end_character": 57957
      },
      {
