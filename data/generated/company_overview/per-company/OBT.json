    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By combining the high-level personal service and relationship-based focus of a community bank with the extensive suite of financial products, technology, and services offered by our larger competitors, we believe we can capitalize on the substantial growth opportunities available in our market areas.",
        "start_character": 803,
        "end_character": 1104
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "From our beginning in 1892, our founders understood the Bank’s success would be closely tied to that of the communities in which we operate, and that long-term value creation would require an uncompromising commitment to service and the establishment of enduring relationships with our clients.",
        "start_character": 12508,
        "end_character": 12802
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In recent years, we have experienced strong growth in the Orange Wealth Management initiative, which combines services offered by OIA, our private bank and trust department in a coordinated strategy for growth.",
        "start_character": 5345,
        "end_character": 5555
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Since 2013, we continue to leverage knowledge and relationships developed over our long history and our commitment to customer service across a strategically expanding footprint.",
        "start_character": 7578,
        "end_character": 7756
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Through OIA and Orange Bank & Trust Company’s trust department, we offer a range of trust services, including managing customer investments, serving as custodian of customer assets, and providing fiduciary services including serving as trustee and personal representative of estates.",
        "start_character": 40508,
        "end_character": 40791
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Through its wholly owned subsidiaries, Orange Bank & Trust Company, a New York state-chartered trust company (the “Bank”) and Orange Investment Advisors, Inc., a registered investment advisor (“OIA”), the Company offers full- service commercial and consumer banking products and services and trust and wealth management services to small businesses, middle-market enterprises, local municipal governments and individuals in the Lower Hudson Valley region, the New York metropolitan area and nearby markets in Connecticut and New Jersey.",
        "start_character": 179,
        "end_character": 715
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Through the trust department of the Bank, we offer traditional trust and administration services to local clients and have a niche focus on Special Needs Trust and Guardianship service.",
        "start_character": 4095,
        "end_character": 4280
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide online banking, mobile banking, and direct deposit services.",
        "start_character": 45134,
        "end_character": 45210
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe our integrated approach to client relationships, growing market position and expanded service offerings will provide significant cross selling and new business opportunities going forward.",
        "start_character": 16878,
        "end_character": 17077
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe the local economies in our geographic footprint offer us significant growth opportunities we can capitalize on through our focus on personalized service, and our ability to realize greater economies of scale than smaller community banks.",
        "start_character": 12162,
        "end_character": 12410
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe the ongoing reduction in the number of locally managed community banks provides the opportunity for us to offer sophisticated banking products and services targeting small and middle market businesses, to expand our customer base, increase assets, and enhance profitability.",
        "start_character": 17738,
        "end_character": 18023
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-028308",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-028308-c22836fe7533cbc1",
        "accession_number": "0001104659-26-028308",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to believe that there are significant cross-selling opportunities within our high-net-worth and business client segments through this platform.",
        "start_character": 5556,
        "end_character": 5711
      }
    ]
  },
