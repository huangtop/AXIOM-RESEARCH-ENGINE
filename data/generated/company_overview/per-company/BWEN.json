    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To reduce the concentration of our sales, we have focused our product development activities and our sales force on expanding and diversifying our customer base and product lines.",
        "start_character": 6149,
        "end_character": 6328
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are leveraging existing customer relationships within each of our segments to cross sell our broad portfolio of capabilities.",
        "start_character": 6329,
        "end_character": 6457
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have a long-standing focus on processes for ensuring the manufacture of high-quality products.",
        "start_character": 24130,
        "end_character": 24227
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We maintain internal quality controls over all core manufacturing processes and carry out quality assurance inspections at the completion of each major manufacturing step to ensure the quality of our products.",
        "start_character": 24396,
        "end_character": 24605
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We manufacture products for a variety of customers in the wind energy, O&G, gas turbine, mining, and other industrial markets.",
        "start_character": 9826,
        "end_character": 9952
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide gearbox repair services and have manufactured loose gearing, gearboxes and systems, and provided heat treat services for aftermarket and Original Equipment Manufacturers (“OEM”) applications for a century.",
        "start_character": 3284,
        "end_character": 3500
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide supply chain solutions, light fabrication, inventory management, kitting and assembly services, primarily serving the combined cycle natural gas turbine market.",
        "start_character": 3853,
        "end_character": 4024
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We utilize a stage gate model for new product development, which provides a framework for evaluating opportunities and commercialization.",
        "start_character": 6458,
        "end_character": 6595
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "While a significant portion of our business is manufactured to our customer’s specifications, we employ design and metallurgical engineers to meet our customer’s stringent quality requirements, to improve product performance and reliability and to develop custom products that are integrated into our customer’s product offerings.",
        "start_character": 3501,
        "end_character": 3831
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, we have developed new variations of our PRS unit which supplies compressed natural gas to regions without established infrastructure as part of the virtual pipeline.",
        "start_character": 7675,
        "end_character": 7854
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a result, although we have historically produced towers for a broad range of wind turbine manufacturers, in any given year a limited number of customers have accounted for the majority of our revenues.",
        "start_character": 10414,
        "end_character": 10618
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007742",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-007742-9c9cf25d14a1c6ab",
        "accession_number": "0001437749-26-007742",
        "filing_date": "2026-03-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, we compete with the internal gear manufacturing capacity of relevant equipment manufacturers and face competition from foreign competitors.",
        "start_character": 14782,
        "end_character": 14934
      }
    ]
  },
