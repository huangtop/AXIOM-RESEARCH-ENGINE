    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As part of our services offerings, we design advanced ICs, develop custom IP and help customers address design challenges.",
        "start_character": 26688,
        "end_character": 26810
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For mainstream PCB customers, where individual or small team productivity is a focus, we provide the OrCAD® family of offerings, which are primarily marketed worldwide through a network of resellers.",
        "start_character": 19054,
        "end_character": 19253
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In delivering methodology services, we leverage our experience and knowledge of design techniques, our products, leading practices and different design environments to enable improved productivity of our customers’ engineering teams.",
        "start_character": 28075,
        "end_character": 28308
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In fiscal 2025, we announced our intent to acquire the Design & Engineering (“D&E”) business of Hexagon Smart Solutions AB (“Hexagon”), including its MSC Software division, which is expected to accelerate our ISD strategy.",
        "start_character": 22470,
        "end_character": 22692
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In fiscal 2025, we expanded our design IP portfolio with the acquisition of the Arm Artisan foundation IP business, adding standard cell libraries, memory compilers, and general-purpose I/Os (“GPIOs”) optimized for advanced process nodes at leading foundries.",
        "start_character": 15867,
        "end_character": 16126
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer molecular modeling and simulation solutions and services.",
        "start_character": 23427,
        "end_character": 23498
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We generally market our products and provide services to existing and prospective customers through a direct sales force consisting of salespeople and applications engineers.",
        "start_character": 31540,
        "end_character": 31714
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We offer a number of services, including design services, services related to methodology, education and hosted design solutions.",
        "start_character": 26284,
        "end_character": 26413
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We offer engineering services to collaborate with our customers in the design of complex ICs and the implementation of key design capabilities, including low power design, IC packaging and board design, functional verification, digital implementation, analog/mixed-signal design and system-level design.",
        "start_character": 26959,
        "end_character": 27262
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We support the use of third-party design products and design IP through our Cadence Connections® program and through our participation in industry groups such as the Silicon Integration Initiative and Accellera System Initiative.",
        "start_character": 28635,
        "end_character": 28864
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We work closely with leading semiconductor ecosystem partners to develop foundry process design kits (“PDKs”) to ensure our core EDA products and solutions meet manufacturing sign-off requirements.",
        "start_character": 10252,
        "end_character": 10449
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000813672-26-000016",
        "provenance_id": "provenance:SEC-FILING-0000813672-26-000016-4742ccafba91bb9d",
        "accession_number": "0000813672-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "By combining Secure-IC’s expertise in cybersecurity with Cadence’s decades of experience in IP and subsystem design, we are able to deliver comprehensive system solutions that accelerate customers’ time to market and are designed to meet stringent security and regulatory requirements.",
        "start_character": 16716,
        "end_character": 17001
      }
    ]
