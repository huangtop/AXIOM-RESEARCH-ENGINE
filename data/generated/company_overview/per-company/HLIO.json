        "end_character": 14214
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-087747",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-087747-d2447ec23aab7093",
        "accession_number": "0001193125-26-087747",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In January 2023, we completed the acquisition of Schultes Precision Manufacturing, Inc.",
        "start_character": 5826,
        "end_character": 5913
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-087747",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-087747-d2447ec23aab7093",
        "accession_number": "0001193125-26-087747",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In parallel, we are designing a comprehensive global job architecture to establish a consistent, market-aligned framework for job definitions, leveling, and career pathways across our global workforce.",
        "start_character": 29597,
        "end_character": 29798
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-087747",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-087747-d2447ec23aab7093",
        "accession_number": "0001193125-26-087747",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In support of our focus on global expansion, we have been driving “in the region, for the region” manufacturing to better align supply chain and manufacturing value streams with customers geographically to shorten lead times, reduce inventory, optimize costs, and mitigate global supply risks.",
