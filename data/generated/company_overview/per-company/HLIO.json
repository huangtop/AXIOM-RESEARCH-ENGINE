      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-087747",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-087747-d2447ec23aab7093",
        "accession_number": "0001193125-26-087747",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As an innovative manufacturer of electronic controls and displays, we serve a variety of markets including off-highway, recreational marine, powersports and specialty vehicles, agriculture, water pumping, power generation, engine-driven industrial equipment, and health and wellness.",
