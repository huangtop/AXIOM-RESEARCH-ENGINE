    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As we further develop our product pipeline, we expect to consider secondary or back-up manufacturers for both active pharmaceutical ingredient and drug product manufacturing.",
        "start_character": 32075,
        "end_character": 32249
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "On September 3, 2025, we entered into an amendment License providing exclusive worldwide rights to develop, commercialize, manufacture, and have manufactured any orally-administered pharmaceutical product containing levosimendan and, in addition to the Company’s existing rights to develop and commercialize subcutaneously administered products containing levosimendan, to manufacture or have manufactured such products.",
        "start_character": 29058,
        "end_character": 29478
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe this strategy will help us develop a portfolio of high-quality product development opportunities, enhance our clinical development and commercialization capabilities, and increase our ability to generate value from our proprietary technologies.",
        "start_character": 7833,
        "end_character": 8088
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We contract with third parties for the manufacturing of all of our product candidates and for pre-clinical and clinical studies and intend to continue to do so in the future.",
        "start_character": 31027,
        "end_character": 31201
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We expect third-party manufacturers to be capable of providing sufficient quantities of our product candidates to meet anticipated full-scale commercial demands, but we have not assessed these capabilities beyond the supply of clinical materials to date.",
        "start_character": 32357,
        "end_character": 32611
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "All of the vendors we use are required to conduct their operations under current Good Manufacturing Practices, a regulatory standard for the manufacture of pharmaceuticals.",
        "start_character": 33002,
        "end_character": 33174
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Currently, we require our officers, employees, consultants, contractors, manufacturers, outside scientific collaborators and sponsored researchers, and other advisors to execute confidentiality agreements in connection with their employment, consulting, or advisory relationships with us, where appropriate.",
        "start_character": 22887,
        "end_character": 23194
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In October 2020, we met with the FDA for an End-of-Phase 2 Meeting to discuss the Phase 2 clinical data and further development of levosimendan in PH-HFpEF.",
        "start_character": 16507,
        "end_character": 16663
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In order to compete successfully, we must develop proprietary positions in patented drugs for therapeutic markets that have not been satisfactorily addressed by conventional research strategies.",
        "start_character": 37586,
        "end_character": 37780
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Key factors on which we will compete with regards to the development and marketing of levosimendan for the treatment of pulmonary hypertension in these patients include, among others, the ability to obtain adequate efficacy data, safety data, cost effectiveness data and hospital formulary approval, marketing exclusivity, and sufficient distribution and handling.",
        "start_character": 34608,
        "end_character": 34972
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "On January 4, 2022, we received a patent from the United States Patent and Trademark Office (“USPTO”) for the subcutaneous administration of levosimendan (TNX-102), whether through the prototype formulation we have developed in collaboration with a formulation development partner, or other subcutaneous formulations meeting certain broad characteristics defined in the patent.",
        "start_character": 23753,
        "end_character": 24130
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-099393",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-099393-53b22a2869dfcf2a",
        "accession_number": "0001193125-26-099393",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also rely on continuing technological innovation and in-licensing opportunities to develop and maintain our proprietary position.",
        "start_character": 26266,
        "end_character": 26398
      }
