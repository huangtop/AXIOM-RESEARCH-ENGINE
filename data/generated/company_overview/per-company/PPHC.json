    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Across these member companies, we offer multi-disciplinary federal and state advocacy and advisory services, including direct advocacy services, strategic intelligence and reputation management.",
        "start_character": 49105,
        "end_character": 49299
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As a company designed by and for the operators of advisory businesses, we optimize corporate strategy, cross-selling, and referral opportunities for our portfolio companies through proactive and collaborative engagement both firm-to-firm and at the holding company level.",
        "start_character": 6278,
        "end_character": 6549
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Importantly, as distinct from legacy branded competitors in our industry who have sought to be all-in-one providers of strategic communications services to their clients, we deliver complementary strategic communications services through stand-alone firms.",
        "start_character": 2966,
        "end_character": 3222
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our business comprises of three reporting segments—Government Relations Consulting, Corporate Communications & Public Affairs Consulting and Compliance and Insights Services—corresponding to the different types of strategic communications services our member companies provide to our clients:",
        "start_character": 1912,
        "end_character": 2204
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our business model allows us to deliver both the scale and reach of those all-in-one providers and also the higher standards of quality, service, creativity, and nimbleness that traditionally have been the domain of smaller boutiques.",
        "start_character": 3448,
        "end_character": 3682
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through our legislative tracking service, we leverage our policy expertise to monitor bills, regulations and other legal developments for clients, helping keep them apprised of new developments that may affect them.",
        "start_character": 50984,
        "end_character": 51199
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer local government monitoring and alert services in various jurisdictions.",
        "start_character": 51200,
        "end_character": 51286
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are active in all major sectors of the economy, including healthcare and pharmaceuticals, asset management and financial services, energy, technology, telecoms and transportation.",
        "start_character": 1269,
        "end_character": 1451
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe the growing scale and reach of our platform creates opportunities for cross-selling services and integrated project management across geographies and service offerings, allowing us to meet a broader range of client needs.",
        "start_character": 30412,
        "end_character": 30644
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We designed our business to address the growing complexity and costs facing major corporate and non-profit entities in managing increasingly intricate and interdependent public policy and reputational challenges, and we now help more than 1,400 clients around the world navigate today’s complex mosaic of stakeholders across the full spectrum of corporate affairs.",
        "start_character": 562,
        "end_character": 926
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We foresee opportunities to develop new, non-services-based products that would be based on our original intellectual property and ways of working.",
        "start_character": 35566,
        "end_character": 35713
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022359",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-022359-e407357c8b118cca",
        "accession_number": "0001628280-26-022359",
        "filing_date": "2026-03-31",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We have also grown our practice capabilities to provide clients a broad range of services, including corporate communications and public affairs.",
        "start_character": 21583,
        "end_character": 21728
      }
    ]
  },
