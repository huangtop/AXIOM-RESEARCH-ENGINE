        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are the registered owner of a variety of the shutterstock.com, bigstock.com, offset.com, premiumbeat.com, rexfeatures.com, turbosquid.com, picmonkey.com, pond5.com, splashnews.com, backgrid.com, envato.com, placeit.net, tutsplus.com, themeforest.net, codecanyon.net, videohive.net, audiojungle.net, graphicriver.net, photodune.net, 3docean.net, and mixkit.co.",
