        "end_character": 30615
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001666071-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001666071-26-000010-513edaa170ea77fb",
        "accession_number": "0001666071-26-000010",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "By serving these marketers at scale, we have developed deep insight into consumer behavior, which has allowed us to optimize how we reach and influence likely buyers.",
        "start_character": 13826,
        "end_character": 13992
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001666071-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001666071-26-000010-513edaa170ea77fb",
        "accession_number": "0001666071-26-000010",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In January 2026, we entered into a definitive agreement to sell substantially all of the assets primarily related to, or primarily used in, our Bridg platform to an affiliate of PAR Technology Corporation.",
        "start_character": 2841,
        "end_character": 3046
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001666071-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001666071-26-000010-513edaa170ea77fb",
        "accession_number": "0001666071-26-000010",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "The breadth of our network of FI partners means that we are able to offer marketers the ability to optimize their marketing efforts to reach a large number of consumers through a single point of contact.",
        "start_character": 4289,
        "end_character": 4492
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001666071-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001666071-26-000010-513edaa170ea77fb",
        "accession_number": "0001666071-26-000010",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also leverage the power of our data to provide marketers utilizing our financial media network with valuable insights into the preferences of their actual or potential customers wherever they shop.",
