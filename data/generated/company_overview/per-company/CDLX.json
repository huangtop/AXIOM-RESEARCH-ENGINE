        "accession_number": "0001666071-26-000010",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Pursuant to the GSA with Bank of America, we provide the Cardlytics platform to Bank of America customers, and as part of our services we form relationships with participating marketers and obtain and publish marketer offers to Bank of America customers.",
        "start_character": 19851,
        "end_character": 20105
      },
      {
