        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "The vessels we deploy on period time charters provide us with relatively stable cash flow and high utilization rates, while the vessels we deploy in the spot market allow us to maintain our flexibility in low charter market conditions.",
        "start_character": 3973,
        "end_character": 4208
