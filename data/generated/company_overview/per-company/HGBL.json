        "filing_date": "2026-03-12",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Historically, recessions drive an increased supply of surplus assets and increased demand for liquidation services, which we believe we are well-positioned to provide.",
        "start_character": 7110,
        "end_character": 7277
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-104062",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-104062-7c518b18003ece36",
        "accession_number": "0001193125-26-104062",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The typical credit we broker sells at a discount to face value, and we typically receive a commission for these services from both buyers and sellers.",
