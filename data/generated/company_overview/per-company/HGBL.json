        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Additionally, we believe an active market for mergers and acquisitions in manufacturing industries drives demand for industrial asset liquidations and our services.",
        "start_character": 7840,
        "end_character": 8004
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-104062",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-104062-7c518b18003ece36",
