        "accession_number": "0001193125-26-104062",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide a full suite of services including market making, acquisitions, refurbishment, dispositions, valuations and secured lending.",
