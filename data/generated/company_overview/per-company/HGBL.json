        "accession_number": "0001193125-26-104062",
        "filing_date": "2026-03-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Through HGP, we offer a global full-service auction, appraisal and asset advisory firm, including the acquisition of turnkey manufacturing facilities and used industrial machinery and equipment.",
        "start_character": 14716,
        "end_character": 14910
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-104062",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-104062-7c518b18003ece36",
        "accession_number": "0001193125-26-104062",
        "filing_date": "2026-03-12",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We believe we have the opportunity for growth in our auction services through our ability to secure ongoing contracts with large multinational sellers, to be a first mover in emerging sectors, and to gain market share in sectors in which we are currently less active.",
