        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For example, we have the capability to manufacture Opdivo substance and drug product internally and also have arrangements with third-party manufacturers to meet demand of Opdivo drug substance and drug product.",
        "start_character": 86499,
        "end_character": 86710
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000014272-26-000004",
