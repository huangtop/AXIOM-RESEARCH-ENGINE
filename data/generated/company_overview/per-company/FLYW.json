        "accession_number": "0001193125-26-067540",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We have the opportunity to offer additional complementary payment services to our clients’ customers in support of our clients’ business goals.",
