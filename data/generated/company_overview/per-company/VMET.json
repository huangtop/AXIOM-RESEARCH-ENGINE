        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As we are not the operator and generally not the owner of the properties underlying our royalty and streaming interests, we have limited or no access to related exploration, development or operational data or to the properties underlying our royalty and streaming interests.",
        "start_character": 50285,
        "end_character": 50559
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052847",
