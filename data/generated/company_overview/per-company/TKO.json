        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Based on our organizational structure, we believe we are well-positioned to effectively and efficiently navigate the rapidly evolving sports and entertainment landscape relative to other sports and entertainment offerings.",
        "start_character": 25781,
        "end_character": 26003
      },
      {
