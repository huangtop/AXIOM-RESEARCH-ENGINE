    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Auna Seguros is registered as an insurance provider with the Mexican Insurance and Surety Commission, and as part of our expansion strategy in Mexico, we are leveraging its existing nationwide insurance license and the infrastructure of our dental and vision business to market our oncology plans in Mexico.",
        "start_character": 30769,
        "end_character": 31076
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Healthcare plans in Peru, Oncosalud, is a vertically integrated healthcare plan platform through which we are both a healthcare payer and a provider of oncology and general healthcare services.",
        "start_character": 41666,
        "end_character": 41859
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2019, we expanded our portfolio to include selected general healthcare plans aiming to provide first-class services at more competitive prices than traditional insurance plans, leveraging our highly successful oncological model.",
        "start_character": 60259,
        "end_character": 60490
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In 2020, we began offering general healthcare plans with broader coverage that includes all specialties and services in our hospitals and clinics in Peru.",
        "start_character": 47970,
        "end_character": 48124
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In Mexico and Peru, we face competition primarily from other privately operated hospitals, clinics and healthcare networks for the provision of healthcare services.",
        "start_character": 84088,
        "end_character": 84252
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In Mexico, we face competition from other privately operated hospitals, clinics and healthcare networks for the provision of healthcare services.",
        "start_character": 85188,
        "end_character": 85333
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In Peru, we also face competition from other privately operated hospitals, clinics and healthcare networks for the provision of healthcare services.",
        "start_character": 86737,
        "end_character": 86885
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we provide a wide variety of medium-complexity services at our regional hospitals and clinics outside of Lima, with our hospitals in Chiclayo and Arequipa serving as our two key regional hubs with a focus on medium-complexity treatments in northern and southern Peru, respectively.",
        "start_character": 33677,
        "end_character": 33971
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Moreover, Auna continues to adapt its organizational structure to the needs of the business and the markets where we operate, focusing on scaling and integrating its established regional capabilities in medical resolution and patient experience.",
        "start_character": 74340,
        "end_character": 74585
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our high-complexity services are centered at our flagship hospital in this network, Clínica Delgado, which we built from the ground up between 2011 and 2014 and which was designed by Gresham Smith & Partners, one of the leading architecture firms for healthcare facilities in the United States.",
        "start_character": 32690,
        "end_character": 32984
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Risk Factors—Risks Relating to Our Business—A failure of our IT systems could adversely impact our business.” In addition to our core information platforms, we have developed the Auna App, which provides our members and patients in Peru with secure access to certain information in our system and an immediate, convenient and personalized way to manage all their healthcare needs.",
        "start_character": 70879,
        "end_character": 71259
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-168210",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-168210-5b0b555709d3b9c1",
        "accession_number": "0001193125-26-168210",
        "filing_date": "2026-04-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Risk Factors—Risks Relating to Our Business—If we are unable to provide advanced care for a broad array of medical needs, demand for our healthcare services may decrease.”",
        "start_character": 67300,
        "end_character": 67471
      }
