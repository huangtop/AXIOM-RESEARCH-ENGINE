        "accession_number": "0001581280-25-000025",
        "filing_date": "2025-11-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We currently manufacture all of our products and multiple sub-assemblies at our manufacturing facilities in South San Francisco, California and Wilsonville, Oregon.",
        "start_character": 22447,
        "end_character": 22611
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001581280-25-000025",
        "provenance_id": "provenance:SEC-FILING-0001581280-25-000025-869316b38675a955",
        "accession_number": "0001581280-25-000025",
        "filing_date": "2025-11-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We employ business development and sales representatives for our biopharma solutions as well.",
