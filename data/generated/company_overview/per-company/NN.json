        "accession_number": "0001554855-26-000328",
        "filing_date": "2026-03-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Domestically, we operate primarily as a service provider, leveraging our intellectual property, spectrum assets, and partnerships with key customers.",
        "start_character": 13129,
        "end_character": 13278
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000328",
