        "accession_number": "0001554855-26-000328",
        "filing_date": "2026-03-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We anticipate NextGen will increase our spectrum utilization significantly, allowing us to offer both high-quality PNT services and broadband data using the same spectrum.",
