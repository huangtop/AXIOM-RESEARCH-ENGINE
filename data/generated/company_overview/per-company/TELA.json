        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As we innovate and develop our products, the new features and improved surgical techniques expand the clinical applications for soft-tissue reinforcement.",
        "start_character": 49053,
        "end_character": 49207
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-034507",
