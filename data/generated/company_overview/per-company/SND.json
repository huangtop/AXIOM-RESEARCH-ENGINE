        "end_character": 36555
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We aim to maintain a culture that prioritizes safety, the environment and our relationship with the communities in which we operate, actions we believe are critical to the success of our business.",
        "start_character": 27780,
        "end_character": 27976
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We believe that our insurance coverage is customary for the industry in which we operate and adequate for our business.",
        "start_character": 41218,
        "end_character": 41337
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe that, among other things, the size and favorable geologic characteristics of our sand reserves, the strategic location and logistical advantages of our facilities, our proprietary SmartDepotTM portable wellsite proppant storage silos, our proprietary SmartPath® wellsite proppant management system, SmartBeltTM conveyor system, access to all Class I rail lines, and the industry experience of our senior management team make us as a highly attractive provider of sand and logistics services.",
        "start_character": 994,
        "end_character": 1496
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe this business provides us with the ability to diversify some of our sales into more stable, consumer-driven products to help mitigate some of the price volatility we are exposed to in the oil and gas markets that we serve.",
        "start_character": 4332,
        "end_character": 4565
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We operate a unit train capable transloading terminal in Van Hook, North Dakota, which became operational in April 2018, to service the Bakken Formation in the Williston Basin.",
        "start_character": 3082,
        "end_character": 3258
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide wellsite proppant handling solutions services and equipment under flexible contract terms custom tailored to meet the needs of our customers.",
        "start_character": 4815,
        "end_character": 4967
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell frac sand under short- and long-term take-or-pay contracts as well as in the spot market, and provide proppant logistics solutions through our in-basin transloading terminals and SmartSystems wellsite proppant storage solutions and other logistics services.",
        "start_character": 29170,
        "end_character": 29435
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Despite the emergence of regional sand in oil and natural gas producing basins, we believe the proppant market continues to offer attractive long-term growth fundamentals for Northern White frac sand in the key operating basins we currently serve due to the logistics advantages in these basins and its superior well results compared to regional sand alternatives.",
        "start_character": 16683,
        "end_character": 17047
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2024, we developed new dual bucket elevators to enhance our vertical material handling capabilities.",
        "start_character": 25788,
        "end_character": 25891
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "The members of our senior management team bring significant experience to the market environment in which we operate.",
        "start_character": 27432,
        "end_character": 27549
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529628-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001529628-26-000006-e8ed90060000079f",
        "accession_number": "0001529628-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that we are one of the few frac sand producers with a network of facilities custom-designed for the specific purpose of delivering frac sand to all of the major U.S.",
