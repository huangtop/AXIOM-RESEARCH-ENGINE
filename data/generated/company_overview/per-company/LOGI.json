        "accession_number": "0001032975-26-000021",
        "filing_date": "2026-05-21",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe our diversified manufacturing footprint across six countries, our supply chain’s extensive global reach, our key distribution channels and strategic business relationships combined with our factory automation, extensive analytic modeling expertise, optimization tools and global processes are key competitive advantages.",
