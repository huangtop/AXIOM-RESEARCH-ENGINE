        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As part of the system offering, we also offer analysis services, if the customer elects not to do such analysis itself.",
        "start_character": 24945,
        "end_character": 25064
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005366",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005366-6d0473c943abe686",
