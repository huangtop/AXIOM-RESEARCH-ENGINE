        "accession_number": "0001016281-26-000021",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2023, we entered into an exclusive partnership agreement with a national insurance provider to market and sell prearranged funeral services, for which we received a $6.0 million incentive payment.",
        "start_character": 4518,
        "end_character": 4717
      },
      {
