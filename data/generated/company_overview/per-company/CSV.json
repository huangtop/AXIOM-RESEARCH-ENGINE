        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Additionally, we are generally required under applicable state laws to deposit a specified amount (which varies from state to state, generally 50% to 100% of the selling price) into a merchandise and service trust fund for preneed cemetery merchandise and services sales.",
        "start_character": 21703,
        "end_character": 21974
      },
      {
