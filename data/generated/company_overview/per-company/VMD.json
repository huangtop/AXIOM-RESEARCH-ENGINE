        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "We are subject to extensive government regulation, including numerous laws directed at regulating reimbursement of our products and services under various government and commercial programs and preventing fraud and abuse, as more fully described below.",
        "start_character": 8964,
        "end_character": 9216
      },
      {
