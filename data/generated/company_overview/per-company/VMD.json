        "filing_date": "2026-03-04",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "If we are found to be out of compliance with accreditation standards during an annual site visit, our enrollment status in the Medicare program could be jeopardized, up to and including termination.",
