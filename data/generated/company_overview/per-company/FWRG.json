    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to build upon the success of the program with expanded development offerings to both our Home Office employees and restaurant management teams.",
        "start_character": 24147,
        "end_character": 24302
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "As consumers increasingly seek higher quality breakfast, brunch and lunch experiences, we believe we are well-positioned to compete with a wide range of national, regional and local establishments that operate during our hours of operation.",
        "start_character": 29770,
        "end_character": 30010
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "At December 28, 2025, we had 9 franchisees operating 73 restaurants with 17 total new restaurant development obligations.",
        "start_character": 6902,
        "end_character": 7023
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to various local philanthropic efforts in the communities we serve, First Watch focuses its giving through key efforts designed to create positive impact both externally and within our organization:",
        "start_character": 3790,
        "end_character": 4000
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To that end, during 2025, we acquired 19 operating restaurants along with development and territory rights in two separate transactions.",
        "start_character": 6566,
        "end_character": 6702
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe the Company’s operation of the restaurants acquired from our franchisees as well as development in the reacquired territory, provides substantial opportunity to realize new Company value.",
        "start_character": 6703,
        "end_character": 6901
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We operate on a “No Nights Ever” model and work to get our restaurant employees “out the door by four”– which allows our teams to enjoy evenings with their family and friends, and an improved quality of life.",
        "start_character": 21408,
        "end_character": 21616
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "•A certified training general manager and restaurant program provides additional financial and growth opportunities for aspiring leaders, enabling us to promote more employees from within our restaurants and ensure we are delivering a best-in-class training experience to all new hires.",
        "start_character": 25403,
        "end_character": 25689
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "And while our work is ongoing, we are dedicated to continuing to build upon our “You First” commitment and unlock possibilities for each team member and the communities we serve.",
        "start_character": 23336,
        "end_character": 23514
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "As a result, we are proud of the many people-focused awards and accolades we have received over the past few decades.",
        "start_character": 3186,
        "end_character": 3303
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "At First Watch, we are committed to making days brighter by creating a culture where our teams and our customers feel valued and celebrated for who they are and the differences they bring to the table.",
        "start_character": 22682,
        "end_character": 22883
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001789940-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001789940-26-000014-dbaaf92cc0012438",
        "accession_number": "0001789940-26-000014",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "At First Watch, we are driven by a pursuit of freshness as is highlighted by our culinary and sourcing philosophy to “Follow the Sun.” With this philosophy, our menu, which is inspired by the seasons, changes four to five times per year.",
        "start_character": 1567,
        "end_character": 1804
      }
