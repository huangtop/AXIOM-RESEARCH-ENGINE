        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For ESS, we supply fully integrated hardware and software solutions with battery health and safety management software powered by Molecular Universe, which we believe differentiates our products in a competitive market.",
        "start_character": 907,
        "end_character": 1126
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001819142-26-000010",
