        "filing_date": "2026-04-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe ourselves, Eurobulk, Eurobulk FE and the Pittas family have developed strong industry relationships and have gained acceptance with charterers, lenders and insurers because of long-standing reputation for safe and reliable service and financial responsibility through various shipping cycles.",
        "start_character": 17699,
