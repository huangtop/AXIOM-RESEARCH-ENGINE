        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide a technology platform and services to onboard talent and enable engagement and/or employment of employees and contractors globally, workforce management, payroll processing and management, and contractor management services.",
        "start_character": 18247,
        "end_character": 18482
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-020487",
