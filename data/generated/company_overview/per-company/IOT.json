        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To support this scale, we dedicate significant resources to maintaining a robust data protection and privacy program designed to secure our customers’ operational data.",
        "start_character": 7830,
        "end_character": 7998
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018167",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018167-21f4f6a235c00ad5",
        "accession_number": "0001628280-26-018167",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that using outsourced manufacturing partners enables greater scale and flexibility at lower costs than establishing our own manufacturing facilities.",
