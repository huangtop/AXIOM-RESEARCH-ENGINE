        "filing_date": "2026-03-16",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We believe that we are well positioned to capitalize on the ongoing proliferation of 5G and the capabilities that a more robust network can provide, particularly in leveraging AI and video.",
        "start_character": 50391,
        "end_character": 50580
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018167",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018167-21f4f6a235c00ad5",
