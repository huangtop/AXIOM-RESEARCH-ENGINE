        "filing_date": "2025-12-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition to our hardware and software, we offer a broad range of complementary services that help our customers build, operate, and transform their networks and associated operational environments.",
        "start_character": 1172,
        "end_character": 1372
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-25-056698",
