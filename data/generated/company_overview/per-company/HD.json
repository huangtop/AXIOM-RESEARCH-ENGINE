    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Building on our historical strength as a destination for all Pros, we are continuing to invest in differentiated capabilities that will help us better serve our Pros’ needs, including differentiated fulfillment options, preferred pricing, additional trade credit offerings including our Pro Trade Credit program, more convenient locations and showroom space, and technology tools designed to streamline order management and project planning and management.",
        "start_character": 7429,
        "end_character": 7885
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Currently, we offer installation services in a variety of categories, such as flooring, water heaters, bath, garage doors, cabinets, cabinet makeovers, countertops, sheds, furnaces and central air systems, windows, and window coverings.",
        "start_character": 8946,
        "end_character": 9182
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In addition, we are leveraging AI tools to improve our search, recommendations, and chat features, and offering new AI-powered customer-facing tools such as Magic ApronTM, which supports customers and associates with online product and project inquiries, and our AI-powered Blueprint Takeoffs Tool and Material List Builder, which generate project-specific materials lists and quotes.",
        "start_character": 21185,
        "end_character": 21569
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In fiscal 2024, we acquired SRS, which sells products to specialty trade roofers, landscapers, and pool contractors.",
        "start_character": 7886,
        "end_character": 8002
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Once a jobseeker has applied for a role and has been selected to move forward in the recruiting process, we provide self-service for many of our positions by allowing jobseekers to schedule or reschedule pre-hire activities directly from their mobile device.",
        "start_character": 36115,
        "end_character": 36373
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "The Home Depot is focused on leveraging its distinct competitive advantages – our brand, excellent customer service, product authority in home improvement, knowledgeable associates and culture, scale, premier real estate portfolio, digital and interconnected experience, supply chain network, and our deep relationships with Pros – to take advantage of the significant growth opportunities in the highly fragmented markets in which we operate.",
        "start_character": 2667,
        "end_character": 3110
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "To complement our merchandising efforts, we offer a number of services for our customers, including installation services for our DIY and DIFM customers, as noted above.",
        "start_character": 12662,
        "end_character": 12831
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer car and van delivery service from the majority of our U.S.",
        "start_character": 31130,
        "end_character": 31202
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide MRO products and related value-added services to multifamily, hospitality, healthcare, and government housing facilities, among others, primarily through our subsidiary HD Supply.",
        "start_character": 8249,
        "end_character": 8444
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide a number of services, including home improvement installation services, and tool and equipment rental.",
        "start_character": 321,
        "end_character": 439
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide curbside pickup to complement our BOPIS offerings, in addition to the self-service lockers at the front entrance of many of our stores.",
        "start_character": 30978,
        "end_character": 31129
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-019436",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-019436-7a108cae33600d3e",
        "accession_number": "0001628280-26-019436",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We maintain a global sourcing program to obtain high-quality and innovative products directly from manufacturers in the U.S.",
        "start_character": 13168,
        "end_character": 13292
      }
