    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Any determination that we are acting in the capacity of a healthcare provider and acting improperly as a healthcare provider, exercising undue influence or control over a healthcare provider or impermissibly sharing fees with a healthcare provider, may result in additional compliance requirements, expense, and liability to us, and require us to change or terminate some portions of our contractual arrangements or business.",
        "start_character": 55790,
        "end_character": 56215
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As an open and self-service platform, we support the development of analytics applications on top of Ignite, which can accelerate the adoption and integration of our Ignite platform by our clients.",
        "start_character": 13464,
        "end_character": 13661
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Based on client feedback and needs, we focus our efforts on developing or acquiring new products, functionality, applications, and core technologies and further enhancing the usability, functionality, reliability, performance, and flexibility of our Solution.",
        "start_character": 44076,
        "end_character": 44335
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Because our Ignite platform is open and we partner with our clients, we are able to identify new opportunities for further improvements and leverage that insight with other clients across our core market to develop new analytics applications and services offerings.",
        "start_character": 21048,
        "end_character": 21313
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Even though we do not directly order or provide healthcare services that are reimbursable by Medicare, Medicaid, or other third-party payors or submit claims or receive reimbursement from any such payor, certain federal and state healthcare laws and regulations pertaining to fraud, abuse, and waste apply or may apply to our business and to the financial arrangements through which we market, sell, and provide our services to our healthcare provider clients.",
        "start_character": 50417,
        "end_character": 50877
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are a leading provider of data and analytics technology and services to healthcare organizations.",
        "start_character": 26,
        "end_character": 126
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have used this process to build several new software applications through our history, and we will continue to invest in product development, particularly at the analytics applications layer of our technology stack.",
        "start_character": 21314,
        "end_character": 21532
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We market and sell our services to healthcare organizations primarily in the United States and we opportunistically market and sell in other countries and regions.",
        "start_character": 42962,
        "end_character": 43125
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We may incur increased software development and administrative expense and delays in delivering technology and services if we need to update our services to conform to these varying and evolving requirements.",
        "start_character": 57396,
        "end_character": 57604
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide a range of high-value-add professional services to help our clients implement and maximize the value of our Solution.",
        "start_character": 36370,
        "end_character": 36498
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe there are significant applications for our Solution outside of our core market, as evidenced by our early efforts to expand into certain international markets and our efforts to expand outside of our core target client of healthcare systems to adjacent markets such as life sciences organizations, health insurance providers, and health information exchanges (HIEs).",
        "start_character": 21817,
        "end_character": 22194
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001636422-26-000035",
        "provenance_id": "provenance:SEC-FILING-0001636422-26-000035-d46e3371151a2749",
        "accession_number": "0001636422-26-000035",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have developed the capabilities to turn these insights into actions by connecting our analytics into the workflow systems, such as an electronic health record (EHR).",
        "start_character": 25001,
        "end_character": 25169
      }
