        "accession_number": "0001973239-26-000097",
        "filing_date": "2026-05-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our business model provides significant flexibility to fund long-term investments in future products.",
        "start_character": 33387,
        "end_character": 33488
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001973239-26-000097",
