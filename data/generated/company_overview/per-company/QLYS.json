        "end_character": 7307
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001107843-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001107843-26-000008-19ce4e5d7f241987",
        "accession_number": "0001107843-26-000008",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also seek to replace IT, security and compliance solutions that organizations have developed internally.",
