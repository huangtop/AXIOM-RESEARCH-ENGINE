        "end_character": 35068
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001111928-26-000040",
        "provenance_id": "provenance:SEC-FILING-0001111928-26-000040-7942c2118b29f7d6",
        "accession_number": "0001111928-26-000040",
        "filing_date": "2026-02-23",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are engaged in research projects to expand the spectral range of products that we offer.",
