        "accession_number": "0001111928-26-000040",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Separately, we have developed and launched CROSSBOW™, a counter-unmanned aircraft system (counter‑UAS) solution offered to government and other authorized parties as part of our advanced application offerings.",
        "start_character": 23538,
        "end_character": 23747
