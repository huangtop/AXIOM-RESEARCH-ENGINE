        "accession_number": "0001111928-26-000040",
        "filing_date": "2026-02-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Some of our competitors are larger than we are and have substantially greater financial, managerial and technical resources, more extensive distribution and service networks, greater sales and marketing capacity, and larger installed customer bases than we do.",
