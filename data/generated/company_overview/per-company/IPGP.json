        "accession_number": "0001111928-26-000040",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Using our knowledge of optical fibers, we recently extended our product line by manufacturing fibers used as a consumable component with our proprietary medical laser systems.",
