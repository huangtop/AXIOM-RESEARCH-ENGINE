        "end_character": 19213
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000732712-26-000007",
        "provenance_id": "provenance:SEC-FILING-0000732712-26-000007-892d566da38b16c8",
        "accession_number": "0000732712-26-000007",
