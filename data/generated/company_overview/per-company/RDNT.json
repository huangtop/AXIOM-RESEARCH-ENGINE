    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Additionally, we perform certain management services for a portion of the professional groups with whom we contract who provide professional radiology services at local hospitals.",
        "start_character": 33372,
        "end_character": 33551
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Although we receive fees under our service agreements for management and administrative services, we are not in a position to make or influence referrals of patients.",
        "start_character": 59463,
        "end_character": 59629
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "At locations where the Group does not provide professional medical services, we have entered into long-term contracts with third-party radiology groups in the area to provide physician services at those centers.",
        "start_character": 31855,
        "end_character": 32066
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In order to comply with this prohibition, we contract with medical groups to provide professional medical services in our centers, including the supervision and interpretation of diagnostic imaging procedures.",
        "start_character": 31365,
        "end_character": 31574
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In order to ensure operational efficiency, we have maintenance arrangements with the various service arms of the original equipment manufacturers that supply our imaging equipment.",
        "start_character": 48234,
        "end_character": 48414
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In the states in which we provide services (except Florida and Arizona), a lay person or any entity other than a professional corporation or similar professional organization is not allowed to practice medicine, including by employing professional persons or by having any ownership interest or profit participation in or control over any medical professional practice.",
        "start_character": 30897,
        "end_character": 31266
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Therefore, we monitor developments in healthcare law and modify our operations from time to time as the business and regulatory environment changes.",
        "start_character": 50606,
        "end_character": 50754
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Under management agreements with the Group or other third-party radiology practices, we provide the use of our diagnostic imaging equipment, technical and management services, and administration of the non-medical functions of the professional medical practices at our centers, including the provision of non-medical staff, accounting services, billing and collection, medical and office supplies, transcription services, maintenance of medical records, and marketing.",
        "start_character": 32448,
        "end_character": 32916
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide radiology services at select imaging centers for the Anaheim Ducks, Los Angeles Angels, Los Angeles Rams, San Francisco 49ers and student athletes of the University of Southern California.",
        "start_character": 46646,
        "end_character": 46850
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are a leading national provider of diagnostic imaging services in the United States based on number of locations and annual imaging revenue.",
        "start_character": 34,
        "end_character": 177
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe our position as a leading provider of diagnostic imaging services and our long-term relationships with physician groups in our markets enable us to obtain more favorable contract terms than would be available to smaller or less experienced imaging services providers.",
        "start_character": 24117,
        "end_character": 24395
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013337",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013337-9a939e6d0c4c5c3c",
        "accession_number": "0001628280-26-013337",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe that our compliance program meets the relevant standards provided by the Office of Inspector General of the Department of Health and Human Services.",
        "start_character": 75663,
        "end_character": 75822
      }
    ]
  },
