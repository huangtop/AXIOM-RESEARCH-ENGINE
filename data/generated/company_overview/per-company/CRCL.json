    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to Arc itself, we offer a suite of developer tools and interoperability services designed to reduce complexity and enable developers and enterprises to build, deploy, and operate consumer-scale applications that deliver and move value across blockchain networks.",
        "start_character": 8670,
        "end_character": 8944
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Once enrolled, we offer minting services to Circle Mint customers free of charge.",
        "start_character": 18828,
        "end_character": 18909
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also provide interoperability services that enable developers and enterprises to move USDC efficiently across blockchains and to support more seamless, cross-chain application experiences.",
        "start_character": 13178,
        "end_character": 13369
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are also facing increasing competition from financial services companies and newly emerging yield-bearing digital assets, including TMMFs, and blockchain network providers that seek to become the preferred rails for stablecoin issuance and settlement.",
        "start_character": 50684,
        "end_character": 50938
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe we compete favorably across key competitive factors and that we have developed a platform business that is difficult to replicate.",
        "start_character": 52940,
        "end_character": 53081
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We continue to expand the network of banks that provide primary liquidity services to the Circle stablecoin ecosystem.",
        "start_character": 19966,
        "end_character": 20084
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We operate information security and privacy programs designed to protect sensitive data and support the safe operation of our products and services, and we monitor changes in law and regulation that could increase compliance costs, affect product design, or otherwise impact our business.",
        "start_character": 34108,
        "end_character": 34396
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, we expect the framework to influence market structure by increasing compliance expectations for stablecoin issuers and by establishing stringent conditions under which foreign-issued stablecoins may be offered on U.S.",
        "start_character": 27259,
        "end_character": 27490
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As of December 31, 2025, we held approximately 88% of USDC reserves in the Circle Reserve Fund, a government money market fund pursuant to Rule 2a-7 under the 1940 Act managed by BlackRock and available only to us.",
        "start_character": 35339,
        "end_character": 35553
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, following the passage of the GENIUS Act, we are exploring ways to further enhance protections and provide certainty for USDC holders in the unlikely event of insolvency.",
        "start_character": 41759,
        "end_character": 41941
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "The GENIUS Act is important because it will provide clear, nationwide standards for the issuance and use of payment stablecoins in the U.S., which we believe can increase market confidence and support broader institutional adoption.",
        "start_character": 26282,
        "end_character": 26514
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001876042-26-000062",
        "provenance_id": "provenance:SEC-FILING-0001876042-26-000062-2708bc61b370372a",
        "accession_number": "0001876042-26-000062",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also maintain compliance programs designed to address anti-bribery and anti-corruption requirements and other regulatory expectations applicable to our operations and our relationships with government entities.",
        "start_character": 33628,
        "end_character": 33841
      }
    ]
  },
