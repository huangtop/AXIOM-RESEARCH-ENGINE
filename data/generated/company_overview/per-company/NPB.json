        "filing_date": "2026-03-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our senior management is also responsible for creating and recommending to our board of directors for approval appropriate risk appetite metrics reflecting the aggregate levels and types of risk we are willing to accept in connection with the operation of our business and pursuit of our business objectives.",
        "start_character": 16868,
        "end_character": 17176
      },
      {
