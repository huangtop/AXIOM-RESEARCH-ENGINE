        "end_character": 19715
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001336706-26-000020",
        "provenance_id": "provenance:SEC-FILING-0001336706-26-000020-82a2d444339019df",
        "accession_number": "0001336706-26-000020",
        "filing_date": "2026-03-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Today, we are the largest bank headquartered in the state of Michigan, one of the largest providers of mortgage warehouse financing, and one of the only mortgage-focused banks in the country.",
