        "accession_number": "0001336706-26-000020",
        "filing_date": "2026-03-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition to our digital platform, we operate loan production offices in 25 cities across 15 states, which support our lending activities and are backed by our centralized operating center in Grand Rapids.",
        "start_character": 9884,
        "end_character": 10091
      },
      {
