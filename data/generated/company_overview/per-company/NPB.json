        "filing_date": "2026-03-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition to our principal executive office, we operate loan production offices across 25 cities in 15 states that are supported through our centralized operating center in Grand Rapids, Michigan.",
        "start_character": 17876,
        "end_character": 18074
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001336706-26-000020",
        "provenance_id": "provenance:SEC-FILING-0001336706-26-000020-82a2d444339019df",
        "accession_number": "0001336706-26-000020",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In particular, we facilitate the educational and professional development of our employees through support to attend conferences and obtain degrees, licenses and certifications while employed by us.",
