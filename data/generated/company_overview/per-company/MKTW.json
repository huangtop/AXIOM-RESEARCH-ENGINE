        "end_character": 12324
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001805651-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001805651-26-000016-2ef5b0ad74e9331b",
        "accession_number": "0001805651-26-000016",
        "filing_date": "2026-03-06",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Today, we are a leading multi-brand platform of subscription businesses that provides premium financial research, software, education, and tools for self-directed investors.",
        "start_character": 349,
        "end_character": 522
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001805651-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001805651-26-000016-2ef5b0ad74e9331b",
        "accession_number": "0001805651-26-000016",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Using this data-driven and time-tested approach, we have developed proprietary practices for customer acquisition that we believe set us apart from other companies.",
