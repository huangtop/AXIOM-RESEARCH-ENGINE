        "end_character": 8565
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035244",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035244-51eef8b454b49a8a",
        "accession_number": "0001104659-26-035244",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We must identify and capture future market opportunities by developing and deploying value-added products.",
        "start_character": 25590,
        "end_character": 25696
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035244",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035244-51eef8b454b49a8a",
        "accession_number": "0001104659-26-035244",
        "filing_date": "2026-03-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We operate an engineering and R&D facility in Fremont, California, that serves as a primary hub for gas-sensing new product development, SBIR-funded research, and quality control for our gas and environmental sensing products.",
        "start_character": 32406,
        "end_character": 32632
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035244",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035244-51eef8b454b49a8a",
        "accession_number": "0001104659-26-035244",
        "filing_date": "2026-03-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide end-to-end engineering services for customers requiring integrated gas-sensing solutions, including custom sensor and module design, circuit optimization, calibration and compensation algorithms, firmware development, and enclosure design and validation.",
