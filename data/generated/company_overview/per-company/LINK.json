        "end_character": 18159
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035244",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035244-51eef8b454b49a8a",
        "accession_number": "0001104659-26-035244",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In Shenzhen, China, we operate an engineering center within our manufacturing facility focused on sustaining engineering, customer support, quality control, and new product introduction for our force-sensing and HMI products.",
        "start_character": 32926,
        "end_character": 33151
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035244",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035244-51eef8b454b49a8a",
        "accession_number": "0001104659-26-035244",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We compete for market share based on our customers’ selection of our components over our competitors during the design phase of their products.",
        "start_character": 25697,
        "end_character": 25840
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035244",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035244-51eef8b454b49a8a",
        "accession_number": "0001104659-26-035244",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to expand our standard product portfolio and develop new technology platforms to capture emerging markets, particularly in IoT-enabled intelligent sensing systems.",
        "start_character": 3598,
        "end_character": 3773
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035244",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035244-51eef8b454b49a8a",
        "accession_number": "0001104659-26-035244",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We design, develop, manufacture, and sell a broad range of force-sensing and HMI technologies that incorporate proprietary materials, firmware, and software into scalable sensor components, subassemblies, modules, and fully integrated products.",
        "start_character": 1149,
        "end_character": 1393
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035244",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035244-51eef8b454b49a8a",
        "accession_number": "0001104659-26-035244",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We manufacture our force-sensing products at our proprietary printed electronics facility in Shenzhen, China, and our Calman facility in Irvine, Scotland, and our Conductive Transfers facility (which we are in the process of relocating from Barnsley, England).",
