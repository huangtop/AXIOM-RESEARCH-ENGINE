        "accession_number": "0001628280-25-056742",
        "filing_date": "2025-12-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our business is based on capital equipment investments by major semiconductor and other manufacturers, and is subject to significant variability in customer demand for our products.",
        "start_character": 9121,
        "end_character": 9302
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-25-056742",
        "provenance_id": "provenance:SEC-FILING-0001628280-25-056742-293e7090a8a8fd6d",
        "accession_number": "0001628280-25-056742",
        "filing_date": "2025-12-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also manufacture products and serve customers in certain other industries, including manufacturing equipment for the display industry.",
        "start_character": 4956,
        "end_character": 5093
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-25-056742",
        "provenance_id": "provenance:SEC-FILING-0001628280-25-056742-293e7090a8a8fd6d",
        "accession_number": "0001628280-25-056742",
        "filing_date": "2025-12-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are well positioned to address the increasing complexity in manufacturing semiconductors, by leveraging the semiconductor capital equipment industry’s most comprehensive portfolio of products to connect and co-optimize our technologies.",
        "start_character": 757,
        "end_character": 996
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-25-056742",
        "provenance_id": "provenance:SEC-FILING-0001628280-25-056742-293e7090a8a8fd6d",
        "accession_number": "0001628280-25-056742",
        "filing_date": "2025-12-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We operate in two reportable segments: Semiconductor Systems and Applied Global Services® (AGS).",
        "start_character": 1227,
        "end_character": 1323
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-25-056742",
