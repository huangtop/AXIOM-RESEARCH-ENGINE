        "end_character": 2555
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-25-056742",
        "provenance_id": "provenance:SEC-FILING-0001628280-25-056742-293e7090a8a8fd6d",
        "accession_number": "0001628280-25-056742",
        "filing_date": "2025-12-12",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "See “Risk Factors – Operational and Financial Risks – We operate in jurisdictions with complex and changing tax laws” for further details.",
