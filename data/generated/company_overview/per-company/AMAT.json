        "accession_number": "0001628280-25-056742",
        "filing_date": "2025-12-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We promote holistic employee learning and development based on the 70/20/10 model--70% on-the-job learning, 20% social/collaborative and 10% formal training, with a focus on advancing technical skills as well as improving general business acumen to address increasing work complexity.",
        "start_character": 21248,
        "end_character": 21532
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-25-056742",
        "provenance_id": "provenance:SEC-FILING-0001628280-25-056742-293e7090a8a8fd6d",
        "accession_number": "0001628280-25-056742",
        "filing_date": "2025-12-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We use qualified vendors, including contract manufacturers, to supply parts, services and product support.",
