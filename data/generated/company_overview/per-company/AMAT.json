        "end_character": 7133
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-25-056742",
        "provenance_id": "provenance:SEC-FILING-0001628280-25-056742-293e7090a8a8fd6d",
        "accession_number": "0001628280-25-056742",
        "filing_date": "2025-12-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to providing equipment for individual process steps, we have the ability to combine, co-optimize and integrate our technologies to develop highly differentiated solutions for our customers.",
