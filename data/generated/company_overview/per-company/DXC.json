        "accession_number": "0001688568-26-000022",
        "filing_date": "2026-05-08",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The IT and professional services markets we compete in are highly competitive, with a large number of companies having onshore and offshore delivery capabilities offering services that overlap with our offerings.",
        "start_character": 5639,
        "end_character": 5851
      },
      {
