        "provenance_id": "provenance:SEC-FILING-0001688568-26-000022-f061714ea126b3cf",
        "accession_number": "0001688568-26-000022",
        "filing_date": "2026-05-08",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide cross-industry business process services, which streamline clients’ core enterprise functions such as finance, HR, procurement, and customer service.",
        "start_character": 3174,
        "end_character": 3339
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001688568-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001688568-26-000022-f061714ea126b3cf",
        "accession_number": "0001688568-26-000022",
        "filing_date": "2026-05-08",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We market and sell our services to customers through a global direct sales force, operating across multiple locations around the world.",
        "start_character": 4768,
        "end_character": 4903
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001688568-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001688568-26-000022-f061714ea126b3cf",
        "accession_number": "0001688568-26-000022",
        "filing_date": "2026-05-08",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We operate through three reportable segments that align with how management assesses performance of the business and allocates resources - Consulting & Engineering Services (\"CES\"), Global Infrastructure Services (\"GIS\"), and Insurance Software & Services (\"Insurance\") - delivering solutions that modernize operations and drive innovation across our customers' entire IT estate.",
        "start_character": 635,
        "end_character": 1014
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001688568-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001688568-26-000022-f061714ea126b3cf",
        "accession_number": "0001688568-26-000022",
        "filing_date": "2026-05-08",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "At DXC, we consider professional development a corporate responsibility and a strategic investment in both our employees’ growth and the Company’s future.",
        "start_character": 12848,
        "end_character": 13002
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001688568-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001688568-26-000022-f061714ea126b3cf",
        "accession_number": "0001688568-26-000022",
        "filing_date": "2026-05-08",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Through our global learning management ecosystem, we provide a wide range of learning programs and a robust career development system to empower employees to reach their full potential.",
        "start_character": 13003,
        "end_character": 13188
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001688568-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001688568-26-000022-f061714ea126b3cf",
        "accession_number": "0001688568-26-000022",
        "filing_date": "2026-05-08",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have strong expertise in industries like finance, automotive, manufacturing, healthcare, life sciences, travel, and the public sector.",
        "start_character": 2255,
        "end_character": 2392
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001688568-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001688568-26-000022-f061714ea126b3cf",
        "accession_number": "0001688568-26-000022",
        "filing_date": "2026-05-08",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "DXC has been a signatory of the United Nations Global Compact (\"UNGC\") since the inception of our Company in 2017, and we are committed in our efforts to align with the UNGC's Ten Principles for responsible business practices.",
