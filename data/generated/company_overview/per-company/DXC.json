        "accession_number": "0001688568-26-000022",
        "filing_date": "2026-05-08",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In response to shifting customer demand, we offer a number of products and services that can have a significant impact on our customers’ sustainability objectives, delivering climate-related benefits far greater than what we could achieve alone through our internal carbon-reduction efforts.",
        "start_character": 10218,
        "end_character": 10509
      },
      {
