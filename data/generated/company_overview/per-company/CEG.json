    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Complementary to our national retail customer portfolio, we have several decades of relationships with wholesale counterparties across all domestic power markets as a means of both monetizing our own generation, as well as sourcing contracted generation to meet customer and portfolio needs.",
        "start_character": 25901,
        "end_character": 26192
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we sell natural gas through our customer-facing business;",
        "start_character": 56512,
        "end_character": 56582
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Many states in which we operate have state and regional programs to reduce GHG emissions and renewable and other portfolio standards, which impact the power sector.",
        "start_character": 58037,
        "end_character": 58201
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through active external engagement with key stakeholders on behalf of our business and customers, we believe we can support the effective design and operation of the electric markets.",
        "start_character": 42781,
        "end_character": 42964
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through our integrated business operations, we sell electricity, natural gas, and other energy-related products and sustainable solutions to various types of customers, including distribution utilities, municipalities, cooperatives, and commercial, industrial, public sector, and residential customers in markets across multiple geographic regions.",
        "start_character": 20419,
        "end_character": 20767
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are also successful at acquiring new customers by offering innovative products and solutions that meet their needs.",
        "start_character": 23721,
        "end_character": 23839
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continually evaluate growth opportunities aligned with our businesses, assets, and markets leveraging our expertise in those areas and offering durable returns.",
        "start_character": 45483,
        "end_character": 45646
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In 2025, we achieved an average refueling outage duration of 22 days for units we operate.",
        "start_character": 10243,
        "end_character": 10333
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to the owned generating resources above, at December 31, 2025, we had contracted generation with a total capacity of 4,798 MWs, which represents electric supply procured under unit-specific agreements.",
        "start_character": 4994,
        "end_character": 5207
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to the owned generation above, we also had purchased power from the spot energy markets that are administered by the RTOs/ISOs and bilateral transactions of 63,999 GWhs and 60,983 GWhs for the years ended December 31, 2025 and 2024, respectively.",
        "start_character": 7129,
        "end_character": 7387
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Most states where we operate have adopted some form of renewable or clean energy procurement requirement.",
        "start_character": 61375,
        "end_character": 61480
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001868275-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001868275-26-000032-ef26d09b86b43483",
        "accession_number": "0001868275-26-000032",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Since our SNF storage pools generally do not have sufficient storage capacity for the life of the respective plant, we have developed dry cask storage facilities to support operations.",
        "start_character": 69471,
        "end_character": 69655
      }
