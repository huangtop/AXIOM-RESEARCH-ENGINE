    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Many countries have announced a requirement for the sale of zero-emission vehicles only within proscribed timeframes, some as early as 2035, and we as an electric vehicle developer aim to comply with these requirements across our entire coming product portfolio as we expand.",
        "start_character": 202481,
        "end_character": 202756
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Pursuant to the Announcement on Relevant Policies for Deepening Value-Added Tax Reform effective on April 1, 2019, we are currently subject to VAT at rates between 6% and 13% on the products and services we provide, less any deductible VAT we have already paid or borne.",
        "start_character": 167430,
        "end_character": 167700
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Pursuant to the Distribution Agreement entered into by and between Lotus Cars Limited, the entity carrying out Lotus UK’s sportscar manufacturing operations, and LTIL, we are the exclusive global distributor (excluding the U.S., where LTIL will act as the head distributor with the existing regional distributor continuing its functions) for Lotus Cars Limited to distribute vehicles, parts, and certain tools, and to provide aftersales services, branding, marketing, and public relations for such vehicles, parts, and tools distributed by it.",
        "start_character": 16057,
        "end_character": 16600
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also provide engineering design consultancy services to external OEMs.",
        "start_character": 31706,
        "end_character": 31779
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also provide service and repair for vehicles manufactured or supplied by Lotus UK, in accordance with the applicable aftersales services and warranty services protocol.",
        "start_character": 19523,
        "end_character": 19694
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are dedicated to offering our customers a convenient and efficient charging experience and provide multiple solutions including home charging, flash charging and on-the-go charging provided by our designated partners who are also our affiliates.",
        "start_character": 19983,
        "end_character": 20231
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are mainly responsible for the design and development of the models, product announcement, and ensuring consistency with global standards of the Lotus brand.",
        "start_character": 37102,
        "end_character": 37262
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are responsible for establishing and maintaining a distribution network and an aftersales service network either selling directly, through Lotus UK’s subsidiaries, or by appointing sub-distributors.",
        "start_character": 18563,
        "end_character": 18764
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have proprietary and patented technologies related to aerodynamics, including wedge-shaped car designs, air intakes, and airfoils, and our electric vehicle portfolio inherits the aerodynamics design heritage.",
        "start_character": 31805,
        "end_character": 32016
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "With that level of complexity and interconnectivity in mind, we are building cybersecurity by TARA process into our vehicle development process itself, with the intent of enabling the business to remain resilient to any potential attacks at our vehicle development.",
        "start_character": 49988,
        "end_character": 50253
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Adhering to our driver-centric design philosophy, we digitalized our cabin design and implemented connectivity features to meet the drivers’ expectations in vehicle digitalization and connectivity.",
        "start_character": 29900,
        "end_character": 30097
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050310",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050310-49623599c90198ad",
        "accession_number": "0001104659-26-050310",
        "filing_date": "2026-04-28",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Apart from top hardware configuration, we also develop our own Hyper OS cabin operating system with the “UNREAL Engine” to support real-time rendering and optimize 3D content and experiences.",
        "start_character": 30672,
        "end_character": 30863
      }
    ]
  },
