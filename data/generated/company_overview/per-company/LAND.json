        "accession_number": "0001495240-26-000007",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are managed by our external adviser, Gladstone Management Corporation (the “Adviser”), and Gladstone Administration, LLC (the “Administrator”), provides administrative services to us.",
        "start_character": 2542,
        "end_character": 2728
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001495240-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001495240-26-000007-95b25146128da94b",
