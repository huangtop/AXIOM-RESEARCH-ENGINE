        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are an externally-managed, agricultural real estate investment trust (“REIT”) that is primarily in the business of owning and leasing farmland, including through lease structures with a variable rent component based on the gross revenues generated from certain farms in lieu of fixed base rent.",
        "start_character": 25,
        "end_character": 322
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001495240-26-000007",
