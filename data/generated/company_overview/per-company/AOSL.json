        "filing_date": "2025-08-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Because power management affects all electronic systems, we believe that developing a wide portfolio of products enables us to target new applications in addition to expanding our share of power management needs within existing applications.",
        "start_character": 39056,
        "end_character": 39297
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-25-041297",
