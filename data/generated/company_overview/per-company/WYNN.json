    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Overall, we believe Wynn Resorts has a demonstrated track record of developing and operating integrated resorts that stimulate local and regional economic activity, by attracting a wide range of customers (including high-net-worth international tourists), driving international tourism, raising average hotel room rates in the region, extending the average length of stay per visitor, complementing existing convention and meeting business with five-star accommodations and appropriately scaled meeting amenities, elevating service levels with the execution of five-star customer service, and stimulating city-wide investment and employment.",
        "start_character": 3666,
        "end_character": 4307
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We continually evaluate our offerings and service levels, and as a result, have made and expect to continue to make enhancements and refinements to our resorts.",
        "start_character": 3368,
        "end_character": 3528
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We foster the growth and development of our employees to ensure that they remain best-equipped to deliver the singular customer service at each of our resorts.",
        "start_character": 55520,
        "end_character": 55679
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We seek to differentiate our integrated resorts by delivering superior design and customer service.",
        "start_character": 14471,
        "end_character": 14570
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Across our resorts, we maintain an extensive program of training and development focused on skills development and career advancement.",
        "start_character": 55680,
        "end_character": 55814
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Approvals are, in certain circumstances, required from the NGC before we can make exceptional repurchases of voting securities above its current market price and before a corporate acquisition opposed by management can be consummated.",
        "start_character": 42997,
        "end_character": 43231
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "For example, some casino operators in the region may pay lower gaming taxes, or may be permitted to offer gaming amenities we are currently unable to offer at Encore Boston Harbor.",
        "start_character": 18746,
        "end_character": 18926
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In Everett, Massachusetts, we operate Encore Boston Harbor, an integrated resort.",
        "start_character": 1059,
        "end_character": 1140
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In Las Vegas, Nevada, we operate and, with the exception of certain retail space, own 100% of Wynn Las Vegas and Encore at Wynn Las Vegas, which we also refer to as our Las Vegas Operations.",
        "start_character": 868,
        "end_character": 1058
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition to gaming regulations, we are subject to extensive local, state, federal and foreign laws and regulations in the jurisdictions in which we operate.",
        "start_character": 54406,
        "end_character": 54565
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, we provide our employees in Macau with numerous professional development and training opportunities to elevate core and leadership skills.",
        "start_character": 7395,
        "end_character": 7546
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001174922-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001174922-26-000013-8ab497b8e6f88e36",
        "accession_number": "0001174922-26-000013",
        "filing_date": "2026-03-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Periodically, we are required to submit detailed financial and operating reports to the NGC and provide any other information that the NGC may require.",
        "start_character": 34217,
