        "accession_number": "0001850902-26-000002",
        "filing_date": "2026-03-02",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are differentiated by our ability to offer customer-specified RUO and GMP formulations with short turnaround times in volumes and product characteristics matching customer needs, our Teknova brand reputation established over 30 years, and our technical expertise.",
