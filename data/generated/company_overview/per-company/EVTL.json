        "offering_role": "service",
        "confidence": 0.96,
        "statement": "After we deliver our aircraft, we expect to be able to provide significant additional value through our “Aircraft Services” business.",
        "start_character": 62700,
        "end_character": 62833
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-033487",
