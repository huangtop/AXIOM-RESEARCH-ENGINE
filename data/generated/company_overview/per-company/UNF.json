        "accession_number": "0001193125-25-256222",
        "filing_date": "2025-10-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Currently, we also manufacture approximately 99% of the mats we place in service at our plant in Cave City, Arkansas.",
        "start_character": 11911,
        "end_character": 12028
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-25-256222",
