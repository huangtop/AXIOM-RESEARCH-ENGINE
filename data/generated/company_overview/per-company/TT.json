        "filing_date": "2026-02-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are one of the leading manufacturers in the world of HVAC systems and services and transport temperature control products and services.",
        "start_character": 5711,
        "end_character": 5849
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-005731",
