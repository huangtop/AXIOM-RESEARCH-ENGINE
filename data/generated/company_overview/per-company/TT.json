        "accession_number": "0001628280-26-005731",
        "filing_date": "2026-02-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We anticipate that we will continue to make significant expenditures for research and development and sustaining activities to maintain and improve our competitive position.",
