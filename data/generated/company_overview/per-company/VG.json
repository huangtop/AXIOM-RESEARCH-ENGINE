        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We employ a portfolio contracting approach designed to sell sufficient term liquefaction capacity to support financing while optimizing revenue and cash flow.",
        "start_character": 7511,
        "end_character": 7669
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002007855-26-000013",
