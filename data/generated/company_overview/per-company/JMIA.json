    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As part of our full-service fulfillment and express delivery infrastructure, we also control the collection and processing of returned merchandise for our sellers.",
        "start_character": 54510,
        "end_character": 54673
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Based on certain performance indicators, such as tenure, seller score, revenue and key performance indicators at product level (visibility, add to cart rate, number of items sold), we rank our sellers and their products which impacts their visibility in the search algorithms.",
        "start_character": 60176,
        "end_character": 60452
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For example, we are able to inform sellers which products have the best conversion rates and at which price points, positioning them to adjust their assortment, price points and marketing campaigns to enhance their performance.",
        "start_character": 20712,
        "end_character": 20939
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For instance, we invest centrally in product development and technology and are able to deploy a unified technology backbone, processes and tools across all markets.",
        "start_character": 33898,
        "end_character": 34063
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Historically, we offered logistics services to third party businesses in certain of our markets and we continue to offer this service in Ivory Coast.",
        "start_character": 56077,
        "end_character": 56226
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In 2025, we expanded our logistics offering with Jumia Delivery, a logistics-as-a-service platform that enables third-party sellers, social commerce vendors and individuals to ship parcels using our last-mile infrastructure.",
        "start_character": 29399,
        "end_character": 29623
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In 2025, we expanded this offering with Jumia Delivery, a logistics-as-a-service platform that enables third-party sellers, social commerce vendors and individuals to ship parcels through our last-mile infrastructure.",
        "start_character": 56227,
        "end_character": 56444
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In a number of jurisdictions, we offer certain payment and financial services to our customers and sellers as a payment service provider (“PSP”).",
        "start_character": 84717,
        "end_character": 84862
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to dedicated Key Account Managers for nominated strategic partners, we have enhanced our support to sellers, by offering an omnichannel support system, offering claim forms and real-time messaging channels to reach out to our dedicated support service teams.",
        "start_character": 66763,
        "end_character": 67033
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we take full advantage of the multi-channel aspects of the African market, having for example adopted a “mobile-first” approach in our product development while exploring highly-localized offline marketing channels, which allows us to expand the audience for our goods and services, increase engagement and conversion and reduce our customer acquisition costs.",
        "start_character": 5967,
        "end_character": 6340
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In connection with our marketplace offering, we also engage in corporate sales, where we sell physical goods to local and regional retailers, distributors and other corporate buyers.",
        "start_character": 6836,
        "end_character": 7018
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001756708-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001756708-26-000015-93c19057e24e6ab4",
        "accession_number": "0001756708-26-000015",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In our technology operations, we rely on a hybrid infrastructure, based on the cloud computing platform provided by third parties, and a private hosting provider for part of our back-office systems for which services we pay licensing fees.",
        "start_character": 70161,
        "end_character": 70400
      }
    ]
  },
