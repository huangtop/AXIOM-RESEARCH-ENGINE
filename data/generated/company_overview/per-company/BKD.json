        "end_character": 13744
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001332349-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001332349-26-000032-9ada1d99c21045ef",
        "accession_number": "0001332349-26-000032",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that our multiple service offerings create marketing synergies and cross-selling opportunities.",
        "start_character": 31189,
        "end_character": 31295
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001332349-26-000032",
        "provenance_id": "provenance:SEC-FILING-0001332349-26-000032-9ada1d99c21045ef",
        "accession_number": "0001332349-26-000032",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe that we provide highly valuable services to seniors, and we continually strive to expand the number of seniors we serve through targeted efforts to increase our occupancy levels while remaining focused on charging an appropriate rate for the services we provide.",
