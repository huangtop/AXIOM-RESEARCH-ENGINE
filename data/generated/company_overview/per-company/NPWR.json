    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In order to allocate capital and resources to this new business opportunity, in the fourth quarter of 2025 we halted SN1 development and testing activities at the La Porte Demonstration Facility.",
        "start_character": 5576,
        "end_character": 5771
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In response to unprecedented demand growth for low-cost, firm power generation solutions with viable pathways to decarbonize, we have broadened the scope of our business to include the development of clean gas power generation using natural gas turbines paired with PCC.",
        "start_character": 3014,
        "end_character": 3284
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are developing a modular, standardized clean gas power plant product incorporating Entropy’s PCC technology (the “Clean Gas Product”).",
        "start_character": 4649,
        "end_character": 4786
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We expect our Clean Gas Product and, if commercialized, the Oxy-Combustion Cycle, to be designed to meet or exceed applicable CO2 capture thresholds and minimum capture rates for electric generating units.",
        "start_character": 14174,
        "end_character": 14379
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We intend to leverage Entropy’s PCC technology and our own project development capabilities to develop and deliver the Clean Gas Product.",
        "start_character": 11711,
        "end_character": 11848
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "While we have halted near-term SN1 development and demonstration activities to allocate capital to the Clean Gas Product, we believe the Oxy-Combustion Cycle remains a valuable asset.",
        "start_character": 12704,
        "end_character": 12887
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "•Clean—We are designing our Clean Gas Product to significantly reduce CO2 emissions from natural gas power generation through the integration of PCC and permanent sequestration.",
        "start_character": 8337,
        "end_character": 8514
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, given the market’s rapid shift in demand for new reliable power generation solutions that can be deployed as soon as possible, irrespective of their environmental impact, we determined it would be challenging for us to develop and commercialize the Oxy-Combustion Cycle on a timely basis to meet this demand and that other prospective solutions that mitigate emissions from gas generation could be deployed sooner and at lower cost than our initial plants.",
        "start_character": 2252,
        "end_character": 2722
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2023, we began the front-end engineering and design (“FEED”) process for our first utility-scale power plant utilizing the Oxy-Combustion Cycle (“SN1”) with the intention of locating SN1 in the Permian Basin of West Texas (“Project Permian”).",
        "start_character": 1134,
        "end_character": 1379
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In March 2025, we suspended further long-lead equipment releases, but value engineering and certain development work continued into the third quarter of 2025.",
        "start_character": 1693,
        "end_character": 1851
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, we are required to obtain permits under the federal Clean Water Act for water discharges, such as storm water runoff associated with construction activities, and to follow a variety of best management practices to ensure that water quality is protected and effects are minimized.",
        "start_character": 39938,
        "end_character": 40230
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001845437-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001845437-26-000009-930d8918eac7e0ad",
        "accession_number": "0001845437-26-000009",
        "filing_date": "2026-03-09",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "To construct and operate our projects, we are required to obtain from federal, state, and local governmental authorities a range of environmental permits and other approvals, including those described below.",
        "start_character": 39049,
        "end_character": 39256
      }
    ]
  },
