        "accession_number": "0001628280-26-011655",
        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "The healthcare services for which we are responsible under such arrangements generally include all healthcare costs which CMS considers as Part A and B costs, including hospitalization and facility costs, primary and specialty care provider costs, and ancillary services costs.",
        "start_character": 14954,
        "end_character": 15231
      },
      {
