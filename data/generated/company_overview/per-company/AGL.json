        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Some states in which we operate require licensing or registration for operations related to, among others, utilization review on behalf of payors, including reviewing medical necessity and appropriateness of healthcare services, or processing claims in connection with insurance or managed care products.",
        "start_character": 79415,
        "end_character": 79719
      },
      {
