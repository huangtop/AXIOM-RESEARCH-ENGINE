        "filing_date": "2025-09-15",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In connection with the above-noted closure of the Yves Veggie Cuisine® business, we expect to close the associated manufacturing facility in Vancouver, British Columbia.",
        "start_character": 17692,
        "end_character": 17861
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-25-203534",
