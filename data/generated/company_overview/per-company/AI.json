    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As such, in addition to the C3 Platform, we offered market-specific versions of all our applications including AI Predictive Maintenance, AI Inventory Optimization, and AI Energy Management for the utility, oil and gas, defense, and financial services industries.",
        "start_character": 71695,
        "end_character": 71958
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "At that time, the common expression for these types of applications was “IoT,” and we appropriately rebranded the company as C3 IoT to communicate to the market that we were again expanding our market offerings from primarily one vertical market (energy) to a broadening range of markets.",
        "start_character": 71286,
        "end_character": 71574
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Early on, we focused on the oil and gas, federal, aerospace and defense, energy and utilities, manufacturing, and financial services sectors, as those industries were early adopters in Enterprise AI.",
        "start_character": 32978,
        "end_character": 33177
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In January of 2009, we founded C3, Inc with the purpose of developing and marketing a software platform and family of software products that would enable companies to exploit the power of elastic cloud computing, big data, IoT, and predictive analytics.",
        "start_character": 65739,
        "end_character": 65992
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In instances where a large or continuing professional services presence may be desired or necessary, we generally rely upon our partner ecosystem to provide those services.",
        "start_character": 36752,
        "end_character": 36924
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide software licenses that do not require maintenance and support services, for which revenue is recognized when the control of the software is transferred to the customer.",
        "start_character": 34773,
        "end_character": 34957
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We began when the market was nascent, and as the market has developed and expanded, we have expanded our branding and our market offerings to meet market expectations.",
        "start_character": 73958,
        "end_character": 74125
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe C3 Generative AI is unique in the market, offering:",
        "start_character": 19259,
        "end_character": 19321
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer a premium stand-ready service through our COE.",
        "start_character": 34280,
        "end_character": 34335
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We were increasingly approached by manufacturing companies, financial services companies, oil and gas companies, and the U.S.",
        "start_character": 70925,
        "end_character": 71050
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "While these products are useful, we believe that none offers the scope of utility necessary and sufficient to rapidly design, develop and deploy Enterprise AI applications, nor the model-driven agentic foundation required to orchestrate and operate autonomous AI agents at enterprise scale.",
        "start_character": 52270,
        "end_character": 52560
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001577526-26-000078",
        "provenance_id": "provenance:SEC-FILING-0001577526-26-000078-8c738c7c7f24f10b",
        "accession_number": "0001577526-26-000078",
        "filing_date": "2026-06-24",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Customers are increasingly adopting the C3 Agentic AI Platform and its agentic capabilities to build and operate autonomous AI agents across their operations, and we are working through a substantial pipeline of related opportunities.",
        "start_character": 64956,
        "end_character": 65190
      }
