    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By providing services to mobile app developers, we gain access to and aggregate massive amounts of anonymous device-level mobile behavioral data that we use to develop our industry-specific solutions.",
        "start_character": 25516,
        "end_character": 25716
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Currently, we offer a basic package of push notification services free of charge, and we charge subscription fees, primarily on a monthly basis, for our VIP premium package.",
        "start_character": 18790,
        "end_character": 18963
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Currently, we offer a private cloud-based service option to our JPush, JSMS, JVerification and JUMS customers.",
        "start_character": 23234,
        "end_character": 23344
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Moreover, we also provide app developers using our services with an interactive web-based service dashboard, allowing them to utilize and monitor our services through simple controls on an ongoing basis.",
        "start_character": 12018,
        "end_character": 12221
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our business model is built upon our massive and quality data foundation, which we have established by leveraging the comprehensive suite of developer services we provide to mobile app developers in China.",
        "start_character": 10095,
        "end_character": 10300
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Over time, we have been able to shorten our product development cycle as we increase the size of our data pool and the depth of our data and accumulated more market intelligence and experiences through a trial-and-error process.",
        "start_character": 34747,
        "end_character": 34975
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Similar to JPush, we currently offer a basic package of instant messaging services free of charge, and we charge subscription fees, primarily on a monthly basis, for our VIP premium package.",
        "start_character": 20880,
        "end_character": 21070
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Since our inception through December 31, 2025, we have accumulated data from over 83.8 billion installations of our software development kits, or SDKs, as part of our developer services.",
        "start_character": 7644,
        "end_character": 7830
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Starting from 2020, we further breakdown the Developer Service revenue into Subscription Service and Value-Added Service.",
        "start_character": 11211,
        "end_character": 11332
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also collaborate with third-party data service providers to supplement our dataset and maintain a strict vetting process before engaging third-party data service providers to ensure the integrity and quality of our data.",
        "start_character": 26183,
        "end_character": 26406
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also directly compete with market intelligence service providers with respect to our market intelligence solutions and financial risk management service providers with respect to our financial risk management solutions.",
        "start_character": 53102,
        "end_character": 53324
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035657",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035657-c5d99ceccb577539",
        "accession_number": "0001104659-26-035657",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also have another team of product developers who identify the potential market demand and lead the development of new SAAS Businesses and enhancement of existing solutions.",
        "start_character": 43876,
        "end_character": 44051
      }
    ]
  },
