        "accession_number": "0001104659-26-037874",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Most new products that we introduce must compete with other products already on the market or products that are later developed by competitors.",
        "start_character": 42099,
        "end_character": 42242
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-037874",
