        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We operate in two segments: investment portfolio and Constructive.",
        "start_character": 8338,
        "end_character": 8404
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001273685-26-000029",
