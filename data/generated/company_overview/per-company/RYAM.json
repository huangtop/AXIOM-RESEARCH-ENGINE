        "accession_number": "0001597672-26-000010",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Customer relationships are typically long-term and are based on an understanding of the customer’s production processes and on our technical expertise, which we utilize to help solve our customers’ production challenges and support new product development.",
        "start_character": 7577,
        "end_character": 7833
      },
      {
