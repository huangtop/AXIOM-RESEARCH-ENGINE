        "accession_number": "0001597672-26-000010",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Specifically, we determined, in light of these new developments and capabilities, that the performance and outlook of the High Purity Cellulose business will be better managed as three separate businesses: Cellulose Specialties, Cellulose Commodities and a new Biomaterials business.",
        "start_character": 3051,
        "end_character": 3334
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001597672-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001597672-26-000010-a183c927946059ac",
