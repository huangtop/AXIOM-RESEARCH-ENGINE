        "end_character": 32342
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001597672-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001597672-26-000010-a183c927946059ac",
        "accession_number": "0001597672-26-000010",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to monitor and implement opportunities to improve the sustainability profile of our manufacturing processes and product offerings.",
