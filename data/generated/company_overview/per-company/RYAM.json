        "end_character": 24514
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001597672-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001597672-26-000010-a183c927946059ac",
        "accession_number": "0001597672-26-000010",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We manufacture cellulose specialties products tailored to our customers’ precise and demanding chemical and physical specifications, achieving industry-leading purity and product functionality.",
        "start_character": 4304,
        "end_character": 4497
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001597672-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001597672-26-000010-a183c927946059ac",
        "accession_number": "0001597672-26-000010",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "With four facilities and five manufacturing lines capable of producing cellulose specialties, we are the only cellulose specialties producer in the world with the flexibility to use both hardwood and softwood fibers, kraft and sulfite cooking processes and various proprietary chemical treatments to provide customized product functionality.",
        "start_character": 8180,
        "end_character": 8521
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001597672-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001597672-26-000010-a183c927946059ac",
        "accession_number": "0001597672-26-000010",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "With the enhanced freezer application, we provide packaging manufacturers with a solution that safeguards product integrity while delivering on sustainability and operational efficiency.",
        "start_character": 18434,
        "end_character": 18620
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001597672-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001597672-26-000010-a183c927946059ac",
        "accession_number": "0001597672-26-000010",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, we possess significant technical expertise and knowledge of wood fiber properties and their modification under a sequence of chemical processes, which we have accumulated and developed over nearly 100 years of practical application to satisfy various customer needs.",
        "start_character": 8522,
        "end_character": 8802
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001597672-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001597672-26-000010-a183c927946059ac",
        "accession_number": "0001597672-26-000010",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In November 2017, we acquired Tembec Inc., a manufacturer of cellulose specialties, lumber, paperboard, newsprint and high-yield pulp.",
        "start_character": 789,
        "end_character": 923
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001597672-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001597672-26-000010-a183c927946059ac",
