    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By employing advanced machine learning models informed by empirical degrader assay datasets that we have amassed, which include a compendium of in vitro and in vivo pharmacokinetic and pharmacodynamic readouts from tens of thousands of targeted protein degrader compounds, we have the ability to reduce the number of design-make-test cycles in our optimization campaigns, eliminate optimization bottlenecks, and shorten the overall project timelines required to achieve desired TPD target product profiles.",
        "start_character": 17920,
        "end_character": 18426
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In addition to our clinical stage drug candidates, we are advancing multiple preclinical-stage programs within our protein degradation portfolio, both on our own and with partners, by developing new targeted protein degraders and degrader antibody conjugates for several therapeutic indications that currently lack treatment options or where current therapies are ineffective.",
        "start_character": 7576,
        "end_character": 7952
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to regulations in the United States, we will be subject to a variety of foreign regulations governing clinical trials and commercial sales and distribution of our drug candidates to the extent we choose to sell any products outside of the United States.",
        "start_character": 164386,
        "end_character": 164651
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our commercial opportunities could be reduced or eliminated if our competitors develop and commercialize products that are safer, more effective, have fewer or less severe side effects, are more convenient or are less expensive than any products that we may develop.",
        "start_character": 88865,
        "end_character": 89131
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "These reductions may also impact the ability of relevant agencies to timely review and approve research and development, manufacturing, and marketing activities which may delay our ability to develop, market and sell any products we may develop.",
        "start_character": 188114,
        "end_character": 188359
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also are eligible to receive mid-single digit to low tens percentage tiered royalties on annual net sales from any commercial products directed to the optioned collaboration targets, subject to certain reductions and excluding sales in the United States of any products for which we exercise our option to co-develop and co-promote, for which the parties share profits and losses evenly.",
        "start_character": 71918,
        "end_character": 72308
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are also eligible to receive mid-single digit to low teen percentage tiered royalties on annual net sales of any commercial products that may result from the collaboration, subject to certain reductions and excluding sales in the United States of any products for which we exercise our option to co-develop and co-promote, for which the parties share profits and losses evenly.",
        "start_character": 78905,
        "end_character": 79285
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We do not own or operate, and currently have no plans to establish, any facilities for product manufacturing, packaging, storage and distribution, or testing.",
        "start_character": 82454,
        "end_character": 82612
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have engaged third-party manufacturers to supply the drug substances for bexobrutideg, zelebrudomide, and NX-1607 and to develop and manufacture finished drug products for use in our clinical trials.",
        "start_character": 82955,
        "end_character": 83157
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We rely on and expect to continue to rely on contract manufacturing organizations (CMOs) for both drug substance and finished drug product.",
        "start_character": 82613,
        "end_character": 82752
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We retain the option to co-develop and co-promote, under a profit share structure, up to two drug candidates in the United States, provided that we may only exercise such option once per licensed product and Gilead retains the right to veto our option selection for any one drug candidate of its choice.",
        "start_character": 69286,
        "end_character": 69589
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001549595-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001549595-26-000016-bd5057125ca575fe",
        "accession_number": "0001549595-26-000016",
        "filing_date": "2026-01-28",
        "offering_role": "product",
        "confidence": 0.92,
