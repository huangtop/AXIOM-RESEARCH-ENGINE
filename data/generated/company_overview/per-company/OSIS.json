    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "After the expiration of our standard product warranty periods, we are often engaged by customers, either directly or through our network of authorized service providers, to provide maintenance services for our security and inspection products.",
        "start_character": 32202,
        "end_character": 32445
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As of June 30, 2025, we employed 7,337 people, of whom 4,505 were employed in manufacturing, 617 were employed in engineering or research and development, 676 were employed in administration, 364 were employed in sales and marketing and 1,175 were employed in service capacities.",
        "start_character": 74404,
        "end_character": 74683
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Finally, we also intend to continue to develop new security and inspection products and technologies, including software, and to enhance our current product and service offerings through internal research and development and selective acquisitions.",
        "start_character": 13529,
        "end_character": 13777
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Further, we provide turnkey screening services to certain customers for which we may recognize revenue over multi-year periods.",
        "start_character": 70972,
        "end_character": 71099
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to close collaboration with our customers in the design and development of our current products, we maintain an active program for the development and introduction of new products, enhancements and improvements to our existing products, including the implementation of new applications of our technology.",
        "start_character": 34943,
        "end_character": 35259
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to manufacturing standard and OEM products, we also specialize in designing and manufacturing customized, value-added subsystems for use in a wide range of products and equipment.",
        "start_character": 21951,
        "end_character": 22142
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition to product design, we provide civil works and system integration services to install and integrate our products with other systems, networks and facilities at the customer site.",
        "start_character": 33368,
        "end_character": 33557
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we provide a variety of service and support options for our healthcare customers, including hospital on-site repair and maintenance service and telephone support, parts exchange programs for customers with the internal expertise to perform a portion of their own service needs and a depot repair center at our division headquarters.",
        "start_character": 32446,
        "end_character": 32791
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In our experience, the OEM customers to whom we provide such services often prefer to engage companies that offer both local and lower-cost offshore facilities.",
        "start_character": 69758,
        "end_character": 69918
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In the markets where we operate, providing optoelectronic devices and electronics manufacturing services, our customers evaluate us and our competitors based on several key factors.",
        "start_character": 68902,
        "end_character": 69083
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The silicon-based optoelectronic devices we manufacture are critical components in most of our products and subsystems.",
        "start_character": 38729,
        "end_character": 38848
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001410578-25-001887",
        "provenance_id": "provenance:SEC-FILING-0001410578-25-001887-4b4b9260854e5309",
        "accession_number": "0001410578-25-001887",
        "filing_date": "2025-08-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also believe that we offer significant added value to our customers by providing a full range of vertically-integrated services, including component design and customization, subsystem concept design and application engineering, product development and prototyping, efficient preproduction and short run manufacturing and competitive mass production capabilities.",
        "start_character": 10802,
        "end_character": 11168
      }
    ]
  },
