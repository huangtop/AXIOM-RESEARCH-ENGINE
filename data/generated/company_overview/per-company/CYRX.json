        "accession_number": "0001104659-26-024180",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "During the second quarter of fiscal year 2025, we completed the divestiture of our specialty courier CRYOPDP business to designated affiliates of DHL Supply Chain International Holding B.V.",
        "start_character": 3035,
        "end_character": 3224
      },
      {
