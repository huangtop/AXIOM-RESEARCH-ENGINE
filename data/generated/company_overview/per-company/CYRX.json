        "end_character": 31129
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-024180",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-024180-4e20ca6e924aa72e",
        "accession_number": "0001104659-26-024180",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a leading global manufacturer of cryogenic systems for the storage and transportation of biological materials, through MVE Biological Solutions (“MVE”) and its portfolio of cryogenic freezer and dewar systems.",
        "start_character": 16281,
        "end_character": 16497
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-024180",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-024180-4e20ca6e924aa72e",
        "accession_number": "0001104659-26-024180",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We endeavor to keep our supply structure up to date and agile as it provides us the opportunity to rapidly scale to support our client’s commercialization, systems, products, and solutions requirements;",
        "start_character": 32338,
        "end_character": 32540
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-024180",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-024180-4e20ca6e924aa72e",
        "accession_number": "0001104659-26-024180",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We intend to file trademark and patent applications covering any newly developed products, methods and technologies.",
