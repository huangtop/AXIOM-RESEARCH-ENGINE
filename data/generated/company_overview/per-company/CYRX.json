        "provenance_id": "provenance:SEC-FILING-0001104659-26-024180-4e20ca6e924aa72e",
        "accession_number": "0001104659-26-024180",
        "filing_date": "2026-03-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "On this foundation, we provide the following core solutions in the Life Sciences Services segment:",
