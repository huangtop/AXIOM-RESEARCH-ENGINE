        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For example, we intend to engage AI solution providers for intelligent vehicles, to develop customized logistics software tailored to our specific needs.",
        "start_character": 26192,
