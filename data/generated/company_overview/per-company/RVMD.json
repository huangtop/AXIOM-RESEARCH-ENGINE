        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to regulations in the United States, we could become subject to a variety of foreign regulations regarding development, approval, commercial sales and distribution of our products if we seek to market our product candidates in other jurisdictions.",
        "start_character": 70096,
        "end_character": 70355
