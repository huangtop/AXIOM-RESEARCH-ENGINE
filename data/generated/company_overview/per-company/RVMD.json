        "provenance_id": "provenance:SEC-FILING-0001193125-26-071563-24c754c1fa7f300e",
        "accession_number": "0001193125-26-071563",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We seek patent protection for product candidates, development programs and related alternatives by filing and prosecuting patent applications in the United States and other countries, as appropriate.",
