        "accession_number": "0001193125-26-071563",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Many of the companies against which we may compete have significantly greater financial resources and expertise in research and development, manufacturing, preclinical testing, conducting clinical trials, obtaining regulatory approvals and marketing approved products than we do.",
        "start_character": 32697,
        "end_character": 32976
      },
      {
