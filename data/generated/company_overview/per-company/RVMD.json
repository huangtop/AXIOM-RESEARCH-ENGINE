        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We intend to retain significant development and commercialization rights to our product candidates and, if marketing approval is obtained, to commercialize our product candidates on our own in the U.S.",
        "start_character": 24754,
        "end_character": 24955
      },
      {
