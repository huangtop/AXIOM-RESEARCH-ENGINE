        "accession_number": "0001193125-26-071563",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are developing a portfolio of compounds that we believe were the first RAS(ON) Inhibitors to use this mechanism of action.",
