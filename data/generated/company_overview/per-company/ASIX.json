        "accession_number": "0001673985-26-000008",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have developed and are executing against a disciplined framework for capital deployment that balances long-term investment to improve the through-cycle profitability of the business with return of cash to shareholders.",
        "start_character": 17562,
        "end_character": 17783
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001673985-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001673985-26-000008-97be5a2b45890f5a",
        "accession_number": "0001673985-26-000008",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We internally polymerize caprolactam into Aegis® Nylon 6 Resin, and we also market and sell the caprolactam that is not consumed internally to customers who use it to manufacture polymer resins to produce fibers, compounds and other nylon products.",
        "start_character": 1984,
        "end_character": 2232
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001673985-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001673985-26-000008-97be5a2b45890f5a",
        "accession_number": "0001673985-26-000008",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We manufacture this product in a ratio of approximately four pounds of ammonium sulfate to one pound of caprolactam.",
