        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For Plant Nutrients, like Nylon, we compete with caprolactam/ammonium sulfate co-product manufacturers and direct ammonium sulfate producers such as Pasadena Commodities International and Nutrien Ltd.",
        "start_character": 29330,
        "end_character": 29530
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001673985-26-000008",
