        "accession_number": "0001673985-26-000008",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also produce and sell AMS, cyclohexanone, oximes and cyclohexanol to customers for use in end-products such as resins, inks, paints, coatings and electronic components.",
        "start_character": 32736,
        "end_character": 32907
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001673985-26-000008",
