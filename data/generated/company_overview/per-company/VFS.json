    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As part of our continued efforts to strengthen our global supply chain, we have also evaluated the feasibility of CKD or SKD plants in select markets where local tax incentives may be available, an in-depth auto-industry supply chain local market and strategies to lower logistical costs to provide more competitive offerings to our customers.",
        "start_character": 83399,
        "end_character": 83742
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "At VinFast, our motto is “boundless together.” It is representative of the adventurous and inspired feeling we want our drivers to experience every time they take the wheel, a precept of our approach to manufacturing, an affirmation of our limitless desire to reach new heights with the products we create, our effort to build a sustainable future and our enthusiastic re-shaping of the electric vehicle driver experience.",
        "start_character": 12542,
        "end_character": 12964
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For example, in 2025, we launched VF Connect in Vietnam, a suite of subscription packages featuring proprietary remote‑control functions and smart features developed internally by VinFast and across the broader Vingroup ecosystem, and we plan to expand these offerings to additional markets over time.",
        "start_character": 58498,
        "end_character": 58799
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our in-house development of new products is based on research on the demands of our drivers, and we are built to be nimble in responding to market opportunities.",
        "start_character": 53602,
        "end_character": 53763
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Over time, we expanded our portfolio to include advanced lithium iron phosphate (“LFP”) chemistry, offering a more cost-effective and competitive solution for electric mobility.",
        "start_character": 103279,
        "end_character": 103456
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Through this ecosystem, we provide end-to-end electric mobility solutions spanning charging infrastructure, ride-hailing and mobility services, as well as secondary sales and rentals of used EVs.",
        "start_character": 24908,
        "end_character": 25103
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We aim to do this through four key initiatives: our cloud-based companion app, unique warranty offer, VinFast Service program and VinFast Power Solutions.",
        "start_character": 28574,
        "end_character": 28728
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We aim to provide a full-service ownership experience based on four key pillars:",
        "start_character": 109790,
        "end_character": 109870
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also have partners in each of our active markets to provide roadside assistance services, which includes towing, to our customers in case of incidents.",
        "start_character": 111708,
        "end_character": 111862
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe our customers will also benefit from the technical capacities of our directly operated centers and authorized service network.",
        "start_character": 111570,
        "end_character": 111707
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We collaborate with third‑party technology and engineering partners through a portfolio of service, development, technology transfer and license agreements entered into in the ordinary course of our product development activities.",
        "start_character": 135701,
        "end_character": 135931
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-052266",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-052266-0ee75082c08eed0f",
        "accession_number": "0001104659-26-052266",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We established a network of VinFast self-operated sales and service locations under three different formats (1S, 2S and 3S), with each format tailored to create a specified customer experience with smaller showroom formats intended for customer education in areas with high foot traffic, while larger showrooms offer opportunities to test drive our vehicles.",
        "start_character": 43252,
        "end_character": 43610
      }
