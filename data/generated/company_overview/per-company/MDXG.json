        "provenance_id": "provenance:SEC-FILING-0001376339-26-000011-d64b8f58c919bbe2",
        "accession_number": "0001376339-26-000011",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also sell our products through distributors.",
