        "end_character": 22352
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047323",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047323-c79853b1789c17eb",
        "accession_number": "0001104659-26-047323",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also work closely with other ecosystem partners in developing our L4 autonomous technologies, products and services.",
        "start_character": 27368,
        "end_character": 27487
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047323",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047323-c79853b1789c17eb",
        "accession_number": "0001104659-26-047323",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We collect development fees in respect of the services we deliver as well as milestone-based royalties settled based on sales volume under this partnership.",
        "start_character": 25369,
        "end_character": 25525
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047323",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047323-c79853b1789c17eb",
