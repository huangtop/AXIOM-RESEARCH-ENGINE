        "accession_number": "0001104659-26-047323",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we also provide ADAS and research and development services to Bosch and autonomous driving research and development services to Nissan.",
        "start_character": 27219,
        "end_character": 27367
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047323",
