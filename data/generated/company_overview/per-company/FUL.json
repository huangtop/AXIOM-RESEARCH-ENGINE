    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As of the beginning of fiscal 2025, we reorganized our operating segments by selling our North America Flooring business, previously part of the Construction Adhesives operating segment, and combining our Insulating Glass, Woodworking and Composite businesses, previously part of the Engineering Adhesives operating segment, with Construction Adhesives Roofing and Building Envelope and Infrastructure businesses to form the Building Adhesive Solutions operating segment.",
        "start_character": 2108,
        "end_character": 2579
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "However, we operate and sell our products in countries that are rated as high-risk for corruption, creating the risk of unauthorized conduct by our employees, customs brokers, distributors or other third party intermediaries that could be in violation of the FCPA or similar local regulations.",
        "start_character": 18335,
        "end_character": 18628
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Much of the technology we use in our products and manufacturing processes is available in the public domain.",
        "start_character": 12810,
        "end_character": 12918
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also develop new applications for existing products and technologies, and improve manufacturing processes to enhance productivity and product quality.",
        "start_character": 14772,
        "end_character": 14925
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a leading worldwide formulator, manufacturer and marketer of adhesives, sealants and other specialty chemical products.",
        "start_character": 508,
        "end_character": 634
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to monitor our markets to ensure we are developing the adhesives and sealants to support our customers’ responses to changing consumer demand, new product designs and upcoming regulatory and sustainability efforts.",
        "start_character": 15340,
        "end_character": 15566
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have built and launched two advanced leadership academies focused on business leadership and manufacturing leadership to ensure people in these roles have the right skills to be effective.",
        "start_character": 11071,
        "end_character": 11262
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As of November 29, 2025, we had sales offices and manufacturing plants in 24 countries outside the United States and satellite sales offices in another 9 countries.",
        "start_character": 3583,
        "end_character": 3747
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Finally, we continue to take great pride in our focus on giving back to the communities in which we operate through the giving efforts of the H.B.",
        "start_character": 9344,
        "end_character": 9490
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Through designing and developing new polymers and new formulations, we expect to continue to grow in our current markets.",
        "start_character": 14650,
        "end_character": 14771
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also provide our customers with technical support and unique solutions designed to address their specific needs.",
        "start_character": 1833,
        "end_character": 1948
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-001767",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-001767-4fac054574a32f76",
        "accession_number": "0001437749-26-001767",
        "filing_date": "2026-01-22",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We continue to monitor the development and implementation of such legislation and regulations.",
        "start_character": 17454,
        "end_character": 17548
      }
