        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition to the data protection laws in the United States, the EEA, the UK and various other jurisdictions in which we operate, we are also subject to the PRC’s data protection laws.",
        "start_character": 93769,
        "end_character": 93954
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001988894-26-000004",
        "provenance_id": "provenance:SEC-FILING-0001988894-26-000004-b27b2373668ae7d5",
