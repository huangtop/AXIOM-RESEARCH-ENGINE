        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our segments comprise our “brand clusters,” which reflect both how our consumers engage with our products and how we manage our business.",
        "start_character": 4164,
        "end_character": 4301
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001988894-26-000004",
