        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also deliver robust card program management, allowing our customers to embed Marqeta in their offering without having to build certain complex elements or customer support services.",
        "start_character": 1103,
        "end_character": 1287
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001522540-26-000017",
