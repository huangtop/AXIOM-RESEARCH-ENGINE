        "end_character": 32459
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001840776-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001840776-26-000013-2ebeadb76eae9143",
        "accession_number": "0001840776-26-000013",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we now operate our business and report our financial performance using two segments: Insurance and Marketplace.",
        "start_character": 1290,
        "end_character": 1414
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001840776-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001840776-26-000013-2ebeadb76eae9143",
        "accession_number": "0001840776-26-000013",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our business model is attractive to our partners because we offer a full-service solution for their customers and their special cars.",
        "start_character": 11672,
        "end_character": 11805
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001840776-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001840776-26-000013-2ebeadb76eae9143",
        "accession_number": "0001840776-26-000013",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our marketplace offerings include live auctions and an online sale platform, as well as brokered private sales, where we facilitate transactions on behalf of sellers and buyers.",
        "start_character": 24466,
        "end_character": 24643
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001840776-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001840776-26-000013-2ebeadb76eae9143",
        "accession_number": "0001840776-26-000013",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Furthermore, we focus on developing capabilities that serve the interests of the automotive enthusiast market.",
        "start_character": 11174,
        "end_character": 11284
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001840776-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001840776-26-000013-2ebeadb76eae9143",
        "accession_number": "0001840776-26-000013",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, we are paid a commission for underwriting, binding coverage, and issuing State Farm Classic+ policies and can offer HDC memberships to State Farm Classic+ customers, providing us an additional revenue opportunity.",
        "start_character": 23083,
        "end_character": 23309
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001840776-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001840776-26-000013-2ebeadb76eae9143",
        "accession_number": "0001840776-26-000013",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also operate a trusted marketplace where collectors and enthusiasts can buy and sell a wide range of vehicles, from entry level enthusiast vehicles to high value collector cars.",
