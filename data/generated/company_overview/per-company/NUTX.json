        "filing_date": "2026-03-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide a full spectrum of healthcare services, including emergency room care, inpatient care, and behavioral health, and offer a complementary suite of ancillary services, including onsite imaging (CT scan, X-ray, MRI, ultrasound, etc.), certified and accredited laboratories, and onsite inpatient pharmacies.",
        "start_character": 1401,
        "end_character": 1714
