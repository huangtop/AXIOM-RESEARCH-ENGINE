        "provenance_id": "provenance:SEC-FILING-0001628280-26-015168-98634acc9f85747b",
        "accession_number": "0001628280-26-015168",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
