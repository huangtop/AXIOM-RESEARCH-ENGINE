        "filing_date": "2026-03-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Comprehensive statutes and regulations govern the manner in which we provide and bill for services and collect reimbursement from governmental programs and private payors, our contractual relationships with our providers, vendors and clients, our marketing activities and other aspects of our operations.",
        "start_character": 21288,
        "end_character": 21592
