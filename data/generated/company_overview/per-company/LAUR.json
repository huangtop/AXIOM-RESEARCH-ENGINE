        "end_character": 116
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009479",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009479-59ca2056d1e5afc6",
        "accession_number": "0001628280-26-009479",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We will continue to develop new programs and course offerings to address the changing needs in the markets.",
