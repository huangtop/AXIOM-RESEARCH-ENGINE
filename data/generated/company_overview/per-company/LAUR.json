        "end_character": 16650
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009479",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009479-59ca2056d1e5afc6",
        "accession_number": "0001628280-26-009479",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Currently, we operate within this range with adaptability and flexibility.",
        "start_character": 18994,
        "end_character": 19068
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009479",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009479-59ca2056d1e5afc6",
        "accession_number": "0001628280-26-009479",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Our scale within the countries in which we operate facilitates distinct advantages for our students and allows us to leverage our operating model across multiple brands in Mexico and Peru.",
        "start_character": 9397,
        "end_character": 9585
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009479",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009479-59ca2056d1e5afc6",
        "accession_number": "0001628280-26-009479",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "There are a number of private and public institutions in both of the countries in which we operate, and it is difficult to predict how the markets will evolve and how many competitors there will be in the future.",
        "start_character": 22828,
        "end_character": 23040
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009479",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009479-59ca2056d1e5afc6",
        "accession_number": "0001628280-26-009479",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "These investments have been instrumental in establishing a deep level of expertise in online education, facilitating the design and delivery of high quality, effective and differentiated online courses in the markets in which we operate.",
        "start_character": 11210,
        "end_character": 11447
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009479",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009479-59ca2056d1e5afc6",
        "accession_number": "0001628280-26-009479",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Throughout Mexico and Peru we operate 24 medical and nine dental schools.",
        "start_character": 12112,
        "end_character": 12185
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009479",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009479-59ca2056d1e5afc6",
        "accession_number": "0001628280-26-009479",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe our future success depends on our ability to attract, develop, and retain skilled employees in a highly competitive talent market.",
        "start_character": 24181,
        "end_character": 24322
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009479",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009479-59ca2056d1e5afc6",
        "accession_number": "0001628280-26-009479",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that increasing student demand, new instruction methodologies designed for the online medium, and growing employer and regulatory acceptance of degrees obtained through online and hybrid modalities will continue to drive online learning in Mexico and Peru.",
        "start_character": 8689,
        "end_character": 8956
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009479",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009479-59ca2056d1e5afc6",
        "accession_number": "0001628280-26-009479",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We currently own, or have filed applications for, trademark registrations for the word “Laureate,” for “Laureate International Universities” and for the Laureate leaf logo in the trademark offices of all jurisdictions in which we operate institutions of higher learning.",
