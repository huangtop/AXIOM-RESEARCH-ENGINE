        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Because we rely on third-party distribution and sales channels to sell our products, we do not control the ultimate investment recommendations given by them to clients.",
        "start_character": 25210,
        "end_character": 25378
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000038777-25-000238",
