        "end_character": 3765
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000038777-25-000238",
        "provenance_id": "provenance:SEC-FILING-0000038777-25-000238-6cb0dfcd42c8f61c",
        "accession_number": "0000038777-25-000238",
        "filing_date": "2025-11-10",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Through our Fiduciary Trust International related subsidiaries, we provide investment management and related services to, among others, high-net-worth individuals and families, family offices, foundations and institutional clients.",
        "start_character": 17377,
        "end_character": 17608
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000038777-25-000238",
        "provenance_id": "provenance:SEC-FILING-0000038777-25-000238-6cb0dfcd42c8f61c",
        "accession_number": "0000038777-25-000238",
        "filing_date": "2025-11-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To the extent that we or any of our funds are designated as a SIFI or G-SIFI, such designations would add additional supervision, review, monitoring and/or regulation resulting in increased scrutiny and oversight that could impact our business.",
        "start_character": 38593,
        "end_character": 38837
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000038777-25-000238",
        "provenance_id": "provenance:SEC-FILING-0000038777-25-000238-6cb0dfcd42c8f61c",
        "accession_number": "0000038777-25-000238",
        "filing_date": "2025-11-10",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also may provide separately managed accounts, private funds, and trust, custody and related services, including administration, performance measurement, estate planning and tax planning.",
