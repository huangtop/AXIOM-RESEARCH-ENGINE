    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our platform is easy to use and we provide extensive guidance on our website through product documentation and numerous high-quality developer tutorials that attract users and reinforce our highly efficient self-service customer acquisition model.",
        "start_character": 6898,
        "end_character": 7145
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer a number of security features to our customers free of charge, including our Distributed Denial of Service (“DDoS”) Protection service and enhanced Role Based Access Control (“RBAC”) offering.",
        "start_character": 17956,
        "end_character": 18162
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are committed to making world-class cloud services approachable by providing attentive support to customers and supporting and investing in the broader developer community.",
        "start_character": 3631,
        "end_character": 3806
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are highly focused on gaining a better understanding of the needs and growth plans of our existing customers, increasing our feature velocity and shaping our product roadmap around the needs of DNE Customers, and leveraging our account management function to provide direct coverage of our top spending accounts.",
        "start_character": 9016,
        "end_character": 9331
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We complement our efficient self-service customer acquisition model and community building and developer outreach efforts with a sales force focused on inside sales, outbound prospecting targeting specific use cases, volume expansion of our self-service customers, expanding our revenue in specific international markets and seeking partnership opportunities to drive revenue growth.",
        "start_character": 34729,
        "end_character": 35112
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We design our products with security in mind and build security features to integrate directly with our platform, making it simple for our customers to build the additional security layers required for their use cases, rather than navigating the operational complexity of purchasing, integrating, and managing disparate security tooling into their projects.",
        "start_character": 17598,
        "end_character": 17955
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We expect to continue to grow the high-quality developer content on our websites, including through the creation of new content and product demonstrations, alongside continuous maintenance and refreshes of our legacy content, while making our education website easier to navigate by integrating Gradient® AI on our education websites so our customers can get the answers they need more seamlessly and efficiently.",
        "start_character": 33207,
        "end_character": 33620
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have developed a product roadmap designed to enhance our ability to offer secure, scalable and reliable solutions for our customers to grow their applications or businesses.",
        "start_character": 19857,
        "end_character": 20033
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We host a number of events to further build our community, including Hacktoberfest with over 56,000 developers completing over 87,000 contributions in 2025, and Deploy, a conference for DigitalOcean users, developers, and business leaders to learn from experts, connect, and be inspired to build their vision on our platform.",
        "start_character": 33621,
        "end_character": 33946
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We offer a comprehensive portfolio of IaaS, PaaS/SaaS and AI/ML products that are specifically designed to address the needs of growing technology companies.",
        "start_character": 5547,
        "end_character": 5704
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer a comprehensive set of cloud platform capabilities which span across Infrastructure-as-a-Service (“IaaS”), including Droplet virtual machines, storage and networking offerings;",
        "start_character": 1758,
        "end_character": 1943
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001582961-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001582961-26-000019-6e0642634ea4e691",
        "accession_number": "0001582961-26-000019",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer expert technical support and customer service to all customers free of charge on a 24/7 basis to help ensure our customers quickly achieve their objectives and overcome challenges.",
        "start_character": 6585,
        "end_character": 6774
      }
