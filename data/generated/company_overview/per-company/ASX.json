        "end_character": 57156
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-135585",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-135585-daf81bc38ec546bf",
        "accession_number": "0001193125-26-135585",
        "filing_date": "2026-04-01",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe, however, that we can still achieve satisfactory performance in the market given that we have been able to provide products with high quality and we are capable of designing new products by cooperating with our customers.",
