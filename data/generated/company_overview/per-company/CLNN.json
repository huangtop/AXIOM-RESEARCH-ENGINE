        "end_character": 58876
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008502",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008502-a9526c49aa8997d6",
        "accession_number": "0001437749-26-008502",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Because of exigent worldwide need, we rapidly developed CNM-ZnAg as a candidate for treatment of COVID-19 using the dietary supplement formulation of CNM-ZnAg that we produce on a limited basis to support immune health.",
