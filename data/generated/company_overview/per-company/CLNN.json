        "end_character": 139197
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008502",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008502-a9526c49aa8997d6",
        "accession_number": "0001437749-26-008502",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Because of the ease with which new single elemental and composite nanocrystals can be made of varying shapes and sizes using our proprietary techniques, we plan to continue developing a wide range of CSN therapeutics to generate a deep pipeline of drug candidates to treat a host of different diseases.",
        "start_character": 5901,
        "end_character": 6203
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008502",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008502-a9526c49aa8997d6",
