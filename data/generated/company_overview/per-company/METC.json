        "accession_number": "0001104659-26-020479",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In mid-2025, we initiated development of our rare earth element and critical mineral operations near Sheridan, Wyoming (the “Brook Mine”).",
        "start_character": 1014,
        "end_character": 1152
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-020479",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-020479-768010e1ec7522d1",
