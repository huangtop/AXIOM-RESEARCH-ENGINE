    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Across our operating segments, we offer a diverse and comprehensive array of services, including workers’ compensation, employer services and consumer health services.",
        "start_character": 1785,
        "end_character": 1952
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "And in 2024, by leveraging our clinical expertise and virtual care platform, we launched our offering of workers’ compensation behavioral health services via Concentra Telemed.",
        "start_character": 43716,
        "end_character": 43892
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As a longstanding nationwide provider of occupational health services, we believe our trusted brand and high visibility locations provide ample awareness and name recognition which serve as a solid foundation for acquiring and retaining business.",
        "start_character": 39713,
        "end_character": 39959
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As of December 31, 2025, we are the largest provider of occupational health services in the United States by number of locations, with a significant national presence.",
        "start_character": 27074,
        "end_character": 27241
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As the largest provider of occupational health services in the U.S., we believe we are well positioned to acquire businesses in areas which are adjacent and complementary to our current occupational health services offering and will be aligned with our mission and business goals.",
        "start_character": 44374,
        "end_character": 44654
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In 2024, we added an advanced primary care service offering at our onsite health clinics to further expand our service offerings.",
        "start_character": 42776,
        "end_character": 42905
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our local management teams work closely and collaboratively with our customers’ local management to discuss business needs and outcomes, and highlight new products and services to ensure we are delivering on our mutual goals.",
        "start_character": 35077,
        "end_character": 35302
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Some states in which we operate limit the practice of medicine and therapy to licensed individuals and certain of those states require that licensed individuals rendering medical services must be employed by or contracted to provide medical services through professional medical organizations and not lay corporations.",
        "start_character": 86152,
        "end_character": 86470
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The managed affiliated professional medical groups (“Managed PCs”) that we contract with to provide healthcare typically receive reimbursement for workers’ compensation services via the employer’s insurance carrier or third-party administrator, based on the fee schedule established by the state in which the injury occurred.",
        "start_character": 8547,
        "end_character": 8872
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The occupational health services provided in this operating segment include workers’ compensation and employer services, and we also provide consumer health services.",
        "start_character": 15513,
        "end_character": 15679
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also designed our service offering to facilitate employees’ access to care regardless of care setting.",
        "start_character": 31778,
        "end_character": 31883
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002014596-26-000029",
        "provenance_id": "provenance:SEC-FILING-0002014596-26-000029-460f5be93b2cfa41",
        "accession_number": "0002014596-26-000029",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are a trusted provider of occupational health services in the United States today because of our focus on the following core competencies over our more than 45-year history: lower average total claim cost, fewer days per claim, and more productive employees.",
        "start_character": 28632,
        "end_character": 28893
