        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We finance our portfolio through a diverse capital strategy which includes cash generated from operations, borrowings under our syndicated revolving line of credit, secured and unsecured debt financing, equity offerings and joint ventures.",
        "start_character": 3354,
        "end_character": 3593
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082573",
