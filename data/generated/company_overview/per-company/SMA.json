        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We operate in two reportable business segments: (i) self storage operations and (ii) our Managed Platform business.",
        "start_character": 21223,
        "end_character": 21338
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082573",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-082573-99eb0985a4bbfab2",
        "accession_number": "0001193125-26-082573",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Based on the Inside Self Storage Top-Operators List ranking for 2025, and after accounting for recent market transactions, we are the 10th largest owner and operator of self storage properties in the United States based on rentable square footage.",
        "start_character": 777,
        "end_character": 1024
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082573",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-082573-99eb0985a4bbfab2",
