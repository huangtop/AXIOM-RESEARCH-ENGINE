        "accession_number": "0001734722-26-000012",
        "filing_date": "2026-03-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We develop and maintain business and technology partnerships that help us to integrate the latest technologies into our platform and to market and deliver our platform to our customers around the world.",
        "start_character": 22847,
        "end_character": 23049
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001734722-26-000012",
