        "filing_date": "2026-03-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Competitive singular or combination products may render one or more of our product candidates obsolete or non-competitive before we can recover the expenses of developing and commercializing any of our product candidates.",
