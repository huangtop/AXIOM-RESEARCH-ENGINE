        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that our extensive expertise in the retail real estate business, access to capital markets, familiarity with real estate markets and our management experience will allow us to evaluate and execute our acquisition strategy successfully over time.",
        "start_character": 11302,
        "end_character": 11558
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012252",
