        "end_character": 9063
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-004724",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-004724-8e583365bc8c94c4",
        "accession_number": "0001437749-26-004724",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are subject to federal, state, and local laws, rules, regulations, and policies governing the use, generation, manufacture, storage, air emission, effluent discharge, handling, and disposal of certain hazardous and potentially hazardous substances used in connection with our operations.",
        "start_character": 37037,
        "end_character": 37327
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-004724",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-004724-8e583365bc8c94c4",
        "accession_number": "0001437749-26-004724",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe our employees are essential to our success and our ability to attract, develop, and retain key talent is a vital part of that.",
        "start_character": 19711,
        "end_character": 19848
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-004724",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-004724-8e583365bc8c94c4",
