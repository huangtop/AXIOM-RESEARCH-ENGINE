        "accession_number": "0001437749-26-004724",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "All of these companies currently have greater financial, technical, research, and/or other resources than we do and have larger and more established manufacturing capabilities and marketing, sales, and support functions.",
        "start_character": 22258,
        "end_character": 22478
      },
      {
