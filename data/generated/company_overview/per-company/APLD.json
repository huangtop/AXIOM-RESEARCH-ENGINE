    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to our contracted lease portfolio, we are developing and originating additional capacity that we expect to support future HPC leasing.",
        "start_character": 8593,
        "end_character": 8739
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We closely monitor legislative and regulatory developments and engage in dialogue with relevant stakeholders to ensure our business practices align with the evolving legal and regulatory framework.",
        "start_character": 21134,
        "end_character": 21331
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As of May 31, 2026, we employed approximately 256 full-time employees across various departments, including design, engineering, IT, operations, construction, administration, finance, and marketing.",
        "start_character": 22042,
        "end_character": 22240
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "At the same time, rising rack power densities driven by successive generations of AI accelerators are pushing critical IT loads beyond the levels most legacy facilities can support, increasing demand for the purpose-built, high-density, liquid-cooled capacity we develop.",
        "start_character": 13889,
        "end_character": 14160
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Because power distribution, cooling architecture, and data hall layouts are standardized across our campuses, we are able to consolidate purchasing around a common set of trusted, qualified partners—including ABB for electrical equipment, BASX for mechanical and cooling systems, and Caterpillar for backup generation—and to place bulk orders against a multi-gigawatt development pipeline.",
        "start_character": 16921,
        "end_character": 17310
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, through our partnership with Base Electron Corporation (\"Base Electron\"), an independent power producer, we are pursuing the development of approximately 1.2 GW of front-of-the-meter, natural gas-fired generation in the Dakotas, which we expect to unlock additional power capacity for our development pipeline.",
        "start_character": 9720,
        "end_character": 10043
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Through our build-out of our first North Dakota facility and the prior experience our leadership team brings to our initiatives, we believe that we have developed a repeatable power strategy to significantly scale our operations.",
        "start_character": 25631,
        "end_character": 25860
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are a U.S.-based designer, developer, owner, and operator of large-scale, purpose-built data centers engineered to support high-performance computing (“HPC”) workloads, including artificial intelligence (“AI”), machine learning, and other accelerated-compute applications.",
        "start_character": 39,
        "end_character": 314
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are advancing an active development pipeline of over 3 GW of utility (gross) power, consisting of near-term greenfield sites in multiple states together with expansion capacity at our existing campuses, certain of which are scalable to 1 GW or more.",
        "start_character": 9296,
        "end_character": 9548
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are doing our part to be as environmentally conscious as possible when choosing sites for development by targeting renewable energy assets to minimize our carbon footprint.",
        "start_character": 26725,
        "end_character": 26900
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We continuously monitor developments in the global supply chain which is necessary to assess their potential impact on the Company’s expansion plans within the HPC data center market.",
        "start_character": 19329,
        "end_character": 19512
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001144879-26-000048",
        "provenance_id": "provenance:SEC-FILING-0001144879-26-000048-d9db165af50a9eab",
        "accession_number": "0001144879-26-000048",
        "filing_date": "2026-07-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We design, build, and operate high-performance, sustainably engineered data centers—which we refer to as AI factories—and deliver that capacity to investment-grade hyperscalers and other leading compute customers under long-term lease and hosting arrangements.",
        "start_character": 315,
        "end_character": 575
      }
    ]
  },
