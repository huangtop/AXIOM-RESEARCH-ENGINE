    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "A large and relatively untapped opportunity is to deepen cross-sell of products to customers across all of our businesses, and we are currently employing technology and data designed to enable us to better track the customer life journey to allow us to identify and better execute on this opportunity.",
        "start_character": 48824,
        "end_character": 49125
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Additionally in 2024, we launched SPM, after the acquisition of an existing chronic care management platform, which offers providers, payers, and Accountable Care Organizations scalable, technology-enhanced services for patients living with chronic conditions.",
        "start_character": 12624,
        "end_character": 12884
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Additionally, we have leveraged our existing Senior database and distribution model to cross-sell to our Healthcare Services segment, as the marketing acquisition costs associated with the sale of a Senior policy are now also utilized to attain consumers for Healthcare Services as well.",
        "start_character": 49126,
        "end_character": 49413
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As a provider of services to entities subject to HIPAA, we are directly subject to certain provisions of the regulations as a “Business Associate.” When acting as a Business Associate under HIPAA, to the extent permitted by applicable privacy regulations and contracts with customers, we are permitted to use and disclose protected health information",
        "start_character": 59804,
        "end_character": 60154
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our success cross-selling ancillary products (e.g., dental, vision and hearing, prescription drug plans and fixed indemnity) to our clients has improved over time, and we continue to look at ways to broaden our cross-selling opportunities.",
        "start_character": 48584,
        "end_character": 48823
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Through our Healthcare Services business, we offer pharmaceutical products and other health-related equipment and services.",
        "start_character": 10812,
        "end_character": 10935
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are also required to comply with various laws and regulations governing Medicare providers, pharmacies, and providers of pharmacy care services, as well as laws governing marketing and advertising activities conducted by telephone, email, mobile devices and the internet.",
        "start_character": 55346,
        "end_character": 55620
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are also subject to various state and federal laws and regulations governing pharmacies and providers of pharmacy care services, including applicable Medicare provider regulations, state and federal anti-kickback laws, and regulations governing the labeling, packaging, advertising, and adulteration of prescription medications.",
        "start_character": 57667,
        "end_character": 57998
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are highly focused on the consumer experience and believe that customer satisfaction is a key vehicle for maximizing cross-sell opportunities and repeat business.",
        "start_character": 48250,
        "end_character": 48415
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe our position in the senior market provides a strategic foundation to expand into adjacent healthcare services, such as chronic care management, pharmacy support, and Healthcare Select solutions.",
        "start_character": 27412,
        "end_character": 27617
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe that offering these services enables healthcare to be more accessible, convenient, and personalized for our members.",
        "start_character": 13088,
        "end_character": 13215
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001794783-25-000081",
        "provenance_id": "provenance:SEC-FILING-0001794783-25-000081-ac94d8755580eba4",
        "accession_number": "0001794783-25-000081",
        "filing_date": "2025-08-21",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe the healthcare services market presents a significant opportunity to grow our business by offering additional products and services through our distribution platform.",
        "start_character": 24052,
        "end_character": 24229
      }
    ]
