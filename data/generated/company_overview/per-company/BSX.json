        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We conduct our internal research and development activities at our facilities and centers of excellence located around the world.",
        "start_character": 16939,
        "end_character": 17068
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000885725-26-000010",
        "provenance_id": "provenance:SEC-FILING-0000885725-26-000010-70a6c3f2d728876a",
        "accession_number": "0000885725-26-000010",
