        "accession_number": "0000040533-26-000006",
        "filing_date": "2026-01-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer comprehensive support for the more than 3,000 Gulfstream aircraft in service around the world and operate an extensive network of service centers.",
