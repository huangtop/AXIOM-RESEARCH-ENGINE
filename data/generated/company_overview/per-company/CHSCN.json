        "filing_date": "2025-11-05",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We operate 10 refined product terminals, nine propane terminals, three asphalt terminals and one lubricants blending and packaging facility.",
        "start_character": 8124,
        "end_character": 8264
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000823277-25-000038",
        "provenance_id": "provenance:SEC-FILING-0000823277-25-000038-777eacdf882e784e",
        "accession_number": "0000823277-25-000038",
        "filing_date": "2025-11-05",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We own and operate export terminals, river terminals and elevators throughout the United States to handle and transport grain and grain products.",
