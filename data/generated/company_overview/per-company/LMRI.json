        "filing_date": "2026-03-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are one of the largest national providers of diagnostic imaging services.",
        "start_character": 27,
        "end_character": 103
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-131907",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-131907-3b4879d1e33a41af",
        "accession_number": "0001193125-26-131907",
        "filing_date": "2026-03-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are the second largest provider of outpatient imaging services in the country by number of centers, with a national footprint predominantly located in attractive MSAs.",
        "start_character": 23770,
        "end_character": 23940
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-131907",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-131907-3b4879d1e33a41af",
        "accession_number": "0001193125-26-131907",
        "filing_date": "2026-03-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe our ability to provide high-quality imaging services in accessible, lower cost sites of care makes us the provider of choice for patients, referring physicians, health systems and payors.",
        "start_character": 19193,
        "end_character": 19391
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-131907",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-131907-3b4879d1e33a41af",
        "accession_number": "0001193125-26-131907",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In geographies where we have historically focused on wholly owned centers, there is a significant opportunity to develop joint ventures with local health systems.",
        "start_character": 37668,
        "end_character": 37830
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-131907",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-131907-3b4879d1e33a41af",
        "accession_number": "0001193125-26-131907",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In some of the states in which we operate, a lay person or any entity other than a professional corporation or other similar professional organization is not allowed to practice medicine, including by employing professional persons or by having any ownership interest or profit participation in or control over any medical professional practice.",
        "start_character": 42929,
        "end_character": 43274
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-131907",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-131907-3b4879d1e33a41af",
        "accession_number": "0001193125-26-131907",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "States in which we operate have adopted certain laws and regulations affecting risk assumption in the healthcare industry, including those that subject certain risk-based managed care contracting arrangements to comply with applicable risk bearing organization insurance laws and regulations.",
        "start_character": 74794,
        "end_character": 75086
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-131907",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-131907-3b4879d1e33a41af",
        "accession_number": "0001193125-26-131907",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "The facilities we operate or manage generate hazardous and medical waste subject to federal and state requirements regarding handling and disposal.",
        "start_character": 75599,
        "end_character": 75746
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-131907",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-131907-3b4879d1e33a41af",
        "accession_number": "0001193125-26-131907",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "There is significant ongoing third-party investment and innovation across the imaging AI ecosystem, and we believe that our use of externally sourced (as opposed to internally developed) AI can facilitate the accelerated adoption of AI, reduce future capital investment therein and preserve the flexibility to select and maintain the most valuable AI solutions.",
        "start_character": 8023,
        "end_character": 8384
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-131907",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-131907-3b4879d1e33a41af",
