        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "To achieve this, we are focused on bolstering our independent software vendor (“ISV”) and other partner relationships, improving our self-service capabilities, cross-selling our products, and expanding internationally.",
        "start_character": 11023,
        "end_character": 11241
      },
      {
