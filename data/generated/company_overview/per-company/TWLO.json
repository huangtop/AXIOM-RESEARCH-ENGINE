        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are continuing to invest in AI-powered capabilities, which we believe have the potential to enhance our offerings’ value to customers, as well as to automate processes and help our business run more efficiently.",
        "start_character": 13764,
        "end_character": 13978
      },
      {
