        "accession_number": "0001447669-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are focused on harnessing Twilio’s foundational strengths in communication channel offerings, global scale, developer loyalty, and contextual data assets to deliver a single cohesive platform for frictionless, context-driven interactions through trust at scale, simplified complexity, and smart engagement.",
        "start_character": 9409,
        "end_character": 9718
      },
      {
