    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through the sampling process, we have seen a variety in approaches to cell designs and, accordingly, are focused on developing a strong understanding of how our electrolyte affects certain cell performance parameters and performs relative to other sulfide electrolyte products.",
        "start_character": 11193,
        "end_character": 11470
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To support these efforts, we plan to utilize our Electrolyte Innovation Center, or EIC, to develop, improve, and test electrolyte manufacturing processes as well as electrolyte products.",
        "start_character": 14901,
        "end_character": 15087
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe Tier 1 battery manufacturers and OEMs are coalescing around sulfide solid-state batteries as the preferred solid state cell architecture of the future and view our continued sampling activities as a validation of our intended business model.",
        "start_character": 10940,
        "end_character": 11192
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe most OEMs and battery manufacturers have a technology roadmap that includes sulfide-based, solid-state cell products that can utilize our electrolyte.",
        "start_character": 1603,
        "end_character": 1764
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe we are the only entity with both pilot-scale sulfide electrolyte manufacturing and pilot-scale solid-state cell manufacturing capabilities, which positions us to utilize feedback from our internal cell development team as well as feedback from customers and other external parties to improve our electrolyte products.",
        "start_character": 6867,
        "end_character": 7195
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "By the end of 2026, we expect to commission a pilot electrolyte line using a continuous manufacturing process.",
        "start_character": 2956,
        "end_character": 3066
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "During 2022, we amended our JDA to provide BMW with a research and development-only license to certain of our intellectual property relating to cell manufacturing.",
        "start_character": 17919,
        "end_character": 18082
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "During 2024, we engaged with BMW in joint development and manufacturing activities at our facilities.",
        "start_character": 18327,
        "end_character": 18428
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "During 2025, we finished ordering long-lead time equipment and conducted detailed design for a pilot line designed to manufacture electrolyte on a continuous process.",
        "start_character": 7979,
        "end_character": 8145
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2025, we focused our cell research and development efforts on enhancing the feedback between our cell and electrolyte teams, with the ultimate goal of developing a superior understanding of how and why our electrolyte performs in a solid-state cell and using that knowledge to help our electrolyte customers improve their cell development.",
        "start_character": 6158,
        "end_character": 6500
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In October 2025, we announced a collaboration with Samsung SDI and BMW AG to pursue development and validation of a demonstration vehicle powered by all-solid-state battery technology.",
        "start_character": 20459,
        "end_character": 20643
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019435",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019435-ce7c29a06b43430a",
        "accession_number": "0001104659-26-019435",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In October 2025, we expanded our partnership with BMW through a collaboration with BMW AG and Samsung SDI to progress development of all-solid-state batteries.",
        "start_character": 19515,
        "end_character": 19674
      }
    ]
