        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We distribute products manufactured by Copeland Corporation, LLC (“Copeland”), The Chemours Company (“Chemours”), Mueller Industries, Inc.",
