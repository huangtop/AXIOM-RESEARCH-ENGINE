        "accession_number": "0001193125-26-082486",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe the diversity of products that we sell, and the scale which we possess, along with the manufacturers’ current product offerings, quality, marketability, and brand-name recognition, allow us to operate favorably relative to our competitors.",
        "start_character": 29296,
        "end_character": 29546
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082486",
