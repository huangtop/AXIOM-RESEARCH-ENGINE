        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We believe that we operate our business in substantial compliance with all applicable federal, state and local laws, and regulations.",
        "start_character": 36195,
        "end_character": 36328
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082486",
