        "accession_number": "0001193125-26-082486",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We compete with a number of distributors and also with several air conditioning and heating equipment manufacturers that distribute a significant portion of their products through their own distribution organizations in certain markets.",
