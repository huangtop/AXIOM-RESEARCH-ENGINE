        "end_character": 5970
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082486",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-082486-d739f7c82db776a9",
        "accession_number": "0001193125-26-082486",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We distribute products manufactured by Flexible Technologies, Inc., a subsidiary of Smiths Group plc (“Flexible Technologies”), Resideo Technologies, Inc.",
        "start_character": 5223,
        "end_character": 5377
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082486",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-082486-d739f7c82db776a9",
        "accession_number": "0001193125-26-082486",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell an expansive line of products and maintain a diverse mix of inventory to meet our customers’ immediate needs, and we seek to provide products a contractor would generally require when installing or repairing a central air conditioner, ductless system, furnace, or refrigeration system on short notice.",
        "start_character": 19665,
        "end_character": 19974
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082486",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-082486-d739f7c82db776a9",
        "accession_number": "0001193125-26-082486",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to the replacement market, we sell to the new construction market, including new homes and commercial construction.",
        "start_character": 11461,
        "end_character": 11588
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082486",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-082486-d739f7c82db776a9",
        "accession_number": "0001193125-26-082486",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, through our subsidiary, Watsco Ventures, LLC, we have developed (internally and through external collaboration) a variety of early-stage technologies intended to help contractor customers grow and become more profitable.",
