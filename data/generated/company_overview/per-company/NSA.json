        "accession_number": "0001628280-26-012248",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We seek to own properties that are well located in high quality sub-markets with highly accessible street access and attractive supply and demand characteristics, providing our properties with strong and stable cash flows that we believe are less sensitive to the fluctuations of the general economy.",
