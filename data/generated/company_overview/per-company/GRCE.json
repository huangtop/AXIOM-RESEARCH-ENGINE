        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are focused on developing and commercializing products for rare and orphan diseases that have the potential to improve clinical outcomes by using our novel drug delivery technologies.",
        "start_character": 26,
        "end_character": 212
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001140361-26-025662",
