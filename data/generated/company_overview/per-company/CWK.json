        "accession_number": "0001628369-26-000008",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "The brokerage of real estate sales and leasing transactions, property and facilities management, project management, conducting real estate valuation and securing debt for clients, among other service lines, require that we comply with regulations and maintain licenses in the various jurisdictions in which we operate.",
        "start_character": 27200,
        "end_character": 27519
