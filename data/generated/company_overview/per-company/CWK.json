        "accession_number": "0001628369-26-000008",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe multinational clients prefer to partner with real estate services providers with the scale necessary to meet their needs across multiple geographies and service lines.",
