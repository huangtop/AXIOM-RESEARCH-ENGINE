    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "By entering Lending as a Service partnerships with other companies, we create new proprietary channels through which to offer our lending and financial services products, and acquire new members, fortifying our membership growth potential.",
        "start_character": 11268,
        "end_character": 11507
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "For example, we are already seeing that the companies commonly referred to as “challenger banks”, “digital banks”, or “neo-banks” offering low-cost digital-only deposit accounts are offering lending products catered to underserved borrowers.",
        "start_character": 16878,
        "end_character": 17119
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we plan to continue developing more cross-buying opportunities between our Set & Save savings product and our credit products, primarily through timely and relevant marketing to existing members via our mobile app.",
        "start_character": 10189,
        "end_character": 10416
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our competitive differentiation in personal loans comes from our segment focus, our technology, data, A.I.-driven approach, and the way we tailor our product designs and borrowers’ experience to meet and exceed the expectations of our target members.",
        "start_character": 12488,
        "end_character": 12738
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through these channels, we help potential and current members become aware of our product offerings, in addition to our brand marketing (including online and broadcast media and outdoor advertising, including the presence of our 126 physical retail locations in some of the communities we serve) and direct marketing (including SMS/text, email, mail and offers made available through our Oportun Mobile App).",
        "start_character": 3380,
        "end_character": 3788
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are subject to various federal, state and local regulatory regimes related to the financial services that we provide.",
        "start_character": 19471,
        "end_character": 19591
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We design our products to holistically address two of the most fundamental challenges to financial health and resilience - access to responsible and affordable credit, and adequate savings.",
        "start_character": 184,
        "end_character": 373
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "While the consumer lending market is competitive, we believe that we can serve our target market with products that lead to better outcomes for consumers because they cost significantly less than other products used to fulfill similar borrowing needs and their responsible design supports consumer financial health.",
        "start_character": 17275,
        "end_character": 17590
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Our secured personal loans are currently offered in 8 states and we are in the process of expanding into other states.",
        "start_character": 15603,
        "end_character": 15721
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Since our inception, we have utilized alternative data sets to rapidly build, test and develop our underwriting, pricing, marketing, fraud and servicing models;",
        "start_character": 5753,
        "end_character": 5913
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We continuously monitor our environment in real-time using tools designed to detect security events and engage with third parties to audit our information security program and to perform regular penetration tests of our web applications and cloud environments.",
        "start_character": 24509,
        "end_character": 24769
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001538716-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001538716-26-000015-1c5ab954b59ed42c",
        "accession_number": "0001538716-26-000015",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We ingest billions of data points into our risk model development using traditional (e.g., credit bureau data) and alternative (e.g., bank transactional information, public records) data.",
        "start_character": 6526,
        "end_character": 6713
      }
