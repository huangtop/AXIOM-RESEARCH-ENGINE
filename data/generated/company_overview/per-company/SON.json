    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Backlog – The Company provides a wide variety of products to multiple end markets and relies on its customers’ forecasts to position raw materials for manufacturing within its facilities.",
        "start_character": 14332,
        "end_character": 14519
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Because we operate in highly competitive markets, we regularly bid for new and continuing business.",
        "start_character": 14948,
        "end_character": 15047
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to develop a range of products made from renewable materials and materials that can be recycled or composted at the end of their life.",
        "start_character": 18569,
        "end_character": 18715
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "With the acquisitions of Eviosys in December 2024 and Metal Packaging in January 2022, we expanded our manufacturing capability in steel and aluminum metal fabrication beyond our existing metal ends and closures products to include metal food and household packaging products for vegetables, tomatoes, fruit, spray cleaners, paint, and other products.",
        "start_character": 6440,
        "end_character": 6791
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As such, we believe attracting, recruiting, developing, integrating and retaining talent is vital to our success.",
        "start_character": 21514,
        "end_character": 21627
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, our Making Decisions Differently initiative, which we started in October 2023, aims to enhance employees’ ability to make better safety decisions on the manufacturing floor.",
        "start_character": 23179,
        "end_character": 23365
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also utilize external organizations and local universities to support our development needs.",
        "start_character": 25037,
        "end_character": 25132
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have created a Global Talent Acquisition and Organizational Development team to provide a more holistic approach to managing the employee lifecycle through continuous training and comprehensive succession planning.",
        "start_character": 24312,
        "end_character": 24529
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have focused on attracting qualified candidates, the professional development of our employees, our promotion and compensation structure, and employee retention efforts.",
        "start_character": 21093,
        "end_character": 21265
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We seek to engage, develop, and reward our employees so they can successfully pursue our purpose of Better Packaging.",
        "start_character": 19694,
        "end_character": 19811
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "In partnership with our employees, we are committed to promoting sustainable practices in our business.",
        "start_character": 17768,
        "end_character": 17871
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000091767-26-000008",
        "provenance_id": "provenance:SEC-FILING-0000091767-26-000008-ec5b49d746819558",
        "accession_number": "0000091767-26-000008",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "We are working to continue to ensure we can make relevant on-pack recyclability claims for our consumer-based product portfolio, while also ensuring we are closing the loop through continued use of post-consumer recycled content.",
        "start_character": 18233,
        "end_character": 18462
      }
