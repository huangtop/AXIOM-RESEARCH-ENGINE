        "accession_number": "0001193125-26-076548",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "By offering non-warranty home services, we can provide additional services to our existing customers and reach new customers, including those not currently interested in home warranties.",
