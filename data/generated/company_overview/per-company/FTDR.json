        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As consumer demand shifts toward more convenient, outsourced services, we believe we have an opportunity as a reliable, scaled service provider with a nationwide network of qualified professional service providers to expand further into non-warranty home services.",
        "start_character": 10605,
        "end_character": 10869
