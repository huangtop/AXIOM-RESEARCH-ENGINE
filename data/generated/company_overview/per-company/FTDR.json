        "accession_number": "0001193125-26-076548",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As home systems and appliances become more complex, and the needs of our customers continue to evolve, we believe our ability to innovate through upgraded and customized product offerings, differentiated service offerings and channel diversification focused on key customer segments will continue to drive customer growth and retention.",
        "start_character": 2456,
        "end_character": 2792
      },
      {
