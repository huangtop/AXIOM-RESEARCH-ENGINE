        "filing_date": "2026-03-05",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Below are some specific aeronautical regulations related to route rights and pricing policy in the countries where we operate.",
        "start_character": 106589,
        "end_character": 106715
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001047716-26-000046",
        "provenance_id": "provenance:SEC-FILING-0001047716-26-000046-d9dc44f78a9a1329",
