        "accession_number": "0001047716-26-000046",
        "filing_date": "2026-03-05",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We incur certain airport usage fees and other charges for services performed by the various airports where we operate, such as air traffic control charges, take-off and landing fees, aircraft parking fees and fees payable in connection with the use of passenger waiting rooms and check-in counter space.",
        "start_character": 99014,
        "end_character": 99317
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001047716-26-000046",
        "provenance_id": "provenance:SEC-FILING-0001047716-26-000046-d9dc44f78a9a1329",
        "accession_number": "0001047716-26-000046",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a consequence, we plan to sell one 767-300F in 2026.",
        "start_character": 53705,
        "end_character": 53760
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001047716-26-000046",
        "provenance_id": "provenance:SEC-FILING-0001047716-26-000046-d9dc44f78a9a1329",
