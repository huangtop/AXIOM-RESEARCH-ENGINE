        "offering_role": "product",
        "confidence": 0.96,
        "statement": "LATAM considers its passenger network to be a key competitive advantage due to the synergies between passenger and cargo operations and, accordingly, we have developed a strategy aimed at increasing competitiveness by enhancing the belly offering.",
        "start_character": 52916,
        "end_character": 53163
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001047716-26-000046",
