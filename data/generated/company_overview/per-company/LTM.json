        "accession_number": "0001047716-26-000046",
        "filing_date": "2026-03-05",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "For long-haul passenger flights, we operate the Boeing 787-8, the Boeing 787-9, the Boeing 767-300ER, the Boeing 777-300ER and the Airbus A330-200 (through wet lease).",
        "start_character": 12924,
        "end_character": 13091
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001047716-26-000046",
