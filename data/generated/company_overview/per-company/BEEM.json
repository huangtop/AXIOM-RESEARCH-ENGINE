        "accession_number": "0001437749-26-011890",
        "filing_date": "2026-04-09",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are increasing our offering of our electrified, transportation products, our energy storage and energy security products, and our smart cities infrastructure products in the U.S., Europe, the Middle East and Africa.",
