    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "An additional element of our intellectual property is our GaN IC process design kit (PDK), which we use to facilitate and accelerate product implementation and end customer development.",
        "start_character": 23568,
        "end_character": 23753
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "By adopting a fabless manufacturing model, we are able to scale faster with a lower fixed-cost burden than our vertically integrated peers.",
        "start_character": 13747,
        "end_character": 13886
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, we have an impressive track record of manufacturing and shipping GaN and SiC devices at scale.",
        "start_character": 4317,
        "end_character": 4424
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Navitas Semiconductor Corporation (“we,” us,” “Navitas” or the “Company”) designs, develops and markets next-generation power semiconductors including gallium nitride (GaN) power integrated circuits (ICs), high-voltage silicon carbide (SiC) devices and associated high-speed silicon system controllers, and digital isolators used in power conversion and charging.",
        "start_character": 27,
        "end_character": 390
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Our status as one of the only pure-play next-generation high-power semiconductor companies positioned at the intersection of AI data center growth and grid modernization provides us with significant competitive advantages as we pursue emerging high-power markets.",
        "start_character": 11278,
        "end_character": 11541
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "The Company offers a wide variety of benefits for employees around the world and invests in tools and resources that are designed to support employees’ individual growth and development.",
        "start_character": 26438,
        "end_character": 26624
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We attract, develop, and retain top critical talent while preparing our workforce for the future by increasing expertise in critical technology areas.",
        "start_character": 27783,
        "end_character": 27933
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have invested significantly in process development to overcome traditional GaN-on-Si manufacturing challenges—including material incompatibilities, defect management, and yield optimization—achieving predictable, consistent manufacturing results suitable for high-volume applications in harsh environments.",
        "start_character": 17246,
        "end_character": 17555
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We leverage deep design expertise and strategic partnerships with leading hyperscalers, GPU vendors, Tier-1 OEMs and ODMs, and platform providers to develop differentiated solutions for next-generation architectures, including 800 VDC systems.",
        "start_character": 14658,
        "end_character": 14901
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We value the diversity of our workforce and actively encourage growth and development opportunities for our employees, embracing collaboration and fostering an inclusive work environment.",
        "start_character": 25562,
        "end_character": 25749
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Whereas many of our competitors specialize in one or the other, we are a full-stack next-generation power semiconductor provider of both GaN and high-voltage SiC devices, allowing system-level optimization across voltage tiers.",
        "start_character": 12060,
        "end_character": 12287
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001821769-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001821769-26-000007-9860ea4623cdf8e0",
        "accession_number": "0001821769-26-000007",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "In late 2025, we announced a strategic pivot that we called “Navitas 2.0,” which entailed an enhanced focus on high-power markets, including AI data centers, energy and grid infrastructure, performance computing and industrial electrification, and a de-emphasis on mobile and consumer products.",
        "start_character": 3685,
        "end_character": 3979
      }
    ]
  },
