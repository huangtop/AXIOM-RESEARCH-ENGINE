    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Due to the short-term nature of the NYISO-operated capacity auctions and a relatively liquid bilateral market for NYISO capacity products, we sell a significant portion of our NYISO capacity through bilateral transactions.",
        "start_character": 21712,
        "end_character": 21934
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Market demand, also known as load, faced by electric power systems, such as those we operate in, varies from moment to moment as a result of changes in business and residential demand, which is often driven by weather.",
        "start_character": 6632,
        "end_character": 6850
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also enter into bilateral capacity transactions, with other PJM market participants, including load-serving entities and generation owners, to manage capacity obligations, pricing exposure, and portfolio risk.",
        "start_character": 18069,
        "end_character": 18281
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Competition in the markets in which we operate is impacted by electricity and fuel prices, congestion along the power grid, subsidies provided by state and federal governments for new and existing generation facilities, including renewables generation and battery ESS, new market entrants, construction of new generation assets, technological advances in power generation, the actions of environmental and other regulatory authorities, and other factors.",
        "start_character": 24341,
        "end_character": 24795
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2025 we created new content to develop executive presence and communication for leaders.",
        "start_character": 35578,
        "end_character": 35669
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In January 2026, the EPA proposed removing eight states (although none that we operate in) from the GNP FIP, and we expect the EPA will take additional action to reconsider other aspects of the GNP FIP in 2026.",
        "start_character": 55852,
        "end_character": 56062
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Risk Factors for additional information concerning the risks faced with respect to the markets in which we operate.",
        "start_character": 25398,
        "end_character": 25513
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "The EPA and the environmental regulatory bodies of states in which we operate have jurisdiction over the diversion, impoundment and withdrawal of water for cooling and other purposes and the discharge of wastewater (including storm water) from our facilities.",
        "start_character": 70402,
        "end_character": 70661
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We and the State of Texas had previously filed legal challenges in 2017 to the EPA's nonattainment designations in the Fifth Circuit Court.",
        "start_character": 59547,
        "end_character": 59686
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are subject to extensive environmental regulation by governmental authorities, including the EPA and the environmental regulatory bodies of states in which we operate.",
        "start_character": 38544,
        "end_character": 38714
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe the development of employees at all levels is critical to Vistra's current and future success.",
        "start_character": 34901,
        "end_character": 35006
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001692819-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001692819-26-000006-7f14fefedd12aa95",
        "accession_number": "0001692819-26-000006",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We continue to evaluate and refine our programs as the development needs of our employees change.",
        "start_character": 35480,
        "end_character": 35577
      }
    ]
