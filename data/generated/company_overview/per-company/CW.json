        "end_character": 1614
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007587",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007587-5041764377f4b68e",
        "accession_number": "0001628280-26-007587",
        "filing_date": "2026-02-12",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are focused on promoting a culture that best leverages the talents of all employees, as well as implementing practices that attract, develop, and retain top talent.",
        "start_character": 21896,
        "end_character": 22063
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007587",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007587-5041764377f4b68e",
        "accession_number": "0001628280-26-007587",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are well positioned in the markets in which we operate, and aspire to grow our critical mass by expanding our global manufacturing capabilities, sales channels and customer relationships, while also seeking to build upon cross-market opportunities that may exist within our defense and commercial market technologies.",
