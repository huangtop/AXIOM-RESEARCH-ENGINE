        "end_character": 11688
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007587",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007587-5041764377f4b68e",
        "accession_number": "0001628280-26-007587",
        "filing_date": "2026-02-12",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "The health, safety, and well-being of our employees, together with protection of the environment in the communities in which we operate, is a top priority for Curtiss-Wright.",
        "start_character": 25388,
        "end_character": 25562
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007587",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007587-5041764377f4b68e",
        "accession_number": "0001628280-26-007587",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Today, we maintain competitive positions in the majority of our key A&D and commercial end markets through engineering and technological leadership, precision manufacturing, and long-standing customer relationships where we are deeply embedded in our customers' workflows.",
