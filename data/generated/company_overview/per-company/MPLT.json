        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our second product candidate, ML-004, is a 5-HT1B/1D agonist that we are developing for the treatment of social communication deficit and/or irritability in ASD.",
        "start_character": 57280,
        "end_character": 57441
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-125072",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-125072-85fd6036b3642de7",
        "accession_number": "0001193125-26-125072",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our second product candidate, ML-004, is a 5-HT1B/1D agonist that we are developing for the treatment of social communication deficit and/or irritability in autism spectrum disorder, or ASD.",
