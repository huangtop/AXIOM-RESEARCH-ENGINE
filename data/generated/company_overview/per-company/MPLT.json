        "provenance_id": "provenance:SEC-FILING-0001193125-26-125072-85fd6036b3642de7",
        "accession_number": "0001193125-26-125072",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our pipeline of product candidates is diversified by mechanism and neural circuit to address a breadth of debilitating CNS disorders, and we currently retain global development and commercial rights to all programs.",
