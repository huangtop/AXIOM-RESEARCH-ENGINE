        "filing_date": "2025-08-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "To that extent, we provide the following service offerings:",
        "start_character": 30095,
        "end_character": 30154
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000950170-25-109742",
