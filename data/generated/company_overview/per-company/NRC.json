        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe the primary competitive factors within our market include quality and focus of service, timeliness of delivery, unique service capabilities, the ability to release innovative solution updates, breadth of solutions, credibility of provider, industry experience, and price.",
        "start_character": 20889,
        "end_character": 21171
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-007002",
