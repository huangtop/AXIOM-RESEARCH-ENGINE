        "end_character": 49472
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000885590-26-000023",
        "provenance_id": "provenance:SEC-FILING-0000885590-26-000023-dbb55a2b7260a2ef",
        "accession_number": "0000885590-26-000023",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We face increased competition from manufacturers of generic pharmaceutical products when patents covering certain of our currently marketed products expire or are successfully challenged or when the regulatory exclusivity for our products expires or is otherwise lost.",
        "start_character": 55158,
        "end_character": 55426
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000885590-26-000023",
        "provenance_id": "provenance:SEC-FILING-0000885590-26-000023-dbb55a2b7260a2ef",
