        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our competitors are pursuing the development and/or acquisition of pharmaceuticals, medical devices and OTC products that target the same diseases and conditions that we are targeting in GI, neurology, dermatology, eye health and other therapeutic areas.",
        "start_character": 53937,
        "end_character": 54191
      },
      {
