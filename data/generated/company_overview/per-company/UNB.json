        "filing_date": "2026-03-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To attract, engage, and retain top talent, we strive to create a supportive workplace, with opportunities for our employees to grow and develop in their careers.",
        "start_character": 3584,
        "end_character": 3745
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000706863-26-000029",
