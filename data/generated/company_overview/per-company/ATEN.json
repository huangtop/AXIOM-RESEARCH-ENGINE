        "provenance_id": "provenance:SEC-FILING-0001580808-26-000014-5b4b152dbfea2d39",
        "accession_number": "0001580808-26-000014",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide global technical support and maintenance services designed to help customers deploy, operate, and optimize our solutions in mission-critical environments.",
        "start_character": 14558,
        "end_character": 14723
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001580808-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001580808-26-000014-5b4b152dbfea2d39",
        "accession_number": "0001580808-26-000014",
        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide integrated capabilities spanning application delivery, traffic management, distributed denial of service (“DDoS”) protection, application and application programming interfaces (“API”) security, and centralized management.",
        "start_character": 435,
        "end_character": 668
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001580808-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001580808-26-000014-5b4b152dbfea2d39",
        "accession_number": "0001580808-26-000014",
        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We support organizations that manage mission-critical applications, high-availability networks, and performance-sensitive digital services where uptime, security, and scalability are essential.",
