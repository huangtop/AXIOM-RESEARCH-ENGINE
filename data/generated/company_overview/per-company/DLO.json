    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Because the regulation of payment service providers is complex and subject to continuous change, we are subject to a number of risks associated with ongoing regulatory compliance.",
        "start_character": 99181,
        "end_character": 99360
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2025, we established a dedicated Artificial Intelligence Research & Development department, including an AI Lab focused on the evaluation, testing, and responsible application of emerging AI technologies relevant to our business.",
        "start_character": 84329,
        "end_character": 84561
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In addition to these core services, we are selectively expanding into adjacent, payment‑related products that leverage our existing infrastructure and regulatory footprint, including Buy Now, Pay Later solutions offered through third‑party providers, Merchant of Record models for certain customer verticals, and virtual account offerings that assign unique, bank‑like identifiers to end customers or sub‑merchants to facilitate local collection, reconciliation and balance management for our merchants.",
        "start_character": 54801,
        "end_character": 55304
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In addition, the presence or footprint of our business may vary from jurisdiction to jurisdiction, depending on the level of maturity and significance of our business in the jurisdictions in which we operate.",
        "start_character": 98972,
        "end_character": 99180
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In no instance do we offer or provide tax consulting services to our merchants.",
        "start_character": 68649,
        "end_character": 68728
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Key Information—Risk Factors—Risks Relating to Our Business and Industry—We are subject to complex and evolving tax regimes and foreign exchange regulations in the countries in which we operate and failure to accurately interpret applicable tax laws or foreign exchange regulations, or changes in tax laws or foreign exchange regulations or changes in existing interpretations of tax laws or foreign exchange regulations, could have a material adverse effect on our business and financial condition.”",
        "start_character": 100499,
        "end_character": 100999
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Key Information—Risk Factors—Risks Relating to Our Business and Industry—We may not be able to obtain or maintain the relevant regulatory licenses, permissions or registrations to carry out our business in the various jurisdictions in which we operate, which may subject us to fines, penalties or force us to discontinue operations in such jurisdictions, any of which could have a material adverse effect on our business, financial condition and results of operations,” “Item 3.",
        "start_character": 99762,
        "end_character": 100240
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Most recently, we launched SmartAPMs, offering tokenization of alternative payment methods across multiple emerging markets.",
        "start_character": 49539,
        "end_character": 49663
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also continue to focus on developing new products as we scale.",
        "start_character": 85517,
        "end_character": 85582
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also partner selectively with PSPs to which we offer our services and “last-mile” connectivity to local payment methods in emerging markets, thus allowing us to reach certain long-tail merchants to which we may not otherwise directly connect.",
        "start_character": 27504,
        "end_character": 27749
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are a Cayman Islands exempted company incorporated with limited liability on February 10, 2021, for the purposes of facilitating our initial public offering that took place on June 3, 2021.",
        "start_character": 3808,
        "end_character": 4000
      },
      {
        "business_evidence_id": "business-evidence:SEC-0002070979-26-000113",
        "provenance_id": "provenance:SEC-FILING-0002070979-26-000113-ec7c36ad5d3aa5e2",
        "accession_number": "0002070979-26-000113",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are replacing a complex patchwork of legacy offerings that in many instances cannot deliver the comprehensive level of functionality required to process large volumes and maximize end-user satisfaction, or fail to comply with local regulatory and tax frameworks.",
        "start_character": 76575,
        "end_character": 76840
