        "end_character": 2229
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001062993-26-002973",
        "provenance_id": "provenance:SEC-FILING-0001062993-26-002973-a38b24d030854b3d",
        "accession_number": "0001062993-26-002973",
        "filing_date": "2026-06-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We operate in North America, South America, and Europe.",
        "start_character": 22179,
        "end_character": 22234
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001062993-26-002973",
        "provenance_id": "provenance:SEC-FILING-0001062993-26-002973-a38b24d030854b3d",
        "accession_number": "0001062993-26-002973",
        "filing_date": "2026-06-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We operate in a complex and evolving regulatory landscape spanning financial regulation, infrastructure, energy policy, international trade, and export controls.",
