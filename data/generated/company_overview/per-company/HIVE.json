        "end_character": 32717
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001062993-26-002973",
        "provenance_id": "provenance:SEC-FILING-0001062993-26-002973-a38b24d030854b3d",
        "accession_number": "0001062993-26-002973",
        "filing_date": "2026-06-02",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "As we expand into the AI and HPC markets, we compete for access to suitable land and power, advanced hardware, technical talent, and customers seeking AI and HPC compute power.",
        "start_character": 31031,
        "end_character": 31207
      },
      {
