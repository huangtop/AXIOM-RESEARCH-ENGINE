      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are focused on attracting, developing, and retaining a highly-skilled workforce that will deliver excellent service to our customers.",
        "start_character": 22472,
        "end_character": 22608
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We derive a competitive advantage in locations where we have pipeline networks, which enable us to provide a reliable and economic supply of products to our larger customers.",
        "start_character": 3919,
        "end_character": 4093
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Liquid bulk gases are delivered in either liquid or gaseous form via tanker or tube trailer and stored, usually in its liquid state, in equipment that we typically design and install at the customer’s site for vaporizing into a gaseous state as needed.",
        "start_character": 7630,
        "end_character": 7882
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Our goal is zero accidents and incidents, and we are committed to continuously improving the safety and health of our employees, contractors, customers, and the communities where we operate.",
        "start_character": 23965,
        "end_character": 24155
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To support this, we benchmark our compensation to remain aligned with market conditions and provide competitive pay and benefits.",
        "start_character": 25885,
        "end_character": 26014
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also develop, engineer, build, own, and operate some of the world’s largest clean hydrogen projects supporting the transition to low- and zero-carbon energy, particularly in industrial applications and the heavy-duty transportation sector.",
        "start_character": 2221,
        "end_character": 2463
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also fund and cooperate in research and development programs conducted by a number of major universities and undertake research work funded by others, including the United States government.",
        "start_character": 16523,
        "end_character": 16716
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We conduct research and development principally in our laboratories located in the United States (Allentown, Pennsylvania), the United Kingdom (Basingstoke and Carrington), Spain (Barcelona), China (Shanghai), and Saudi Arabia (Dhahran).",
        "start_character": 16285,
        "end_character": 16522
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We continue to develop technologies to help our facilities and our customers lower energy consumption, improve efficiency, and lower emissions.",
        "start_character": 21171,
        "end_character": 21314
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We design and manufacture equipment for air separation, hydrocarbon recovery and purification, and liquid helium and liquid hydrogen transport and storage.",
        "start_character": 10417,
        "end_character": 10572
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000002969-25-000055",
        "provenance_id": "provenance:SEC-FILING-0000002969-25-000055-8b9a416edea2c699",
        "accession_number": "0000002969-25-000055",
        "filing_date": "2025-11-20",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We manage our operations, assess performance, and report earnings under five reportable segments: Americas, Asia, Europe, Middle East and India, and Corporate and other.",
