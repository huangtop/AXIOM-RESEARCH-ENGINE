        "accession_number": "0001650372-25-000036",
        "filing_date": "2025-08-15",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We developed the Atlassian Marketplace to provide customers a wide range of apps they can use to enhance our products, further increasing the value of the Atlassian platform.",
        "start_character": 9583,
        "end_character": 9757
      },
      {
