        "end_character": 20165
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001857154-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001857154-26-000015-433c6a66258e9566",
        "accession_number": "0001857154-26-000015",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "At an additional facility in Winston-Salem, we manufacture our proprietary doughnut-making equipment for shipment to new shops and Doughnut Factories around the world.",
        "start_character": 24042,
        "end_character": 24209
      },
      {
