        "end_character": 26121
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001857154-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001857154-26-000015-433c6a66258e9566",
        "accession_number": "0001857154-26-000015",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, we generate revenue from our franchisees through development and initial franchise fees relating to new shop openings, ongoing royalties charged to franchisees based on their sales, and advertising fees based on their sales.",
        "start_character": 11288,
        "end_character": 11525
      },
      {
