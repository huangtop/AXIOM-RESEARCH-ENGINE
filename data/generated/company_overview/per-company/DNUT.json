        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We depend on our Krispy Kremers to provide great customer service, to make our products in adherence to our high-quality standards and to maintain the consistency of our operations.",
        "start_character": 19732,
        "end_character": 19913
      },
      {
