        "provenance_id": "provenance:SEC-FILING-0001297184-26-000009-2e53fea97cb7a926",
        "accession_number": "0001297184-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Many of the products that we are developing qualify for CGT.",
