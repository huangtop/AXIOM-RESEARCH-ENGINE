        "provenance_id": "provenance:SEC-FILING-0001297184-26-000009-2e53fea97cb7a926",
        "accession_number": "0001297184-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In recent years, we have shifted our development focus from primarily complex generics toward proprietary and biosimilar products, reflecting our long-term strategy to expand into higher-value, innovative-driven programs.",
