        "accession_number": "0001300514-26-000013",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We intend to continue to introduce more modern and popular products that appeal to the Asian marketplace and believe our continued improvement in our high-quality gaming product offerings has enabled us to capture a meaningful share of the overall Macao gaming market across all player segments.",
        "start_character": 22146,
        "end_character": 22441
      },
      {
