        "accession_number": "0001193125-26-057329",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For our AAV gene therapy products, we have the capabilities to manufacture and test our own drug substance and drug products while also leveraging CDMO partners.",
