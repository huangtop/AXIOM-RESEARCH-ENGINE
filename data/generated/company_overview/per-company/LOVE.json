        "filing_date": "2026-04-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We aim to maximize customer lifetime value for both new and existing customers by delivering a consistent brand message across our omni-channel platform, which we believe influences our customers’ buying decisions, and through our unique product offerings designed to evolve with our customers’ needs.",
        "start_character": 12046,
        "end_character": 12347
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022929",
