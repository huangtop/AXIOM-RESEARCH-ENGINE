        "accession_number": "0001628280-26-022929",
        "filing_date": "2026-04-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a technology driven company that designs, manufactures and sells unique, high quality furniture derived through our proprietary Designed for Life® approach which results in products that are built to last a lifetime and designed to evolve as our customers’ lives do.",
