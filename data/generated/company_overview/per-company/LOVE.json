        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As we continue to grow our business and add additional showrooms in strategic locations across the United States, we seek the ability to service more customers locally with area-designated representatives who will shift their efforts between our showrooms and customers’ homes.",
        "start_character": 15530,
        "end_character": 15807
