        "filing_date": "2025-11-21",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We operate a decentralized, adaptive business model, which provides us with flexibility to pursue acquisitions and other strategic transactions.",
        "start_character": 5001,
        "end_character": 5145
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001530950-25-000260",
        "provenance_id": "provenance:SEC-FILING-0001530950-25-000260-908e5de1c59e4a93",
        "accession_number": "0001530950-25-000260",
        "filing_date": "2025-11-21",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell Post Consumer Brands products primarily to grocery stores, mass merchandise customers, supercenters, club stores, natural/specialty stores, dollar stores, discounters, wholesalers, convenience stores, pet supply retailers and drug store customers.",
        "start_character": 23374,
        "end_character": 23629
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001530950-25-000260",
        "provenance_id": "provenance:SEC-FILING-0001530950-25-000260-908e5de1c59e4a93",
