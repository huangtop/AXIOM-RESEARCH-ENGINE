        "filing_date": "2026-03-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As we advance our current and any future product candidates through development, we will consider our lack of redundant supply for the API and drug product for each product candidate to protect against any potential supply disruptions.",
        "start_character": 33270,
        "end_character": 33505
      },
      {
