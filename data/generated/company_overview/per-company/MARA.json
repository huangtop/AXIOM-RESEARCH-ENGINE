    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As we evaluate and develop AI inference capabilities within our infrastructure, we expect any potential AI-related revenue to be derived from offering inference compute capacity and private, dedicated cloud solutions to third-party customers, with pricing based on usage, capacity commitments, or other commercial arrangements.",
        "start_character": 13730,
        "end_character": 14057
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Alongside our Bitcoin mining foundation, we are in the process of taking initial steps to extend our platform beyond Bitcoin mining and into AI and HPC workloads, leveraging our core competencies in energy ownership, flexible load management, and rapid compute deployment.",
        "start_character": 20490,
        "end_character": 20762
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As we expand into the AI and HPC markets, we also face competition from established data-center operators and infrastructure providers with significant capital resources, brand recognition and technical expertise.",
        "start_character": 28883,
        "end_character": 29096
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As we expand into the development and operation of AI and HPC workloads, we may become subject to various laws, ordinances and regulations.",
        "start_character": 33847,
        "end_character": 33986
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "However, we may also become subject to additional regulatory requirements on a state and local level in the geographies in which we operate, and as we strategically expand our operations into new areas.",
        "start_character": 33612,
        "end_character": 33814
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2026, we expect to continue to monetize bitcoin opportunistically to enhance our financial flexibility, including to provide liquidity or to fund capital projects and other initiatives that we believe enhance long-term shareholder value, subject to market conditions and our capital allocation priorities.",
        "start_character": 20181,
        "end_character": 20489
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, we participate in Bitcoin-related projects focused on the technological development of hardware, firmware, mining pools, and side chains that leverage blockchain cryptography.",
        "start_character": 4005,
        "end_character": 4193
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In parallel, we are in the process of developing artificial intelligence (“AI”) inference and high-performance computing (“HPC”) capabilities.",
        "start_character": 332,
        "end_character": 474
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In support of these initiatives, we acquired a majority ownership interest in Exaion SaS (“Exaion”), a company that develops and operates HPC data centers and provides secure cloud and AI infrastructure, further strengthening our position in the technology industry.",
        "start_character": 1654,
        "end_character": 1920
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In the second half of 2025, we began selling bitcoin to fund operations.",
        "start_character": 20108,
        "end_character": 20180
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Internationally, we operate five facilities across three different countries as part of a broader international strategy to position MARA as a power-advantaged digital infrastructure platform beyond the United States.",
        "start_character": 25942,
        "end_character": 26159
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001507605-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001507605-26-000007-57e485abf1501975",
        "accession_number": "0001507605-26-000007",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Once we have identified a promising idea, the next step is to develop a prototype.",
        "start_character": 21834,
        "end_character": 21916
      }
    ]
  },
