        "accession_number": "0001736730-26-000016",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we are eligible to receive up to $440 million in development and commercial milestone payments, subject to achievement of specified criteria, as well as tiered royalties on annual net sales of licensed products ranging from the low- to mid-single digits during a defined royalty term for each licensed product.",
        "start_character": 28627,
        "end_character": 28950
      },
      {
