        "accession_number": "0001736730-26-000016",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As of December 31, 2025, we had 48 employees, all of whom were full-time and 34 of whom were engaged in research and development activities.",
