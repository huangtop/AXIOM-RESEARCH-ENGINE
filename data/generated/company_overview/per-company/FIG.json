    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "At the same time, we also see roles continuing to blur as the product-development process keeps evolving.",
        "start_character": 19913,
        "end_character": 20018
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also make Figma’s Organization plan available for free for K-12 students and educators to help develop the next generation of product builders.",
        "start_character": 25021,
        "end_character": 25167
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are quickly becoming a system of record for design and product development at a time when software is growing exponentially.",
        "start_character": 1823,
        "end_character": 1950
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We exist to serve anyone designing and building products and digital experiences.",
        "start_character": 36422,
        "end_character": 36503
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "While it’s possible for AI to get to working software with a simple prompt, we believe that the most important differentiator is craft — ensuring that the product looks, feels, and works “just right.” We’ve designed Figma Make with many ways to iterate and refine its outputs.",
        "start_character": 10016,
        "end_character": 10292
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "•Maintaining our rapid and proven pace of product innovation: Since launching our core product Figma Design in 2015, we have expanded our platform to serve more parts of the product development process with FigJam, Figma Slides, Figma Draw, Figma Make, Dev Mode, Figma Sites, and Figma Buzz.",
        "start_character": 25578,
        "end_character": 25869
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For these users, we’ve created Figma Draw, which is a dedicated space for vector editing within Figma Design.",
        "start_character": 5961,
        "end_character": 6070
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2019, we introduced the ability to build plugins in Figma Design that help teams fully connect their workflows, bring in real data, and accelerate their design process.",
        "start_character": 27843,
        "end_character": 28014
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2025, we added our own Model Context Protocol (“MCP”) server to Dev Mode, which allows developers to connect an agent in their code editor directly to designs in Figma.",
        "start_character": 8465,
        "end_character": 8636
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In certain countries in which we operate, we are subject to, and comply with, local labor law requirements which may automatically make our employees subject to industry-wide collective bargaining agreements.",
        "start_character": 35674,
        "end_character": 35882
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In response, we built Dev Mode, which is tailor-made for developer audiences and built with their specific ways of working in mind.",
        "start_character": 27467,
        "end_character": 27598
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009228",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009228-6b98194140ed0aa4",
        "accession_number": "0001628280-26-009228",
        "filing_date": "2026-02-18",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are therefore subject to laws and regulations regarding privacy, data security, and our processing of such data at the federal, state, and local level in the United States, as well as similar laws and regulations in the other jurisdictions where we operate, including in the European Economic Area (the “EEA”) and the United Kingdom (the “UK”).",
        "start_character": 33706,
        "end_character": 34053
      }
