        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2025 we launched Schwab Advisor ProDirect™, a membership-based program designed to help independent RIA firms accelerate sustainable growth through structured guidance, peer learning, and operational best practices.",
        "start_character": 19198,
        "end_character": 19416
      },
      {
