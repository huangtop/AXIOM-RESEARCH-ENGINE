        "end_character": 22954
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000316709-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000316709-26-000009-2d9a8371ceed67b1",
        "accession_number": "0000316709-26-000009",
        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "•Scale and Size of the Business – As one of the largest investment services firms in the U.S., we are able to spread operating costs and amortize new investments over a large base of clients, and harness the resources to evolve capabilities to meet client needs.",
        "start_character": 4342,
        "end_character": 4604
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000316709-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000316709-26-000009-2d9a8371ceed67b1",
