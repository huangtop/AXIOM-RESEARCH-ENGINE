        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have developed risk and capital allocation models to support our Mortgage Insurance business.",
        "start_character": 73673,
        "end_character": 73769
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-061383",
