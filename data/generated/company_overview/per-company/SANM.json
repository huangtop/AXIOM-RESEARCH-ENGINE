        "accession_number": "0000897723-25-000042",
        "filing_date": "2025-11-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In a JDM model, our customers bring market knowledge and product requirements, and we bring complete design engineering and NPI services.",
