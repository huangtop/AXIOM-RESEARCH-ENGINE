        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our Professional Services team delivers deep supply chain and enterprise commerce domain expertise to our customers through industry-specific “best-practices” protocols and processes developed through the collective knowledge we have gained from 30 years of implementing our supply chain solutions worldwide.",
        "start_character": 20282,
        "end_character": 20590
