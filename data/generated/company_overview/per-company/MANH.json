        "filing_date": "2026-02-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We develop, sell, deploy, service and maintain software solutions designed to manage supply chains, inventory and omnichannel operations for retailers, wholesalers, manufacturers, logistics providers and other organizations.",
