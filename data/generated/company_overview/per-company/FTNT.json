        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In certain cases, we sell directly to large service providers, major systems integrators and large end users.",
        "start_character": 17280,
        "end_character": 17389
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
