        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The concept of an integrated cybersecurity platform that converges networking and security and consolidates point products is what guides how we design our products and advise our customers and partners.",
        "start_character": 14861,
        "end_character": 15064
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001262039-26-000007-7f61e7e0718ebaf0",
        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are committed to implementing a comprehensive approach to protecting the security and integrity of our products throughout the product design, development, manufacturing, delivery and support processes.",
        "start_character": 24452,
        "end_character": 24657
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001262039-26-000007-7f61e7e0718ebaf0",
        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We focus our research and development efforts on developing new hardware and software products and services, and adding new features to existing products, services and operating systems.",
        "start_character": 23469,
        "end_character": 23655
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001262039-26-000007-7f61e7e0718ebaf0",
        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We outsource the manufacturing of our security appliance products to a variety of contract manufacturers and original design manufacturers.",
        "start_character": 19441,
        "end_character": 19580
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001262039-26-000007-7f61e7e0718ebaf0",
        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We primarily sell our products and services through a two-tier distribution model.",
        "start_character": 17013,
        "end_character": 17095
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001262039-26-000007-7f61e7e0718ebaf0",
        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell to distributors that sell to resellers and to service providers and managed security service providers (“MSSPs”), who, in turn, sell products and/or services to end-customers.",
        "start_character": 17096,
        "end_character": 17279
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001262039-26-000007-7f61e7e0718ebaf0",
        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "•We conduct regular patch release cycles and operate a notification service to support and encourage customers to apply security patches.",
        "start_character": 25714,
        "end_character": 25851
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001262039-26-000007-7f61e7e0718ebaf0",
        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, we manage global memory component supply through diversified sourcing arrangements, strategic inventory planning and coordination with key supply chain partners.",
        "start_character": 21763,
        "end_character": 21938
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001262039-26-000007-7f61e7e0718ebaf0",
        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Examples of our initiatives focused on our employees include our company matching program for employee charitable contributions, paid volunteering days (where applicable) and the free security training programs we offer to help with career development for our employees, in addition to the general public.",
        "start_character": 35352,
        "end_character": 35657
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001262039-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001262039-26-000007-7f61e7e0718ebaf0",
        "accession_number": "0001262039-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, the application and interpretation of these laws and regulations often are uncertain, particularly in the industry in which we operate.",
