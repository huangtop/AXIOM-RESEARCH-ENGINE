        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Federal law restricts our ability to borrow from our banks by limiting the aggregate amount we may borrow and by requiring that all loans to us be secured in designated amounts by specified forms of collateral.",
        "start_character": 12627,
        "end_character": 12837
      },
      {
