      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-188853",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-188853-057c2610ae570238",
        "accession_number": "0001193125-26-188853",
        "filing_date": "2026-04-29",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide our content and services through three major channels, including our PC channel, our mobile channel and third-party channel.",
        "start_character": 17991,
        "end_character": 18126
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-188853",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-188853-057c2610ae570238",
        "accession_number": "0001193125-26-188853",
        "filing_date": "2026-04-29",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "While we believe that our integrated platform business model and targeted user base is unique, we compete with other content and service providers for user traffic, advertising revenues and fee-based services.",
        "start_character": 32289,
        "end_character": 32498
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-188853",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-188853-057c2610ae570238",
        "accession_number": "0001193125-26-188853",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Based on commercial big data, we developed a data analytical system, which has successfully helped to build a comprehensive analytical chain of big data and helped us to achieve our goals of making precise and efficient commercial strategy decisions.",
        "start_character": 29832,
        "end_character": 30082
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-188853",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-188853-057c2610ae570238",
        "accession_number": "0001193125-26-188853",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Following the success of these two platforms, we decided to develop Fengfei (“凤飞”), an advertising platform that we built based on in-app advertisement solutions.",
        "start_character": 27952,
        "end_character": 28114
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-188853",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-188853-057c2610ae570238",
        "accession_number": "0001193125-26-188853",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For example, we internally developed an analytic platform named Fengyan (“凤眼”) to track and analyze certain real-time user behavior data under user consent.",
        "start_character": 26995,
        "end_character": 27151
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-188853",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-188853-057c2610ae570238",
        "accession_number": "0001193125-26-188853",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For technology screening, the machine recognizes the video and image content and we use an in-house developed identification system in order to comply with PRC regulatory requirements regarding Internet content.",
        "start_character": 17745,
        "end_character": 17956
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-188853",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-188853-057c2610ae570238",
        "accession_number": "0001193125-26-188853",
        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition to our own channels, we operate official accounts and mini-programs across major social media platforms in China and overseas, including but not limited to WeChat, Weibo, Douyin, Kuaishou, Bilibili, X (formerly Twitter), and Facebook to distribute our content.",
        "start_character": 20353,
        "end_character": 20625
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-188853",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-188853-057c2610ae570238",
        "accession_number": "0001193125-26-188853",
        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.92,
