        "accession_number": "0001437749-25-029723",
        "filing_date": "2025-09-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "During fiscal 2024 we completed the process of transferring the manufacturing of our Adzenys and Cotempla products to a United States-based CMO who started manufacturing both Adzenys and Cotempla during the third quarter of fiscal 2024 and will manufacture all of our ADHD products going forward.",
        "start_character": 45718,
        "end_character": 46014
      },
      {
