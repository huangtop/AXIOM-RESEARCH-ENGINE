        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "The scope and content of compensation regulation in the financial industry are continuing to develop, and we expect that these regulations and resulting market practices will continue to evolve over a number of years.",
        "start_character": 71858,
        "end_character": 72075
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000049196-26-000015",
        "provenance_id": "provenance:SEC-FILING-0000049196-26-000015-8634c4eb9abd37a8",
