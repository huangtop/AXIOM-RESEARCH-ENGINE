        "filing_date": "2026-02-03",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer a suite of value added services, including payouts, payments orchestration, and fraud prevention and risk management solutions that help reduce merchant losses through our proprietary protection programs.",
        "start_character": 11440,
        "end_character": 11653
      },
      {
