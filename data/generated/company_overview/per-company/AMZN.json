        "accession_number": "0001018724-26-000004",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide advertising services to sellers, vendors, publishers, authors, and others, through programs such as sponsored ads, display, and video advertising.",
