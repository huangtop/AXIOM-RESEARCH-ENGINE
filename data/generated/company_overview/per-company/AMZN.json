        "accession_number": "0001018724-26-000004",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We design our stores to enable hundreds of millions of unique products to be sold by us and by third parties across dozens of product categories.",
        "start_character": 1382,
        "end_character": 1527
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001018724-26-000004",
