        "accession_number": "0001104659-26-021817",
        "filing_date": "2026-03-02",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As a mobile virtual network operator (“MVNO”), we depended on either T-Mobile or AT&T to provide us with network services under the amended Master Network Services Agreement (as amended, the “MNSA”) and Network Services Agreement (as amended, the “NSA”), respectively.",
        "start_character": 20263,
        "end_character": 20531
