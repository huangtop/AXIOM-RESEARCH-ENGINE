        "provenance_id": "provenance:SEC-FILING-0001445305-26-000016-684b4fad51257837",
        "accession_number": "0001445305-26-000016",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We market our platform globally to banks, insurance and investment firms with fit-for-purpose solutions to simplify the complexity of regulatory, financial, risk and sustainability management.",
