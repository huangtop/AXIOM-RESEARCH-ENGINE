        "filing_date": "2025-12-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We typically target acquisition opportunities that allow us to broaden our product offerings, services and technologies while expanding our customer base and geographic presence.",
        "start_character": 7614,
        "end_character": 7792
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000046619-25-000082",
