        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As part of our growth strategy, we have continued to invest in our research and development activities.",
        "start_character": 32578,
        "end_character": 32681
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000046619-25-000082",
