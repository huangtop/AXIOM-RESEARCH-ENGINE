        "provenance_id": "provenance:SEC-FILING-0001193125-26-071441-541e1f41d653f278",
        "accession_number": "0001193125-26-071441",
        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "As the fresh packaged bread category has continued to experience weakness and is expected to remain challenging, we are conducting a comprehensive review to further optimize our brand portfolio.",
        "start_character": 7253,
        "end_character": 7447
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071441",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071441-541e1f41d653f278",
        "accession_number": "0001193125-26-071441",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "We believe having a well-diversified portfolio of brands allows us to be more competitive in the marketplace and appeal to a broader range of consumers.",
        "start_character": 16193,
        "end_character": 16345
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071441",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071441-541e1f41d653f278",
        "accession_number": "0001193125-26-071441",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "We often focus our marketing efforts on specific products and holidays, such as",
        "start_character": 20168,
        "end_character": 20247
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071441",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071441-541e1f41d653f278",
        "accession_number": "0001193125-26-071441",
        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "Additionally, we are continuing to optimize our distribution system by reducing network complexity through depot consolidation and reducing transport miles.",
        "start_character": 8520,
        "end_character": 8676
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071441",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071441-541e1f41d653f278",
        "accession_number": "0001193125-26-071441",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "Additionally, we have made and are continuing to make marketing investments to target e-commerce sales as consumers shift to more online shopping alternatives, such as grocery delivery sites, retailer websites and apps, among others.",
