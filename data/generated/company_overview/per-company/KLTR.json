    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "(“Kaltura,” “we,” “us,” or “our”), are a market-leading provider of video and rich media offerings for enterprises.",
        "start_character": 45,
        "end_character": 160
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As of December 31, 2025, we owned five registered trademarks in the United States and nine registered trademarks in foreign jurisdictions, including the European Union and Brazil, that we consider material to the marketing of our products, including the “Kaltura” name and logo.",
        "start_character": 109518,
        "end_character": 109796
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "At the same time, we are focused on attracting new customers by offering a broader and more modular set of solutions that can be adopted independently or as part of larger platform deployments.We believe the combination of our established enterprise offerings and newer AI-driven and conversational capabilities enables us to address both our core industries and select adjacent markets, as well as a broader range of customer sizes and adoption patterns.",
        "start_character": 67143,
        "end_character": 67598
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we are investing in developer-led growth (“DLG”) initiatives by expanding our APIs, SDKs, and developer tools, including planned offerings such as an Agentic Avatar SDK.",
        "start_character": 65599,
        "end_character": 65781
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Many customers already deploy Kaltura across multiple products, use cases, and departments, and we believe there are opportunities to increase adoption through upsell and cross-sell of new offerings, including AI-assisted content creation, conversational engagement, and journey-oriented analytics and orchestration.",
        "start_character": 66599,
        "end_character": 66915
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "To address data sovereignty, latency, and regulatory requirements, we offer multiple deployment options, including shared and dedicated software-as-a-service (“SaaS”) environments, regional deployments, and managed private or on-premises configurations.",
        "start_character": 89433,
        "end_character": 89686
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Unlike many point solutions that address only isolated aspects of the content lifecycle or user engagement, we believe our offerings are designed to operate cohesively across multiple use cases, buyer personas, and organizational functions.",
        "start_character": 100493,
        "end_character": 100733
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also distribute certain offerings through third-party cloud marketplaces and digital sales channels.",
        "start_character": 94847,
        "end_character": 94950
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also offer APIs, SDKs, and developer tools that enable customers, partners, independent software vendors (“ISVs”), system integrators (“SIs”), and developers to embed Kaltura’s video, rich media, and conversational capabilities into their own products, applications, and workflows.",
        "start_character": 105534,
        "end_character": 105818
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe these strategies position us to expand the scope of our offerings, broaden our go-to-market reach, and increase adoption across a wider range of customers, use cases, and industries.",
        "start_character": 67599,
        "end_character": 67792
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe this developer-led approach may allow Kaltura technology to power a growing number of third-party software products and experiences over time.",
        "start_character": 95728,
        "end_character": 95881
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018182",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018182-997b8a521fc2c68d",
        "accession_number": "0001628280-26-018182",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe this market segment spans both enterprise and mid-market customers and supports adoption models, ranging from enterprise-led deployments to product-led and developer-led implementations.",
        "start_character": 12169,
        "end_character": 12366
      }
    ]
  },
