        "statement": "At December 31, 2025, we employed approximately 100 engineers engaged in engineering and product development.",
        "start_character": 51167,
        "end_character": 51276
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001036262-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001036262-26-000012-6129e5e415bab37e",
