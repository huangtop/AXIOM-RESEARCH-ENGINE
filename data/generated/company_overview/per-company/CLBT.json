    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "For the purposes of the GDPR and the UK equivalent, we are not considered to be a controller regarding our customers' PII processed as part of the services provided to them and serve as a processor in a limited number of circumstances.",
        "start_character": 53370,
        "end_character": 53605
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we continue to evolve the mix of offerings used by customers and escalate prices in line with market conditions.",
        "start_character": 23379,
        "end_character": 23504
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In the private sector, we mainly sell to legal, compliance, internal investigation groups or eDiscovery groups within enterprises, and to service providers.",
        "start_character": 31331,
        "end_character": 31487
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also modify and enhance certain digital forensic solutions for our Public Sector Customers and develop new capabilities that address the specific needs of our enterprise customers and service providers, including capabilities aimed at helping them identify relevant data faster.",
        "start_character": 27469,
        "end_character": 27750
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We work closely with Amazon Web Services (AWS) to develop and scale our Cellebrite Cloud Platform, which we use to deliver our cloud-delivered solutions across the digital investigation end to end flow.",
        "start_character": 28023,
        "end_character": 28225
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As we drive greater adoption of our cloud-delivered solutions, we plan to continue making investments to further scale our Cellebrite Cloud Platform infrastructure, aiming to achieve compliance with various technical program requirements, standards and certifications for deployment of our cloud-delivered solutions at scale by federal and state government customers in the different regions we sell to.",
        "start_character": 28226,
        "end_character": 28629
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In December 2025, we acquired Corellium, a U.S.-based provider of Arm-based Virtualization Software that empowers developers and security experts to research, work, and test seamlessly on an ever-expanding range of devices, from mobile smartphones to IoT and industrialized systems.",
        "start_character": 57999,
        "end_character": 58281
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In smaller accounts, we typically sell to police chiefs, senior law enforcement professionals or those charged with overseeing the agency’s digital forensics labs.",
        "start_character": 30926,
        "end_character": 31089
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Various other countries in which we operate regulate the import of certain decryption and cryptographic solutions and technology, including import permitting and licensing requirements, and have enacted laws that could limit our ability to distribute our solutions or could limit our customers’ ability to implement our solutions in those countries.",
        "start_character": 48613,
        "end_character": 48962
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Virtually every jurisdiction in which we operate has established its own legal framework relating to privacy, data protection, and information security matters with which we and/or our customers must comply.",
        "start_character": 50910,
        "end_character": 51117
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also cross-sell and upsell our investigative solutions into the Investigative & Intelligence Units of our customers.",
        "start_character": 18934,
        "end_character": 19053
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013790",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013790-24db4d583e3ba7bb",
        "accession_number": "0001628280-26-013790",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We develop and implement marketing programs to educate customers and increase awareness about how they can maximize existing Cellebrite solutions utilizing relevant channels such as our online customer community, in-person, virtual and on-demand customer workshops, webinars, and other content hosted on our website such as videos, blogs, infographics and technical white papers.",
        "start_character": 32873,
        "end_character": 33252
      }
    ]
  },
