        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We generally provide industrial services directly to refineries and petrochemical plants.",
        "start_character": 1876,
        "end_character": 1965
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000105634-26-000025",
