        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are one of the largest specialty contractors in the United States and a leading provider of electrical and mechanical construction and facilities services, building services, and industrial services.",
        "start_character": 201,
        "end_character": 403
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000105634-26-000025",
