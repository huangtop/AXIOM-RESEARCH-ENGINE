        "end_character": 21412
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000105634-26-000025",
        "provenance_id": "provenance:SEC-FILING-0000105634-26-000025-25eb2d14cda68250",
        "accession_number": "0000105634-26-000025",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.86,
