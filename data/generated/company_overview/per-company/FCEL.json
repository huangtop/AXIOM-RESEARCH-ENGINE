    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As we continue our focus on business in international markets such as Europe and Asia, we plan to explore manufacturing and assembly opportunities in those markets to achieve more efficient product manufacturing and supply chain operations, as well as meet the increasing government requirements for the inclusion of locally sourced content and components in order to benefit from enhanced clean energy investment incentives.",
        "start_character": 75852,
        "end_character": 76277
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Beginning in fiscal year 2024, we began entering into LTSAs with certain customers in South Korea, pursuant to which we agreed to provide replacement modules and to service these customers’ facilities after they transitioned away from their prior service providers.",
        "start_character": 80971,
        "end_character": 81236
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to our existing core molten carbonate-based commercial products, we engage strategically in research and development, both company-funded and carried out under grants from and commercial agreements with private companies and various government agencies through our Advanced Technologies programs.",
        "start_character": 20084,
        "end_character": 20392
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to our service agreements, we provide a warranty for our products against manufacturing or performance defects for a specific period of time.",
        "start_character": 82475,
        "end_character": 82628
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to research and development performed under research contracts, including as described under the heading “Advanced Technologies Programs” above, we also fund our own research and development activities to (i) advance our core carbonate portfolio, including the development of carbon recovery and capture applications, (ii) advance the development of our solid oxide electrolysis cell and module technology with the goal of supporting growing demand for applications in the hydrogen generation market segment, and (iii) support our generation operating portfolio with product enhancements and improvements.",
        "start_character": 65670,
        "end_character": 66287
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, as part of these restructuring plans, we ceased development of the solid oxide power generation platform and began focusing on demonstrating the capabilities of our solid oxide electrolysis platform, for which we expect to seek partnerships for product commercialization and manufacturing.",
        "start_character": 35239,
        "end_character": 35541
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The service aspects of our business model provide a recurring and predictable revenue stream for the Company.",
        "start_character": 81601,
        "end_character": 81710
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "These incentives are intended to accelerate deployment of carbon capture solutions and may benefit applications we are developing, including those in collaboration with ExxonMobil’s Low Carbon Solutions business.",
        "start_character": 85602,
        "end_character": 85814
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through fiscal year 2024, we invested in product development and manufacturing scale up for two solid oxide platforms: power generation and electrolysis.",
        "start_character": 67699,
        "end_character": 67852
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Under the typical provisions of both our LTSAs and PPAs, we provide services to monitor, operate, service and maintain our systems to meet specified performance levels.",
        "start_character": 81315,
        "end_character": 81483
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also develop projects and sell equipment directly to customers, providing a complete solution of engineering, installing, and servicing the fuel cell power plant under an engineering, procurement, and construction agreement (“EPC”) and a long-term maintenance and service agreement.",
        "start_character": 37468,
        "end_character": 37753
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-122302",
        "provenance_id": "provenance:SEC-FILING-0001104659-25-122302-bdd9f001fbd7cad9",
        "accession_number": "0001104659-25-122302",
        "filing_date": "2025-12-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are also in the process of performing life cycle analyses on our products, as well as our production and office locations, and developing a roadmap to net zero carbon emissions.",
        "start_character": 93467,
        "end_character": 93647
      }
    ]
  },
