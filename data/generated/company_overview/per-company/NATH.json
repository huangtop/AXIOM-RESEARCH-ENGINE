        "filing_date": "2026-06-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "A franchisee who desires to open multiple locations in a specific territory within the United States may enter into an area development agreement under which we would expect to receive an area development fee based upon the number of proposed locations which the franchisee is authorized to open.",
        "start_character": 24498,
        "end_character": 24794
      },
      {
