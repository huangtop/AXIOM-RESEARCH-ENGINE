    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As part of our broad manufacturing strategy to expedite the manufacturing of our product candidates and minimize manufacturing risk, we currently have established relationships with CDMOs for the manufacturing of our drug substance or product candidates.",
        "start_character": 40836,
        "end_character": 41090
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "However, if we enter into any transaction granting rights to the inventions or sell products created as a result of a collaboration with a third party, we have a choice to pay a share of the resulting revenue instead of royalties from such sales.",
        "start_character": 38448,
        "end_character": 38694
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In such case, we will no longer conduct development or commercialization of that product, the Company will receive tiered royalties on net sales in the United States instead of a share of profits or losses, and certain milestones will be reduced.",
        "start_character": 33288,
        "end_character": 33534
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Until GSK has fully assumed such responsibility, and for our other product candidates, we rely, and expect to continue to rely, on third-party contract development and manufacturing organizations (CDMOs) for the production of our",
        "start_character": 40533,
        "end_character": 40762
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are advancing a portfolio of programs focused on genetically validated targets, supported by our expertise in drug development, protein engineering, and antibody discovery.",
        "start_character": 557,
        "end_character": 732
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We complement our antibody discovery and protein engineering capabilities with other modalities, such as nucleic acids, which we may incorporate into our product candidate design.",
        "start_character": 14861,
        "end_character": 15040
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We do not currently have the infrastructure or internal capability to manufacture our product candidates for use in clinical trials and commercialization.",
        "start_character": 40214,
        "end_character": 40368
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We expect to continue to rely on third-party manufacturers or our collaboration partners for the commercial supply of any of our product candidates for which we obtain marketing approval.",
        "start_character": 41231,
        "end_character": 41418
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We further intend to leverage our clinical development and trial execution expertise to advance new product candidates expeditiously through first-in-human and proof-of-concept studies to derisk the next stages of development in a data-driven manner.",
        "start_character": 10904,
        "end_character": 11154
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We may opt out of the sharing of development costs and of profit and losses from commercialization in the United States on a product-by-product basis.",
        "start_character": 33137,
        "end_character": 33287
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We must manufacture our product candidates for clinical trial use in compliance with current good manufacturing practices (cGMP) regulations.",
        "start_character": 39166,
        "end_character": 39307
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-071593",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-071593-dbb42b0d6e185787",
        "accession_number": "0001193125-26-071593",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We use multiple approaches to select targets that we believe will lead to efficient development of product candidates with optimized therapeutic potential, based on genetic and mechanistic evidence.",
        "start_character": 12561,
        "end_character": 12759
      }
    ]
