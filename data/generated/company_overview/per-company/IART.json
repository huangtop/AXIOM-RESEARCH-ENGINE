        "provenance_id": "provenance:SEC-FILING-0000917520-26-000011-cfc62c8d0a5b8d96",
        "accession_number": "0000917520-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through various Business Resource Groups (“BRGs”), leadership councils and external partnerships, we provide opportunities for colleagues to contribute to our culture, develop professionally and provide feedback to our executive team.",
        "start_character": 89360,
        "end_character": 89594
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000917520-26-000011",
        "provenance_id": "provenance:SEC-FILING-0000917520-26-000011-cfc62c8d0a5b8d96",
        "accession_number": "0000917520-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We apply our core competency in regenerative technology to innovate products for neurosurgical, wound applications, plastic surgery, and reconstructive surgery and we have extensive R&D development programs for our core platforms of electromechanical technologies.",
