        "accession_number": "0000917520-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to our need to comply with such regulations in connection with our direct activities, we also sell and provide goods, technology and services to agents, representatives and distributors who may export such items to customers and end-users.",
