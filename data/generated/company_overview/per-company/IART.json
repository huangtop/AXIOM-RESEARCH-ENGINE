        "provenance_id": "provenance:SEC-FILING-0000917520-26-000011-cfc62c8d0a5b8d96",
        "accession_number": "0000917520-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Over the years, we have significantly expanded our global footprint by investing in our commercial and manufacturing operations, as well as introducing new products.",
        "start_character": 11250,
        "end_character": 11415
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000917520-26-000011",
