        "accession_number": "0000917520-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In particular, the collagen used in the products that we manufacture is derived from fetal bovine dermis from the U.S.",
