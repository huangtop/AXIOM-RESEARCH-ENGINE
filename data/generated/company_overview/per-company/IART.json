        "provenance_id": "provenance:SEC-FILING-0000917520-26-000011-cfc62c8d0a5b8d96",
        "accession_number": "0000917520-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through leadership appointments and the development of a comprehensive plan to establish a robust end-to-end supply chain, we hope to enhance our supply chain capabilities and overall product available and operational reliability and resiliency.",
        "start_character": 20113,
        "end_character": 20358
      },
      {
