        "accession_number": "0000917520-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Such reforms could have an adverse effect on anticipated revenues from product that we may successfully develop and for which we may obtain marketing approval and may affect our overall financial condition and ability to develop product.",
