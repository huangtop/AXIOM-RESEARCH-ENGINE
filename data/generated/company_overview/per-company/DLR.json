        "accession_number": "0001104659-26-015365",
        "filing_date": "2026-02-13",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Through investments and strategic partnerships, we have significantly expanded our capabilities as a leading provider of interconnection and cloud-enablement services globally.",
        "start_character": 16368,
        "end_character": 16544
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-015365",
