        "end_character": 62552
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-002657",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-002657-3bc10f5a0b1392e0",
        "accession_number": "0001477932-26-002657",
        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We strategically monitor developments in the container and tanker industries on a regular basis and, subject to market demand, will seek to enter into shorter or longer time or bareboat charters according to prevailing market conditions.",
