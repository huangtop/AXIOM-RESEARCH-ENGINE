        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "If we sell any vessel with the relevant charters attached, the sale price may be affected by the relationship of the charter rate to the prevailing market rate for a comparable charter with the same terms.",
        "start_character": 19820,
        "end_character": 20025
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-002657",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-002657-3bc10f5a0b1392e0",
        "accession_number": "0001477932-26-002657",
        "filing_date": "2026-04-30",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In 2025, our vessels did not complete any port call in Iran, and we are not aware of any vessels owned or controlled by our affiliates completing any port call in Iran or other jurisdictions required to be disclosed pursuant to Section 13(r) of the Exchange Act.",
        "start_character": 46545,
        "end_character": 46807
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-002657",
