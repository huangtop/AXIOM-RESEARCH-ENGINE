        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "For instance, leveraging our digitalized KYC/KYA/KYP management, we are able to accurately match our products with a suitable client base, and therefore enhance our operating efficiency.",
        "start_character": 70316,
        "end_character": 70502
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050892",
