        "provenance_id": "provenance:SEC-FILING-0001082554-26-000006-976031716b5fa171",
        "accession_number": "0001082554-26-000006",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Under this agreement, we sell Unituxin to Cencora at a transfer price that we establish, and we pay Cencora fees for services provided in connection with the distribution and support of Unituxin.",
        "start_character": 55074,
        "end_character": 55269
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001082554-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001082554-26-000006-976031716b5fa171",
        "accession_number": "0001082554-26-000006",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also engage in a variety of additional research and development efforts, including efforts to develop new and improved devices to deliver our current commercial products and other small molecule therapies, some of which are intended for once-daily or as-needed administration, for a variety of pulmonary indications.",
        "start_character": 27392,
        "end_character": 27711
