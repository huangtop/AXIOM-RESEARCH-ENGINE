        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2004, the European Commission designated Nebulized Tyvaso an orphan medicinal product for the treatment of both PAH and chronic thromboembolic pulmonary hypertension, which would confer a ten-year exclusivity period commencing if and when we obtain marketing approval.",
        "start_character": 65767,
        "end_character": 66038
