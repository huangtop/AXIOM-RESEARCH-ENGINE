      {
        "business_evidence_id": "business-evidence:SEC-0001082554-26-000006",
        "provenance_id": "provenance:SEC-FILING-0001082554-26-000006-976031716b5fa171",
        "accession_number": "0001082554-26-000006",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also have products in development for PAH, idiopathic pulmonary fibrosis (IPF), and progressive pulmonary fibrosis (PPF), and other diseases with unmet medical needs.",
