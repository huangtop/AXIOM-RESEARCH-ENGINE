        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In the United States, we also market and sell an oncology product, Unituxin® (dinutuximab) Injection (Unituxin), which is approved by the FDA for the treatment of high-risk neuroblastoma.",
        "start_character": 1562,
        "end_character": 1749
