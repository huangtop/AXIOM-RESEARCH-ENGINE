        "accession_number": "0001104659-25-091644",
        "filing_date": "2025-09-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are focused on rapidly developing an ecosystem of new interactive app-like components for researchers that will deliver time saving efficiencies in core research workflows and knowledge creation processes.",
