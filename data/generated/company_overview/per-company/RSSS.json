        "confidence": 0.96,
        "statement": "We seek to grow revenue through product differentiation, and the development of new products that are attractive to new and existing customers.",
        "start_character": 15762,
        "end_character": 15905
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-25-091644",
