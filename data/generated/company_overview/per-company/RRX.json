        "filing_date": "2026-02-20",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We believe that sustainable business practices strengthen our Company by helping us better serve our customers, delivering higher returns for our shareholders, creating more opportunities for our associates, and making meaningful contributions to the communities in which we operate.",
