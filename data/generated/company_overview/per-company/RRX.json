        "provenance_id": "provenance:SEC-FILING-0000082811-26-000054-76d5856a4c02b7c9",
        "accession_number": "0000082811-26-000054",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe the key driver of our innovation strategy is the development of products that include energy efficiency, embedded intelligence and variable speed technology solutions.",
