    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As each business segment faces a unique set of challenges, we developed a commerce platform on top of which we offer tailored products and solutions to address specific business needs.",
        "start_character": 30675,
        "end_character": 30859
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we provide a range of complementary services to meet user needs, including our App Market, which enables registered users to easily install and uninstall a variety of free and paid web applications developed by us or identified and selected through third-party developers based on user demands.",
        "start_character": 9373,
        "end_character": 9680
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Since our founding, we have developed and launched multiple innovative products, services, and business solutions that empower any business, organization or brand worldwide to create, manage and grow a fully integrated and dynamic digital presence.",
        "start_character": 487,
        "end_character": 735
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer a variety of additional products and services to further complement and enhance our users’ business or branding needs, most notably Payments by Wix, a payment platform that helps our users receive payments from their customers through their Wix website, and Paid Ad Campaigns, which allows businesses to run dynamic online ad campaigns on online ad platforms.",
        "start_character": 8754,
        "end_character": 9127
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that the key competitive factors in our market include, simplicity and ease of use, functionality, product breadth, integration of multiple solutions, price, design quality, global scope, security and reliability, and brand recognition and reputation.",
        "start_character": 70323,
        "end_character": 70585
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that we compete favorably on these factors because of the unique combination of our comprehensive suite of design and digital presence software, advanced technology and product integration, efficiencies in operations, brand recognition and marketing expertise, longstanding customer, designer and developer relationships, large user base, and track record of successfully attracting new users to our website and products.",
        "start_character": 70586,
        "end_character": 71018
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have developed these software applications for businesses in specific verticals, including retail and online stores, services, event planners and management, hotel and property management, fitness, music, photography and restaurants, among other verticals.",
        "start_character": 8301,
        "end_character": 8560
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have since developed and launched multiple products and solutions leveraging AI Technologies.",
        "start_character": 40022,
        "end_character": 40118
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We invest in research and development to enhance and expand our product and service offerings, tailor our marketing efforts, and expand our registered user base.",
        "start_character": 65465,
        "end_character": 65626
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We mostly use third-party cloud services to run our research and development activities (such as Amazon, Google, GitHub and BuildKite) and to operate our office applications.",
        "start_character": 63830,
        "end_character": 64004
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer our solutions through a freemium SaaS business model (free and premium services), and as of December 31, 2025, we had approximately 6.1 million premium subscriptions.",
        "start_character": 3935,
        "end_character": 4110
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015222",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015222-47cf5674229427a8",
        "accession_number": "0001628280-26-015222",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell Google’s Google Workspace application as an integrated solution, which allows our users to create a personalized Gmail email address using their Wix-connected domain name, to enable them to send professional emails from their business address, create group mailing lists for sales, support, email marketing and more, and access other related features through their Wix’s site management dashboard.",
        "start_character": 27969,
        "end_character": 28374
      }
    ]
