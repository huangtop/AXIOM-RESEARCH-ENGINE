    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "During the term of the ALI Agreement, to the extent we are required to make any payments to MD Anderson pursuant to our license agreements with MD Anderson, whether a milestone or royalty payment, as a result of the research and development or sale of a sublicensed product, ALI shall be required to advance or reimburse us such payments.",
        "start_character": 108384,
        "end_character": 108722
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For our lead product candidate, Annamycin, we currently utilize a single contract manufacturer to supply API and a separate single contract manufacturer for final drug product formulation.",
        "start_character": 97027,
        "end_character": 97215
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Further, on behalf of Moleculin, LLC, we entered into a co-development agreement with Houston Pharmaceuticals, Inc., which culminated with the merger of Moleculin, LLC into MBI coincident with our initial public offering allowing us to gain control of the WP1066 Portfolio.",
        "start_character": 122422,
        "end_character": 122695
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Given the limited number of contract manufacturers that operate under cGMP regulations and are capable of manufacturing our product candidates, we may face competition for manufacturing capacity.",
        "start_character": 98393,
        "end_character": 98588
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Government authorities at the federal, state and local level in the US, and in analogous levels in other countries extensively regulate products such as those we are developing, including the conditions under which such products are approved for use, their safety and effectiveness, and how they are developed, tested, manufactured, packaged and labeled, promoted, stored and distributed.",
        "start_character": 130371,
        "end_character": 130759
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The pharmaceutical drug product candidates that we develop must be approved by the FDA before they may be marketed and commercially distributed in the US, and by regulators in other countries before being marketed and commercially distributed there.",
        "start_character": 130760,
        "end_character": 131009
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "There are a number of established therapies that may be considered competitive for the cancer indications for which we intend to develop our lead product candidate, Annamycin.",
        "start_character": 125179,
        "end_character": 125354
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Under the ALI Agreement, we granted ALI a worldwide royalty-bearing, exclusive license to research, develop, manufacture, have manufactured, use, import, offer to sell and/or sell products in the field of non-human animals under the licensed intellectual property.",
        "start_character": 107788,
        "end_character": 108052
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We do not own or operate manufacturing facilities for the production of active pharmaceutical ingredients (API) or final drug products for our product candidates.",
        "start_character": 96664,
        "end_character": 96826
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We expect to continue to rely on third-party contract manufacturers to produce API and final drug product in quantities sufficient to support our clinical development programs and, if our product candidates receive regulatory approval, commercial supply.",
        "start_character": 97355,
        "end_character": 97609
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have elected to rely on third-party contract manufacturers for all aspects of API manufacturing and drug product formulation, both for clinical development and, if approved, commercial production.",
        "start_character": 96827,
        "end_character": 97026
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-008841",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-008841-507636f8e2f49f7d",
        "accession_number": "0001437749-26-008841",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have entered into manufacturing agreements with these third-party manufacturers to supply API and drug product for our clinical trials.",
        "start_character": 97216,
        "end_character": 97354
