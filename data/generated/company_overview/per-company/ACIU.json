        "accession_number": "0001104659-26-027342",
        "filing_date": "2026-03-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Given the seriousness of AD and public pressure for new therapeutics, we consider regulatory agencies to be important stakeholders in our product development strategies.",
        "start_character": 117409,
        "end_character": 117578
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-027342",
