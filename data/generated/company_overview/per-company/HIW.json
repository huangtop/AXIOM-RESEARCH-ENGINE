        "accession_number": "0000921082-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Unlike REITs that outsource the leasing, management, maintenance and/or customer service of their properties entirely to third parties, we are a fully-integrated REIT that generally staffs the leasing, management, maintenance and customer service of our own portfolio.",
        "start_character": 8224,
        "end_character": 8492
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000921082-26-000005",
