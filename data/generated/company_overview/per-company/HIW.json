        "accession_number": "0000921082-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "As a result, we operate division offices in Atlanta, Nashville, Orlando, Raleigh and Tampa, which are led by seasoned real estate professionals with significant commercial real estate experience managing across multiple economic cycles.",
        "start_character": 7581,
        "end_character": 7817
      },
      {
