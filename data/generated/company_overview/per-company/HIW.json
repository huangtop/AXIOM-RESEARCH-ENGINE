        "filing_date": "2026-02-10",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Our balance sheet also allows us to proactively assure our existing and prospective customers that we are able to fund tenant improvements and maintain our properties in good condition while retaining the flexibility to capitalize on favorable development and acquisition opportunities as they arise.",
        "start_character": 4825,
        "end_character": 5125
