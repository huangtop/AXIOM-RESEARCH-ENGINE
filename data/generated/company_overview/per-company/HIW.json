        "accession_number": "0000921082-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "•we are able to provide our customers with more cost-effective services such as build-to-suit construction and space modification, including tenant improvements and expansions;",
        "start_character": 8760,
        "end_character": 8936
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000921082-26-000005",
