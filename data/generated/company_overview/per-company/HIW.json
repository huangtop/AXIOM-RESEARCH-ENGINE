        "accession_number": "0000921082-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are subject to laws, rules and regulations of the United States and the states and local municipalities in which we operate, including laws and regulations relating to environmental protection and human health and safety.",
        "start_character": 6756,
        "end_character": 6980
      },
      {
