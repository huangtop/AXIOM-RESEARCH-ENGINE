        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Primarily because many of our employees are involved with the management and maintenance of our own portfolio, we have robust health and safety processes and training protocols designed to mitigate workplace incidents, risks and hazards.",
        "start_character": 18932,
        "end_character": 19169
      },
      {
