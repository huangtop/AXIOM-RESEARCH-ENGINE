        "end_character": 35892
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-282941",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-282941-4b9f9ad58f385d86",
        "accession_number": "0001193125-26-282941",
        "filing_date": "2026-06-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide inspection and aftermarket services such as API/premium thread inspection, drill pipe repairs, Non-Destructive Testing (NDT) and load testing and other general ancillary services such as inspections, general machining, welding and testing, which forms a small part of the Company’s business.",
        "start_character": 25575,
        "end_character": 25882
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-282941",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-282941-4b9f9ad58f385d86",
        "accession_number": "0001193125-26-282941",
        "filing_date": "2026-06-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also seek to provide high-quality customer service through continued warehouse optimization.",
        "start_character": 44204,
        "end_character": 44299
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-282941",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-282941-4b9f9ad58f385d86",
        "accession_number": "0001193125-26-282941",
        "filing_date": "2026-06-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a growth-oriented manufacturer of surface wellhead systems, or SWS, and oil country tubular goods, or OCTG products used in the oil and gas industry.",
        "start_character": 3685,
        "end_character": 3841
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-282941",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-282941-4b9f9ad58f385d86",
