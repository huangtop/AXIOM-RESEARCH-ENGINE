    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Government authorities in the United States, at the federal, state, and local level, and other countries extensively regulate, among other things, the research, development, testing, manufacture, quality control, import, export, safety, effectiveness, approval, labeling, packaging, storage, record-keeping, promotion, advertising, distribution, marketing and post-approval activities of drug and biological product candidates, such as those we are developing.",
        "start_character": 76472,
        "end_character": 76932
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we may face competition from companies developing product candidates that are based on synthetic lethality in cancer.",
        "start_character": 59706,
        "end_character": 59836
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Most companion diagnostics for oncology product candidates, such as those we are developing, utilize the PMA pathway.",
        "start_character": 112030,
        "end_character": 112147
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For BBI-940, we are unaware of any therapeutic programs developing compounds directed against the Kinesin target.",
        "start_character": 61297,
        "end_character": 61410
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In the POTENTIATE trial, we used an internally developed ecDNA diagnostic clinical trial assay, which we refer to as ECHO (ecDNA Harboring Oncogenes), to detect ecDNA in patient tumor samples by analyzing genomic data from routine next generation sequencing (NGS) tests.",
        "start_character": 4538,
        "end_character": 4808
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Our ecDTx pipeline currently consists of three clinical stage small molecules, one of which, BBI-940, we have prioritized for ongoing development.",
        "start_character": 40491,
        "end_character": 40637
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Through Spyglass, we have developed a sophisticated understanding of amplification biology, including ecDNA biology, and key cellular mechanisms that facilitate tumor growth and development of resistance to therapeutic treatments.",
        "start_character": 37140,
        "end_character": 37370
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Through extensive testing in preclinical cancer models with ecDNA-enabled oncogene amplifications, we identified what we believe to be an optimal Kinesin degrader profile for targeting ecDNA-positive tumors and designed our lead ecDTx, BBI-940, accordingly.",
        "start_character": 44911,
        "end_character": 45168
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To our knowledge, we are the first company developing new cancer medicines directed at amplification biology and ecDNA function and the only company to date to bring an ecDTx into the clinic.",
        "start_character": 6445,
        "end_character": 6636
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Using our proprietary Spyglass platform, we identify targets essential for ecDNA functionality in oncogene amplified cancer cells, then design and develop small molecule drugs called ecDNA-directed therapeutic candidates (ecDTx) to inhibit those targets, with the aim to prevent cancer cells from using chromosomal instability (CIN) and ecDNA amplification biology to grow, adapt, and become resistant to existing therapies.",
        "start_character": 1451,
        "end_character": 1875
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also plan to continue to evaluate additional manufacturers to build redundancies into our supply chain.",
        "start_character": 75145,
        "end_character": 75251
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-097543",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-097543-d82344ee15406345",
        "accession_number": "0001193125-26-097543",
        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are developing our ecDTx to be administered as a single agent and in combination with other therapies.",
        "start_character": 32787,
        "end_character": 32892
      }
    ]
  },
