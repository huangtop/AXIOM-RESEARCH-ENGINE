        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We currently operate infrastructure facilities and service centers to support our infrastructure operations in the southwestern and midwestern portions of the United States.",
        "start_character": 25872,
        "end_character": 26045
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015693",
