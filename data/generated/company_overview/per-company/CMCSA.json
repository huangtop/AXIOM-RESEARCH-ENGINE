    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Additionally, we offer technology, tools, data-driven services and marketplace solutions to customers in the media industry to facilitate effective engagement of advertisers with their target audiences.",
        "start_character": 9960,
        "end_character": 10162
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As part of our distribution agreements with domestic cable networks, we generally receive an allocation of scheduled advertising time that our advertising business sells, and we also sell advertising on our Sky-branded entertainment television networks and on our digital platforms.",
        "start_character": 9534,
        "end_character": 9816
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As part of our low-income broadband adoption program, we offer qualifying domestic customers broadband services at discounted rates through our Internet Essentials and Internet Essentials Plus services, with downstream speeds of up to 75 and 100 megabits per second, respectively.",
        "start_character": 4105,
        "end_character": 4385
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Other companies and municipalities have launched fiber-based or newer satellite-based broadband technologies that provide services in certain areas in which we operate.",
        "start_character": 21257,
        "end_character": 21425
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our advertising sales are affected by the prices we charge for each advertising unit, which are generally based on the size and demographics of our viewing audiences, audience ratings on our television networks, the number of advertising units we can place in our programming and on our digital properties, and our ability to sell advertising across our television and streaming business.",
        "start_character": 26770,
        "end_character": 27158
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "These services are primarily provided to Fortune 1000 companies and other large enterprises with multiple locations both within and outside of our distribution footprint, where we provide coverage outside of our service areas through agreements with other companies to use their networks.",
        "start_character": 12376,
        "end_character": 12664
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also compete with companies offering technology, tools and other services to customers in the media industry.",
        "start_character": 24513,
        "end_character": 24625
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also license our technology platforms to other multichannel video providers and distribute certain of our Sky-branded entertainment television networks to third-party video service providers.",
        "start_character": 10354,
        "end_character": 10548
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also license the right to use the Universal Studios brand name and other intellectual property and provide other services to third parties, including the party that owns and operates the Universal Studios Singapore theme park on Sentosa Island, Singapore.",
        "start_character": 44427,
        "end_character": 44685
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer certain bundled DTC streaming services to our domestic and international broadband customers.",
        "start_character": 7412,
        "end_character": 7519
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also offer international and domestic DTC streaming services marketed under the NOW brand, which provide video content over the internet and do not require a set-top box.",
        "start_character": 8861,
        "end_character": 9034
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-004994",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-004994-57d7d20a81c9f7af",
        "accession_number": "0001628280-26-004994",
        "filing_date": "2026-02-03",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer prepaid domestic broadband services with downstream speeds of up to 200 megabits per second marketed under the NOW brand and offer monthly access to our network of Wi-Fi hotspots.",
        "start_character": 4386,
        "end_character": 4579
      }
