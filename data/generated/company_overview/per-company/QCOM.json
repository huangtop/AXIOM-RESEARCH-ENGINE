        "accession_number": "0000804328-25-000085",
        "filing_date": "2025-11-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We innovate and collaborate across many ecosystems, including with manufacturers, operators, developers, system integrators, infrastructure vendors, cloud providers, test tool vendors, service providers, governments and industry standards organizations, to enable next-generation digital transformation.",
