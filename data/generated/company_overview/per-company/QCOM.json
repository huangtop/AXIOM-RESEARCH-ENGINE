        "filing_date": "2025-11-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We develop innovations that are integrated into our product portfolio to expand the opportunity for wireless communications and enhance the value of our products and services.",
        "start_character": 50188,
        "end_character": 50363
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000804328-25-000085",
