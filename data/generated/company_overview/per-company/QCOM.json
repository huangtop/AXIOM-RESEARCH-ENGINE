        "end_character": 2837
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000804328-25-000085",
        "provenance_id": "provenance:SEC-FILING-0000804328-25-000085-da5ced9e61dfdd63",
        "accession_number": "0000804328-25-000085",
        "filing_date": "2025-11-05",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "By licensing or otherwise providing rights to use our patents to a wide range of equipment manufacturers, we are supporting the global rollout and availability of 5G technology.",
