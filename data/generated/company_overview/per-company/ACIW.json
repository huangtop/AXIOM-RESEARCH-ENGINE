        "accession_number": "0000935036-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To ensure the highest software quality, we implement rigorous testing and quality assurance processes throughout the development lifecycle.",
        "start_character": 24060,
        "end_character": 24199
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000935036-26-000011",
        "provenance_id": "provenance:SEC-FILING-0000935036-26-000011-1b730c85f4169102",
