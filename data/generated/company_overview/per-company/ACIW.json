        "end_character": 27537
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000935036-26-000011",
        "provenance_id": "provenance:SEC-FILING-0000935036-26-000011-1b730c85f4169102",
        "accession_number": "0000935036-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To ensure we are building for the market, we facilitate user group meetings to help us determine our product and solution strategy, development plans, and aspects of customer support.",
        "start_character": 22607,
        "end_character": 22790
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000935036-26-000011",
        "provenance_id": "provenance:SEC-FILING-0000935036-26-000011-1b730c85f4169102",
        "accession_number": "0000935036-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also believe that our financial performance has been attributable to our ability to design and deliver quality products and solutions coupled with our ability to identify and successfully complete and integrate strategic acquisitions.",
        "start_character": 2002,
        "end_character": 2239
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000935036-26-000011",
        "provenance_id": "provenance:SEC-FILING-0000935036-26-000011-1b730c85f4169102",
        "accession_number": "0000935036-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide advanced fraud protection services to our biller customers, leveraging our proven AI, human, and data analytics capabilities.",
        "start_character": 5766,
        "end_character": 5907
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000935036-26-000011",
        "provenance_id": "provenance:SEC-FILING-0000935036-26-000011-1b730c85f4169102",
        "accession_number": "0000935036-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are typically responsible for the sales and marketing of the vendors' products, and agreements with these vendors generally provide for revenue sharing based on relative responsibilities.",
        "start_character": 26396,
        "end_character": 26586
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000935036-26-000011",
        "provenance_id": "provenance:SEC-FILING-0000935036-26-000011-1b730c85f4169102",
        "accession_number": "0000935036-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We offer our customers a wide range of professional services, including consultation, analysis, design, development, implementation, integration, testing, project management, and education services.",
        "start_character": 17501,
        "end_character": 17699
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000935036-26-000011",
        "provenance_id": "provenance:SEC-FILING-0000935036-26-000011-1b730c85f4169102",
        "accession_number": "0000935036-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "However, we typically are not involved in the development process used by these third parties.",
        "start_character": 27538,
        "end_character": 27632
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000935036-26-000011",
