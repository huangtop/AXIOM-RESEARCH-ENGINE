    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Although we sell products to, and are paid by distributors and contract manufacturers, we refer to the end customer as our customer.",
        "start_character": 13730,
        "end_character": 13862
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Disruptions to our business and supply chain (and the business and supply chains of our customers) could cause significant delays in shipments of our products until we are able to shift our manufacturing, assembling, or testing from the affected subcontractor to another third-party vendor.",
        "start_character": 31603,
        "end_character": 31893
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also pursue targeted advertising in key trade publications, and we have a cooperative marketing program that allows our distributors and representatives to promote our products to their local markets in conjunction with their own advertising activities.",
        "start_character": 15342,
        "end_character": 15598
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that our future success depends on retaining the services of our key personnel, developing their successors and properly managing the transition of key roles when they occur.",
        "start_character": 41362,
        "end_character": 41547
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We believe that we are competitive with respect to these factors, particularly because our ICs typically are smaller in size, are highly integrated, achieve high-performance specifications at lower price points than many competitive products, and are manufactured in standard CMOS, which generally enables us to supply them on a relatively rapid basis to customers to meet their product introduction schedules.",
        "start_character": 33047,
        "end_character": 33457
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We design smart, energy-efficient products that enable battery-powered, ultra-low-power wireless communications for our customers across industries where technology can meaningfully influence environmental and societal outcomes across home, medical, industrial, and commercial environments, including air pollution and waste management monitoring, water integrity, residential irrigation monitoring, street lighting networks, advanced metering infrastructure and green energy solutions.",
        "start_character": 43170,
        "end_character": 43656
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have built a leading wireless development platform and product portfolio for the IoT based on Bluetooth®, sub-GHz proprietary technologies, Wi - SUN, Thread, Wi-Fi®, Zigbee®, and Z-Wave®.",
        "start_character": 6335,
        "end_character": 6525
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have relationships with many independent sales representatives and distributors worldwide whom we have selected based on their understanding of the mixed-signal marketplace and their ability to provide effective field sales applications support for our products.",
        "start_character": 14662,
        "end_character": 14927
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We make it easy for developers to solve complex wireless challenges throughout the product lifecycle and get to market quickly with innovative solutions that transform industries, grow economies, and improve lives.",
        "start_character": 354,
        "end_character": 568
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, we strive to design substantially all our ICs in standard CMOS processes.",
        "start_character": 20419,
        "end_character": 20506
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a fabless semiconductor company, we conduct IC design and development in our facilities and electronically transfer our proprietary IC designs to third-party semiconductor fabricators who process silicon wafers to produce the ICs that we design.",
        "start_character": 29567,
        "end_character": 29815
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001038074-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001038074-26-000005-d2ece380c2a3dc2b",
        "accession_number": "0001038074-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to developing specific security hardware and software capabilities, we also focus design and engineering efforts on technologies that simplify and accelerate adoption by customers of security features engineered into our silicon chips.",
        "start_character": 27526,
        "end_character": 27773
      }
    ]
  },
