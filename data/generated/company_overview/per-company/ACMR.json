    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As of December 31, 2025, we had 2,513 full-time equivalent employees, of whom 196 were in administration, 365 were in manufacturing, 1,228 were in research and development, and 724 were in sales and marketing and customer services.",
        "start_character": 27290,
        "end_character": 27521
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Based on requests from customers, we developed and incorporated the special function of chamber auto-clean module into the Ultra C Coater, which further differentiates it from other products in the market by reducing or eliminating the cleaning of shroud in the coater which increases the tool’s continuous production time.",
        "start_character": 12315,
        "end_character": 12638
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We conduct a substantial majority of our product development, manufacturing, support and services in mainland China, with additional product development and subsystem production in Korea.",
        "start_character": 16974,
        "end_character": 17161
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We develop and deliver a broad portfolio of differentiated semiconductor process equipment that spans front-end wafer fabrication through advanced packaging.",
        "start_character": 4831,
        "end_character": 4988
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have been investing in the development of new products for several adjacent front-end process steps—including furnace, PECVD, and track—leveraging common design principles, modular platforms, and deep process integration.This multi-product approach enables us to support customers across a larger portion of the manufacturing flow, deepen technical engagement, and is intended to create additional growth opportunities over time.",
        "start_character": 5309,
        "end_character": 5741
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have designed these products for use in fabricating foundry, logic and memory chips, including dynamic random-access memory, or DRAM, and 3D NAND-flash memory chips.",
        "start_character": 947,
        "end_character": 1115
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have focused our selling efforts on establishing a referenceable base of leading foundry, logic and memory chip makers, whose use of our products can influence decisions by other manufacturers.",
        "start_character": 3077,
        "end_character": 3273
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We market and sell our products worldwide using a combination of our direct sales force and third-party representatives.",
        "start_character": 14971,
        "end_character": 15091
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We select these independent representatives based on their ability to provide effective field sales, marketing forecast and technical requirement updates for our products.",
        "start_character": 15810,
        "end_character": 15981
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Accordingly, we may experience difficulty in selling to a given manufacturer if that manufacturer has qualified a competitor’s equipment.",
        "start_character": 26944,
        "end_character": 27081
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For this reason, we devote significant financial and personnel resources to research and development.",
        "start_character": 18458,
        "end_character": 18559
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-013231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-013231-8af0db1e681c47db",
        "accession_number": "0001628280-26-013231",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "If, however, that cleaning equipment constrains chip yield, we expect, based on our experience to date, that the manufacturer will evaluate implementing new equipment that cleans more effectively.",
        "start_character": 27082,
        "end_character": 27278
      }
    ]
