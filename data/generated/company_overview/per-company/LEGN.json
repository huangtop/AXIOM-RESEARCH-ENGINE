        "accession_number": "0001801198-26-000008",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our competitors also may obtain FDA or other regulatory approval for their products more rapidly than we may obtain approval for ours, which could result in our competitors establishing a strong market position before we are able to enter the market or make our development more complicated.",
        "start_character": 117493,
        "end_character": 117784
      },
      {
