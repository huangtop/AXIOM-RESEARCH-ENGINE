    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Although some of our competitors are larger than we are and may possess greater resources or provide more vertically integrated services, we believe that we are well-positioned to compete effectively and favorably in the markets in which we operate based on the foregoing factors.",
        "start_character": 47616,
        "end_character": 47896
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We begin with core site preparation services, including underground capabilities such as drilling and blasting, wet utility work, electrical utility lines, and grading, and we expand our service lines as our customer mix evolves, further strengthening our position as a leading provider of end-to-end infrastructure services across the Southeastern United States.",
        "start_character": 23912,
        "end_character": 24275
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We deliver our suite of comprehensive infrastructure services that support the planning, preparation, installation, and development of residential, commercial, industrial, municipal, and state infrastructure projects, primarily through in-house teams and equipment, significantly reducing the need for outsourcing or subcontractors, which enables industry-leading project execution.",
        "start_character": 8252,
        "end_character": 8634
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We originated as a niche provider of wet utilities installation and have, over time, both organically and through acquisitions, added capabilities, including grading, site clearing, erosion control, drilling and blasting, paving, and related site services, to become a full-service, end-to-end provider of turnkey infrastructure services.",
        "start_character": 10123,
        "end_character": 10461
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide a comprehensive set of construction services to our customers through our skilled workforce.",
        "start_character": 14648,
        "end_character": 14751
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide a comprehensive suite of infrastructure services to the residential, commercial, industrial, municipal, and state infrastructure markets.",
        "start_character": 7313,
        "end_character": 7461
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide our services using traditional general contracting arrangements, which are predominantly fixed unit price or “lump sum” contracts awarded based on the lowest bid.",
        "start_character": 33082,
        "end_character": 33255
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, we are exploring the possibility of adding a concrete casting plant in the near future for the manufacturing of precast concrete wet utility components (e.g., underground concrete storm drainpipes, boxes, joints, etc.).",
        "start_character": 31879,
        "end_character": 32112
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Because we own and maintain most of the equipment required for our contracts and have an experienced workforce to handle many types of municipal civil construction, we are able to bid competitively on many categories of contracts, especially complex, multitask projects.",
        "start_character": 48395,
        "end_character": 48665
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For example, we are currently vertically integrating our asphalt supply by constructing our own asphalt plants in strategic locations near our jobsites.",
        "start_character": 27307,
        "end_character": 27459
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2024, we expanded into the Greensboro, NC market organically, and in May 2025, we acquired Page & Associates, Inc., a local provider based in Greensboro.",
        "start_character": 10933,
        "end_character": 11089
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-120014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-120014-93d261d70ccbd41d",
        "accession_number": "0001193125-26-120014",
        "filing_date": "2026-03-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Led by an experienced, long-tenured management team and supported by talented project managers, we are driven by a culture of safety and employee development.",
        "start_character": 8635,
        "end_character": 8793
      }
