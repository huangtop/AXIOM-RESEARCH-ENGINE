        "end_character": 18158
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000006281-25-000153",
        "provenance_id": "provenance:SEC-FILING-0000006281-25-000153-b32f540296d9b2d5",
        "accession_number": "0000006281-25-000153",
        "filing_date": "2025-11-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe distributors provide a cost-effective means of reaching a broad range of customers while providing efficient logistics services.",
        "start_character": 16213,
        "end_character": 16352
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000006281-25-000153",
        "provenance_id": "provenance:SEC-FILING-0000006281-25-000153-b32f540296d9b2d5",
        "accession_number": "0000006281-25-000153",
        "filing_date": "2025-11-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We design, manufacture, test and market a broad portfolio of solutions, including integrated circuits (ICs), software and subsystems that leverage high-performance analog, mixed-signal and digital signal processing technologies.",
        "start_character": 451,
        "end_character": 679
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000006281-25-000153",
        "provenance_id": "provenance:SEC-FILING-0000006281-25-000153-b32f540296d9b2d5",
        "accession_number": "0000006281-25-000153",
        "filing_date": "2025-11-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell our ICs to customers worldwide, many of whom use products spanning our core technologies in a wide range of applications.",
        "start_character": 6347,
        "end_character": 6476
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000006281-25-000153",
        "provenance_id": "provenance:SEC-FILING-0000006281-25-000153-b32f540296d9b2d5",
        "accession_number": "0000006281-25-000153",
        "filing_date": "2025-11-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell our products globally through a direct sales force, third-party distributors, independent sales representatives and via our website.",
        "start_character": 15272,
        "end_character": 15412
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000006281-25-000153",
        "provenance_id": "provenance:SEC-FILING-0000006281-25-000153-b32f540296d9b2d5",
