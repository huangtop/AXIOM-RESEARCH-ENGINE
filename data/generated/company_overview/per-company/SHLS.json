        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our business activities are subject to numerous laws and regulations in the jurisdictions in which we operate.",
        "start_character": 21662,
        "end_character": 21772
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe our system solutions are unique in our industry because they integrate design and engineering support, proprietary components and innovative installation methods into a single offering.",
        "start_character": 2169,
        "end_character": 2365
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continually devote resources to research and development (“R&D”), with the objective of developing innovative new products that reduce the cost and improve the reliability and safety of renewable energy.",
        "start_character": 14549,
        "end_character": 14755
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We refer to complete EBOS solutions that use products manufactured by us, typically in connection with the design and specification of an entire EBOS system, as “system solutions”.",
        "start_character": 1274,
        "end_character": 1454
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Given the custom nature of both our system solutions and individual components and the long development cycle for solar energy and BESS projects, we typically have 12 months or more of lead time to quote, engineer, produce and ship orders we receive, and we do not stock large amounts of finished goods.",
        "start_character": 1865,
        "end_character": 2168
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are subject to standard environmental, health and safety, and pollution‑control laws and regulations in the jurisdictions where we operate.",
        "start_character": 19020,
        "end_character": 19162
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe our track record as an innovator and leading developer of EBOS technologies positions us to deliver tailored solutions that enhance performance and cost-effectiveness across solar, energy storage, and data center projects.",
        "start_character": 9425,
        "end_character": 9658
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have manufacturing facilities located in Tennessee and Alabama.",
        "start_character": 11189,
        "end_character": 11255
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "When we sell one of our patented system solutions, we work closely with our customers to design, specify and engineer a complete EBOS solution tailored to their project.",
        "start_character": 1455,
        "end_character": 1624
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "We measure the effectiveness of our R&D using a number of metrics, beginning with a market requirements definition, which includes a program budget, financial payback, resource requirements, and time required to launch the new product, system, or service into the market.",
        "start_character": 14882,
        "end_character": 15153
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001831651-26-000021",
        "provenance_id": "provenance:SEC-FILING-0001831651-26-000021-478822dba44bff0d",
        "accession_number": "0001831651-26-000021",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.88,
        "statement": "However, given the mission-critical nature of EBOS (as further described below), the decision to use our products typically involves input from both the EPC and the owner/developer of the energy infrastructure energy project.",
