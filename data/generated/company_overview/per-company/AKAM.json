    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Akamai’s enhanced offering offers greater deployment choices for customers and access to a portfolio of technology integrations that we believe is unrivaled in the market.",
        "start_character": 7196,
        "end_character": 7367
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By aligning with these partners, we believe we are better able to market our solutions and leverage partners to add valuable services to complement our offerings and improve the customer experience.",
        "start_character": 25101,
        "end_character": 25299
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In 2025, we continued to expand Akamai's compute platform to include additional data centers to provide access to powerful dedicated compute, storage and networking services in major metros that lack cloud computing options and availability, enabling organizations to place compute-intensive workloads as close as possible to end users.",
        "start_character": 10998,
        "end_character": 11334
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to entering into agreements with resellers, we have several other types of sales and marketing focused alliances with entities such as system integrators, application service providers, technology solution distributors, referral partners and marketplaces.",
        "start_character": 24833,
        "end_character": 25100
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we work closely with the Akamai Foundation, to provide community service and charitable matching fund opportunities for Akamai employees, endeavors that have been shown to increase employee engagement.",
        "start_character": 18007,
        "end_character": 18221
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In our view, we also benefit from the high quality of our offerings, our customer service and the information we can provide to our customers about their online operations and value.",
        "start_character": 28475,
        "end_character": 28657
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Privacy laws, such as the European Union General Data Protection Regulation and the California Consumer Privacy Act, impact how we use data generated from our network to improve and develop services, as well as our ability to reach current and prospective customers, understand how our solutions are being used, use and transfer data about our employees and respond to customer requests allowed under applicable laws.",
        "start_character": 29107,
        "end_character": 29524
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through our service and support offerings we work closely with our customers to develop creative and tailored solutions to assist them with integrating, configuring, optimizing and managing our core offerings.",
        "start_character": 15037,
        "end_character": 15246
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide services and support for our customers as they utilize our solutions.",
        "start_character": 1694,
        "end_character": 1779
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We compete with companies offering products and services that provide internet content delivery and hosting services, security and cloud computing solutions, technologies used by carriers to improve the efficiency of their systems, streaming content delivery services and equipment-based solutions for internet performance problems, such as load balancers and server switches.",
        "start_character": 27034,
        "end_character": 27410
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We expect competition for our offerings to increase both from existing competitors and new market entrants.",
        "start_character": 26241,
        "end_character": 26348
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001086222-26-000022",
        "provenance_id": "provenance:SEC-FILING-0001086222-26-000022-15cd9a6c6621a09d",
        "accession_number": "0001086222-26-000022",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We market and sell our solutions globally through our field sales and services organization and through many channel partners, including adidas, AHEAD, Avant, BV Tech, Carahsoft, CPD, Deloitte, Deutsche Telecom, Doyen, Guidepoint, Kyndryl, LevelBlue, Macnica, Microsoft Azure, Netpoleon, Oplium, Optiv, Presidio, SHI, Telefonica Group, Trace3 and WWT.",
        "start_character": 24481,
        "end_character": 24832
      }
    ]
  },
