    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Because of the high level of product differentiation and the increasing complexity and challenges of customer requirements, we have experienced, and may continue to experience, extended design cycles before production orders are received.",
        "start_character": 31055,
        "end_character": 31293
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For example, in the higher-performance segments of computing we serve, our Advanced Products most often compete with solutions offered by large integrated device manufacturers (“IDMs”), which offer integrated circuits (“ICs”) and semiconductor-based modules.",
        "start_character": 25152,
        "end_character": 25410
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Generally, we compete with developers and manufacturers of integrated circuits and semiconductor-based modules when addressing the needs of customers in enterprise computing and other market segments with implementations of our proprietary Factorized Power ArchitectureTM (“FPA”) using Advanced Products.",
        "start_character": 3028,
        "end_character": 3332
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In contrast, we generally compete with manufacturers of integrated power supplies when addressing the needs of customers, across a wide range of market segments, implementing conventional power systems architectures (e.g., Centralized Power Architecture (“CPA”), Distributed Power Architecture (“DPA”), and Intermediate Bus Architecture (“IBA”)) using Brick Products.",
        "start_character": 3333,
        "end_character": 3700
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In granting licenses, we generally retain the right to use our patented technologies and manufacture and sell our products in all licensed geographic areas and fields of use.",
        "start_character": 37951,
        "end_character": 38125
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In this facility, we manufacture Brick Products, with the exception of custom products produced by our Vicor Custom Power and VJCL subsidiaries, and Advanced Products, with the exception of certain products manufactured, packaged, and tested by third party wafer foundries and packaging contractors in the United States and Asia.",
        "start_character": 32690,
        "end_character": 33019
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Product quality and reliability are critical to our success and, as such, we emphasize quality and reliability in our design and manufacturing activities.",
        "start_character": 33344,
        "end_character": 33498
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Reflecting our strategy, we categorize our offerings as either Advanced Products or Brick Products, generally based on design, performance, and form factor considerations, as well as the range of evolving applications for which the respective categories are appropriate.",
        "start_character": 9830,
        "end_character": 10100
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Reflecting this strategy, we categorize our offerings as either “Advanced Products” or “Brick Products,” generally based on design, performance, and form factor considerations, as well as the range of evolving applications for which the products are appropriate.",
        "start_character": 2692,
        "end_character": 2954
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Since the Company was founded, we have pursued continuous innovations in product design and achievements in product performance, largely enabled by our focus on the research and development of advanced technologies and processes, often implemented in proprietary semiconductor circuitry, materials, and packaging.",
        "start_character": 2378,
        "end_character": 2691
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The customers we serve with Advanced Products are in market segments generally characterized by an emphasis on product performance differentiation, a compelling TCO, relatively extended and highly competitive design cycles, and product life cycles of generally less than three years.",
        "start_character": 25773,
        "end_character": 26056
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-085102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-085102-f8679aeaf39f2c9f",
        "accession_number": "0001193125-26-085102",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also sell a range of electrical and mechanical accessories for use with our products.",
        "start_character": 11568,
        "end_character": 11656
      }
    ]
  },
