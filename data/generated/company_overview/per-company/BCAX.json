        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Healthcare providers, physicians, and third-party payors will play a primary role in the recommendation and prescription of drug products for which we obtain marketing approval.",
        "start_character": 123894,
        "end_character": 124071
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-022010",
