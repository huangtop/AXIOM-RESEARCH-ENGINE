        "accession_number": "0001675644-26-000017",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer a better value proposition to our customers by providing high-touch service with few added fees.",
        "start_character": 5605,
        "end_character": 5710
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001675644-26-000017",
