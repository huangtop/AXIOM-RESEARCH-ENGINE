        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For beverages in emerging and fast growing categories where we may not currently have a brand presence, we license various trademarks from third-party partners, which generally allow us to sell and distribute certain products or brands throughout the U.S., Canada, or Mexico.",
        "start_character": 21638,
        "end_character": 21913
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001418135-26-000016",
