        "end_character": 8897
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001418135-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001418135-26-000016-e6cbfc49a4257992",
        "accession_number": "0001418135-26-000016",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We engineer and design most of our single serve brewers and utilize third-party contract manufacturers located in various countries in Asia for brewer appliance manufacturing.",
