        "accession_number": "0001558370-25-005850",
        "filing_date": "2025-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe this business is currently entering a growth phase and that our developed systems and adherence to strict regulation and oversight provides us a competitive advantage in the business.",
