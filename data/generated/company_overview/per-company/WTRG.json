        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "The Regulated Natural Gas segment is comprised of one operating segment representing natural gas utility companies, for which the Company provides natural gas distribution services.",
        "start_character": 4947,
        "end_character": 5128
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000078128-26-000050",
        "provenance_id": "provenance:SEC-FILING-0000078128-26-000050-bbb5ce50178df751",
        "accession_number": "0000078128-26-000050",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The Regulated Water segment is comprised of eight operating segments for the Company’s water and wastewater regulated utility companies, aligned with the states where we provide these services.",
        "start_character": 4428,
        "end_character": 4621
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000078128-26-000050",
        "provenance_id": "provenance:SEC-FILING-0000078128-26-000050-bbb5ce50178df751",
