        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In the states where we operate regulated water utilities, we believe there are approximately 5,000 wastewater facilities in operation, with the majority of the population being served by government-owned wastewater systems.",
        "start_character": 15243,
        "end_character": 15466
      },
      {
