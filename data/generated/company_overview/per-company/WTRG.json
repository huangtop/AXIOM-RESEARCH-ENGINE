        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In the states in which we operate, we are primarily subject to economic regulation by the following state utility commissions:",
        "start_character": 28285,
        "end_character": 28411
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000078128-26-000050",
