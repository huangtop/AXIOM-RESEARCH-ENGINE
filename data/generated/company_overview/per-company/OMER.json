        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have retained all worldwide marketing and distribution rights to YARTEMLEA, our product candidates, and our development programs.",
        "start_character": 23585,
        "end_character": 23717
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-010636",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-010636-08712d7bcce5f770",
