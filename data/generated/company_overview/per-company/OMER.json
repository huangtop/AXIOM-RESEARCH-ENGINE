        "accession_number": "0001437749-26-010636",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Government authorities in the U.S., the European Union (the “EU”) and other countries extensively regulate the research, development, testing, manufacture, labeling, promotion, advertising, distribution, marketing, and export and import of drug and biologic products including YARTEMLEA and the product candidates that we are developing.",
        "start_character": 41708,
