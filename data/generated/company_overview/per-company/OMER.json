        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have built a research and development organization that includes expertise in discovery research, preclinical development, product formulation, analytical and medicinal chemistry, manufacturing, clinical development and regulatory and quality assurance.",
        "start_character": 83799,
        "end_character": 84055
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-010636",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-010636-08712d7bcce5f770",
        "accession_number": "0001437749-26-010636",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have laboratories in-house for analytical method development, bioanalytical testing, formulation, non-GMP stability testing, and small-scale compounding of laboratory supplies of product candidates;",
        "start_character": 25879,
        "end_character": 26080
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-010636",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-010636-08712d7bcce5f770",
