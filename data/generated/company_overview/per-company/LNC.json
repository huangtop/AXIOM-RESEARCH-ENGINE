        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Additionally, we offer other products and services that complement our primary offerings:",
        "start_character": 43325,
        "end_character": 43414
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000059558-26-000016",
