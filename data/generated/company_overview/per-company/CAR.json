        "statement": "We also offer rental options that provide greater control, self-service and contactless capabilities.",
        "start_character": 25827,
        "end_character": 25928
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000723612-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000723612-26-000012-b8ddc4042d33a1f7",
