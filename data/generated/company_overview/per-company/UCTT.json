    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Because our engineers work closely with our customers’ engineers and understand the fabrication, assembly and testing of their products, we often can improve their design for manufacturability and implement automation, thereby reducing their cost and improving their quality and consistency.",
        "start_character": 5419,
        "end_character": 5710
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we expect to face new competitors as we enter new markets or otherwise expand our products and service offerings.",
        "start_character": 25840,
        "end_character": 25966
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we have developed an overall infrastructure to provide our customers with service and support 24 hours a day, seven days a week.",
        "start_character": 20292,
        "end_character": 20433
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our strategy is to grow our position and increase our value to our customers as a leading solutions and service provider in the semiconductor markets we serve, while serving a limited number of other technologically similar market opportunities.",
        "start_character": 7671,
        "end_character": 7916
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that equipment outsourcing and service offerings among OEMs creates a significant market opportunity for us to grow our business with existing and new customers.",
        "start_character": 8055,
        "end_character": 8227
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have broadened our IDM, memory and foundry portfolio into the sub-fab with the design and manufacturing of components, process solutions and fully integrated sub-systems which all support process tool facilitization.",
        "start_character": 8401,
        "end_character": 8620
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have dedicated New Business Development managers for both our product and service businesses.",
        "start_character": 19228,
        "end_character": 19324
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We offer our customers an integrated outsourced solution for major subassemblies, improved design-to-delivery cycle times, design for manufacturability, prototyping and component manufacturing, tool chamber parts cleaning and coating and micro contamination analytical services.",
        "start_character": 2909,
        "end_character": 3187
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We seek to optimize our supply chain management, design and manufacturing coordination and controls to respond rapidly to order requests, enabling us to decrease product design and customization cycle times for our customers.",
        "start_character": 5193,
        "end_character": 5418
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell and support our products and services through our Customer Business Management organization.",
        "start_character": 18043,
        "end_character": 18143
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell our products and services primarily to customers in the semiconductor capital equipment and semiconductor integrated device manufacturing industries, and we also sell to the display, consumer, medical, energy, industrial, and research equipment industries.",
        "start_character": 16514,
        "end_character": 16778
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-010744",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-010744-2d717ee33f6f11e6",
        "accession_number": "0001628280-26-010744",
        "filing_date": "2026-02-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We ship a majority of our products and provide most of our services to U.S.-registered customers with both domestic and international locations.",
        "start_character": 1261,
        "end_character": 1405
      }
