        "filing_date": "2026-05-19",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are subject to a variety of environmental, health and safety (“EHS”) laws and regulations in the jurisdictions in which we operate and in which our products are distributed.",
