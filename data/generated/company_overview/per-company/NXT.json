        "filing_date": "2026-05-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are a multi-product platform company offering a connected ecosystem of technologies and services, including electrical balance of systems solutions, power conversion technologies, and software-driven capabilities incorporating artificial intelligence (“AI”), automation, and robotics.",
        "start_character": 2740,
        "end_character": 3027
