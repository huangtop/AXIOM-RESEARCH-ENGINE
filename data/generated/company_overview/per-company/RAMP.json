        "accession_number": "0000733269-26-000025",
        "filing_date": "2026-05-21",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "(\"LiveRamp\", \"we\", \"us\", or the \"Company\") is a leading data collaboration technology company, empowering marketers and media owners to deliver and measure marketing performance everywhere it matters.",
