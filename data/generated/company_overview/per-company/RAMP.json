        "accession_number": "0000733269-26-000025",
        "filing_date": "2026-05-21",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Given the strong network effects associated with our platform, we work with both enterprise marketers and the companies they partner with to execute their marketing, including agencies, marketing technology providers, publishers and data providers.",
