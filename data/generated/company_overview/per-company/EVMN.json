        "end_character": 191232
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-093932",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-093932-5a5334ca50df7a69",
        "accession_number": "0001193125-26-093932",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, AprilBio may terminate the agreement if we challenge any licensed patent or if we cease active development of the licensed product.",
