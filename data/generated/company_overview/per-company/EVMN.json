        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "License Agreement, we are responsible for the development and commercialization of the licensed product, except that AprilBio was responsible for completing the then ongoing Phase 1 clinical trial.",
