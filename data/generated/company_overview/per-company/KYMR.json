        "accession_number": "0001193125-26-073395",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We rely on and expect to continue to rely on third-party manufacturers for the production of both drug substance and finished drug product.",
        "start_character": 39060,
        "end_character": 39199
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073395",
