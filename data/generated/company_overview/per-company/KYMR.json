        "accession_number": "0001193125-26-073395",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have engaged third-party manufacturers to supply the drug substances for our drug candidates and a third-party manufacturer to develop and manufacture finished drug products that we are using in our",
