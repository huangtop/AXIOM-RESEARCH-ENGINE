        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We engage in a variety of internal and external workforce development initiatives to ensure we have a strong pipeline of talent with the skills needed to execute our strategic priorities.",
