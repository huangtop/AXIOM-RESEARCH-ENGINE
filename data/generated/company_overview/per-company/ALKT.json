    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "If we cannot license the intellectual property at issue or develop non-infringing solutions for any allegedly infringing aspect of our business, we may be unable to compete effectively.",
        "start_character": 39291,
        "end_character": 39476
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In addition, while we are not currently under examination by the FFIEC, a formal interagency body empowered to prescribe uniform principles, standards and report forms for the examination of FIs, to make recommendations to promote uniformity in the supervision of FIs and to directly administer, coordinate, oversee and implement a supervisory program, known as the Multi-Regional Data Processing Services program, for the supervision and examination of the largest, systemically important third-party service providers to FIs, it is possible that we may become subject to FFIEC examination at some point in the future.",
        "start_character": 46818,
        "end_character": 47437
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To remain competitive, we believe we must continue to invest in research and development, sales and marketing, client support and our business operations generally.",
        "start_character": 43216,
        "end_character": 43380
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are a technology service provider to FIs in the United States that are subject to regulation, supervision and examination by a number of regulatory agencies, including the Office of the Comptroller of the Currency (the “OCC”), the NCUA, the Board of Governors of the Federal Reserve System (the “Federal Reserve”), the Federal Deposit Insurance Corporation (the “FDIC”) and other federal or state agencies that regulate or supervise FIs in the United States.",
        "start_character": 45854,
        "end_character": 46315
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe based on third-party estimates that this segment of the market represents an opportunity of more than 200 million registered users and offers the greatest potential lifetime value, considering the cost and resources to acquire and service the relationship.",
        "start_character": 7667,
        "end_character": 7934
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that the comprehensive integration among our solution offerings and our clients’ internal and third-party systems, combined with our deep industry expertise, including our domain expertise in retail and business banking, reputation for consistent, high-quality client support, pace at which we bring innovation to market, and unified cloud-based digital banking and SaaS solutions distinguish us from the competition.",
        "start_character": 40297,
        "end_character": 40725
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that we compete favorably with respect to these factors within the markets we serve, but we expect competition to continue and increase as existing competitors continue to evolve their offerings and as new companies enter our market.",
        "start_character": 42971,
        "end_character": 43215
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We focus on this subsection of the broader market because we view this base as offering the greatest potential lifetime value, considering the cost and resources to acquire and service the relationship.",
        "start_character": 33301,
        "end_character": 33503
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2025 and 2024, we spent 26.7% and 28.8%, respectively, of revenues on research and development, underlining our commitment to ongoing innovation.",
        "start_character": 21269,
        "end_character": 21417
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, certain of our clients have or can obtain the ability to create their own in-house systems, and while many of these systems have difficulties scaling and providing an integrated platform, we still face challenges displacing in-house systems and retaining clients that choose to develop an in-house system.",
        "start_character": 41385,
        "end_character": 41703
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Similarly, we continue to expand our sales and marketing organization focusing on new client wins, cross-selling opportunities and client renewals.",
        "start_character": 5742,
        "end_character": 5889
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001529274-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001529274-26-000009-6aa9ec18051c8ed9",
        "accession_number": "0001529274-26-000009",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We expect cross-sell to continue to contribute meaningfully to our growth.",
        "start_character": 20091,
        "end_character": 20165
      }
    ]
  },
