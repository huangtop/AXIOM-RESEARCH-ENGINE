        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through AdParlor, LLC (\"AdParlor\"), our wholly-owned subsidiary, we operate our non-core business which offers advertiser clients managed creator marketing and media buying services across social media platforms.",
        "start_character": 5681,
        "end_character": 5893
      },
      {
