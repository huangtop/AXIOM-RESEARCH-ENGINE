    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Additionally, we operate a number of retail locations in the United States, Canada, Italy and Germany, which we refer to as Company-operated stores and where our money remittance services are available.",
        "start_character": 20031,
        "end_character": 20233
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In most countries in which we operate, either we or our agents are required to obtain licenses or to register with a government authority in order to offer money transfer services.",
        "start_character": 38433,
        "end_character": 38613
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In recent years, we expanded our services to allow remittances to Africa and Asia from the United States, began offering sending services from Canada to Latin America and Africa, and completed acquisitions which further strengthen our presence in Latin America and position us to grow in the Europe to Africa, Asia and LAC corridors.",
        "start_character": 16225,
        "end_character": 16558
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our business is organized around one reportable segment that provides money remittance services primarily between the U.S.",
        "start_character": 16568,
        "end_character": 16690
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our money remittance services are subject to anti-money laundering laws and regulations of the United States, including the Bank Secrecy Act (“BSA”), as amended by the USA PATRIOT Act of 2001, as well as state laws and regulations and the anti-money laundering laws and regulations in many of the countries in which we operate.",
        "start_character": 34299,
        "end_character": 34626
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Regardless, we continue to innovate in the industry by differentiating our money remittance business through programs to foster loyalty among agents as well as consumers and have expanded our channels through which our services are accessed to include online and mobile offerings in preparation for consumer adoption.",
        "start_character": 48964,
        "end_character": 49281
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide our remittance services to Africa and Asia from the United States and offer money transfer services from Canada to Latin America and Africa.",
        "start_character": 355,
        "end_character": 511
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide remittance services from Spain, Italy and Germany to Africa, Asia and Latin America.",
        "start_character": 512,
        "end_character": 612
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have an ongoing program designed to comply with escheatment laws as they apply to our business.",
        "start_character": 40082,
        "end_character": 40180
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We maintain a compliance program designed to comply with anti-bribery laws and regulations applicable to our business.",
        "start_character": 44979,
        "end_character": 45097
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide our money remittance services utilizing our internally developed proprietary software systems, which we believe enhance the productivity of our network of sending agents, enabling them to quickly, reliably and cost-effectively process remittance transactions.",
        "start_character": 9422,
        "end_character": 9692
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015647",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015647-ef5d4d43d49dad5d",
        "accession_number": "0001628280-26-015647",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a philosophy, we sell credible solutions to agents, not discounts or higher commissions as is typical for the industry.",
        "start_character": 48221,
        "end_character": 48343
      }
    ]
  },
