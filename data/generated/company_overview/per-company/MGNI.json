        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We offer a self-service model that allows sellers to access our platform without extensive involvement by our personnel.",
        "start_character": 18386,
        "end_character": 18506
      },
      {
