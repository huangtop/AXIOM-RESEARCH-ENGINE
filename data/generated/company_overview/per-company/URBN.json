        "confidence": 0.96,
        "statement": "In addition to retail stores, we offer our products and services directly to our customers through our websites, mobile applications, social media and third-party digital platforms and customer contact centers.",
        "start_character": 1220,
        "end_character": 1430
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-137916",
