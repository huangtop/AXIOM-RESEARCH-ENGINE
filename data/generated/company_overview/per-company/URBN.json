        "filing_date": "2026-04-01",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are a leading lifestyle products and services company which operates a portfolio of global consumer brands including the Anthropologie, Free People, FP Movement, Urban Outfitters and Nuuly brands.",
        "start_character": 25,
        "end_character": 224
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-137916",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-137916-054ab683f1e92f5e",
        "accession_number": "0001193125-26-137916",
        "filing_date": "2026-04-01",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are the registered owner in the United States of certain service marks and trademarks, including, but not limited to “Anthropologie,” “BDG,” “FP Movement,” “Free People,” “Maeve,” “Nuuly,” “Terrain,” “Urban Outfitters” and “URBN.” Each mark is renewable indefinitely, contingent upon continued use at the time of renewal.",
        "start_character": 30024,
        "end_character": 30348
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-137916",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-137916-054ab683f1e92f5e",
        "accession_number": "0001193125-26-137916",
        "filing_date": "2026-04-01",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We maintain our own buying groups that select and develop products to satisfy our target customers and provide us with the appropriate amount and timing of products offered.",
        "start_character": 15410,
        "end_character": 15583
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-137916",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-137916-054ab683f1e92f5e",
        "accession_number": "0001193125-26-137916",
        "filing_date": "2026-04-01",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "The Company provides an update on key metrics annually and releases an Impact Report biannually.",
        "start_character": 32432,
        "end_character": 32528
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-137916",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-137916-054ab683f1e92f5e",
        "accession_number": "0001193125-26-137916",
        "filing_date": "2026-04-01",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Through our unique culture, competitive compensation and benefits, development, training, coaching and mentorship programs and a collaborative recruiting process, we believe we are positioned to attract top talent and drive high levels of performance, engagement and retention.",
        "start_character": 35689,
        "end_character": 35966
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-137916",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-137916-054ab683f1e92f5e",
        "accession_number": "0001193125-26-137916",
        "filing_date": "2026-04-01",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also have arrangements with agents and third-party manufacturers to produce our private label and exclusive merchandise.",
        "start_character": 22613,
        "end_character": 22736
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-137916",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-137916-054ab683f1e92f5e",
        "accession_number": "0001193125-26-137916",
        "filing_date": "2026-04-01",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We believe that by starting a conversation and interacting directly with our customers, most notably via Instagram, Pinterest, Facebook and TikTok, our own mobile applications and in artificial intelligence platforms, we are more effective at understanding and serving their fashion needs.",
        "start_character": 21070,
        "end_character": 21359
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-137916",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-137916-054ab683f1e92f5e",
        "accession_number": "0001193125-26-137916",
        "filing_date": "2026-04-01",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We manage and analyze our performance based on a single Retail segment omni-channel rather than separate channels and believe that the Retail segment omni-channel results present the most meaningful and appropriate measure of our performance.",
        "start_character": 3630,
        "end_character": 3872
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-137916",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-137916-054ab683f1e92f5e",
        "accession_number": "0001193125-26-137916",
        "filing_date": "2026-04-01",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We operate a Wholesale segment under the Free People, FP Movement and Urban Outfitters brands.",
