    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also believe that competition for real estate financing comes from middle-market business owners themselves, many of whom have had a historic preference to own, rather than lease, the real estate they use in their businesses.",
        "start_character": 32524,
        "end_character": 32752
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are an active asset manager and regularly review each of our properties to evaluate, various factors, including, but not limited to, changes in the business performance at the property, credit of the tenant and local real estate market conditions.",
        "start_character": 25690,
        "end_character": 25940
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are an internally managed real estate company that acquires, owns and manages primarily single-tenant properties that are net leased on a long-term basis to middle-market companies operating service-oriented or experience-based businesses.",
        "start_character": 18,
        "end_character": 260
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a landlord, we compete in the multi-billion dollar commercial real estate market with numerous developers and owners of properties, many of which own properties similar to ours in the same markets in which our properties are located.",
        "start_character": 33129,
        "end_character": 33365
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Because the focus of our investment strategy is on middle-market and select smaller operators, our investment in their real estate operating assets is typically either the first time the real estate has transacted, or we are the capital provider for a portion of a merger/acquisition transaction with another operator involving the real estate.",
        "start_character": 3096,
        "end_character": 3440
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Building on our senior leadership team's experience in net lease real estate investing, we have developed leading origination, underwriting, financing, and property management capabilities.",
        "start_character": 19085,
        "end_character": 19274
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Factors we evaluate in connection with hiring, developing, training, compensating and advancing individuals include, but are not limited to, qualification, performance, skill and experience.",
        "start_character": 35415,
        "end_character": 35605
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Furthermore, we believe that there is strong demand for our net-lease capital solutions among middle-market and smaller companies that own commercial real estate, in part, due to the bank regulatory environment, which, since the turmoil in the housing and mortgage industries from 2007-2009, has generally been characterized by increased scrutiny and regulation.",
        "start_character": 12443,
        "end_character": 12805
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Our focus on investing in properties operated by middle market and smaller operators provides us with what we believe is a large addressable market of investment opportunities, one in which our tenants are largely undeserved from a capital perspective.",
        "start_character": 17028,
        "end_character": 17280
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also maintain an ATM Program and, as of December 31, 2025, we had the ability to sell additional common stock thereunder with an aggregate gross sales price of up to $347.5 million.",
        "start_character": 21446,
        "end_character": 21630
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe middle-market companies are underserved from a capital perspective and that we can offer them attractive real estate financing solutions while allowing us to enter into leases that provide us with stable cash flows and attractive risk-adjusted returns.",
        "start_character": 15871,
        "end_character": 16134
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001728951-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001728951-26-000008-b17377dd2a642aaa",
        "accession_number": "0001728951-26-000008",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe our senior management team’s reputation, in-depth market knowledge and extensive network of long-standing relationships in the net lease industry provide us access to an ongoing pipeline of attractive investment opportunities.",
        "start_character": 28452,
        "end_character": 28689
      }
    ]
  },
