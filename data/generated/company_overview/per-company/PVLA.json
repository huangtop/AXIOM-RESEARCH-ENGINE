        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our competitors also may obtain FDA or other regulatory approval for their products more rapidly than we may obtain approval for our own, which could result in our competitors establishing a strong market position before we are able to enter the market.",
        "start_character": 104179,
        "end_character": 104432
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-133372",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-133372-6b56a026a42c9081",
