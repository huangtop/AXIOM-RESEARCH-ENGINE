        "filing_date": "2026-04-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition to direct competition, we face indirect competition from companies that sponsor or maintain high traffic volume websites or provide an initial point of entry for internet users, including, but not limited to, providers of search services, web browsers and navigation pages.",
        "start_character": 30714,
        "end_character": 30999
      },
      {
