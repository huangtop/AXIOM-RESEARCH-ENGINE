        "filing_date": "2026-04-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, as a social media platform featuring social networking services and providing a rich variety of multimedia contents, we are subject to intense competition from providers of similar services, such as social networking platforms and multimedia content platforms with social features.",
        "start_character": 29483,
        "end_character": 29777
