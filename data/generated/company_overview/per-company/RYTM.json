    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In connection with our commercialization of IMCIVREE or any future product candidate, we have engaged and could engage other third parties to assist in manufacturing and/or supply chain related activities.",
        "start_character": 116962,
        "end_character": 117167
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Sales will depend, in part, on the extent to which third-party payors, including government health programs in the United States such as Medicare and Medicaid, commercial health insurers and managed care organizations, provide coverage, and establish adequate reimbursement for, IMCIVREE and other product candidates we may develop and obtain approval for in the future.",
        "start_character": 189392,
        "end_character": 189762
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Under our agreements, we pay these third parties for services and/or manufacturing in accordance with the terms of mutually agreed upon work orders, which we may enter into from time to time.",
        "start_character": 116643,
        "end_character": 116834
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe our deep developmental experience and global commercial presence uniquely position us to develop this molecule with the goal of offering a portfolio of treatment options to patients struggling with hyperphagia and severe obesity enabling the treatment that is right for them.",
        "start_character": 78461,
        "end_character": 78747
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have also entered into commercial supply agreements, including with Polypeptide and Astrea for manufacturing of drug substance, or API, and drug product for IMCIVREE.",
        "start_character": 116473,
        "end_character": 116642
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have entered into process development and manufacturing service agreements with our CMOs, including, PolyPeptide Group, Braine L’Alleud, or Polypeptide, Neuland Laboratories, and Astrea Monts S.A.S (formerly Recipharm), or Astrea, for certain process development and manufacturing services for regulatory starting materials and/or drug substance, or API, and drug product in connection with the manufacture of setmelanotide.",
        "start_character": 116045,
        "end_character": 116472
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "While there are a limited number of companies that can produce raw materials and API in the quantities and with the quality and purity that we require for our product, based on our diligence to date, we believe our current network of manufacturing partners are able to fulfill these requirements, and are capable of continuing to expand capacity as needed.",
        "start_character": 117168,
        "end_character": 117524
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Based on these preliminary results, we are pursuing development of both setmelanotide and RM-718, one of our two next-generation MC4R agonists, for PWS, a rare genetic disease that results in a number of physical, mental and behavioral problems.",
        "start_character": 50458,
        "end_character": 50703
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Because we rely on these CMOs, we have personnel with pharmaceutical development and manufacturing experience who are responsible for maintaining our CMO relationships.",
        "start_character": 118618,
        "end_character": 118786
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Concurrently, we are engaging with applicable regulatory authorities to address the impact of our discontinuing development of the weekly formulation of setmelanotide, which was a component of our pediatric investigation plan, or PIP, in the EU (and the United Kingdom).",
        "start_character": 72339,
        "end_character": 72609
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Following the disclosure of these positive preliminary results in December 2025, we announced plans to further develop setmelanotide and RM-718 for PWS.",
        "start_character": 6576,
        "end_character": 6728
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012399",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012399-824c31c579aa2503",
        "accession_number": "0001628280-26-012399",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Grounded in these guiding principles, we believe we have developed a collaborative environment where our colleagues feel respected, valued, and inspired to contribute to their fullest potential.",
        "start_character": 217771,
        "end_character": 217965
      }
    ]
