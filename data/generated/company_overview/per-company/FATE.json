        "end_character": 47209
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073699",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-073699-7bef8fe7f2e612bd",
        "accession_number": "0001193125-26-073699",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In particular, we are required to commit a minimum amount of funding toward the development of a licensed product on an annual basis or conduct activities toward specific development milestones.",
