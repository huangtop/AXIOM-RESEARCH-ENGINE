        "accession_number": "0001384101-26-000010",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "If premarket review, clearance, or approval is required for the tests that we market as LDTs, our business could be negatively affected until such review is completed and clearance or approval to market is obtained, and the FDA could require that we stop selling our tests pending premarket clearance or approval.",
        "start_character": 53444,
        "end_character": 53757
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001384101-26-000010",
