        "accession_number": "0001104659-26-050737",
        "filing_date": "2026-04-29",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In January 2025, we engaged Ariel Syndicate 1910 of Lloyd’s to provide insurance coverage for the product warranty services of our solar modules worldwide effective from January 1, 2025.",
