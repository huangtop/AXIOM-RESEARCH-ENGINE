        "end_character": 23454
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050737",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-050737-247d17d075ac9ec7",
        "accession_number": "0001104659-26-050737",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have built a vertically integrated solar power product value chain, manufacturing from silicon wafers to solar cells and solar modules.",
