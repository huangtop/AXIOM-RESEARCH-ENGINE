        "accession_number": "0001104659-26-050737",
        "filing_date": "2026-04-29",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we have established operation management and project-based customer service teams, aiming to supervise the whole installation process and service our customers in a timely manner.",
        "start_character": 54214,
        "end_character": 54406
      },
      {
