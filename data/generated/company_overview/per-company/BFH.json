        "accession_number": "0001101215-26-000016",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are constantly seeking to improve our digital and mobile capabilities, in order to support and enhance our product offerings, drive growth for our brand partners and improve the customer experience.",
