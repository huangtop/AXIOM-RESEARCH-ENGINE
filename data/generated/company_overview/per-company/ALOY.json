        "accession_number": "0001437749-26-005114",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that this is an important first step to not only marketing our existing products to financial professionals but also developing new and even bespoke products for this market segment.",
