        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are not aware of any governmental regulations or approvals required for the marketing or use of our Blackbox System or the services provided.",
        "start_character": 28350,
        "end_character": 28494
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005114",
