        "accession_number": "0001437749-26-005114",
        "filing_date": "2026-02-23",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We offer our subscribing customers a trading tool and not a trading platform, broker dealer or exchange, and therefore we do not believe we are subject to regulatory oversight by the SEC, FINRA or other financial regulatory agencies.",
