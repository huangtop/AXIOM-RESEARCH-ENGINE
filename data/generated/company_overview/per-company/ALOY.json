        "end_character": 23789
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005114",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005114-14a7069e9c6f9a49",
        "accession_number": "0001437749-26-005114",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that technological developments to the Blackbox System and platform have been and will continue to be critical to the success of our company.",
        "start_character": 19051,
        "end_character": 19203
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005114",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005114-14a7069e9c6f9a49",
        "accession_number": "0001437749-26-005114",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We offer all members access to a curriculum of classes and orientations, and live market sessions.",
