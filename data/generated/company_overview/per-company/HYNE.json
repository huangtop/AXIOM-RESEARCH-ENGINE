        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Consistent with our interest rate risk strategy, we sell, on a servicing released basis a significant portion of our originations of fixed rate one to four residential mortgage loans.",
        "start_character": 13315,
        "end_character": 13498
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-035156",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-035156-d41c639151a9fb79",
