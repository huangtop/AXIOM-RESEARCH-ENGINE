        "accession_number": "0001326732-26-000015",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Product licenses are arrangements in which we have internally developed drug candidates and, based on a strategic review, licensed partial or full rights to third parties to continue development and potential commercialization.",
        "start_character": 19796,
        "end_character": 20023
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001326732-26-000015",
