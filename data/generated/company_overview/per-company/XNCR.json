        "end_character": 104928
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001326732-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001326732-26-000015-0de6c50a90145236",
        "accession_number": "0001326732-26-000015",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In December 2015, we entered into a master services agreement with Selexis SA for the manufacture of proprietary cell lines.",
