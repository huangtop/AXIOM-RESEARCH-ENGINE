    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "(together with its consolidated subsidiaries, “UL Solutions”, the “Company”, “we”, “our”, and “us”) is a global safety science leader that provides Testing, Inspection and Certification (“TIC”) services and related software and advisory offerings to customers worldwide.",
        "start_character": 47,
        "end_character": 317
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As our core TIC customer needs have evolved, we have extended our business beyond product testing to serve as a global provider of software, data and advisory solutions, enabling our customers to manage complex regulatory requirements, deliver supply chain transparency and operationalize sustainability.",
        "start_character": 8472,
        "end_character": 8776
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Compliance with EHS laws and regulations increases our operating costs, limits or restricts the services we provide, or the methods by which we offer, sell and fulfill those services or conduct our business, and subjects us to the possibility of regulatory or private actions or proceedings.",
        "start_character": 22196,
        "end_character": 22487
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Furthermore, we offer over 350 independent third-party conformity assessment services around the world and are capable of testing and certifying against over 4,000 global standards, which affords us vast insight into the safety of products across a wide range of end markets and geographies.",
        "start_character": 1525,
        "end_character": 1816
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Lastly, we offer advisory and technical services to support our customers in managing their safety, compliance, regulatory risk and sustainability programs.",
        "start_character": 14064,
        "end_character": 14220
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The outsourced product TIC market, where we currently focus, is served by our Industrial and Consumer segments, which provide comprehensive testing, inspection and certification services to customers across a broad array of end markets.",
        "start_character": 2189,
        "end_character": 2425
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are required to maintain credentials from accreditors, regulators and scheme owners based on applicable regulations and scheme rules in order to provide conformity assessment services to our customers globally.",
        "start_character": 19769,
        "end_character": 19982
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are the owner of the iconic UL-in-a-circle certification mark (the “UL Mark”) that appears on billions of products around the world.",
        "start_character": 1817,
        "end_character": 1952
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We offer our customers global market access services that help them ensure the safety and quality of their products while also supporting their efforts to manage the broader risks they face throughout their product lifecycle processes.",
        "start_character": 1953,
        "end_character": 2188
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer testing services to address performance and other requirements that may not be required by any regulation and may not result in a certification, but are still desired by our customers to help ensure the safety, performance and reliability of their products.",
        "start_character": 13375,
        "end_character": 13641
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We operate in a global and highly fragmented industry that is diverse across geographies, services and markets.",
        "start_character": 18387,
        "end_character": 18498
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001901440-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001901440-26-000005-a0a89d44a84e085c",
        "accession_number": "0001901440-26-000005",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide software as a service (“SaaS”) and license-based software solutions, including implementation and training services related to software, to enable our customers to manage complex regulatory requirements, deliver supply chain transparency and operationalize sustainability.",
        "start_character": 14261,
        "end_character": 14544
      }
