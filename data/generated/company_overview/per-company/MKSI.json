        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "These inflections provide additional growth opportunities for MKS, as we believe we are uniquely positioned to deliver the broadest and deepest portfolio of solutions.",
        "start_character": 4675,
        "end_character": 4842
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-066820",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-066820-c418526518846f1a",
