        "provenance_id": "provenance:SEC-FILING-0001193125-26-177605-f787a4d620c0b63a",
        "accession_number": "0001193125-26-177605",
        "filing_date": "2026-04-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Leveraging our business strengths, we design targeted community programs and investments that we believe are capable of driving change and delivering transformative outcomes.",
