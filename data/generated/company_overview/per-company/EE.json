        "end_character": 10463
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-078407",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-078407-4238a338b9f9f84a",
        "accession_number": "0001193125-26-078407",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To continue to develop our existing business, we plan to use our track record as a reliable operator and strategic commercial actions to develop a reputation as more than a floating regasification terminal provider.",
        "start_character": 23350,
        "end_character": 23565
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-078407",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-078407-4238a338b9f9f84a",
        "accession_number": "0001193125-26-078407",
        "filing_date": "2026-02-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Under these agreements, we either provide regasification services or utilize our assets to directly provide natural gas, LNG, power, or steam to our customers.",
        "start_character": 1917,
        "end_character": 2076
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-078407",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-078407-4238a338b9f9f84a",
        "accession_number": "0001193125-26-078407",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to look at opportunities to develop additional terminals with integrated natural gas sales as well as agreements to access capacity on existing terminals where we already provide regasification services.",
        "start_character": 12000,
        "end_character": 12215
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-078407",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-078407-4238a338b9f9f84a",
        "accession_number": "0001193125-26-078407",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "When compared to other entities that sell LNG, from large LNG producers to portfolio players to trading houses, we believe we are better positioned to open and expand new markets given our expertise in the downstream portion of the LNG value chain.",
        "start_character": 20789,
        "end_character": 21037
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-078407",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-078407-4238a338b9f9f84a",
        "accession_number": "0001193125-26-078407",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "For projects in which we operate the onshore facilities, we may be responsible for obtaining associated permits.",
        "start_character": 35382,
        "end_character": 35494
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-078407",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-078407-4238a338b9f9f84a",
        "accession_number": "0001193125-26-078407",
        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, we are also subject to the International Convention for the Control and Management of Ships’ Ballast Water and Sediments.",
        "start_character": 36366,
        "end_character": 36500
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-078407",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-078407-4238a338b9f9f84a",
        "accession_number": "0001193125-26-078407",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In response, we often manage seasonal demand fluctuation in our existing markets by configuring our global operations to meet energy needs during the winters in both the northern and southern hemispheres.",
