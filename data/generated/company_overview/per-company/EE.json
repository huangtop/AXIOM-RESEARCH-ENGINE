        "accession_number": "0001193125-26-078407",
        "filing_date": "2026-02-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our business is substantially supported by long-term, take-or-pay agreements, which provide consistent revenue and cash flow from our high-quality customer base.",
        "start_character": 1755,
        "end_character": 1916
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-078407",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-078407-4238a338b9f9f84a",
        "accession_number": "0001193125-26-078407",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The stable nature of our terminal services revenue stream is underscored by the critical nature of the services we provide to our customers, who are often in markets lacking natural gas supply optionality.",
