        "accession_number": "0001831631-26-000028",
        "filing_date": "2026-03-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We operate within a complex area of the financial services industry, and our business requires a significant compliance and regulatory infrastructure.",
