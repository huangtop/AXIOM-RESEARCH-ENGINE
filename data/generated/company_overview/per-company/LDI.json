        "accession_number": "0001831631-26-000028",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have historically maintained liquidity levels that are designed to allow us to fund our loan origination business, manage our day-to-day operations and protect us against foreseeable market risks.",
        "start_character": 12952,
        "end_character": 13151
      },
      {
