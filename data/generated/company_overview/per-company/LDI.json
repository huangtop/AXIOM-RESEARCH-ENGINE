        "accession_number": "0001831631-26-000028",
        "filing_date": "2026-03-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "With respect to our mortgage loan businesses, we face, and may face in the future, competition in such areas as loan product offerings, rates, fees and customer service.",
        "start_character": 14098,
        "end_character": 14267
      },
      {
