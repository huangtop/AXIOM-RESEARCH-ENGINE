        "end_character": 15700
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-283871",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-283871-173f45c85e0f25d3",
        "accession_number": "0001193125-26-283871",
        "filing_date": "2026-06-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To clarify our vision for society and the direction of our initiatives, we established the “SMBC Group Statement on Social Value Creation.” We have also designated “Green Planet,” “Thriving People,” and “Fulfilled Growth” as our material issues.",
