    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "After the previously-announced wind down of our powertrain operations, we shifted our focus to the development and commercialization of the KARNO Power Module as a standalone product targeting power generation and e-mobility markets, and related R&D services that we have undertaken pursuant to contracts with the United States government.",
        "start_character": 3778,
        "end_character": 4117
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Environmental standards applicable to us are established by the laws and regulations of the countries in which we operate, and our product are sold, and standards adopted by regulatory agencies and the permits and licenses that we hold.",
        "start_character": 44638,
        "end_character": 44874
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Unlike our competitors, who lack access to the KARNO Power Module’s technology and capabilities, we can provide a combination of product delivery and specialized testing services that our customers are seeking.",
        "start_character": 49160,
        "end_character": 49370
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also face competition in the market for R&D services from companies that specialize in the design, development and testing of electric generator systems and components and other engineering services.",
        "start_character": 48729,
        "end_character": 48931
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide R&D services to third parties, including the ONR.",
        "start_character": 31728,
        "end_character": 31788
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We will continue to provide R&D services to third parties under existing contracts and anticipate entering into additional R&D agreements in 2026 with ONR and other government customers.",
        "start_character": 32764,
        "end_character": 32950
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As production volumes rise, we may consider outsourcing certain production and assembly functions including the printing, manufacturing and assembly of specific components or the entire generator to third parties.",
        "start_character": 40029,
        "end_character": 40242
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In early 2025, we announced that delivery of early deployment customer units and validation of KARNO Power Module design parameters were delayed due to design and production problems related to a key printed component − the regenerator − as well as delays in ramping up production of linear electric motors by a contract manufacturer.",
        "start_character": 29455,
        "end_character": 29789
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In parallel, we are pursuing design modifications to enable the production of components with less complex geometry using conventional manufacturing processes, reducing reliance on",
        "start_character": 39269,
        "end_character": 39449
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "The KARNO Power Module and KARNO Core technology, including the technology that we acquired from General Electric, and the technology developed by Hyliion subsequent to the acquisition, is protected by numerous patents and trademarks which we believe provide us with extensive and lasting protection for our intellectual property.",
        "start_character": 4396,
        "end_character": 4726
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To that end, we are prepared to file additional patent applications as we consider appropriate under the circumstances relating to the new technologies that we develop.",
        "start_character": 42503,
        "end_character": 42671
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011278",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011278-1c8cb3664315a389",
        "accession_number": "0001628280-26-011278",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are also developing a modular 800 kW system consisting of four KARNO Core units that is planned to be delivered to the U.S.",
        "start_character": 16436,
        "end_character": 16562
      }
