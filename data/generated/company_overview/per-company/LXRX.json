        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Consistent with this approach, we seek to retain exclusive rights to the benefits of certain research and development programs by developing and commercializing drug candidates from those programs internally, particularly in the United States for indications treated by specialist physicians.",
        "start_character": 19400,
        "end_character": 19692
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001062822-26-000050",
