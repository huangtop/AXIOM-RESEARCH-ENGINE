        "provenance_id": "provenance:SEC-FILING-0001193125-26-155933-33656d477c567710",
        "accession_number": "0001193125-26-155933",
        "filing_date": "2026-04-15",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Furthermore, we also offer college admission consultation services for students, which were upgraded to AI-based College Admission Adviser in 2024, offering more timely and personalized support.",
