        "provenance_id": "provenance:SEC-FILING-0001193125-26-155933-33656d477c567710",
        "accession_number": "0001193125-26-155933",
        "filing_date": "2026-04-15",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also generate revenues from global marketing and promotion services, which provides four main types of services, including integrated marketing, influencer campaigns, paid social advertising and live-streaming services.",
        "start_character": 52992,
        "end_character": 53214
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-155933",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-155933-33656d477c567710",
        "accession_number": "0001193125-26-155933",
        "filing_date": "2026-04-15",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also offer Youdao Ads, a global leading digital marketing solution for brand expansion in global markets, which provides four main types of services, including integrated marketing, influencer campaigns, paid social advertising and live-streaming services.",
