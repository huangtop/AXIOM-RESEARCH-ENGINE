        "filing_date": "2026-04-15",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As we continued to develop our learning services primarily including digital content services, STEAM courses and adult courses, we also benefitted from our strong course and content development capabilities.",
        "start_character": 29676,
        "end_character": 29883
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-155933",
