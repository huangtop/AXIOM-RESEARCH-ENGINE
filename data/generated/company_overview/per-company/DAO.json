        "end_character": 32419
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-155933",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-155933-33656d477c567710",
        "accession_number": "0001193125-26-155933",
        "filing_date": "2026-04-15",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Over the years, we have developed the following core technologies to deliver an effective and enjoyable learning experience to our users across our comprehensive suite of products and services.",
