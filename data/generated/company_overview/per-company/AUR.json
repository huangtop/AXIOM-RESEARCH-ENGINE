    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Additionally, we protect our proprietary rights through agreements with our commercial partners, supply-chain vendors, employees, and consultants, as well as close monitoring of the developments and products in the industry.",
        "start_character": 39893,
        "end_character": 40117
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As part of this partnership, we work with AUMOVIO to jointly design, develop, validate, deliver, and service the scalable autonomous system for the industry.",
        "start_character": 43794,
        "end_character": 43951
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Led by a team with deep experience, including Chris and Drew, we have launched and are continuing to develop the Aurora Driver based on what we believe to be the most advanced and scalable suite of self-driving hardware, software, and data services in the world to fundamentally transform the global transportation market.",
        "start_character": 490,
        "end_character": 812
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also continued to operate commercial trucking pilots throughout 2025 with FedEx, Schneider, Volvo Autonomous Solutions, and Werner, among others, through which we regularly and autonomously hauled loads under the supervision of vehicle operators, and we are also integrating access to Uber Freight’s digital freight network and McLeod’s transportation management system within our autonomous trucking subscription service.",
        "start_character": 6583,
        "end_character": 7008
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that our approach to technological development, coupled with our Driver as a Service business model, enables us to develop and scale our technology efficiently.",
        "start_character": 22657,
        "end_character": 22828
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We expect that these strategic partners will support activities such as vehicle manufacturing, financing and leasing, service and maintenance, parts replacement, facility ownership and operation, and other commercial and operational services as needed.",
        "start_character": 8380,
        "end_character": 8632
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "At Aurora, we work with the federal government to ensure it maintains its regulatory authority over the design, construction, and performance of motor vehicles, as well as over the safety of commercial motor vehicles operating interstate commerce, and applies that same authority to the regulation of autonomous vehicles.",
        "start_character": 45289,
        "end_character": 45610
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Because we use the same hardware stack across vehicle types, this reduces our cost to serve each end-market in which we operate.",
        "start_character": 18054,
        "end_character": 18182
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "By being able to recoup the significant majority of our development costs across multiple end markets, we increase the return on our overall investment, as well as each capability we develop.",
        "start_character": 17741,
        "end_character": 17932
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "By creating a common driver platform for multiple vehicle types and use cases, the capabilities we develop in one market reinforce and strengthen our competitive advantages in other areas.",
        "start_character": 1146,
        "end_character": 1334
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "From the beginning, we have invested in building a mission-driven company based on a set of values that drive who we are and how we operate.",
        "start_character": 23144,
        "end_character": 23284
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001828108-26-000016",
        "provenance_id": "provenance:SEC-FILING-0001828108-26-000016-6746492a9b782b90",
        "accession_number": "0001828108-26-000016",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Given the intense work in these areas, we expect several foreign markets to provide a workable path forward for autonomous vehicle operations in their respective jurisdictions in the near-term.",
        "start_character": 48030,
        "end_character": 48223
      }
    ]
  },
