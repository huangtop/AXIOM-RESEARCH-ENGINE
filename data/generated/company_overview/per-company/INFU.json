        "end_character": 11020
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012804",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012804-388b8925a1f49edb",
        "accession_number": "0001628280-26-012804",
