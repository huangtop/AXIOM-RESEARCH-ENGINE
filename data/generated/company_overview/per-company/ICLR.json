    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As the number of trials that need to be performed increases and these trials become focused in indications where finding suitable patients is increasingly challenging, we believe that drug developers will increasingly rely on CROs to manage these trials to leverage their global expertise and to continue to focus their own competencies on drug discovery and sales and marketing of commercialized products.",
        "start_character": 46649,
        "end_character": 47055
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For over thirty years we have grown significantly to become a global provider of outsourced development and services to pharmaceutical, biotechnology, medical device and government and public health organizations.",
        "start_character": 184,
        "end_character": 397
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "On October 2, 2023, the Company acquired 100% of the equity of BioTel Research, LLC which comprised the business formerly known as Philips Pharma Solutions, a leading provider of medical imaging and cardiac safety monitoring services.",
        "start_character": 2337,
        "end_character": 2571
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Quality project execution underpins all that we do and we have an ongoing focus on developing our people and processes to continue to enhance our service delivery.",
        "start_character": 35094,
        "end_character": 35257
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "The current market challenge in patient enrollment creates an opportunity for ICON to differentiate its service offering and we are working to reduce patient recruitment times through enhanced site and investigator selection based on key performance metrics and through use of our proprietary FIRECREST technology which is used to train and support sites during the development process.",
        "start_character": 27743,
        "end_character": 28129
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To meet the evolving needs of both our existing and new clients we continue to enhance our capabilities through both organic service development and targeted acquisitions.",
        "start_character": 32533,
        "end_character": 32704
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "To support this objective, we continue to evolve our collaboration and delivery models, invest in technology that will enable closer data integration across our service areas and enhance our project and program management capabilities.",
        "start_character": 32297,
        "end_character": 32532
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer full-service and functional service partnerships to our customers.",
        "start_character": 1578,
        "end_character": 1658
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are advancing clinical research while offering customers broader and deeper experience, scale, and focus, complemented by continuity of delivery and speed to market.",
        "start_character": 61194,
        "end_character": 61362
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are focused on operational excellence across our support functions, and we operate a global business support infrastructure across functions including finance, information technology, facilities, human resources, legal and quality assurance.",
        "start_character": 35385,
        "end_character": 35629
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We believe that we are one of a select group of CROs with the expertise and capability to conduct clinical trials in the major therapeutic areas on a global basis and have the operational flexibility to provide development services on a stand-alone basis or as part of an integrated full-service solution.",
        "start_character": 17492,
        "end_character": 17797
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-038487",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-038487-40f9eacf8fb77cf0",
        "accession_number": "0001628280-26-038487",
        "filing_date": "2026-05-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have achieved strong growth since our foundation in 1990, as a global provider of outsourced development and commercialization services to pharmaceutical, biotechnology, medical device and government and public health organizations.",
        "start_character": 18618,
        "end_character": 18853
      }
    ]
  },
