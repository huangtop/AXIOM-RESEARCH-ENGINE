        "accession_number": "0001730168-25-000121",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We focus our research and development efforts on the development of mission-critical, innovative, retentive and higher value product platforms and those that improve the quality and stability in our broadly-deployed products.",
        "start_character": 24369,
        "end_character": 24594
      },
