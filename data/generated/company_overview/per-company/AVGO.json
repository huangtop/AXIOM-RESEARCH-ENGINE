        "business_evidence_id": "business-evidence:SEC-0001730168-25-000121",
        "provenance_id": "provenance:SEC-FILING-0001730168-25-000121-06d618a7e0bacc1d",
        "accession_number": "0001730168-25-000121",
        "filing_date": "2025-12-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We leverage our design capabilities in markets where we believe our innovation and reputation will allow us to earn attractive margins by developing high value-add products.",
        "start_character": 24595,
        "end_character": 24768
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001730168-25-000121",
