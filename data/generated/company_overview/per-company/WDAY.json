    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By extending our go-to-market capabilities globally, we aim to grow our business by selling to new customers in new regions.",
        "start_character": 15282,
        "end_character": 15406
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we offer Workday Success Plans, a comprehensive, add-on subscription service that delivers continuous value for our customers through strategic advice, product expertise, adoption resources, on-demand education, and technical guidance.",
        "start_character": 18795,
        "end_character": 19043
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also face competition from other enterprise software vendors, from regional competitors that only operate in certain geographic markets, from vendors of specific applications that address only one or a portion of our applications, and from vendors that specialize in specific industries in which we provide services, some of which offer cloud-based or AI-powered solutions.",
        "start_character": 20251,
        "end_character": 20627
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer extensive customer training opportunities and a professional services ecosystem of experienced Workday consultants and system integrators to help customers achieve a timely adoption of Workday and enable them to enhance the value of our applications over the life of their subscription.",
        "start_character": 19044,
        "end_character": 19344
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer professional services, as do our Workday Services Partners, to help customers deploy our solutions and continually adopt new capabilities.",
        "start_character": 2912,
        "end_character": 3064
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also selectively acquire companies that are consistent with our design principles, existing product set, corporate strategy, and company culture, such as our acquisitions of Flowise, Paradox, Sana, and Pipedream in fiscal 2026.",
        "start_character": 13499,
        "end_character": 13729
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell our subscription contracts and related services and solutions globally through direct sales, through our sales partners, and over Workday Marketplace.",
        "start_character": 14227,
        "end_character": 14385
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell to emerging, medium-sized, and large global organizations that span numerous industry categories, including financial services, government, healthcare, higher education, hospitality, manufacturing, professional and business services, retail, technology and media, and transportation.",
        "start_character": 18046,
        "end_character": 18337
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Whether through creating resources that strengthen our culture, building inclusive products and technology, or developing great talent, we are building a vibrant workplace that fuels collaboration.",
        "start_character": 26202,
        "end_character": 26399
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For example, we developed Career Hub which helps our employees share skills and interests and receive relevant connections, curated learning content, and recommended jobs to help them on their career journeys.",
        "start_character": 27730,
        "end_character": 27939
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In fiscal 2026, we announced Workday Build, a new open developer platform that will give customers and our partners the ability to create and share AI-powered solutions directly on the Workday platform.",
        "start_character": 3221,
        "end_character": 3423
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001327811-26-000014",
        "provenance_id": "provenance:SEC-FILING-0001327811-26-000014-b1582d868a2a4954",
        "accession_number": "0001327811-26-000014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "This process helps ensure we pay according to the market value of the jobs we offer.",
        "start_character": 25432,
        "end_character": 25516
      }
