        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Brookfield Renewable seeks to make a positive difference for our people and the communities in which we operate.",
        "start_character": 64483,
        "end_character": 64595
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001791863-26-000004",
        "provenance_id": "provenance:SEC-FILING-0001791863-26-000004-e5da6b5f9b00d52f",
        "accession_number": "0001791863-26-000004",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In December 2024, we, together with institutional partners, entered into a strategic partnership with a leading eFuels manufacturer, to invest up to $1.1 billion (approximately $220 million net to Brookfield Renewable), consisting of a $200 million upfront structured equity investment, including the construction of a production facility in West Texas, and an exclusive right to invest up to $850 million in future projects that meet certain investment criteria.",
        "start_character": 18331,
        "end_character": 18794
      },
      {
