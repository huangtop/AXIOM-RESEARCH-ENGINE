        "accession_number": "0001791863-26-000004",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that our group’s scale and global operating, development and investing capabilities make our group well positioned to partner with governments and corporates to help them achieve their transition targets, while also improving the stability of grids through the delivery of secure, low-cost renewable power.",
        "start_character": 41282,
        "end_character": 41599
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001791863-26-000004",
        "provenance_id": "provenance:SEC-FILING-0001791863-26-000004-e5da6b5f9b00d52f",
        "accession_number": "0001791863-26-000004",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We continue to accelerate our group’s development activities as our group builds out Brookfield Renewable’s over 200 GW renewable power",
        "start_character": 39806,
        "end_character": 39941
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001791863-26-000004",
        "provenance_id": "provenance:SEC-FILING-0001791863-26-000004-e5da6b5f9b00d52f",
