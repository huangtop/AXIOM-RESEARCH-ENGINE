        "filing_date": "2026-02-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Our group complies with applicable laws in the countries in which we operate.",
        "start_character": 58720,
        "end_character": 58797
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001791863-26-000004",
