    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Space Systems, our line of business which we believe presents a substantial growth opportunity, is designed to enable us to sell our satellites directly to select customers to whom satellite ownership is important.",
        "start_character": 22832,
        "end_character": 23046
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a vertically integrated company that designs, manufactures, integrates and operates our own high-resolution imaging satellites, and the image processing pipeline necessary to deliver services to our customers, including images and value-added layers of semantic data.",
        "start_character": 35915,
        "end_character": 36189
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are committed to developing all of our people in different dimensions, including programmatic leadership, people leadership, business leadership and technological leadership.",
        "start_character": 27872,
        "end_character": 28049
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Beyond the EO market opportunity we continue to focus on addressing the growing market of satellite manufacturing and sales.",
        "start_character": 12890,
        "end_character": 13014
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "By entering into the SpaceX Agreement with a U.S.-based launch provider, we are directly and indirectly subject to the license requirements of the Office of Commercial Space Transportation (“AST”) of the Federal Aviation Administration (“FAA”).",
        "start_character": 46086,
        "end_character": 46330
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Having voluntarily subscribed to the United Nations Committee on Personal Uses of Outer Space orbital debris principles and guidance, we sought out the leading technical standards guiding responsible design, management, and test of space objects to meet the defined measures.",
        "start_character": 47084,
        "end_character": 47359
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In contrast, we seek to develop and deploy satellites that are significantly less expensive and physically smaller than those used by the incumbent providers.",
        "start_character": 14299,
        "end_character": 14457
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are a U.S.-incorporated company operating without the heavy burden of export controls based on our non-ITAR design and our principal manufacturing location in Montevideo, Uruguay.",
        "start_character": 3501,
        "end_character": 3683
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are a vertically integrated company, and we design our satellites and all of their subsystems, including onboard computers, propulsion system, telescopes, cameras, radios, sensors and actuators.",
        "start_character": 16757,
        "end_character": 16954
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that vertical integration across design, manufacturing and operations produces efficiencies up and down the value chain, which allows us to reduce intermediary costs, control quality and scale up more quickly.",
        "start_character": 26083,
        "end_character": 26303
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We believe that we are well-positioned to compete with legacy satellite providers and NewSpace geospatial data providers by shifting the industry paradigm from raw data collection to actionable, AI-driven intelligence.",
        "start_character": 14690,
        "end_character": 14908
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001874315-26-000013",
        "provenance_id": "provenance:SEC-FILING-0001874315-26-000013-71531bc714066683",
        "accession_number": "0001874315-26-000013",
        "filing_date": "2026-03-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We believe this enables us to rapidly and substantially grow the number of satellites we operate in Earth's orbit, establishing large constellations capable of frequent and comprehensive Earth observation at a fraction of the cost.",
        "start_character": 14458,
        "end_character": 14689
      }
