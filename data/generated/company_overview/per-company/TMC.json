        "offering_role": "product",
        "confidence": 0.92,
        "statement": "On March 29, 2019, we entered into a Strategic Alliance Agreement with Allseas, whereby the parties will conduct project development of an integrated offshore nodule collection system for use by our subsidiaries.",
        "start_character": 94883,
        "end_character": 95095
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-037863",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-037863-1ebf9a5769a1c140",
