        "accession_number": "0001104659-26-050766",
        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In November 2023, we established Chagee Holdings (UK) Limited under the laws of the United Kingdom, through which we operate our business in the United States and intend to explore expansion opportunities in other American markets.",
        "start_character": 1713,
        "end_character": 1944
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050766",
