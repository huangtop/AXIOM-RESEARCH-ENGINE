        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Once the plan receives final approval, we rely on the support of our robust supply chain center to ensure a stable supply of essential ingredients for the new offering.",
        "start_character": 35319,
        "end_character": 35487
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-050766",
