        "end_character": 18429
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-017047",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-017047-83b9ec8890d15000",
        "accession_number": "0001104659-26-017047",
        "filing_date": "2026-02-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we have provided certain services to a university partner to assist them in expanding their online graduate programs.",
