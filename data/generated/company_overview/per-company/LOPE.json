        "end_character": 88084
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-017047",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-017047-83b9ec8890d15000",
        "accession_number": "0001104659-26-017047",
        "filing_date": "2026-02-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "To this end, our business was created and continues to evolve to meet the needs of the local community in which we operate as well as those outside our community.",
        "start_character": 19492,
        "end_character": 19654
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-017047",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-017047-83b9ec8890d15000",
        "accession_number": "0001104659-26-017047",
        "filing_date": "2026-02-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide education services to numerous university partners across the United States.",
