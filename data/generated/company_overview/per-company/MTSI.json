        "end_character": 15556
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001493594-25-000054",
        "provenance_id": "provenance:SEC-FILING-0001493594-25-000054-8e22fdc3aca040e1",
        "accession_number": "0001493594-25-000054",
        "filing_date": "2025-11-14",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Further, we have been accredited by the United States Department of Defense with Trusted Foundry status which we believe differentiates us as a trusted manufacturer of ICs for U.S.",
        "start_character": 10473,
        "end_character": 10653
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001493594-25-000054",
        "provenance_id": "provenance:SEC-FILING-0001493594-25-000054-8e22fdc3aca040e1",
