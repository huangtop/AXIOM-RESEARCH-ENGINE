        "accession_number": "0001193125-26-226962",
        "filing_date": "2026-05-15",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Since most of our products are customizable, we encourage our website customers to get personal help from our interior design professionals, either in person or online.",
        "start_character": 72899,
        "end_character": 73067
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-226962",
