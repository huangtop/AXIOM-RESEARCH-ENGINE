        "end_character": 9217
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000950170-25-111331",
        "provenance_id": "provenance:SEC-FILING-0000950170-25-111331-d56e1a92f9d7e178",
        "accession_number": "0000950170-25-111331",
        "filing_date": "2025-08-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have developed this successful operating platform by improving operational and business processes and deriving value from sustainability-based initiatives, including polyester and nylon recycling.",
