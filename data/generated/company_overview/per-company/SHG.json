        "filing_date": "2026-04-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition to personalized wealth management services provided as part of our private banking and securities services, we also provide asset management services through Shinhan Asset Management, our wholly owned subsidiary.",
        "start_character": 77891,
        "end_character": 78115
      },
      {
