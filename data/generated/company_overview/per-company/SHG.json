        "accession_number": "0001193125-26-168235",
        "filing_date": "2026-04-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Chohung Bank historically was a dominant provider of such services since 1958, and following our acquisition of Chohung Bank, we continue to hold a dominant market share in these services.",
