        "provenance_id": "provenance:SEC-FILING-0001324404-26-000007-110cefe1e35b136b",
        "accession_number": "0001324404-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We will own and operate this infrastructure, and the Blue Point joint venture will compensate us for these services.",
        "start_character": 15665,
        "end_character": 15781
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001324404-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001324404-26-000007-110cefe1e35b136b",
        "accession_number": "0001324404-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "With our employees focused on safe and reliable operations, environmental stewardship, and disciplined capital and corporate management, we are on a path to decarbonize our ammonia production network – the world’s largest – to enable low-carbon hydrogen and nitrogen products for energy, fertilizer, emissions abatement and other industrial activities.",
        "start_character": 736,
        "end_character": 1088
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001324404-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001324404-26-000007-110cefe1e35b136b",
        "accession_number": "0001324404-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a result of the Terra acquisition, we acquired five nitrogen fertilizer manufacturing facilities;",
        "start_character": 20322,
        "end_character": 20422
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001324404-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001324404-26-000007-110cefe1e35b136b",
        "accession_number": "0001324404-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a result, we became focused solely on nitrogen manufacturing and distribution.",
