        "filing_date": "2025-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We attempt to minimize the effect of competition by offering a variety of loan options and value-added services and by leveraging the working relationships developed with the majority of our members over the past 56 years.",
        "start_character": 34219,
        "end_character": 34441
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000070502-25-000211",
