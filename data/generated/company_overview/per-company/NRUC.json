        "accession_number": "0000070502-25-000211",
        "filing_date": "2025-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We therefore strive to align our human capital management strategy with our member-focused mission and core values of service, integrity and excellence.",
