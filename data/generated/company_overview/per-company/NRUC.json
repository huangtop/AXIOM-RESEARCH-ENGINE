        "accession_number": "0000070502-25-000211",
        "filing_date": "2025-08-05",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "If a member system defaults on its obligation to pay debt service, then we are obligated to pay any required amounts under our guarantees.",
