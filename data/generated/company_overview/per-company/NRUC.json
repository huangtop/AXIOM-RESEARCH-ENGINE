        "end_character": 21301
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000070502-25-000211",
        "provenance_id": "provenance:SEC-FILING-0000070502-25-000211-4f074581bafb691b",
        "accession_number": "0000070502-25-000211",
        "filing_date": "2025-08-05",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "If a system defaults for failure to make the debt payments and any available debt service reserve funds have been exhausted, we are obligated to pay scheduled debt service under our guarantee.",
        "start_character": 22806,
        "end_character": 22998
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000070502-25-000211",
        "provenance_id": "provenance:SEC-FILING-0000070502-25-000211-4f074581bafb691b",
        "accession_number": "0000070502-25-000211",
        "filing_date": "2025-08-05",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "In exchange for a fee, we issue irrevocable letters of credit to support members’ obligations to energy marketers, other third parties and to the USDA Rural Business-Cooperative Service.",
