        "end_character": 41366
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000070502-25-000211",
        "provenance_id": "provenance:SEC-FILING-0000070502-25-000211-4f074581bafb691b",
        "accession_number": "0000070502-25-000211",
        "filing_date": "2025-08-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also continued our annual Leadership Development Program, designed for managers at all levels, by providing training opportunities aligned to CFC’s core leadership competencies.",
