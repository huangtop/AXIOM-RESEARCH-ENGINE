    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We leverage and enhance our collective strengths through collaboration and development initiatives by offering numerous opportunities for our employees to engage in personal and professional growth, including educational support and eligibility for tuition assistance and reimbursement, participation in industry conferences and networking events, individual leadership training, access to an online learning library, town hall meetings with our CEO and senior leadership team, sponsorship of employees through a women’s resource group, and peer mentorship opportunities.",
        "start_character": 28343,
        "end_character": 28914
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Within these sectors, we have meaningful concentrations in distribution and warehouse, manufacturing, food processing, general merchandise, quick service restaurants, and casual dining.",
        "start_character": 2806,
        "end_character": 2991
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In contrast, we may also seek to own real estate that is fungible, located in strong markets with solid fundamentals, and is highly marketable to a broad array of potential end users to ensure long-term occupancy regardless of tenant.",
        "start_character": 22095,
        "end_character": 22329
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are primarily focused on long-term, fee simple ownership of properties leased to national or large regional retailers operating in e-commerce resistant industries where the presence of a physical location is important to the end consumer and mission critical to the tenant.",
        "start_character": 22545,
        "end_character": 22821
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We compete for tenants to occupy our properties in all of our markets with other owners and operators of commercial real estate.",
        "start_character": 23550,
        "end_character": 23678
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We focus on single-tenant manufacturing, warehouse and distribution facilities, food processing, refrigerated storage, flex-space, and research and development facilities where the tenant has a strong credit profile and experienced management team.",
        "start_character": 21328,
        "end_character": 21576
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We seek to acquire, finance, and develop primarily freestanding, single-tenant commercial real estate properties located in the United States that are under lease and fully occupied at the time of acquisition or development completion.",
        "start_character": 19556,
        "end_character": 19791
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "•Community Engagement – We are committed to making a positive impact in the communities in which we operate through corporate philanthropy, employee volunteerism, and community partnerships.",
        "start_character": 29743,
        "end_character": 29933
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "As part of the commitment to our employees, we are focused on the following initiatives:",
        "start_character": 27264,
        "end_character": 27352
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "Because substantially all of our properties are leased under long-term leases, we are not currently required to perform significant ongoing leasing activities on our properties.",
        "start_character": 14373,
        "end_character": 14550
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "If our lessees do not comply with environmental law, or we are unable to enforce the indemnification obligations of our lessees, our results of operations would be adversely affected.",
        "start_character": 42998,
        "end_character": 43181
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001424182-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001424182-26-000012-04e4cb2671388574",
        "accession_number": "0001424182-26-000012",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "In order to qualify as a REIT, we are required under the Code, among other things, to distribute annually at least 90% of our REIT taxable income, determined without regard to the dividends paid deduction and excluding any net capital gain.",
