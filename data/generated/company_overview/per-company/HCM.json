      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-023822",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-023822-a6e3d6652c94ac30",
        "accession_number": "0001104659-26-023822",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have the right to manufacture the licensed product for development and commercialization in the licensed territory and are generally responsible for funding all clinical trials of tazemetostat, including the portion of global trials conducted in the licensed territory.",
        "start_character": 175987,
        "end_character": 176259
