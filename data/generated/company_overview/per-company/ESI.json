        "accession_number": "0001590714-26-000018",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We diligently focus on building and maintaining leading positions in niche sectors of high-growth markets by offering innovative products and high value-added services to our customers.",
