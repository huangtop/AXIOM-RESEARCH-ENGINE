    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By using a by-product of the milling process which is the bagasse (the fiber of the sugarcane), we cogenerate renewable electricity which is used to power our mills, and we then sell the balance to the local grid via long-term contracts and spot transactions.",
        "start_character": 12492,
        "end_character": 12751
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to complying with local labor regulations, we seek to promote the personal and professional development of our employees by offering them an adequate working environment with proper health and safety protections.",
        "start_character": 152680,
        "end_character": 152904
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we own two facilities where we process our raw milk, as well as third parties’ milk, and we sell our products to the domestic and export markets.",
        "start_character": 76265,
        "end_character": 76423
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In agriculture, we produce a diversified portfolio of products—including various crops, rice, sugarcane and dairy—supplying both our own industrial operations and third-party clients.",
        "start_character": 8295,
        "end_character": 8478
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Owning a portion of the land where we operate is a key element of our business model.",
        "start_character": 17233,
        "end_character": 17318
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also own two milk processing facilities where we produce ultra-high temperature (“UHT”) milk, powdered milk, semi-hard cheese, cream and chocolate milk, among other products, with the flexibility to sell to both the domestic and export market based on relative profitability.",
        "start_character": 16287,
        "end_character": 16565
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also promote the movement of selected contractors from developed regions into new marginal regions by offering them an opportunity to grow their businesses.",
        "start_character": 118204,
        "end_character": 118363
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide ancillary services including grain warehousing, conditioning, handling and drying.",
        "start_character": 8827,
        "end_character": 8925
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Additionally, we manage diet quality by adapting our feeding regime based on the various feeding stages in the lifetime of each cow.",
        "start_character": 79397,
        "end_character": 79529
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a hedging strategy, we sell the electricity production of our mills through long-term contracts adjusted for inflation by reference to the “IPCA”.",
        "start_character": 40945,
        "end_character": 41094
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "As of December 31, 2025, we operate four free-stall facilities with over 14,400 milking cows.",
        "start_character": 2069,
        "end_character": 2162
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001499505-26-000069",
        "provenance_id": "provenance:SEC-FILING-0001499505-26-000069-f2eb98155a8ea626",
        "accession_number": "0001499505-26-000069",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "During 2025, we also developed a new animal welfare protocol that more accurately reflects our production model and animal welfare program.",
        "start_character": 113939,
        "end_character": 114078
      }
