        "end_character": 33194
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-095014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-095014-68f1ef3d46af04fd",
        "accession_number": "0001193125-26-095014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are able to utilize the same general principles and similar drug discovery methods developed from our rezatapopt, p53 Y220C, program to facilitate the development of additional new product candidates.",
