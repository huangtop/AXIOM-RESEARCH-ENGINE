        "provenance_id": "provenance:SEC-FILING-0001193125-26-095014-68f1ef3d46af04fd",
        "accession_number": "0001193125-26-095014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are leveraging our precision oncology platform to develop a pipeline of oral small molecule product candidates.",
        "start_character": 18047,
        "end_character": 18161
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-095014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-095014-68f1ef3d46af04fd",
        "accession_number": "0001193125-26-095014",
        "filing_date": "2026-03-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are leveraging our precision oncology platform to develop a pipeline of orally available, potent and highly selective small molecule product candidates that target p53 mutations or other p53-related cancers.",
        "start_character": 4539,
        "end_character": 4749
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-095014",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-095014-68f1ef3d46af04fd",
