      },
      {
        "business_evidence_id": "business-evidence:SEC-0001872789-25-000036",
        "provenance_id": "provenance:SEC-FILING-0001872789-25-000036-c8ee1d45a857fd78",
        "accession_number": "0001872789-25-000036",
        "filing_date": "2025-11-25",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to pen needles, we sell sterile, single-use insulin syringes, which are used to inject insulin drawn from insulin vials.",
        "start_character": 1411,
        "end_character": 1543
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001872789-25-000036",
