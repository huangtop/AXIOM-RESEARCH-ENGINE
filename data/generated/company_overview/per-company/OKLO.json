    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "On December 4, 2025, we entered into an equity distribution agreement with sales agents pursuant to which we may offer and sell, at our sole discretion, shares of our common stock up to an aggregate gross sales price of $1,500.0 million in an \"at-the-market\" (\"ATM\") offering (the \"December ATM Program\").",
        "start_character": 19352,
        "end_character": 19657
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are developing next-generation fast fission power plants called “powerhouses.” In our differentiated build, own, and operate business model, we plan to sell power in the forms of electricity and heat directly to customers, which we believe can allow for fast-tracked customer adoption.",
        "start_character": 10887,
        "end_character": 11175
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, we plan to be the designer, builder, owner, and operator of our powerhouses and plan to focus on small-scale powerhouses (15 MWe, 75 MWe, and potentially 100 MWe and higher designs).",
        "start_character": 24440,
        "end_character": 24636
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Given our growth stage, we continue to develop and evaluate our overall cost and potential pricing structure as we evaluate our unit economics, which we expect to be subject to market and extrinsic forces such as the impact of construction costs as a result of tariffs, supply chain pressures, and other macroeconomic factors.",
        "start_character": 17312,
        "end_character": 17638
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In September 2025, we announced plans to design, build, and operate a fuel recycling facility in Tennessee as the first phase of an advanced fuel center (the \"Advanced Fuel Center\") to recycle used nuclear fuel into fuel for fast reactors, including our Aurora powerhouse line.",
        "start_character": 8039,
        "end_character": 8316
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition to our powerhouse and fuel recycling development, we are progressing construction of a pilot scale fuel fabrication facility and building plans for a first‑of‑a‑kind new commercial scale fuel fabrication facility.",
        "start_character": 11475,
        "end_character": 11700
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition to selling power under PPAs, we are taking steps to enhance our mission with our fuel fabrication projects and advanced nuclear fuel recycling technology.",
        "start_character": 17659,
        "end_character": 17825
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, we are a leader in the nuclear industry in the development of advanced fuel recycling, which can unlock the energy content of used nuclear fuel;",
        "start_character": 11176,
        "end_character": 11333
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In contrast, we plan to be the designer, builder, owner, and operator of our powerhouses and plan to focus on small-scale powerhouses (15 MWe-75 MWe, and potentially 100 MWe and higher).",
        "start_character": 14264,
        "end_character": 14450
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In particular, beyond developing recycling and fuel fabrication facilities, we are evaluating the use of alternative fuel materials, including plutonium currently designated for the DOE’s dilute-and-dispose programs, that may be made available by the U.S.",
        "start_character": 10067,
        "end_character": 10322
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "It is uncertain when, if at all, we will obtain NRC approvals for the design, construction, and operation of any of our powerhouses.",
        "start_character": 22989,
        "end_character": 23121
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-018698",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-018698-63e7de951c5b8e58",
        "accession_number": "0001628280-26-018698",
        "filing_date": "2026-03-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "On January 7, 2026, we announced the execution of a DOE Other Transaction Agreement (\"OTA\") to support the design, construction, and operation of a radioisotope pilot plant (“Radioisotope Pilot Facility”) under the DOE RPP.",
        "start_character": 20564,
        "end_character": 20787
      }
    ]
  },
