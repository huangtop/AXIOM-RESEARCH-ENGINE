        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "As we continue to invest in and grow both our business and our team, our employees continue to be guided by core principles shared across our organization on how we operate and behave.",
        "start_character": 58789,
        "end_character": 58973
      },
      {
