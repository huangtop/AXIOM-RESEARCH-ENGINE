    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to our B2C business, we have expanded our market opportunity by targeting corporate clients through our Swvl Business (TaaS) offerings.",
        "start_character": 18292,
        "end_character": 18439
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to our B2C offerings, we developed ways of diversifying our revenues and identifying potentially higher-margin offerings.",
        "start_character": 9196,
        "end_character": 9329
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also plan to offer fleet management consulting and reporting services.",
        "start_character": 11434,
        "end_character": 11507
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are also subject to seasonality in certain sectors of our B2B offerings, for example, our contracts with schools, universities and other educational institutions have low activity during the summer months, which are between July and September of each year within our operating markets.",
        "start_character": 6970,
        "end_character": 7258
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are also subject to seasonality in certain sectors of our B2C offerings, for example, during the summer season in Egypt, from July to September, we observe high activity due to more people commuting for vacation.",
        "start_character": 7465,
        "end_character": 7680
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are planning to introduce value-added services, such as premium ride subscriptions, corporate mobility solutions, and white-label transit offerings, to drive cross-sell and upsell opportunities, which can potentially unlock new revenue streams while strengthening customer engagement.",
        "start_character": 26634,
        "end_character": 26921
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We believe that the technology powering our offerings (please see the section entitled “Our Technology” below), as well as our early entry into the mass-transit ridesharing space (and the network effects that such early entry enables), have allowed and will allow us to scale our business efficiently, in turn enabling us to create and maintain a strong competitive position in the markets in which we operate.",
        "start_character": 17881,
        "end_character": 18291
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that these developed markets are more attractive for our services, given that these markets (i) have larger addressable Taas/SasS mass transit markets, (ii) higher prices can be charged for the same offering when compared to developing markets which results in higher margins, and (iii) their public transport systems function efficiently, yet still have the potential efficiency improvements.",
        "start_character": 30450,
        "end_character": 30854
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We currently serve the customers on our platform through two offerings: B2C and B2B (marketed as Swvl Business), which includes our TaaS and SaaS model.",
        "start_character": 7695,
        "end_character": 7847
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Whereas other companies in the ridesharing industry focus on one or two product categories (such as intracity and intercity B2C offerings), our offerings include both B2C and B2B offerings, which provide our business with multiple avenues for growth.",
        "start_character": 19303,
        "end_character": 19553
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Further, intellectual property laws vary from country to country, and we are in the process of transferring our intellectual property from Egypt to other jurisdictions in which we operate.",
        "start_character": 35526,
        "end_character": 35714
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-045255",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-045255-9ee13944ff3fada6",
        "accession_number": "0001104659-26-045255",
        "filing_date": "2026-04-20",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are a technology-driven disruptive mobility company that aims to provide reliable, safe, cost-effective and environmentally responsible mass transit solutions.",
        "start_character": 426,
        "end_character": 588
      }
    ]
  },
