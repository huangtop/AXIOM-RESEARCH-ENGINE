        "end_character": 2270
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000723125-25-000028",
        "provenance_id": "provenance:SEC-FILING-0000723125-25-000028-7deb81957a1fa7ec",
        "accession_number": "0000723125-25-000028",
        "filing_date": "2025-10-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are also focused on developing new and fundamentally different memory structures, materials, and packages designed to facilitate our transition to next generation products.",
