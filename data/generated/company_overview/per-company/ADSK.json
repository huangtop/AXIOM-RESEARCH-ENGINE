        "filing_date": "2026-03-03",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are expanding these offerings based upon demand and opportunity in response to challenges posed by climate change.",
        "start_character": 23972,
        "end_character": 24089
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000769397-26-000015",
        "provenance_id": "provenance:SEC-FILING-0000769397-26-000015-8ee57003566d14c6",
        "accession_number": "0000769397-26-000015",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are undertaking a multi-year process to develop lifecycle solutions within and between our industry clouds, powered by shared platform services, and with our data model at its core.",
        "start_character": 10502,
        "end_character": 10686
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000769397-26-000015",
        "provenance_id": "provenance:SEC-FILING-0000769397-26-000015-8ee57003566d14c6",
        "accession_number": "0000769397-26-000015",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We plan to continue managing significant product development operations internationally over the next several years.",
        "start_character": 12838,
        "end_character": 12954
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000769397-26-000015",
        "provenance_id": "provenance:SEC-FILING-0000769397-26-000015-8ee57003566d14c6",
        "accession_number": "0000769397-26-000015",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell our products and services globally, through a combination of direct and indirect channels.",
        "start_character": 13494,
        "end_character": 13592
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000769397-26-000015",
        "provenance_id": "provenance:SEC-FILING-0000769397-26-000015-8ee57003566d14c6",
        "accession_number": "0000769397-26-000015",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We strive to increase our competitive separation by investing in research and development, allowing us to bring new products to market and create exciting new versions of existing products that offer compelling efficiencies for our customers.",
        "start_character": 27927,
        "end_character": 28169
      },
      {
