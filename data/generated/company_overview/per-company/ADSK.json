        "accession_number": "0000769397-26-000015",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To drive continued progress and meet growing demand, we continue to expand the solutions, education, and support we offer, helping customers secure a competitive advantage for a low-carbon future by designing high-performance buildings, resilient cities and infrastructure, and more efficient transportation and products.",
        "start_character": 23412,
        "end_character": 23733
