        "end_character": 10501
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000769397-26-000015",
        "provenance_id": "provenance:SEC-FILING-0000769397-26-000015-8ee57003566d14c6",
        "accession_number": "0000769397-26-000015",
        "filing_date": "2026-03-03",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a global leader in 3D design, engineering and entertainment technology solutions, spanning architecture, engineering, construction, product design, manufacturing, media, and entertainment.",
        "start_character": 108,
        "end_character": 303
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000769397-26-000015",
        "provenance_id": "provenance:SEC-FILING-0000769397-26-000015-8ee57003566d14c6",
