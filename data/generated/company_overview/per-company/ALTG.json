        "accession_number": "0001193125-26-076932",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition to repair and maintenance on an as needed or scheduled basis, we provide ongoing preventative maintenance services and warranty repairs for our customers.",
        "start_character": 4846,
        "end_character": 5012
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-076932",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-076932-7fa8473b310608d6",
