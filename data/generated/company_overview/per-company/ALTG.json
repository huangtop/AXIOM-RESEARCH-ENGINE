        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Notably, we are the exclusive OEM replacement parts distributor in substantially all our territories, allowing us to provide superior aftermarket service support to our customers.",
