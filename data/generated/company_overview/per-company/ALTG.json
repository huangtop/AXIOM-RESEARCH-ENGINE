        "accession_number": "0001193125-26-076932",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Equipment rental is complementary to our new and used equipment sales and is an important component of our business model, allowing customers to be flexible with their capital spend on equipment needed to operate their businesses.",
        "start_character": 10636,
        "end_character": 10866
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-076932",
