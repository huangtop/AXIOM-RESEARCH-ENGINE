        "accession_number": "0001193125-26-076932",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our business system is a full suite of highly integrated software solutions intended to manage equipment dealership activities at all essential levels.",
