    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Along with all other Coca‑Cola bottlers in the United States and Canada, we are a member of Coca-Cola Bottlers’ Sales & Services Company LLC (“CCBSS”), which was formed to provide certain procurement and other services with the intention of enhancing the efficiency and competitiveness of the Coca‑Cola bottling system.",
        "start_character": 16451,
        "end_character": 16770
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Along with certain other Coca‑Cola bottlers, we are a member of CONA Services LLC (“CONA”), an entity formed to provide business process and information technology services to its members.",
        "start_character": 11287,
        "end_character": 11475
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "As a manufacturer, distributor and seller of beverage products of The Coca‑Cola Company and other beverage companies in exclusive geographic territories, we are subject to antitrust laws of general applicability.",
        "start_character": 25510,
        "end_character": 25722
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In exchange for our rights to use the CONA System and receive CONA-related services, we are charged service fees by CONA, which we are obligated to pay even if we are not using the CONA System for all or any portion of our distribution and manufacturing operations.",
        "start_character": 12128,
        "end_character": 12393
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "It has also been proposed that the federal government, through agencies such as the United States Department of Health and Human Services, or individual states enact policies that would discourage consumption of our products or ban or restrict the usage of certain ingredients used in the manufacture of the products that we sell.",
        "start_character": 28361,
        "end_character": 28691
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "On March 31, 2017, we entered into an amended and restated ancillary business letter (the “Ancillary Business Letter”) with The Coca‑Cola Company, pursuant to which we were granted advance waivers to acquire or develop certain lines of business involving the preparation, distribution, sale, dealing in or otherwise using or handling of certain beverage products that would otherwise be prohibited under the CBA.",
        "start_character": 12441,
        "end_character": 12853
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The Coca‑Cola Company has no rights under the incidence-based pricing agreement to establish the prices, or the elements of the formulas used to determine the prices, at which we sell products, but does have the right to establish certain pricing under other agreements, including the RMA.",
        "start_character": 9485,
        "end_character": 9774
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The Company also distributes its products using alternative routes to market (“ARTM”), which include distribution by third-party distributors, the manufacturer of the product or the customer’s supply chain infrastructure.",
        "start_character": 18288,
        "end_character": 18509
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Through our Total Rewards Program, we strive to offer competitive compensation, benefits and services to our full-time teammates, including incentive plans, recognition plans, defined contribution plans, healthcare benefits, tax-advantaged spending accounts, corporate chaplaincy, employee assistance programs and other programs.",
        "start_character": 33510,
        "end_character": 33839
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are party to an amended and restated master services agreement with CONA, pursuant to which CONA agreed to make available, and we became authorized to use, the Coke One North America system (the “CONA System”), a uniform information technology system developed to promote operational efficiency and uniformity among North American Coca‑Cola bottlers.",
        "start_character": 11476,
        "end_character": 11829
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell our products primarily in single-use, recyclable bottles and cans in varying package configurations from market to market.",
        "start_character": 20508,
        "end_character": 20638
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-009057",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-009057-bd0c8ad049eda152",
        "accession_number": "0001628280-26-009057",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Coca‑Cola Consolidated, Inc., a Delaware corporation (together with its majority-owned subsidiaries, “Coca‑Cola Consolidated,” the “Company,” “we,” “us” or “our”), distributes, markets and manufactures nonalcoholic beverages in territories spanning 14 states and the District of Columbia.",
        "start_character": 30,
        "end_character": 318
      }
    ]
