        "provenance_id": "provenance:SEC-FILING-0001193125-26-064005-34856d9e89323805",
        "accession_number": "0001193125-26-064005",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our competitors also may obtain FDA or other regulatory approval for their products more rapidly than we may obtain approval for ours, which could result in our competitors establishing a strong market position before we are able to enter the market or that may make our development more complicated.",
        "start_character": 82770,
        "end_character": 83070
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-064005",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-064005-34856d9e89323805",
