        "accession_number": "0001193125-26-064005",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we are obligated to use commercially reasonable efforts to develop and commercialize at least one licensed product in certain major markets.",
