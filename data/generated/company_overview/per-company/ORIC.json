        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Except for Voronoi’s right to participate in such development activities, we are wholly responsible for development and commercialization of licensed products in the ORIC Territory.",
        "start_character": 60728,
        "end_character": 60909
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-064005",
