        "accession_number": "0001437749-26-012531",
        "filing_date": "2026-04-16",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In Oklahoma, we are focused on the development of our reserves in Canadian, Grady, Kingfisher, Garfield, Major, and Garvin counties where we have approximately 4,015 net leasehold acres in the Scoop/Stack Play.",
        "start_character": 12996,
        "end_character": 13206
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-012531",
