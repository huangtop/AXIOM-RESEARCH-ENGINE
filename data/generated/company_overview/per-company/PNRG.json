        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In 2026, we plan to continue our focus on preserving financial flexibility and liquidity as we manage the risks facing our industry.",
        "start_character": 3253,
        "end_character": 3385
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-012531",
