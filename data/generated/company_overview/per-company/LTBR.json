    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In October 2025, we entered into an Agreement for Safety Analysis Codes and Services for Lightbridge Fuel Designs with Numerical Advisory Solutions, LLC (NAS), a provider of nuclear engineering analysis software.",
        "start_character": 47693,
        "end_character": 47905
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "That said, we believe Lightbridge Fuel™ remains the only advanced light-water reactor fuel in development that can provide power uprates, cycle length extensions, improved safety, and load following in a single product as desired by the utilities.",
        "start_character": 56549,
        "end_character": 56796
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In November 2025, we announced the start of irradiation testing of the Company’s recently manufactured enriched uranium-zirconium alloy fuel material coupon samples in the ATR at INL.",
        "start_character": 41301,
        "end_character": 41484
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to our issued and pending patents, we rely on trade secrets and proprietary know-how related to our nuclear fuel technology, design methodologies, and development processes.",
        "start_character": 60035,
        "end_character": 60220
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In the short to medium term, we expect the development of the fabrication processes for Lightbridge Fuel™ to continue to be performed utilizing existing facilities and equipment within the DOE national laboratory complex at Idaho National Laboratory (INL).",
        "start_character": 16575,
        "end_character": 16831
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Our patent applications are directed to our proprietary nuclear fuel technology and we seek additional patent protection for our fuel designs, development, and related alternatives by filing patent applications in the U.S.",
        "start_character": 59776,
        "end_character": 59998
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We anticipate fuel development milestones for Lightbridge Fuel™ over the next 2-3 years will consist of the following:",
        "start_character": 25676,
        "end_character": 25794
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are developing next generation nuclear fuel for water-cooled reactors that could significantly improve the economics and safety of existing and new nuclear power plants, large and small, and enhance proliferation resistance of spent nuclear fuel while supplying clean energy to the electric grid or to “behind the meter” customers for electric power, including data centers.",
        "start_character": 405,
        "end_character": 782
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are engaged in the design and development of proprietary, innovative nuclear fuels to improve the cost-competitiveness, safety, proliferation resistance and performance of nuclear power generation.",
        "start_character": 4558,
        "end_character": 4758
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are passionate about understanding the needs of our society, and we work hard to develop our next generation nuclear fuel.",
        "start_character": 67196,
        "end_character": 67321
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe our fuel designs, which use multi-lobe metallic fuel rods with a proprietary helical geometry that enhances heat transfer with the goal of improving thermal margins, may allow current and new-build nuclear reactors to safely increase power production and reduce operations and maintenance costs on a per kilowatt-hour basis.",
        "start_character": 7125,
        "end_character": 7460
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001076",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001076-76919022590565a9",
        "accession_number": "0001477932-26-001076",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe our proprietary nuclear fuel designs have the potential, based on our preliminary evaluations, to improve the nuclear power industry’s economics by:",
        "start_character": 6512,
        "end_character": 6671
      }
    ]
