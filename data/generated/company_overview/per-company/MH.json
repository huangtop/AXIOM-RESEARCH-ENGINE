        "filing_date": "2026-06-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "However, many of the laws and regulations to which we are subject continue to develop and could be interpreted, applied or amended in ways that are unfavorable to our business.",
        "start_character": 33237,
        "end_character": 33413
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001951070-26-000022",
