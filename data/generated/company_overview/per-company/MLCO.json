        "accession_number": "0001193125-26-105023",
        "filing_date": "2026-03-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have leased an area within City of Dreams Sri Lanka, which is an integrated resort developed and operated by a subsidiary of John Keells, Waterfront Properties, under our brand “City of Dreams Sri Lanka” in accordance with a brand license agreement, to operate a casino business.",
