        "end_character": 23974
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000927653-26-000069",
        "provenance_id": "provenance:SEC-FILING-0000927653-26-000069-aa9f07b0f4e3fb61",
        "accession_number": "0000927653-26-000069",
        "filing_date": "2026-05-08",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide solutions to our customers including supply management technology, world-class marketing programs, managed care, and services to help them meet their business and quality goals.",
