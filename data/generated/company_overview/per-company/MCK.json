        "filing_date": "2026-05-08",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also provide specialty health services in Canada and biopharma services to pharmaceutical manufacturers, including a national network of specialized pharmacies and patient support and care programs.",
        "start_character": 15714,
        "end_character": 15915
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000927653-26-000069",
