        "accession_number": "0000927653-26-000069",
        "filing_date": "2026-05-08",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We develop customized plans to address the product, operational, and clinical support needs of our customers, including inventory management, reducing administrative burdens, and training and educating clinical staff.",
        "start_character": 22286,
        "end_character": 22503
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000927653-26-000069",
        "provenance_id": "provenance:SEC-FILING-0000927653-26-000069-aa9f07b0f4e3fb61",
        "accession_number": "0000927653-26-000069",
        "filing_date": "2026-05-08",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have undertaken additional strategic initiatives in recent years designed to increase operational efficiencies, focus on our core healthcare businesses, execute our business strategy, and enhance our competitive position.",
