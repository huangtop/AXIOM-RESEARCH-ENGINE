        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Also, designated staff at our corporate, business and facility levels help identify, prioritize and manage sustainability-related risks and opportunities, and we have a responsible operations working group made up of global manufacturing and technical experts who are focused on key operational issues related to water and GHG emissions.",
        "start_character": 41721,
        "end_character": 42058
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001856485-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001856485-26-000008-025ff239fdfd1b26",
