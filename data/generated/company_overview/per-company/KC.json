    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "At project initiation, we provide planning services with in-depth industry know-how, setting the overarching route for cloud migration.",
        "start_character": 44337,
        "end_character": 44472
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Based on the variety of cloud products, we have designed various industry-specific solutions that can unleash the full potential of our infrastructure resources and add value to our customers.",
        "start_character": 43859,
        "end_character": 44051
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "For example, we have obtained ISO 9001 for Quality Management System, ISO 20000-1 for Service Management System, ISO 27001 for Information Security Management, ISO 22301 for Business Continuity Management Systems, ISO 27018 for Protection of Personally Identifiable Information for Public Cloud and ISO 27017 for Cloud Security Management System.",
        "start_character": 112086,
        "end_character": 112432
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In September 2020, we completed a public offering in which we offered an aggregate of 9,250,000 ADSs and our selling shareholders sold an aggregate of 8,421,576 ADSs.",
        "start_character": 1358,
        "end_character": 1524
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition to developing advanced cloud technologies, we aim to build and deliver more enabling products and services to all stakeholders.",
        "start_character": 118670,
        "end_character": 118809
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Instead of merely providing cloud solutions to facilitate the entire cloud adoption process, we also offer end-to-end fulfillment and deployment services, ranging from planning, solution development, fulfillment and deployment, as well as ongoing maintenance and upgrade.",
        "start_character": 42819,
        "end_character": 43090
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Leveraging abundant IDC resources and hybrid cloud networking experience, we design high-availability and cost-effective underlying architecture solutions for the application deployment of our clients, effectively reducing operational costs and improving business productivity.",
        "start_character": 83796,
        "end_character": 84073
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Leveraging our cloud infrastructure, we provide various advanced cloud products that can be utilized to design different solutions to meet various business needs.",
        "start_character": 42498,
        "end_character": 42660
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Leveraging the relationship we built with our clients through our cloud delivery products, we have the natural advantage to cross-sell other cloud products, such as computing, storage and database products, to explore additional monetization opportunities.",
        "start_character": 77794,
        "end_character": 78050
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We aim to deliver high-quality cloud services with careful data and information protection, and we are in relentless pursuit of security-driven innovations to provide effective solutions.",
        "start_character": 109029,
        "end_character": 109216
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We allocate a substantial portion of our operating expenses to research and development, including upgrading our infrastructure, improving our cloud technology and developing new products and solutions.",
        "start_character": 107021,
        "end_character": 107223
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-047100",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-047100-668152faa2606b83",
        "accession_number": "0001104659-26-047100",
        "filing_date": "2026-04-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer our solutions in a holistic approach by merging our cloud solutions with dedicated customer services.",
        "start_character": 40264,
        "end_character": 40379
      }
    ]
  },
