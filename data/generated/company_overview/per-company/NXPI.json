        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Where we consider it desirable, we develop names for our new products and secure trademark protection.",
        "start_character": 39273,
        "end_character": 39375
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001413447-26-000008",
