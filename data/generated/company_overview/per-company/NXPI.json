      {
        "business_evidence_id": "business-evidence:SEC-0001413447-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001413447-26-000008-f2e10b0ac17375f4",
        "accession_number": "0001413447-26-000008",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we invest a few percent of our total research and development expenditures in research activities that drive innovative products or technologies that could contribute significantly to our company's growth in the future.",
        "start_character": 35382,
        "end_character": 35614
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001413447-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001413447-26-000008-f2e10b0ac17375f4",
        "accession_number": "0001413447-26-000008",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Using our strong Automotive & Industrial portfolios, we are enhancing our product offerings by providing system solution platforms including safety case enablement and software defined vehicle (SDV) middleware for the growing ecosystems in & around vehicles, smart factories, robotics, homes and buildings.",
        "start_character": 13501,
        "end_character": 13807
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001413447-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001413447-26-000008-f2e10b0ac17375f4",
        "accession_number": "0001413447-26-000008",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We annually perform a fundamental review of our business portfolio and our related new product and technology development opportunities to decide on changes in the allocation of our research and development resources.",
        "start_character": 35615,
        "end_character": 35832
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001413447-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001413447-26-000008-f2e10b0ac17375f4",
        "accession_number": "0001413447-26-000008",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We engage with leading global companies and sell products in all major geographic regions.",
        "start_character": 904,
        "end_character": 994
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001413447-26-000008",
