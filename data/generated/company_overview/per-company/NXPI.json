        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As part of this consolidation, we have made equity investments in the following joint venture manufacturing companies with the aim of facilitating this transition:",
        "start_character": 27324,
