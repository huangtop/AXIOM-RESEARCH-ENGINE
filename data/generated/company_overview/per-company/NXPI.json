        "accession_number": "0001413447-26-000008",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We primarily focus our internal and joint venture wafer manufacturing operations on running proprietary specialty process technologies that enable us to differentiate our products on key performance features, and we generally outsource wafer manufacturing in process technologies that are available at third-party wafer foundries when it is economical to do so.",
        "start_character": 26131,
        "end_character": 26492
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001413447-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001413447-26-000008-f2e10b0ac17375f4",
