    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "According to Frost & Sullivan, we are the first carrier-neutral data center service providers in China with infrastructure interconnected with all major network providers, which connect and share data traffic to help scale the rapid development of the early internet industry in China.",
        "start_character": 18149,
        "end_character": 18434
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As a carrier-neutral data center service provider, we provide high interconnectivity to our customers with our access to multiple carriers and service providers and the availability of multiple-provider bandwidth.",
        "start_character": 23274,
        "end_character": 23487
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As a result, we are able to provide service-level agreement for 99.9% uptime for power for our self-built data centers.",
        "start_character": 23154,
        "end_character": 23273
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As of December 31, 2025, we had over 1,500 customers for our managed hosting services and over 7,000 enterprise customers in total.",
        "start_character": 19989,
        "end_character": 20120
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As of December 31, 2025, we had over 7,000 enterprise customers, of which over 1,500 enterprise customers are using our managed hosting services.",
        "start_character": 42268,
        "end_character": 42413
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "As of December 31, 2025, we operate self-built data centers and partnered data centers mainly located in tier-1 and surrounding cities in China, including all major internet hubs, as well as locations in Southeast Asia, with an aggregate capacity in service of 889MW from our wholesale IDC business and 49,863 cabinets in service from our retail IDC business.",
        "start_character": 35823,
        "end_character": 36182
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As of the date of this annual report, we are qualified to provide broadband access services in Beijing.",
        "start_character": 88533,
        "end_character": 88636
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As one of the leading service providers in each one of these value-added service markets, we believe our offerings not only complement our core hosting services, but also position us to capture additional growth opportunities.",
        "start_character": 56166,
        "end_character": 56392
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Aside from standard products, we are also leveraging and embedding our ecosystem’s offerings to provide turnkey hybrid cloud solutions for our key customers.",
        "start_character": 51680,
        "end_character": 51837
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Based on our partnership with Microsoft to introduce Azure and Microsoft 365 (formerly Office 365) in China in 2013, we are also the first carrier-neutral data center service provider to offer global cloud services in China and our services have helped accelerate the digital transformation of our enterprise customers.",
        "start_character": 18435,
        "end_character": 18754
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Based on the foregoing, we are not required to complete filing with the CSRC for our prior overseas offerings at this stage, but we may be subject to the filing requirements for our future capital raising activities under the Overseas Listing Regulations.",
        "start_character": 169809,
        "end_character": 170064
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044361",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044361-fc52ca146091f93e",
        "accession_number": "0001104659-26-044361",
        "filing_date": "2026-04-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Depending on customer needs, we provide different levels of tailored server administration services, including operating system support and assistance with updates, server monitoring, server backup and restoration, server security evaluation, firewall services, and disaster recovery.",
        "start_character": 27534,
        "end_character": 27818
      }
