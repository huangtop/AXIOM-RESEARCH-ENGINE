    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Any product candidates that we successfully develop and commercialize will compete with existing therapies and new therapies that may become available in the future.",
        "start_character": 59206,
        "end_character": 59371
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Future legislation could limit payments for pharmaceuticals such as IGALMI® and the product candidates that we are developing.",
        "start_character": 158437,
        "end_character": 158563
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also plan to maintain the current drug substance and product manufacturer as part of our supply chain strategy.",
        "start_character": 78692,
        "end_character": 78806
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We currently rely on strategic manufacturing partners, in particular ARx, LLC (“ARx”), and expect to continue to rely on third parties for the manufacture of our product candidates for clinical research and our products for commercialization efforts.",
        "start_character": 60272,
        "end_character": 60522
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have selected a larger third-party drug product manufacturer and will be executing technology transfer of drug product manufacture to a larger manufacturer.",
        "start_character": 78532,
        "end_character": 78691
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We rely on third party contract manufacturing organizations to support development and manufacture of product candidates for our clinical trials, and, if any of our current or future product candidates receives marketing approval, we expect to rely on such manufacturers to meet commercial demand.",
        "start_character": 77308,
        "end_character": 77605
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As described further below, we have deprioritized the development of BXCL501 for certain other proposed indications.",
        "start_character": 3918,
        "end_character": 4034
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As part of the Clinical Reprioritization we paused our plan to develop a Phase 2 human proof-of-concept trial design to investigate BXCL501 as a potential adjunctive treatment and its potential accelerant effect in combination with first-line selective serotonin reuptake inhibitors or serotonin-norepinephrine reuptake inhibitors.",
        "start_character": 45221,
        "end_character": 45552
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Finally, with respect to neuropsychiatric indications, we prioritize those compounds with structural design features that we believe may contribute to high blood-brain barrier permeability and therefore could increase the likelihood of compound penetration into the brain.",
        "start_character": 9555,
        "end_character": 9827
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In June 2021, we initiated a global clinical trial designed to evaluate the safety and efficacy of BXCL501 in the acute treatment of agitation associated with pediatric schizophrenia and bipolar disorders, in part to fulfill pediatric study requirements agreed to with the FDA in connection with the approval of IGALMI®.",
        "start_character": 45569,
        "end_character": 45889
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to its potential use in combination with CPIs to treat mCRPC, an immunologically cold tumor, we have been developing BXCL701 as a therapeutic for pancreatic cancer, and other solid tumors with greater, or “non-cold,” immunological activity that are nonetheless regarded as difficult-to-treat, and hematological malignancies.",
        "start_character": 72653,
        "end_character": 72989
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036214",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036214-cfa0177201e14fcc",
        "accession_number": "0001104659-26-036214",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, based on the preclinical observation that BXCL701 showed direct cytotoxic activity against certain leukemic cells, we have initiated clinical development targeting relapsed or refractory acute myeloid leukemia (“AML”).",
        "start_character": 73732,
        "end_character": 73963
      }
    ]
  },
