        "confidence": 0.96,
        "statement": "The Company operates in a highly competitive environment across its various business segments.",
        "start_character": 34150,
        "end_character": 34244
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-023561",
