        "accession_number": "0001193125-26-295158",
        "filing_date": "2026-07-06",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "The Company operates at the intersection of immune profiling, research-use immune reagents and in vitro diagnostics.",
        "start_character": 12559,
        "end_character": 12675
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-295158",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-295158-52ee87b9ed5bdc2e",
        "accession_number": "0001193125-26-295158",
        "filing_date": "2026-07-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are a biotechnology company focused on immune response detection, T cell immune profiling and the development of in vitro diagnostic technologies for viral and immune-mediated diseases.",
        "start_character": 5778,
        "end_character": 5966
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-295158",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-295158-52ee87b9ed5bdc2e",
        "accession_number": "0001193125-26-295158",
        "filing_date": "2026-07-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are designing ViraxImmune™ with the objective of making the assay workflow as practical and transferable as possible for appropriately qualified laboratory partners, although there can be no assurance that we will achieve this objective or that laboratories, healthcare providers or other customers will adopt the platform.",
        "start_character": 17074,
        "end_character": 17400
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-295158",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-295158-52ee87b9ed5bdc2e",
        "accession_number": "0001193125-26-295158",
        "filing_date": "2026-07-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are developing ViraxImmune™ as a T cell immune profiling and in vitro diagnostic platform intended to measure and characterize immune responses and other markers of immune dysfunction in selected disease areas.",
        "start_character": 15888,
        "end_character": 16101
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-295158",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-295158-52ee87b9ed5bdc2e",
        "accession_number": "0001193125-26-295158",
        "filing_date": "2026-07-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are developing ViraxImmune™ as a potential immune-profiling platform that may, if successfully validated, have applications across multiple disease areas where T cell responses, immune dysfunction, chronic inflammation or immune exhaustion are believed to be clinically relevant.",
        "start_character": 6921,
        "end_character": 7203
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-295158",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-295158-52ee87b9ed5bdc2e",
        "accession_number": "0001193125-26-295158",
        "filing_date": "2026-07-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We continue to invest in research and development activities relating to ViraxImmune™, ImmuneSelect and related immune profiling technologies.",
        "start_character": 20386,
        "end_character": 20528
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-295158",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-295158-52ee87b9ed5bdc2e",
        "accession_number": "0001193125-26-295158",
        "filing_date": "2026-07-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have selected PAIS as our initial development focus because these conditions represent areas of unmet clinical need where objective tools to characterize immune dysfunction remain limited.",
        "start_character": 7404,
        "end_character": 7595
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-295158",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-295158-52ee87b9ed5bdc2e",
        "accession_number": "0001193125-26-295158",
        "filing_date": "2026-07-06",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We operate in highly competitive and evolving markets, including immune profiling, research-use immune reagents and in vitro diagnostics.",
