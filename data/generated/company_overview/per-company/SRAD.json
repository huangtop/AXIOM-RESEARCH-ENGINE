        "provenance_id": "provenance:SEC-FILING-0001104659-26-035485-93a3a614e5586c0a",
        "accession_number": "0001104659-26-035485",
        "filing_date": "2026-03-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Through our advanced development environment, we are able to quickly distribute product improvements using modern CI/CD techniques, ensuring that every release is built against stringent quality gates but can still be delivered in the shortest timeframe possible.",
