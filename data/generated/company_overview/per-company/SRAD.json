        "accession_number": "0001104659-26-035485",
        "filing_date": "2026-03-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Further, we provide our Competition Management services, which include integrated solutions to collect live data with API solutions to multiple leagues and federations.",
