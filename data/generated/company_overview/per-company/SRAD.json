        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that our Managed Trading Services (“MTS”), Sports Betting & Gaming platform, and Marketing services provide clients with significant value and these products are currently underpenetrated in our existing betting client base.",
        "start_character": 28639,
        "end_character": 28874
