        "accession_number": "0001437749-26-005983",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We assemble our liquid filtration systems and manufacture plastic products at our facilities located in Hobro, Denmark.",
