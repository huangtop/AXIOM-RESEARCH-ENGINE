        "accession_number": "0001437749-26-005983",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also sell our products through distributors and agents in many other countries and regions such as China, Korea, Spain, UK, France, Greece, Middle East, Singapore, Australia, and the U.S.",
