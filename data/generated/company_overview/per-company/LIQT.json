        "accession_number": "0001437749-26-005983",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2014, we acquired Provital Solutions, a Danish filtration system manufacturing company, that enabled our Company to broaden our offering of products and systems for ceramic filters, SiC membranes, and modular liquid filtration systems.",
        "start_character": 26180,
        "end_character": 26418
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005983",
