        "provenance_id": "provenance:SEC-FILING-0001437749-26-005983-a33d032c01e7f010",
        "accession_number": "0001437749-26-005983",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are expanding our range of products to better leverage existing customer relationships and develop new relationships within the oil & gas, marine, chemical, and other industries.",
