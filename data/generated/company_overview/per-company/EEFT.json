    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Further, we expect to continue to take advantage of cross-selling opportunities with our epay and EFT Processing Segments by providing prepaid services through our stores and agents and offering our money transfer services at select prepaid retail locations and ATMs we operate in key markets.",
        "start_character": 44415,
        "end_character": 44708
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition to our core business, we offer a variety of value-added services, including ATM and POS DCC, domestic and international surcharge, foreign currency dispensing, advertising, digital content sales at ATMs, Customer Relationship Management (\"CRM\"), prepaid mobile top-up, bill payment, money transfer, fraud management, foreign remittance payout, cardless payout, banknote recycling solutions and tax-refund services.",
        "start_character": 5937,
        "end_character": 6363
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, complementary services offered by our epay Segment, where we provide prepaid mobile top-up services through POS terminals, strengthens the EFT Processing Segment's line of services.",
        "start_character": 21258,
        "end_character": 21452
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we provide global account-to-account money transfer services under the brand name Xe.",
        "start_character": 38954,
        "end_character": 39052
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In most markets, we operate under sponsorship by our own e-money or payment service licensed entities.",
        "start_character": 12876,
        "end_character": 12978
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In some markets, we have agreements with a financial institution under which we are designated as a service provider (which we refer to as \"sponsorship agreements\") for the acceptance of domestic cards and/or cards bearing international logos, such as Visa® and Mastercard®.",
        "start_character": 12979,
        "end_character": 13253
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Increasing the number of non-owned ATMs and POS terminals that we operate under management services agreements and continued development of our credit, debit and prepaid card outsourcing business could provide continued growth while minimizing our capital investment.",
        "start_character": 20990,
        "end_character": 21257
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "On ATMs or POS devices that are operated for financial institutions, or where we offer DCC as a stand-alone service to financial institutions or merchants, we share the foreign exchange margin.",
        "start_character": 16163,
        "end_character": 16356
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Technology in the areas in which we operate is developing very rapidly, and we are aware that many other companies have filed patent applications for products, processes, and services similar to those we provide.",
        "start_character": 64128,
        "end_character": 64340
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Through Xe, we offer cash management solutions and foreign currency risk management services to small-and-medium-sized businesses.",
        "start_character": 39291,
        "end_character": 39421
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide card production and processing services to some of our prepaid gift card partners and telecom content providers.",
        "start_character": 32992,
        "end_character": 33120
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001554855-26-000131",
        "provenance_id": "provenance:SEC-FILING-0001554855-26-000131-44408840876755d4",
        "accession_number": "0001554855-26-000131",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are committed to the ongoing development of innovative new products and services to offer our EFT processing customers.",
        "start_character": 17118,
        "end_character": 17240
      }
