    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In each of the jurisdictions in which we operate, we are regulated by the relevant health and/or human services departments, Medicaid agencies, boards of pharmacy and other healthcare providers, departments of insurance, and departments of health that oversee the activities of MCOs and health plans providing or arranging to provide services to enrollees.",
        "start_character": 54682,
        "end_character": 55038
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through our experience with Medicaid populations and long-time presence in states with experience in long-term care for children and adolescents in the foster care system, we have developed care management, service coordination and crisis prevention/response programs that improve healthcare outcomes through decreasing preventable emergency department utilization and improving access to primary care and behavioral health intervention.",
        "start_character": 31308,
        "end_character": 31745
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also operate under a Memorandum of Understanding with the Arkansas Department of Human Services Division of Medical Services and the Arkansas Insurance Department to participate in the Medicaid expansion model that Arkansas has adopted (referred to as AR Health and Opportunity for Me program).",
        "start_character": 64527,
        "end_character": 64824
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We offer commercial health insurance products to individuals through the ACA Health Insurance Marketplace, and through large and small employer groups in limited areas.",
        "start_character": 19024,
        "end_character": 19192
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We often start our provider relationships in a pay-for-performance model, in which providers are reimbursed for the fair market value of services provided.",
        "start_character": 37649,
        "end_character": 37804
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We operate in a highly competitive and evolving industry characterized by business consolidations, strategic partnerships, market pressures, and ongoing regulatory and legislative changes at both at the federal and state levels, including healthcare reform initiatives described under the heading \"Regulation.\" Shifts in the political environment may further influence the competitive landscape.",
        "start_character": 51336,
        "end_character": 51731
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We pay providers under a variety of methods, including fee-for-service, capitation arrangements and value-based arrangements.",
        "start_character": 36273,
        "end_character": 36398
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide a full spectrum of managed healthcare products and services, primarily through Medicaid, Medicare and commercial products.",
        "start_character": 4011,
        "end_character": 4144
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "With local leadership owning all three lines of business within each health plan, we are able to translate local best practices from our Medicaid business into product development, distribution, network and pricing decisions we make for our Marketplace and Medicare businesses.",
        "start_character": 29067,
        "end_character": 29344
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a result of these efforts, we are the nation's largest Medicaid and Marketplace insurer as well as the largest stand-alone PDP provider, based on the most recent publicly available membership data.",
        "start_character": 27778,
        "end_character": 27978
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As of December 31, 2025, we operated in 29 states under federally-facilitated Marketplace contracts with CMS and state-based exchanges.",
        "start_character": 64391,
        "end_character": 64526
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001071739-26-000049",
        "provenance_id": "provenance:SEC-FILING-0001071739-26-000049-71a2f3eb69d84358",
        "accession_number": "0001071739-26-000049",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Based on continued market growth, we believe a significant market opportunity exists for managed care organizations (MCOs) with operations and programs focused on the distinct socio-economic, cultural and healthcare needs of the uninsured population and the Medicaid populations.",
        "start_character": 9043,
        "end_character": 9322
      }
    ]
  },
