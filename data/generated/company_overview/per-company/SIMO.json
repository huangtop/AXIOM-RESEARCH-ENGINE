        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell our products to NAND flash makers, module makers and OEMs worldwide that service multiple markets including computing, data center, mobile, automotive and industrial markets.",
