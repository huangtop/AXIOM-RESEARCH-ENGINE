        "confidence": 0.96,
        "statement": "In our Asset Management business, we conduct investment research on a global basis to develop market, industry and company-specific insights and evaluate investment opportunities.",
        "start_character": 18611,
        "end_character": 18790
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001311370-26-000008",
