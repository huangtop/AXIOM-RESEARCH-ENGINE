        "filing_date": "2026-02-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide other asset management services to our clients, including asset allocation and other investment advisory services, as well as locally customized investment solutions.",
        "start_character": 19141,
        "end_character": 19323
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001311370-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001311370-26-000008-943d476f3fbbf8ae",
        "accession_number": "0001311370-26-000008",
        "filing_date": "2026-02-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe that we have been pioneers in offering international Financial Advisory services, with the establishment of our New York, Paris and London offices dating back to the nineteenth century.",
