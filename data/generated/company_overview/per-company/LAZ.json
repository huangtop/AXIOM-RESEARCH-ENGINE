        "filing_date": "2026-02-23",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "The financial services industry, and all of the businesses in which we operate, are intensely competitive, and we expect them to remain so.",
        "start_character": 27218,
        "end_character": 27357
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001311370-26-000008",
