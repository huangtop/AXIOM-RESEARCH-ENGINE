        "provenance_id": "provenance:SEC-FILING-0001609711-26-000010-0939b52146140c4c",
        "accession_number": "0001609711-26-000010",
        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer email service plans through our partnerships with Titan email and Open Xchange email with multi-feature web interfaces that connect to our customers' domains.",
