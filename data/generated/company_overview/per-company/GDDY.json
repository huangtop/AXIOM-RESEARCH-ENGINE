        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, through GoDaddy Registry, we operate or provide back-end registry services to approximately 170 TLDs.",
        "start_character": 69641,
        "end_character": 69755
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001609711-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001609711-26-000010-0939b52146140c4c",
        "accession_number": "0001609711-26-000010",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We aim to lead the small business commerce market by enabling GoDaddy customers of all sizes, from those starting out to those with established businesses looking to scale and grow, to sell everywhere their customers shop.",
