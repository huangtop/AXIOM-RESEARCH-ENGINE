        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also sell domain registrations through relationships with third-party resellers and we provide back-end registry services supporting approximately 170 TLDs.",
        "start_character": 26146,
        "end_character": 26305
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001609711-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001609711-26-000010-0939b52146140c4c",
