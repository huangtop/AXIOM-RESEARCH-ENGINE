        "filing_date": "2026-02-25",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "For customers wanting to protect their email data, we provide email add on services, such as email backup services, encryption services (in partnership with ProofPoint), archiving services (in partnership with Barracuda) and other advanced e-mail security.",
        "start_character": 18002,
        "end_character": 18258
