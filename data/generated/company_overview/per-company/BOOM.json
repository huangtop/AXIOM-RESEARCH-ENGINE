    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "(“DMC”, “we”, “us”, “our”, or the “Company”) operates three manufacturing businesses: Arcadia Products, DynaEnergetics and NobelClad, which provide differentiated products and engineered solutions primarily for the construction, energy, and industrial processing markets.",
        "start_character": 307,
        "end_character": 578
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2023, we launched DS Liberator™ 2.0, which is a newly designed ballistic release tool that enables wireline service companies to disengage from a perforating string that has become stuck in the well bore.",
        "start_character": 22201,
        "end_character": 22408
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In response to the exacting needs of customers, we expanded and enhanced the IS3 product line, including adding an IS3 igniter specifically designed for our DS Liberator 2.0 and the DS MicroSet™ 2.0.",
        "start_character": 17748,
        "end_character": 17947
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our compensation and benefits teams regularly evaluate our comprehensive benefits program, and we strive to develop and implement policies and programs that are fair to employees, support our business goals, maintain competitiveness, and promote shared fiscal responsibility among DMC and our employees.",
        "start_character": 48280,
        "end_character": 48583
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are careful in protecting our proprietary know-how and manufacturing expertise in Arcadia Products, DynaEnergetics, and NobelClad, and each business unit has implemented measures and procedures designed to ensure that the information remains confidential.",
        "start_character": 52447,
        "end_character": 52705
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe the Arcadia and Wilson Partitions product lines benefit from low-cost manufacturing platforms, effective supply chain management, broad model offerings, product quality and availability, short lead times and highly diversified and long-tenured customer bases.",
        "start_character": 9669,
        "end_character": 9939
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "This acquisition diversified the markets and industries in which we operate and dramatically expanded our addressable markets.",
        "start_character": 46638,
        "end_character": 46764
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We offer employees benefits that vary by country and are designed to promote employee well-being, meet or exceed the requirements of local laws, and be competitive in the marketplace.",
        "start_character": 48584,
        "end_character": 48767
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We seek to maximize the potential of our employees through learning and development initiatives.",
        "start_character": 50086,
        "end_character": 50182
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "Competition in the explosion-welded clad metal business is global, and we believe that NobelClad holds a premium market position in the industry.",
        "start_character": 41359,
        "end_character": 41504
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "We are seeing an increase for equipment related to processing biomass feedstocks and biofuel end products, mostly stainless and nickel alloy clad.",
        "start_character": 34147,
        "end_character": 34293
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000034067-26-000009",
        "provenance_id": "provenance:SEC-FILING-0000034067-26-000009-287d751e12476958",
        "accession_number": "0000034067-26-000009",
        "filing_date": "2026-02-23",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "We are committed to ensuring a work environment in which all employees are treated with dignity and respect.",
        "start_character": 50528,
        "end_character": 50636
