        "accession_number": "0000845877-26-000014",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Unlike other GSEs such as other FCS institutions and the Federal Home Loan Banks, we are not structured as a cooperative owned exclusively by member institutions and established to provide services exclusively to its members.",
        "start_character": 30684,
        "end_character": 30909
      },
      {
