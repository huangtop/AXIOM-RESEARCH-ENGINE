        "end_character": 12057
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001784254-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001784254-26-000009-bddaa8a66a861d55",
        "accession_number": "0001784254-26-000009",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In most cases, a third party produces the event, which we help promote, and we sell certain sponsorship opportunities to our advertisers.",
