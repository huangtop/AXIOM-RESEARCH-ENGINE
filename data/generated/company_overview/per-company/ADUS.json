    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As a large-scale provider of home-based care, we market to and partner with managed care organizations, taking advantage of an industry shift from traditional fee-for-service Medicare and Medicaid toward managed care models that aim to better coordinate care and typically have narrower provider networks.",
        "start_character": 10500,
        "end_character": 10805
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As of December 31, 2025, we provide all three levels of care, personal care, home health and hospice services, in Ohio, Tennessee, Illinois and New Mexico and strategically continue to pursue other markets.",
        "start_character": 836,
        "end_character": 1042
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As of December 31, 2025, we provided services in 23 states through approximately 262 offices.",
        "start_character": 460,
        "end_character": 553
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Other providers, entities and individuals in the communities we serve provide services similar to those we offer.",
        "start_character": 17162,
        "end_character": 17275
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The growth of our revenues is closely correlated with the number of consumers to whom we provide our services.",
        "start_character": 7869,
        "end_character": 7979
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The hospice services we provide include palliative nursing care, social work, spiritual counseling, homemaker services and bereavement counseling.",
        "start_character": 14551,
        "end_character": 14697
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also focus on establishing new and maintaining existing referral relationships with various managed care organizations that contract with the states to service the Medicaid programs.",
        "start_character": 20568,
        "end_character": 20753
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer personal care services to private pay consumers.",
        "start_character": 4380,
        "end_character": 4442
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe this approach to care delivery and the integration of our services into the broader healthcare continuum are particularly attractive to managed care organizations and others who are ultimately responsible for the healthcare needs of our consumers and over time will increase our business with these organizations.",
        "start_character": 7524,
        "end_character": 7848
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We believe we are attractive to managed care organizations due to our coordinated care model and integration of services into the broader healthcare industry, our status as a larger, more experienced partner than our competition and our ability to provide sophisticated technology, electronic visit records and an outcomes-driven approach to service.",
        "start_character": 10806,
        "end_character": 11156
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We currently have relationships and agreements with the Veterans Health Administration to provide personal care services in several states, principally in Texas, New Mexico, Illinois and California.",
        "start_character": 40016,
        "end_character": 40214
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-005352",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-005352-93aee0a42c2c5acf",
        "accession_number": "0001437749-26-005352",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We expect ongoing consolidation within our industry, driven by the desire of healthcare systems and managed care organizations to narrow their networks of service providers, and also by the industry’s increasingly complex regulatory, operating and technology requirements.",
        "start_character": 5304,
        "end_character": 5576
      }
    ]
