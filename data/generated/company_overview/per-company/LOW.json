        "filing_date": "2026-03-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are building an omnichannel supply chain that positions the right products in the right quantities in the right places, and operates with greater network capacity with better flow management and optimization.",
        "start_character": 13336,
        "end_character": 13547
      },
      {
