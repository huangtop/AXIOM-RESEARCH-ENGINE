        "filing_date": "2026-03-23",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are committed to offering a wide selection of national brand-name merchandise complemented by our selection of high-value private brands.",
        "start_character": 11310,
        "end_character": 11450
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000060667-26-000029",
        "provenance_id": "provenance:SEC-FILING-0000060667-26-000029-87850f7b05124850",
        "accession_number": "0000060667-26-000029",
        "filing_date": "2026-03-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to develop and implement productivity tools, including freight flow optimization and advanced AI customer service tools, to enhance the efficiency of our sales associates and improve the customer experience.",
        "start_character": 7697,
        "end_character": 7916
      },
      {
