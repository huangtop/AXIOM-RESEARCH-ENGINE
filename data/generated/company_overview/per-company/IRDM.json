        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As a result, we are the only mobile satellite services operator offering real-time, weather-resilient, low-latency services with true global coverage, including full coverage of the polar regions.",
        "start_character": 20187,
        "end_character": 20383
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001418819-26-000009",
