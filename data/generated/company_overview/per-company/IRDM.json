        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By supporting these distributors as they develop new products, services and applications, we believe we create additional demand for our products and services and expand our target markets at a lower cost than would a more direct marketing model.",
        "start_character": 26097,
        "end_character": 26343
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001418819-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001418819-26-000009-b93d1260bf3735e9",
        "accession_number": "0001418819-26-000009",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Following our acquisition of Satelles in April 2024, we began offering Iridium PNT services.",
        "start_character": 79023,
        "end_character": 79115
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001418819-26-000009",
