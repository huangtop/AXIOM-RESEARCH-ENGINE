    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "During the year, we realigned our market strategy to focus on the industries and countries where we believe the largest opportunity exists for our current platform offerings.",
        "start_character": 15183,
        "end_character": 15357
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Rather than developing standalone hardware products, we now design and deploy coordinated device, edge, data hub, and cloud software capabilities that operate as a unified system to address complex industrial reliability challenges.",
        "start_character": 12241,
        "end_character": 12473
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Regarding products, we made the strategic decision to cease marketing, development, and sale of drone related product offerings given the high degree of customization required and limited overlap with our software platform.",
        "start_character": 15879,
        "end_character": 16102
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Regarding services, we discontinued offering training and inspection related services which were ancillary to our core offerings.",
        "start_character": 16103,
        "end_character": 16232
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are transitioning our flexible manufacturing strategy toward greater use of contract manufacturing with third parties for both high-volume and an expanding portion of lower-volume specialized products, and correspondingly reducing our reliance on in-house manufacturing activities.",
        "start_character": 31862,
        "end_character": 32146
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe our early entrance into these markets with our MSAI Connect platform will enable us to gain expertise, informing our product development decisions so that we may more effectively customize our solutions for customers’ needs.",
        "start_character": 24784,
        "end_character": 25019
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer installation services that cover on-site hardware mounting, sensor commissioning, and connectivity into the MSAI Connect platform.",
        "start_character": 11487,
        "end_character": 11626
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We prioritize disciplined innovation and structured product development to maintain and extend our competitive position across our target markets.",
        "start_character": 26815,
        "end_character": 26961
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "With this combination, we expect to develop new innovative solutions for industry-specific applications, expanding our product offering without requiring significant manufacturing or inventory changes.",
        "start_character": 24262,
        "end_character": 24463
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As our software solutions continue to evolve, we are increasingly targeting process design, safety, and operational leaders whose priorities involve process waste reduction, enhanced safety protocols, and improved quality of manufacturing outputs.",
        "start_character": 22163,
        "end_character": 22410
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In distribution and logistics, we mainly compete with large scale manufacturers of handheld sensor devices that provide on-device thermal image display and basic on-device software.",
        "start_character": 34328,
        "end_character": 34509
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-032148",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-032148-242d552dca04d45c",
        "accession_number": "0001104659-26-032148",
        "filing_date": "2026-03-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Through collaboration with several blue-chip multinational customers during development and deployment, we have validated high-value, mission-critical use cases across our target markets: distribution and logistics, manufacturing and data centers.",
        "start_character": 2390,
        "end_character": 2637
      }
    ]
