        "accession_number": "0001437749-26-010342",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We expect any products that we develop and commercialize to compete on the basis of, among other things, efficacy, safety, price and the availability of reimbursement from government or other third-party payers.",
