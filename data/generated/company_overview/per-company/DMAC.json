        "accession_number": "0001437749-26-010342",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that our DM199 product candidate, development capabilities, experience and scientific knowledge provide us with certain competitive advantages.",
