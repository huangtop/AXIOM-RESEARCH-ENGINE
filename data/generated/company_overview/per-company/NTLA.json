        "end_character": 133523
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-076550",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-076550-1ad948d87bc85302",
        "accession_number": "0001193125-26-076550",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For any products that we may ultimately commercialize, not only will we compete with any existing therapies and those therapies currently in development, but we will also have to compete with new therapies that may become available in the future.",
        "start_character": 40221,
        "end_character": 40467
      },
      {
