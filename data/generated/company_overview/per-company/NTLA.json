        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For example, we need approval from regulatory agencies for our clinical studies, development, manufacturing, distribution, exportation and importation, commercialization, marketing and reimbursement relating to our products and product candidates.",
        "start_character": 43038,
        "end_character": 43285
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-076550",
