        "end_character": 1711
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-076550",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-076550-1ad948d87bc85302",
        "accession_number": "0001193125-26-076550",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In that event, we may be unable to further develop and commercialize one or more of our product candidates, which could harm our business significantly.",
        "start_character": 37661,
        "end_character": 37813
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-076550",
