        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "At our 268,000 square foot technology TIDC in Wilmington, Ohio, we receive and ship inventory, configure and integrate technology solutions, provide depot maintenance and services, and process returned products.",
        "start_character": 31740,
        "end_character": 31951
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019108",
