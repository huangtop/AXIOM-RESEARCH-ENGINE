        "filing_date": "2026-02-24",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Through our custom-designed Web-based system, we are able to offer our larger corporate customers an efficient and effective method of sourcing, evaluating, purchasing, and tracking a wide variety of IT products and services.",
        "start_character": 23329,
        "end_character": 23554
      },
      {
