    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "(“we”, “us”, “our”, or the “Company”) is in the business of acquiring, developing and operating assets and businesses that represent critical infrastructure for customers in the transportation, energy and industrial products industries.",
        "start_character": 54,
        "end_character": 290
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "FTAI and USS also entered into an exclusive strategic rail partnership under which we will provide rail service to USS for an initial term of 15 years with minimum volume commitments for the first five years.",
        "start_character": 10691,
        "end_character": 10899
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that there are a large number of acquisition opportunities in our markets and that our Manager’s expertise and business and financing relationships, together with our access to capital and generally available capital for infrastructure projects in today’s marketplace, will allow us to take advantage of these opportunities.",
        "start_character": 3267,
        "end_character": 3602
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Although we have established certain policies and procedures designed to mitigate conflicts of interest, there can be no assurance that these policies and procedures will be effective in doing so.",
        "start_character": 39233,
        "end_character": 39429
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, changes to environmental standards or regulations in the industries in which we operate could limit the economic life of the assets we acquire or reduce their value, and also require us to make significant additional investments in order to maintain compliance.",
        "start_character": 36534,
        "end_character": 36808
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, we are obligated to reimburse certain expenses incurred by our Manager on our behalf.",
        "start_character": 9956,
        "end_character": 10054
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also seek to develop incremental opportunities to deploy capital through follow-on investments in our existing assets in order to grow our earnings and create value.",
        "start_character": 2375,
        "end_character": 2543
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We approach markets and opportunities by first developing an asset acquisition strategy with our Manager and then pursuing optimal opportunities within that strategy.",
        "start_character": 6548,
        "end_character": 6714
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are externally managed by our Manager, an affiliate of Fortress, which has a dedicated team of experienced professionals focused on the acquisition of infrastructure assets since 2002.",
        "start_character": 8273,
        "end_character": 8460
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are subject to federal, state, local and foreign laws and regulations relating to the protection of the environment, including those governing the discharge of pollutants to air and water, the management and disposal of hazardous substances and wastes, the cleanup of contaminated sites and noise and emission levels.",
        "start_character": 35933,
        "end_character": 36253
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We operate in some corridors served by other railroads and motor carriers.",
        "start_character": 35414,
        "end_character": 35488
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001899883-26-000015",
        "provenance_id": "provenance:SEC-FILING-0001899883-26-000015-b36bc32de7e06191",
        "accession_number": "0001899883-26-000015",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "While we expect to hold our assets for extended periods of time, we and our Manager continually review our assets to assess whether we should sell or otherwise monetize them.",
        "start_character": 32279,
        "end_character": 32453
      }
    ]
  },
