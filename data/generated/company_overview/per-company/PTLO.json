        "accession_number": "0001871509-26-000012",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We work with team members and managers to build individual development plans with training and experience, and we hold regularly scheduled development programs throughout the year for each level of leadership.",
