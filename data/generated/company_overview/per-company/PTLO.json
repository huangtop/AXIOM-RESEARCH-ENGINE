        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Guided by our purpose of creating lifelong memories and our Employee Value Proposition (\"EVP\") — Feeding Passions, Making Memories — we aim to attract, hire, develop and retain great people who turn their obsession for our brand into a profession.",
        "start_character": 11924,
        "end_character": 12171
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001871509-26-000012",
