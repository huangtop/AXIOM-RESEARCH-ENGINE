        "accession_number": "0001282637-26-000005",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We invest significantly in research and development in order to meet our customers’ needs and to adapt to the rapidly changing environment for new and improved products and services.",
