        "accession_number": "0001282637-26-000005",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Safety and environmental responsibility are a way of life at NewMarket - enhancing operations, the way we work, and the relationships we maintain with our employees, customers, supply chain partners, and the communities in which we operate.",
