        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "If we, or our contract manufacturers, fail to comply, then the FDA may not allow us to market products that have been affected by the failure.",
        "start_character": 57893,
        "end_character": 58035
      },
      {
