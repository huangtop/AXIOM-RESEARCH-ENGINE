        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In expanding our network of Dealerships, we carefully consider potential markets and conduct a systematic evaluation of each potential new site, using a scoring system that we have developed internally.",
        "start_character": 19389,
        "end_character": 19591
      },
      {
