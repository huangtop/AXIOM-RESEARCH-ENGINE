        "end_character": 13237
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-027231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-027231-feff174405c13c8c",
        "accession_number": "0001628280-26-027231",
        "filing_date": "2026-04-24",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "Since we do not have storage facilities, the product delivery is made daily according to a supply and logistics plan, which considers the capacity and inventory levels as well as the behavior of the demand of each one of our service stations, ensuring a continuous and sufficient supply to serve the markets where we have operations.",
