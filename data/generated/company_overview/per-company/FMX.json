      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-027231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-027231-feff174405c13c8c",
        "accession_number": "0001628280-26-027231",
        "filing_date": "2026-04-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are developing Bara in the Jalisco and Bajio regions and expanding its presence in the northern region of Mexico, allowing us to build a strong market position and leverage our deep understanding and operational expertise in these markets.",
        "start_character": 98488,
        "end_character": 98730
      },
      {
