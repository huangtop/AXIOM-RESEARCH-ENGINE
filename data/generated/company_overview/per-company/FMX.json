        "filing_date": "2026-04-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We generate economic value by designing, building and scaling mass business models, which enables us to meet our customers’ daily needs in a distinguished and efficient manner.",
        "start_character": 11273,
        "end_character": 11449
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-027231",
