        "end_character": 96716
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-027231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-027231-feff174405c13c8c",
        "accession_number": "0001628280-26-027231",
        "filing_date": "2026-04-24",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "We are a relatively small participant in the market, representing 2.8% of the total number of pharmacy services locations in Mexico with a presence in 12 of 32 states in the country.",
        "start_character": 87512,
        "end_character": 87694
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-027231",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-027231-feff174405c13c8c",
        "accession_number": "0001628280-26-027231",
        "filing_date": "2026-04-24",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "We are leveraging the competitive advantages and strong market position of our businesses to build innovative digital businesses in the financial services industry to address the financial needs of our customers and business partners, with an efficient and comprehensive value proposition closely aligned with OXXO Mexico.",
