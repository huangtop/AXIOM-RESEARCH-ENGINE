        "provenance_id": "provenance:SEC-FILING-0001628280-26-027231-feff174405c13c8c",
        "accession_number": "0001628280-26-027231",
        "filing_date": "2026-04-24",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that the competencies that our businesses have developed can be replicated in other geographic regions.",
