        "accession_number": "0001628280-26-027231",
        "filing_date": "2026-04-24",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We also operate B2B businesses: we are the primary distributor to independent pharmacies and a significant participant in institutional markets, both private (clinics and medical centers) and public (hospitals).",
