        "end_character": 20540
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001406666-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001406666-26-000005-cfa20bc67227c815",
        "accession_number": "0001406666-26-000005",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We market and sell our platform (agentic AI, cloud, software and appliances) and managed services to service providers of all types and sizes.",
        "start_character": 15347,
        "end_character": 15489
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001406666-26-000005",
