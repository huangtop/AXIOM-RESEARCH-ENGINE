        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We market, sell and support the success of our platform and managed services predominantly through our direct sales force, supported by marketing, product management and customer success personnel.",
        "start_character": 17937,
        "end_character": 18134
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001406666-26-000005",
