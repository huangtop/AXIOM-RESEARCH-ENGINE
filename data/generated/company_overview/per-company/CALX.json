        "end_character": 15575
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001406666-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001406666-26-000005-cfa20bc67227c815",
        "accession_number": "0001406666-26-000005",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We develop, market and sell platform, cloud and managed services, which are powered by agentic AI, that enable communication service providers (“CSPs”) of all types and sizes to innovate and transform their businesses to focus on delivering outstanding subscriber experiences and become CXPs.",
        "start_character": 61,
        "end_character": 353
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001406666-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001406666-26-000005-cfa20bc67227c815",
        "accession_number": "0001406666-26-000005",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have made significant investments in our product portfolio, and we intend to continue to dedicate significant resources to research and development to develop, enhance and deliver new platform features and capabilities, including investments in innovative technologies that support our business strategy.",
        "start_character": 18801,
        "end_character": 19108
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001406666-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001406666-26-000005-cfa20bc67227c815",
        "accession_number": "0001406666-26-000005",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We integrate our supply-chain management and new product introduction activities with those outsourced to third parties.",
