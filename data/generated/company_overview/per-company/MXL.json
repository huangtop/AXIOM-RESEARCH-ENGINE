        "accession_number": "0001288469-26-000011",
        "filing_date": "2026-01-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As a fabless semiconductor design company, we do not manufacture our products and, with respect to the activities we conduct directly, we believe we leave a limited environmental footprint.",
