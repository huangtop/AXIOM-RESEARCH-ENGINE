        "accession_number": "0001288469-26-000011",
        "filing_date": "2026-01-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a fabless integrated circuit design company whose products integrate all or substantial portions of a high-speed communication system, including radio frequency, or RF, high-performance analog, mixed-signal, digital signal processing, security engines, data compression and networking layers, and power management.",
