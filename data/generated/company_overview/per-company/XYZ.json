        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we differentiate ourselves by offering transparent pricing, no mandatory long-term contracts, and our ability to innovate and reshape the industries we operate in to expand access to traditionally unserved or underserved sellers.",
        "start_character": 38517,
        "end_character": 38759
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012254",
