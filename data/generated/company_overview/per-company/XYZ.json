        "accession_number": "0001628280-26-012254",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our products are designed to be self-serve and intuitive to make initial setup and new employee training fast and easy, although we also offer full-service setup and support.",
