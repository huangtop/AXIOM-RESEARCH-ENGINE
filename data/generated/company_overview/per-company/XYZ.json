        "accession_number": "0001628280-26-012254",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2025, we also introduced Cash App Score, an internally developed credit scoring framework used to support underwriting decisions, credit limit management, portfolio monitoring, and product eligibility across our lending offerings.",
        "start_character": 29317,
        "end_character": 29550
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012254",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012254-4a79658826f13b92",
        "accession_number": "0001628280-26-012254",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to these tiers, we also offer custom pricing for larger sellers to meet their specific business needs.",
        "start_character": 14011,
        "end_character": 14125
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012254",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-012254-4a79658826f13b92",
