        "accession_number": "0001193125-26-079454",
        "filing_date": "2026-02-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our presence spans all 50 states, we serve over 465,000 patients daily through our approximately 10,500 clinical providers and pharmacists, and our services make a profound impact in the lives and communities of the people we serve.",
        "start_character": 940,
        "end_character": 1172
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-079454",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-079454-f8a34085c0a2d892",
