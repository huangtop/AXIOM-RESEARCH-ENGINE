        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our senior leadership’s attention to how we operate and manage our services and enterprise support functions is reflected in continuous improvement efforts in both volume and cost efficiency related areas for improved results.",
        "start_character": 38989,
        "end_character": 39215
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-079454",
