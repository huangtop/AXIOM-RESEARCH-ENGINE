        "provenance_id": "provenance:SEC-FILING-0001193125-26-079454-f8a34085c0a2d892",
        "accession_number": "0001193125-26-079454",
        "filing_date": "2026-02-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our Company has received numerous human resources and many people-related awards from external companies over the years, and we remain committed to executing on our vision to be the leading provider of health services in the United States and doing so through an engaged and stable workforce.",
        "start_character": 74620,
        "end_character": 74912
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-079454",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-079454-f8a34085c0a2d892",
        "accession_number": "0001193125-26-079454",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our business could be adversely affected if we are not able to continue to penetrate existing markets, successfully expand into new markets, maintain or establish new relationships with health plans and providers, recruit qualified employees, or if we experience significant customer attrition to our competitors.",
        "start_character": 48455,
        "end_character": 48768
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-079454",
