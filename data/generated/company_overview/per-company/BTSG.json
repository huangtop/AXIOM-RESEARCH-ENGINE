        "filing_date": "2026-02-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In our Provider Services segment, we also compete for physicians, nurse practitioners, physician assistants, nurses, therapists, and other medical and non-medical personnel that we directly employ to provide healthcare services for our patients and to provide licensed medical services.",
        "start_character": 47974,
        "end_character": 48260
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-079454",
