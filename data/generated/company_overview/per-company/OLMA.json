        "accession_number": "0001193125-26-107169",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, our product candidates, if approved, will complete with multiple approved products or products that may be approved for future indications for which we develop such product candidate.",
