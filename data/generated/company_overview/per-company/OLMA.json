        "accession_number": "0001193125-26-107169",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Because of the extensive time required for clinical development and regulatory review of the drugs we develop, it is possible that, before palazestrant, OP-3136, or any future product candidates we may develop can be commercialized, any related patent may expire or remain in force for only a short period following commercialization, thereby reducing any advantage of any such patent.",
        "start_character": 70207,
        "end_character": 70592
