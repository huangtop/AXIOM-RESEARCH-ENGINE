        "end_character": 2308
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073878",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-073878-0eab8480391d6511",
        "accession_number": "0001193125-26-073878",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We compete in markets for networking and communications services and solutions for Service Providers, businesses, government agencies and other organizations worldwide.",
        "start_character": 26452,
        "end_character": 26620
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073878",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-073878-0eab8480391d6511",
        "accession_number": "0001193125-26-073878",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We have a diverse global customer base that includes large, medium and small Service Providers, alternative Service Providers, such as utilities, municipalities and fiber overbuilders;",
        "start_character": 15165,
        "end_character": 15349
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073878",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-073878-0eab8480391d6511",
        "accession_number": "0001193125-26-073878",
        "filing_date": "2026-02-26",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We operate in two business segments: (1) Network Solutions, which includes hardware and software products, and (2) Services & Support, which includes a portfolio of network design and implementation services, support services and AI-driven operations including cloud-hosted SaaS applications that complement our product portfolio and can also be utilized to support other platforms.",
        "start_character": 2836,
        "end_character": 3218
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073878",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-073878-0eab8480391d6511",
        "accession_number": "0001193125-26-073878",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We plan to maintain our emphasis on product development to enable us to respond to rapidly changing technology and evolving industry standards.",
        "start_character": 18777,
        "end_character": 18920
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073878",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-073878-0eab8480391d6511",
        "accession_number": "0001193125-26-073878",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell our products through our direct sales organization and our distribution network.",
        "start_character": 15868,
        "end_character": 15956
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073878",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-073878-0eab8480391d6511",
        "accession_number": "0001193125-26-073878",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We take an approach to our portfolio in which we are focused in specific markets where we can offer competitive differentiation and scale while also having enough diversity and breadth in the portfolio to provide end-to-end connectivity solutions that offer value to our customers.",
        "start_character": 13943,
        "end_character": 14224
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073878",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-073878-0eab8480391d6511",
        "accession_number": "0001193125-26-073878",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We typically manufacture our lower-volume, higher-mix products and build and test product prototypes and many of our initial production units at our manufacturing site in Huntsville, Alabama.",
        "start_character": 24064,
        "end_character": 24255
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073878",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-073878-0eab8480391d6511",
        "accession_number": "0001193125-26-073878",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "While we develop the majority of our products internally, we also leverage partners for some solutions.",
