        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Additionally, we manage a process that identifies the components that are best purchased directly by contract manufacturers for use in the assembly of our products to achieve manufacturing efficiency, quality and cost objectives.",
        "start_character": 23004,
        "end_character": 23233
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073878",
