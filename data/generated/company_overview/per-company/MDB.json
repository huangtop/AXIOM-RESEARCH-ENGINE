        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By empowering developers to build and modernize applications quickly and cost-efficiently, we enable developers’ agility and accelerate their time-to-revenue for new products.",
        "start_character": 13823,
        "end_character": 13998
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-016799",
