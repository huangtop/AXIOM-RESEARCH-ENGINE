        "end_character": 41890
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-234423",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-234423-79eb340733f93b1b",
        "accession_number": "0001193125-26-234423",
