        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The portfolio of intellectual property and trade secrets that we have developed includes patents related to the activity of our HAC and methods that we expect to generate hIgG at commercial scale.",
        "start_character": 45498,
        "end_character": 45694
      },
      {
