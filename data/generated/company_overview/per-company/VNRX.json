    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Given the wide-ranging nature of our products in development we believe that our market opportunity is large.",
        "start_character": 24101,
        "end_character": 24210
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Moreover, our competitors may make rapid technological developments that may result in our intended technologies and products becoming obsolete before we are able to enter the market, recover the expenses incurred to develop them or generate significant revenue.",
        "start_character": 27379,
        "end_character": 27641
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "There may also be other companies developing products competitive with ours of which we are unaware.",
        "start_character": 26557,
        "end_character": 26657
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that our focus on innovation and robust assay development, as well as our diverse intellectual property portfolio, positions us to become a signiﬁcant player in this cutting-edge ﬁeld of science.",
        "start_character": 3067,
        "end_character": 3273
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We intend to continue our development of the Nucleosomics™, Capture-PCR and Capture-Seq™ technologies and will continue to apply for patents for future product developments.",
        "start_character": 33445,
        "end_character": 33618
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Based on over a decade of work on the chemistry of circulating chromatin fragments, we have also developed a transformational wet chemistry pathway that identifies and physically isolates chromatin fragments that we know are tumor-associated from background DNA of the same sequence, using Chromatin Immunoprecipitation (“ChIP”).",
        "start_character": 14307,
        "end_character": 14636
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition to biomarkers we have developed and commercialized a High Throughput Model that measures Neutrophil Extracellular Traps “NETs” activation and inhibition in whole blood in real time, helping companies develop new therapeutics to combat sepsis and other NETs-related disease.",
        "start_character": 12849,
        "end_character": 13134
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Subject to the publication of this study in a peer reviewed journal, we expect to receive a $5 million contractual milestone payment, and we anticipate generating ongoing revenue from this development.",
        "start_character": 9038,
        "end_character": 9239
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are currently focusing on manufacturing our key components such as the antibodies and positive controls at Silver One, as well as ELISA kits.",
        "start_character": 16146,
        "end_character": 16290
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are partnering with established diagnostic companies and liquid biopsy companies to market, sell, and process our tests, leveraging their networks and expertise.",
        "start_character": 17330,
        "end_character": 17494
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have also outsourced a portion of the production of our ELISA kits to a third-party manufacturer in the U.S.",
        "start_character": 16291,
        "end_character": 16402
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001477932-26-001832",
        "provenance_id": "provenance:SEC-FILING-0001477932-26-001832-fe66e88f017ef54b",
        "accession_number": "0001477932-26-001832",
        "filing_date": "2026-03-31",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "In this way, Nu.Q® Discover is able to unlock value from Volition’s intellectual property (“IP”) portfolio by helping us to commercialize the areas we are not going to drive ourselves.",
        "start_character": 12398,
        "end_character": 12582
      }
    ]
  },
