    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We maintain operational processes to address privacy and marketing requirements, including consent and preference management for email, SMS and targeted advertising, honoring applicable opt-out rights, and applying data minimization and protective techniques (such as pseudonymization, tokenization or encryption, as appropriate) to reduce risk while supporting business functions.",
        "start_character": 23222,
        "end_character": 23603
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Further, we are able to offer standardized sizing across the Lulus assortment, simplifying the shopping experience and giving our customer confidence that she is selecting the best fit.",
        "start_character": 3293,
        "end_character": 3478
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2022, we engaged an outside supply chain risk management and audit company to evaluate our supply chain risks and develop an oversight and auditing program, under which we started conducting third-party audits in 2023.",
        "start_character": 32932,
        "end_character": 33153
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In some instances, we may be obligated to give customers the right to prevent sharing or selling of their personal information with third parties.",
        "start_character": 23928,
        "end_character": 24074
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Our brand primarily operates direct-to-consumer, and while we expect that it will continue to operate in that manner as we continue to grow, we are focusing on channel expansion and wholesale initiatives to further build brand awareness, expand our reach and attract new customers.",
        "start_character": 12327,
        "end_character": 12608
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Our employees, also known as the “LuCrew” are integral to our success, and we strive to prioritize our employees’ development, growth, and wellbeing.",
        "start_character": 33875,
        "end_character": 34024
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We aggregate and analyze data in order to optimize the customer experience internally, and do not monetize the information we collect by selling it to third parties for money for their own external purposes.",
        "start_character": 17735,
        "end_character": 17942
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We continue to leverage data-driven customer insights to try to develop strong customer relationships and become a one-stop shop for Gen Z and Millennial women.",
        "start_character": 9409,
        "end_character": 9569
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have built our software development and deployment cycles such that software changes can be deployed daily after being verified by fully automated testing, as well as by human functional testing.",
        "start_character": 17042,
        "end_character": 17240
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have effectively brought the boutique experience online, developing one-on-one relationships with our customers in order to learn and then address their individual needs.",
        "start_character": 2921,
        "end_character": 3094
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have internal resources dedicated to employee learning and development.",
        "start_character": 38095,
        "end_character": 38169
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036884",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036884-2498b4c05a25608c",
        "accession_number": "0001104659-26-036884",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "As a vertically integrated business, we retain full control of critical aspects of our business including brand, product, marketing, distribution, and customer service.",
        "start_character": 20285,
        "end_character": 20453
      }
