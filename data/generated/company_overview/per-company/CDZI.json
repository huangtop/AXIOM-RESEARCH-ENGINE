        "filing_date": "2026-03-31",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are focused on executing on our objectives of implementing our projects and realizing the cash flow potential of our assets, while also evaluating opportunities to ensure our workforce reflects the diversity of the communities in which we operate.",
        "start_character": 46871,
        "end_character": 47121
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-010517",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-010517-d1bd5acf7eba3959",
        "accession_number": "0001437749-26-010517",
