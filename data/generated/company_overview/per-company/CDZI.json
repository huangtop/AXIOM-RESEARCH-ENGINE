        "filing_date": "2026-03-31",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In the normal course of developing our land, water and infrastructure assets, we are required to demonstrate to various regulatory authorities that we are in compliance with the laws, regulations and policies enforced by such authorities.",
        "start_character": 47249,
        "end_character": 47487
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-010517",
