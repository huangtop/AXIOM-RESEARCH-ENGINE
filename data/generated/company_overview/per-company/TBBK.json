        "filing_date": "2026-02-25",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our primary competitors in each of our business lines differ significantly from those in our other business lines principally because few financial institutions compete against us in all business segments in which we operate.",
