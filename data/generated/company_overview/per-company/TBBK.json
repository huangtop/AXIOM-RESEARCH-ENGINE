        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Because we outsource these operational functions to experienced third-party service providers with the capacity to process a high volume of transactions, we believe we can more readily and cost-effectively respond to growth than if we sought to develop these capabilities internally.",
        "start_character": 10258,
        "end_character": 10541
