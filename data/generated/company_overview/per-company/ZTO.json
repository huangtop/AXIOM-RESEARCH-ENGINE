        "filing_date": "2026-04-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "For certain enterprise customers, we provide direct pickup services without going through the pickup outlets of our network partners.",
        "start_character": 29946,
        "end_character": 30079
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044613",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044613-42cf62bd8e9bbb78",
