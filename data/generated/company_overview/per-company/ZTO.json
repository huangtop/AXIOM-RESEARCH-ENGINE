        "accession_number": "0001104659-26-044613",
        "filing_date": "2026-04-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our network partners directly interact with our end customers, and we provide ongoing training and conduct regular performance reviews to ensure they provide quality customer services.",
        "start_character": 30670,
        "end_character": 30854
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-044613",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-044613-42cf62bd8e9bbb78",
