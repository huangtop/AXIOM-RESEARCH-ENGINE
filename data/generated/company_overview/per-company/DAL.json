    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our strategic relationships with international airlines are an important part of our business as they improve our access to markets around the world and enable us to provide customers a more seamless global travel experience across our alliance network.",
        "start_character": 3632,
        "end_character": 3885
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Through alliance arrangements with other SkyTeam carriers, we are able to link our route network with those of the other member airlines, providing opportunities to increase connecting traffic while offering enhanced customer service through reciprocal codesharing and loyalty program participation, airport lounge access and cargo operations.",
        "start_character": 16778,
        "end_character": 17121
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are continuing to refresh our fleet by acquiring new and more fuel-efficient aircraft with increased premium seating and cargo capacity to replace retiring aircraft, while modifying our existing aircraft cabins to increase premium offerings and harmonize interiors.",
        "start_character": 4538,
        "end_character": 4806
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are currently able to obtain adequate supplies of aircraft fuel, including fuel produced by the Trainer refinery operated by our subsidiary Monroe Energy, LLC (\"Monroe\") and its pipeline subsidiary, or procured through the sale of gasoline, diesel and other refined petroleum products (\"non-jet fuel products\") the refinery produces, and crude oil for Monroe's operations.",
        "start_character": 23569,
        "end_character": 23944
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "•Our Maintenance, Repair and Overhaul (\"MRO\") operation, where we are well-positioned for growth through contractual agreements with jet engine manufacturers, including both legacy and next-generation engine platforms, as well as through our airframe and other maintenance services.",
        "start_character": 8107,
        "end_character": 8389
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For example, we own a 2% equity interest in China Eastern, with whom we have a strategic joint marketing and commercial cooperation arrangement covering traffic flows between China and the U.S.",
        "start_character": 16010,
        "end_character": 16203
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In 2025, we announced partnerships with both JetZero and Maeve to accelerate the design and development of revolutionary aircraft.",
        "start_character": 21504,
        "end_character": 21634
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Over time, we also expect AI to play an even greater role in the way we manage and minimize operational disruptions.",
        "start_character": 10885,
        "end_character": 11001
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Through our regional carrier program, Delta Connection®, we have contractual arrangements with regional carriers to operate aircraft using our \"DL\" designator code.",
        "start_character": 17471,
        "end_character": 17635
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To facilitate transactions with participating companies, we sell miles to non-airline businesses and other airlines.",
        "start_character": 9120,
        "end_character": 9236
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are a member of SkyTeam Cargo, an international airline cargo alliance with six other airlines that offers an extensive worldwide network, through which we provide global solutions to our customers by connecting our network with those partners.",
        "start_character": 19295,
        "end_character": 19542
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000027904-26-000013",
        "provenance_id": "provenance:SEC-FILING-0000027904-26-000013-d04c940b57746e25",
        "accession_number": "0000027904-26-000013",
        "filing_date": "2026-02-11",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are also subject to certain environmental laws and contractual obligations governing the management and release of regulated substances, which may require investigation and remediation at affected sites.",
        "start_character": 43757,
        "end_character": 43963
      }
    ]
