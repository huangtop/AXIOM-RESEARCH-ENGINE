        "accession_number": "0001280058-26-000006",
        "filing_date": "2026-02-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Less frequently, we compete with providers of traditional, non-automated fundraising service providers, including parties providing services in support of traditional direct mail or email campaigns, special events fundraising, peer-to-peer, telemarketing and personal solicitations.",
        "start_character": 50230,
        "end_character": 50512
      },
      {
