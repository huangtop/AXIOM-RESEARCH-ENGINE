        "end_character": 4846
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000833640-26-000037",
        "provenance_id": "provenance:SEC-FILING-0000833640-26-000037-4d9fbb5a51f86501",
        "accession_number": "0000833640-26-000037",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also continue to expand our offerings of technical documentation and design-support tools and services to help customers use our products.",
