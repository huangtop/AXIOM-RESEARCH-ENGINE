        "accession_number": "0000833640-26-000037",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through our research and development efforts, we seek to introduce more advanced products for these markets offering higher levels of integration and performance compared to earlier products.",
