        "end_character": 22049
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000833640-26-000037",
        "provenance_id": "provenance:SEC-FILING-0000833640-26-000037-4d9fbb5a51f86501",
        "accession_number": "0000833640-26-000037",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also provide extensive hands-on design support as well as online design tools, such as our PI Expert design software, that further reduce time-to-market and product development risks.",
        "start_character": 13556,
        "end_character": 13742
      },
      {
