        "accession_number": "0000833640-26-000037",
        "filing_date": "2026-02-06",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe we offer products that enable manufacturers to meet or exceed these regulations, and all other such regulations of which we are aware.",
