        "accession_number": "0001075531-26-000009",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have made significant investments in people, technology, marketing, and our travel offerings, particularly towards our strategic initiatives such as the Connected Trip, payments, and in key regions such as Asia and the U.S.",
        "start_character": 8239,
        "end_character": 8465
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001075531-26-000009",
