        "accession_number": "0001075531-26-000009",
        "filing_date": "2026-02-18",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are executing against our long-term strategy to create an ideal AI-powered traveler experience, offering our customers relevant options and suggestions at the times and in the language they want them, making trips booked with us seamless, easy, and valuable.",
        "start_character": 5436,
        "end_character": 5697
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001075531-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001075531-26-000009-62c6323e8ff6a739",
        "accession_number": "0001075531-26-000009",
        "filing_date": "2026-02-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We continue to optimize collaboration among our brands to provide consumers with comprehensive and value-oriented services, share resources and technological innovations, and co-develop new services.",
        "start_character": 7740,
        "end_character": 7939
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001075531-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001075531-26-000009-62c6323e8ff6a739",
