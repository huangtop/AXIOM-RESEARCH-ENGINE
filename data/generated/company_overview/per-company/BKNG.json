        "accession_number": "0001075531-26-000009",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We invest to support growth by our brands, whether through increased marketing, geographic expansion, technological innovation, or increased access to travel service offerings.",
        "start_character": 7940,
        "end_character": 8116
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001075531-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001075531-26-000009-62c6323e8ff6a739",
        "accession_number": "0001075531-26-000009",
        "filing_date": "2026-02-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer these services through five primary consumer-facing brands: Booking.com, Priceline, Agoda, KAYAK, and OpenTable:",
