        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our business is supported by multiple systems and platforms designed with an emphasis on scalability, performance, redundancy, and security.",
        "start_character": 14119,
        "end_character": 14259
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001075531-26-000009",
