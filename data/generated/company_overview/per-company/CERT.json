        "end_character": 19828
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001827090-26-000011",
        "provenance_id": "provenance:SEC-FILING-0001827090-26-000011-151d81ac0ee9b5ca",
        "accession_number": "0001827090-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also rely on independent contractors to address discrete parts of our business and provide expertise in certain specialized areas or focus on projects.",
        "start_character": 38341,
        "end_character": 38495
      },
      {
