        "accession_number": "0001827090-26-000011",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As we continue to expand our portfolio of offerings, through our unique blend of science, technology and consulting services.",
        "start_character": 27779,
        "end_character": 27904
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001827090-26-000011",
