        "accession_number": "0001559720-26-000004",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We operate a global marketplace connecting guests with stays, experiences, and services, collectively in over 220 countries and regions.",
