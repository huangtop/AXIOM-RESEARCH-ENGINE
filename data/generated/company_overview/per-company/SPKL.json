        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, the tender offer will be conditioned on public shareholders not tendering more than the number of public shares we are permitted to redeem.",
        "start_character": 53880,
        "end_character": 54032
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036922",
