        "end_character": 13297
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036922",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036922-31aff368e1d7791c",
        "accession_number": "0001104659-26-036922",
        "filing_date": "2026-03-30",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "After the initial business combination, we will also continue to support the merged company and help it become successful in the public markets.",
        "start_character": 7591,
        "end_character": 7735
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036922",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036922-31aff368e1d7791c",
        "accession_number": "0001104659-26-036922",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "Because we are able to complete our initial business combination using our cash, debt or equity securities, or a combination of the foregoing, we have the flexibility to use the most efficient combination that will allow us to tailor the consideration to be paid to the target business to fit its needs and desires.",
        "start_character": 25423,
        "end_character": 25738
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036922",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036922-31aff368e1d7791c",
        "accession_number": "0001104659-26-036922",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "The amount of time independent directors will devote in any time period will vary based on whether a target business has been selected for our initial business combination and the stage of the business combination process we are in.",
        "start_character": 78709,
        "end_character": 78941
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036922",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036922-31aff368e1d7791c",
        "accession_number": "0001104659-26-036922",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "We are especially interested in companies that have seen recent positive inflection points in their performance due to the adoption of disruptive strategies and business models driven by the changes in the global economy over the last few years during the pandemic.",
        "start_character": 8330,
        "end_character": 8595
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036922",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036922-31aff368e1d7791c",
        "accession_number": "0001104659-26-036922",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "We are not prohibited from pursuing an initial business combination with a business that is affiliated with our Sponsor, officers or directors.",
        "start_character": 9927,
        "end_character": 10070
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036922",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036922-31aff368e1d7791c",
        "accession_number": "0001104659-26-036922",
        "filing_date": "2026-03-30",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "Additionally, we are a “smaller reporting company” as defined in Item 10(f)(1) of Regulation S-K.",
