    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are actively engaging with customers through Tillys Rewards by offering early access to product launches, events and promotional deals to loyalty members.",
        "start_character": 30284,
        "end_character": 30441
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are also using the data and information provided by loyalty members to personalize the experience to the user and improve the communication and offering.",
        "start_character": 30442,
        "end_character": 30598
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have developed a corporate culture that we believe empowers the individual store managers to make store-level business decisions and we reward them when they exceed sales targets.",
        "start_character": 25722,
        "end_character": 25904
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Finally, we coordinate closely with our visual merchandise managers and marketing group in order to manage inventory levels in connection with our promotions and seasonality.",
        "start_character": 21842,
        "end_character": 22016
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For example, we sell merchandise to customers in all 50 states and the District of Columbia while having physical stores in just 33 states.",
        "start_character": 28270,
        "end_character": 28409
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, we compete with independent specialty shops, department stores, off-price retailers, online marketplaces such as Amazon, online retailers such as Fashion Nova, Revolve, Shein, and Temu, stores and websites operated by our third-party brands, and direct marketers that sell similar lines of merchandise and that target customers through catalogs, e-commerce and social media.",
        "start_character": 36886,
        "end_character": 37273
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Our associates share the same passion as our customers for the brands that we sell, enabling them to engage with our customers and make shopping at Tillys a fun, social experience.",
        "start_character": 23588,
        "end_character": 23768
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "The number of store associates we employ generally increases during peak selling seasons, particularly the back-to-school and the winter holiday seasons.",
        "start_character": 25568,
        "end_character": 25721
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also monitor sell-through rates among stores and online to identify opportunities for inventory transfers to generate greater sales efficiencies.",
        "start_character": 11675,
        "end_character": 11823
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We endeavor to design incentive programs for store associates that promote a competitive, yet fun, culture that is consistent with our image.",
        "start_character": 26253,
        "end_character": 26394
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have developed and maintained strong and, in many cases, long-standing relationships with our third-party vendors and we have a history of identifying and growing with emerging brands.",
        "start_character": 19517,
        "end_character": 19704
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-024440",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-024440-d574f5c0bb9b5846",
        "accession_number": "0001628280-26-024440",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have developed inventory planning and allocation processes to support our merchandising strategies.",
        "start_character": 20710,
        "end_character": 20812
      }
    ]
  },
