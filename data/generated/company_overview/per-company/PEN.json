        "end_character": 1502
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001321732-26-000007",
        "provenance_id": "provenance:SEC-FILING-0001321732-26-000007-e375440378163b25",
        "accession_number": "0001321732-26-000007",
        "filing_date": "2026-02-25",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have successfully developed, obtained regulatory clearance or approval for, and introduced products into the thrombectomy market since 2007, access market since 2008, embolization market since 2011, and neurosurgical market since 2014.",
