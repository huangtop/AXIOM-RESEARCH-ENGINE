        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In the highly competitive hospitality industry in which we operate, trademarks, service marks, trade names, logos and patents are very important to the success of our business.",
        "start_character": 37451,
        "end_character": 37627
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001585689-26-000007",
