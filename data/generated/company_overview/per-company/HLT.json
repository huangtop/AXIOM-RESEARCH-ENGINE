        "provenance_id": "provenance:SEC-FILING-0001585689-26-000007-c8d441b8b703dbcc",
        "accession_number": "0001585689-26-000007",
        "filing_date": "2026-02-11",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The management and franchise segment includes all of the hotels we manage for third-party owners, as well as all properties that license our intellectual property (\"IP\") and/or use our booking channels and related programs, and where we provide other contracted services, but the day-to-day services of the hotels are operated or managed by someone other than us.",
        "start_character": 1108,
        "end_character": 1471
      },
      {
