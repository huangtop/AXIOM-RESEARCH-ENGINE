        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Because we sell and support our products globally, we have a globally distributed workforce to manufacture products in the U.S.",
        "start_character": 43982,
        "end_character": 44109
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001007587-26-000004",
