        "end_character": 37069
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001007587-26-000004",
        "provenance_id": "provenance:SEC-FILING-0001007587-26-000004-ba956cc3cf7ff90f",
        "accession_number": "0001007587-26-000004",
        "filing_date": "2026-03-10",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we have increased our inventory substantially as we ramp up production in order to generate a targeted amount of inventory of maritime satellite connectivity and satellite television terminals to meet anticipated demand, as we are winding down our product manufacturing operations at our Middletown, Rhode Island location.",
