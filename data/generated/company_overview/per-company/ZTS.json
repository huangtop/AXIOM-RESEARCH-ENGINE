        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As part of our growth strategy, we focus on the discovery and development of new chemical, biopharmaceutical and biological entities, as well as product lifecycle innovation, primarily through our research and development (R&D) group.",
        "start_character": 9037,
        "end_character": 9271
