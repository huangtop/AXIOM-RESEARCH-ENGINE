        "accession_number": "0001555280-26-000011",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Depending on the nature of the agreement, we may act as the commercialization partner for discoveries that originate during the period of collaborative research, or we may own or have exclusive rights to any intellectual property that enables the development of proprietary products or models.",
        "start_character": 34514,
        "end_character": 34807
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001555280-26-000011",
