    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By closely engaging with customers throughout the product development process, we identify opportunities to replace traditional manufacturing methods with cutting-edge additive manufacturing solutions.",
        "start_character": 49618,
        "end_character": 49819
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Following those two acquisitions, in 2015, we introduced our branded Stratasys Direct Manufacturing, or SDM, service, which significantly broadened and increased our production and offering of AM parts, which are used by our customers as prototypes, benchmarks and end-use parts.",
        "start_character": 754,
        "end_character": 1033
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Further augmenting the Stratasys materials portfolio described above, we have developed an ecosystem of third-party materials partnerships.",
        "start_character": 72223,
        "end_character": 72362
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In April 2023, we purchased the assets of Covestro’s additive manufacturing materials business, including all of the SOMOS™ photocurable liquids portfolio.",
        "start_character": 8367,
        "end_character": 8522
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In July 2014 and August 2014, we acquired Solid Concepts and Harvest Technologies, respectively, two leading providers of additive manufacturing services.",
        "start_character": 599,
        "end_character": 753
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to our standard portfolio, we support customized material development for non-Stratasys systems to meet specific customer requirements.",
        "start_character": 71575,
        "end_character": 71722
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we provide pay-per-usage subscription services for our 3D printers and 3D production systems via partners in our global manufacturing network.",
        "start_character": 82637,
        "end_character": 82792
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our customers are dispersed geographically, and we are not reliant on any single country or region for most of our product sales and services revenues, although 59.7% of our 2025 revenues were generated in the Americas and our Stratasys Direct Manufacturing printed parts services are primarily based in the United States and therefore reliant on United States customers.",
        "start_character": 107789,
        "end_character": 108160
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our legal and commercial name is Stratasys Ltd., and we are the product of the 2012 merger of two leading additive manufacturing companies, Stratasys, Inc.",
        "start_character": 76,
        "end_character": 231
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our materials portfolio was similarly bolstered in May 2025 when we acquired key assets and operations of Forward AM Technologies GmbH, formerly a prominent additive manufacturing materials brand, particularly enhancing our Selective Absorption Fusion (SAF) and Digital Light Processing (DLP) portfolios.",
        "start_character": 3060,
        "end_character": 3364
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Recognizing that our end-users have varying support needs, we offer a range of support programs that enable our end-users to continue to receive maintenance services beyond the initial warranty period.",
        "start_character": 81662,
        "end_character": 81863
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-015079",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-015079-19ce9dde61e3cb13",
        "accession_number": "0001628280-26-015079",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To further strengthen our leadership position and following our strategy to deepen the focus on additive manufacturing, tooling and rapid prototyping for specific vertical markets, we have announced a variety of technology and go-to-market partnerships for various key vertical markets, such as automotive, aerospace, consumer products and healthcare.",
        "start_character": 63676,
        "end_character": 64027
      }
    ]
