        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Likewise, in many instances, we provide promotional and marketing support and/or funds and/or dispensing equipment and repair services to fountain and bottle/can retailers, typically pursuant to marketing agreements.",
        "start_character": 24448,
        "end_character": 24664
      },
      {
