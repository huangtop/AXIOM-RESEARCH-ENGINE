        "end_character": 11154
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-027133",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-027133-34d4478852e0fe2b",
        "accession_number": "0001104659-26-027133",
        "filing_date": "2026-03-12",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Forward-looking statements include statements concerning business strategy, among other things, including anticipated trends and developments in and management plans for our business and the markets in which we operate.",
        "start_character": 278,
        "end_character": 497
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-027133",
