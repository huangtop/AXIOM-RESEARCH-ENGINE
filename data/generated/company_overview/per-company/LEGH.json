        "accession_number": "0001104659-26-027133",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In an inventory finance arrangement, we sell products to our independent retailers and provide financing for the sales.",
        "start_character": 32950,
        "end_character": 33069
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-027133",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-027133-34d4478852e0fe2b",
        "accession_number": "0001104659-26-027133",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "These financing solutions are structured to give us an attractive return on investment, when coupled with the gross margin we realize on products specifically targeted for these new manufactured housing communities.",
        "start_character": 15310,
        "end_character": 15525
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-027133",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-027133-34d4478852e0fe2b",
        "accession_number": "0001104659-26-027133",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to expand financing solutions to manufactured housing community-owner customers in a manner that includes developing new sites for products in or near urban locations where there is a shortage of sites to place our products.",
        "start_character": 17291,
        "end_character": 17527
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-027133",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-027133-34d4478852e0fe2b",
        "accession_number": "0001104659-26-027133",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide comprehensive sales training to retail sales associates and bring them to our manufacturing facilities for product training and to view new product designs as they are developed.",
        "start_character": 28745,
        "end_character": 28934
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-027133",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-027133-34d4478852e0fe2b",
        "accession_number": "0001104659-26-027133",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide financing to owners of manufactured housing communities for our products that they buy in order to rent to their residents.",
