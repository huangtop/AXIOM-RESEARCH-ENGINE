        "offering_role": "product",
        "confidence": 0.96,
        "statement": "And we provide financing solutions to manufactured housing community owners that buy our products for use in their housing communities.",
        "start_character": 5334,
        "end_character": 5469
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-027133",
