        "end_character": 35177
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-027133",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-027133-34d4478852e0fe2b",
        "accession_number": "0001104659-26-027133",
        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide inventory financing for most of our independent retailers for products we manufacture and for pre-owned products.",
