        "accession_number": "0001628280-26-014844",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We compete for sellers based on many factors including the scale of our buyers, ease of use of our marketplace, our brands and seller trust and security.",
