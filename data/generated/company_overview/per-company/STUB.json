        "accession_number": "0001628280-26-014844",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As we expand and localize our international activities, we are increasingly becoming obligated to comply with additional laws of countries or markets in which we operate.",
        "start_character": 11780,
        "end_character": 11950
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-014844",
