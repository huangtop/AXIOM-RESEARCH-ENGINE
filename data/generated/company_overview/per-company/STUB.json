        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Across verticals, we have observed how content owners gravitate towards online marketplaces with similar capabilities and we believe this trend will eventually shape the distribution and consumption of live events, further propelling our market opportunity.",
        "start_character": 1924,
        "end_character": 2181
