        "accession_number": "0001628280-26-014844",
        "filing_date": "2026-03-05",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As we seek to continue growing our marketplace globally, we face competition in attracting buyers and sellers.",
        "start_character": 2519,
        "end_character": 2629
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-014844",
