    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Coupled with the experience and expertise of our management and scientific teams, we believe we possess meaningful potential to compete in developing and commercializing important products to improve the pregnancy experience and the health of mothers and babies.",
        "start_character": 102442,
        "end_character": 102704
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In the future, we may use this technology to develop products for a number of health conditions other than premature birth.",
        "start_character": 13629,
        "end_character": 13752
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Notwithstanding the foregoing advantages, given the potential market opportunity represented by the PreTRM test and other pregnancy-related products and services that we may develop, we expect competition to emerge and intensify in the coming years, with one or more competitive offerings resulting from competitors’ efforts.",
        "start_character": 102705,
        "end_character": 103030
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our product discovery and development approach is based on rigorous science and health-based economic analyses as we discover, develop and commercialize biomarker tests and predictive analytic products and services designed to transform pregnancy-related care for patients, doctors and payers.",
        "start_character": 13180,
        "end_character": 13473
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our proprietary technology platform is designed to provide deep characterization of the biology of pregnancy, which we are using to develop additional products addressing pregnancy outcomes, such as time-to-birth, preeclampsia, gestational diabetes, and other conditions.",
        "start_character": 28322,
        "end_character": 28593
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our tests also may become subject to other foreign premarket review, compliance, and regulatory approval regimes applicable to IVDs if we decide to expand and offer our services internationally beyond certain EU markets.",
        "start_character": 141805,
        "end_character": 142025
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Societal Guidelines: We believe that broad market adoption of a product benefits from the product being included in clinical societal guidelines, and therefore we support organizations such as SMFM and ACOG by providing them insights from our accumulating evidence development.",
        "start_character": 17249,
        "end_character": 17526
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Under this agreement, we provided clinical laboratory services as requested by participating physicians and other health care professionals, and written reports to those physicians and professionals of the results of the services performed in accordance with the PRIME study.",
        "start_character": 100792,
        "end_character": 101067
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Utilizing our product discovery, development and commercialization approach, and in view of these stark realities of preterm birth, we focused our first development and commercialization efforts on addressing preterm birth.",
        "start_character": 49516,
        "end_character": 49739
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also agreed to develop a sales, marketing, and customer service program, and to provide training and marketing to duly licensed physicians specializing in obstetrics and gynecology or family medicine, or licensed nurse midwives, at the reasonable request of Elevance Health.",
        "start_character": 99360,
        "end_character": 99637
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also continue to file patent applications on new developments and improvements that may be important to our future business.",
        "start_character": 113301,
        "end_character": 113428
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001534969-26-000009",
        "provenance_id": "provenance:SEC-FILING-0001534969-26-000009-7184f8c9f384ab49",
        "accession_number": "0001534969-26-000009",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also may become subject to regulation in foreign jurisdictions as we begin seeking to expand international utilization of our PreTRM test and any future tests we develop, and the jurisdictions in which we pursue operations adopt licensure requirements for U.S.-based clinical laboratories offering and providing diagnostic testing services to professionals located in those jurisdictions.",
        "start_character": 122203,
        "end_character": 122594
      }
    ]
