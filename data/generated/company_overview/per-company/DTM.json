    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Additionally, we intend to develop low carbon business opportunities and deploy GHG reducing technologies as part of our goal of being leading environmental stewards in the midstream industry.",
        "start_character": 4497,
        "end_character": 4689
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are an owner, operator, and developer of an integrated portfolio of natural gas midstream assets.",
        "start_character": 1004,
        "end_character": 1104
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We intend to leverage the scale and scope of our large asset platforms, our services, and our capabilities to increase efficiency across our portfolio and in the strategically situated market regions where we operate.",
        "start_character": 5501,
        "end_character": 5718
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We operate natural gas storage facilities in Michigan as interstate facilities regulated by PHMSA and provide interstate storage and related services pursuant to a FERC-approved tariff.",
        "start_character": 47754,
        "end_character": 47939
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide multiple, integrated natural gas services to customers through our interstate pipelines, intrastate pipelines, storage systems, gathering lateral pipelines and compression and surface facilities, and gathering systems including related treatment plants, and compression and surface facilities.",
        "start_character": 1105,
        "end_character": 1409
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide other ancillary services within our Gathering segment, including compression, dehydration, gas treatment, water impoundment, water transportation, water disposal, and sand mining.",
        "start_character": 16499,
        "end_character": 16689
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We will continue to provide safe, highly reliable, timely and cost-competitive service, which is a key distinguishing competitive advantage.",
        "start_character": 5038,
        "end_character": 5178
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Every state in which we operate is certified by PHMSA to regulate the safety of intrastate gas pipeline facilities consistent with the federal safety standards, and some of these states apply additional or more stringent safety standards or reporting requirements to intrastate gas pipeline facilities in their respective jurisdictions.",
        "start_character": 44246,
        "end_character": 44582
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "States in which we operate may also adopt a complaint-based regulation of natural gas gathering activities, which allows natural gas producers and shippers to file complaints with state regulators in an effort to resolve grievances relating to gathering access and rate discrimination.",
        "start_character": 35754,
        "end_character": 36039
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are also subject to OSHA Process Safety Management regulations, which are designed to prevent or minimize the consequences of catastrophic releases of toxic, reactive, flammable or explosive chemicals.",
        "start_character": 72685,
        "end_character": 72889
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are also subject to the EPA Risk Management Program, which addresses the prevention of chemical accidents and preparedness for emergencies.",
        "start_character": 72890,
        "end_character": 73032
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001842022-26-000003",
        "provenance_id": "provenance:SEC-FILING-0001842022-26-000003-9466e24f10d92ab0",
        "accession_number": "0001842022-26-000003",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have implemented programs and policies designed to keep our pipelines and other facilities in compliance with existing environmental laws and regulations, and we incur significant costs in connection with compliance.",
        "start_character": 50910,
        "end_character": 51129
      }
    ]
  },
