        "provenance_id": "provenance:SEC-FILING-0001193125-26-126371-02c8a379627bd8aa",
        "accession_number": "0001193125-26-126371",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We endeavor to patent or in-license technology, inventions and improvements that we consider important to the development of our business.",
