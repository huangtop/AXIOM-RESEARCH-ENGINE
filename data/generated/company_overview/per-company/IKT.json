        "accession_number": "0001193125-26-126371",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We rely on third-party contract development and manufacturing organizations (“CDMOs”), to manufacture and supply our preclinical and clinical materials to be used during development of our product candidates.",
        "start_character": 19999,
        "end_character": 20207
      },
      {
