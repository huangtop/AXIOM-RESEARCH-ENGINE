      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126371",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126371-02c8a379627bd8aa",
        "accession_number": "0001193125-26-126371",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By 2015, we had developed our own portfolio of protein kinase inhibitors to treat bacterial and viral infections, including viral infections in the brain.",
        "start_character": 15005,
        "end_character": 15159
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-126371",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-126371-02c8a379627bd8aa",
        "accession_number": "0001193125-26-126371",
        "filing_date": "2026-03-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "During 2015, we also began our endeavors in developing product candidates for other diseases of the brain, including neurodegeneration.",
