        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we design and develop tailor-made insurance products together with our insurer partners.",
        "start_character": 9469,
        "end_character": 9570
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-175067",
