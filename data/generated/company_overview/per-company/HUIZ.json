        "end_character": 35063
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-175067",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-175067-5a85fd9eee6fe109",
        "accession_number": "0001193125-26-175067",
        "filing_date": "2026-04-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also proactively collaborate with those insurer partners that we have established a long and stable relationship with to design and develop insurance products together.",
