        "filing_date": "2026-03-18",
        "offering_role": "service",
        "confidence": 0.88,
        "statement": "(“CSI”) (acquisition closed May 2025), a premier provider of event registration, lead retrieval, and data analytics services for major trade shows and conferences.",
        "start_character": 13472,
        "end_character": 13635
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-031280",
