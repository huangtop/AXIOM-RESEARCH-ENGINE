        "accession_number": "0001104659-26-031280",
        "filing_date": "2026-03-18",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In the United States, we had 194 employees, including 56 employees in our research and development department, 53 employees in our sales and marketing department, 85 employees in our general and administrative department.",
        "start_character": 19530,
        "end_character": 19751
      },
      {
