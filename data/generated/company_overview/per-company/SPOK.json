        "end_character": 25274
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001289945-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001289945-26-000010-eb566eaa6a6e313b",
        "accession_number": "0001289945-26-000010",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also sell devices to resellers who lease or resell them to their subscribers and then sell messaging services utilizing our networks.",
