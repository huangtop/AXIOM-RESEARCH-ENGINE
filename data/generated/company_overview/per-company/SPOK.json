        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer managed services, which includes the implementation services for all the available upgrades to the software purchased by the customer over the term of the contract.",
        "start_character": 25516,
        "end_character": 25694
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001289945-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001289945-26-000010-eb566eaa6a6e313b",
