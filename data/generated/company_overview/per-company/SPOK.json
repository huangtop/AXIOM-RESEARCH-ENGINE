        "accession_number": "0001289945-26-000010",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The GenA pager is the only product available on the market with these capabilities, and we maintain an exclusive arrangement with the product's manufacturer whereby it may not market or sell the product to any third party without our consent.",
