        "accession_number": "0001289945-26-000010",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer ancillary services, such as voicemail and equipment loss or maintenance protection, which help increase the monthly recurring revenue we receive, along with these traditional messaging services.",
        "start_character": 17697,
        "end_character": 17905
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001289945-26-000010",
        "provenance_id": "provenance:SEC-FILING-0001289945-26-000010-eb566eaa6a6e313b",
