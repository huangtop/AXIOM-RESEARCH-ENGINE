        "filing_date": "2026-04-08",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "As an external innovation partner to the life science industry, we provide stand-alone services or integrated offerings, characterized by multi-year, multi-stage drug discovery and development campaigns using our industrialized and comprehensive infrastructure.",
        "start_character": 13300,
        "end_character": 13561
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-040767",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-040767-65bd99ef5ebde17c",
