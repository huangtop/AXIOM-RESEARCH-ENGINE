    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Our business benefits from elevated single family home ownership costs which makes renting more attractive, positive household formation trends, residents choosing a longer-term rental lifestyle for greater flexibility in living arrangements and the overall deficit in housing across the country, especially in the areas in which we are investing.",
        "start_character": 5080,
        "end_character": 5427
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our multi-pronged investment strategy featuring acquisitions, new stand-alone and expansion developments, densifying developments and accretive renovations of existing properties is focused on optimizing and balancing our portfolio in terms of the markets we operate in and between urban and suburban submarkets within those markets.",
        "start_character": 6552,
        "end_character": 6885
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Elevated single family home ownership costs (large down payments, high interest rates, etc.), low for sale inventory and existing homeowners that are reluctant to sell given favorable locked-in financing all support renting in the long-term, especially in the markets in which we operate.",
        "start_character": 7393,
        "end_character": 7681
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Recognizing that employee needs are not one-size-fits-all, we offer a comprehensive and inclusive benefits program designed to support a broad range of needs.",
        "start_character": 26274,
        "end_character": 26432
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "These principles guide how we attract and retain talent, invest in development and create an environment where people feel seen, supported and empowered to contribute their best.",
        "start_character": 19660,
        "end_character": 19838
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "This is our corporate purpose and we carry it through our relationships with our customers, our employees, our shareholders and the communities in which we operate.",
        "start_character": 5746,
        "end_character": 5910
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Through annual talent reviews, we evaluate the organization’s talent strength and identify key development needs, helping to inform succession planning, guide support and resources for our people and endeavor to ensure organizational readiness for the future.",
        "start_character": 21654,
        "end_character": 21913
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "To develop, attract and retain the best employees, we are committed to providing a total compensation package that is market-based, performance driven, fair and internally equitable.",
        "start_character": 20734,
        "end_character": 20916
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also face significant competition for the acquisition and development of apartment communities.",
        "start_character": 12440,
        "end_character": 12538
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We also maintain a structured succession-planning process that identifies and develops high-potential talent in an effort to ensure leadership continuity and support the organization's long-term stability.",
        "start_character": 25447,
        "end_character": 25652
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We believe our strategy capitalizes on the preference of renters of all ages to live in the locations where we operate which typically are near transportation (both public transit and convenient highway access), entertainment, employment centers/universities and cultural and outdoor amenities.",
        "start_character": 9429,
        "end_character": 9723
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051433",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051433-8d36ae53b1c6e266",
        "accession_number": "0001193125-26-051433",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe work should evolve alongside the people who power it, which means listening closely, designing with intention and leading with clarity and care.",
        "start_character": 19839,
        "end_character": 19994
      }
    ]
  },
