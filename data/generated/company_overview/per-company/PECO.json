        "accession_number": "0001476204-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are a limited partner of the Operating Partnership, and our wholly-owned subsidiary, Phillips Edison Grocery Center OP GP I LLC, is the sole general partner of the Operating Partnership.",
        "start_character": 1783,
        "end_character": 1972
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001476204-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001476204-26-000005-beccf42c6f96919f",
        "accession_number": "0001476204-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We focus on owning centers in markets with strong household incomes and growing populations where both leading grocers and small shop Neighbors are successful.",
        "start_character": 6477,
        "end_character": 6636
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001476204-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001476204-26-000005-beccf42c6f96919f",
        "accession_number": "0001476204-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "•Advantages of the Market—We continue to see many advantages to the suburban markets where we operate our shopping centers.",
        "start_character": 6353,
        "end_character": 6476
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001476204-26-000005",
