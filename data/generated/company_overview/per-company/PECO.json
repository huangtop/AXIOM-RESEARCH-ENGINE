        "accession_number": "0001476204-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our tenants, who we refer to as “Neighbors,” are a mix of national, regional, and local retailers that primarily provide necessity-based goods and services.",
