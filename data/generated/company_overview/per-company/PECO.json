        "accession_number": "0001476204-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "operator_business",
        "confidence": 0.9,
        "statement": "Additionally, we are seeking growth opportunities to complement our core grocery-anchored portfolio with incremental initiatives, such as everyday retail, often referred to as unanchored centers, to enhance our portfolio returns.",
        "start_character": 3176,
        "end_character": 3405
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001476204-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001476204-26-000005-beccf42c6f96919f",
        "accession_number": "0001476204-26-000005",
        "filing_date": "2026-02-10",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "These factors combine to determine the level of occupancy and rental rates that we are able to achieve at our properties.",
