        "accession_number": "0001437749-26-004524",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In our maleic anhydride market, we compete primarily based on price, customer service, reliability of supply and logistics management.",
        "start_character": 29696,
        "end_character": 29830
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-004524",
