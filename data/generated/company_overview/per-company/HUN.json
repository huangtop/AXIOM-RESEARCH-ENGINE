        "confidence": 0.96,
        "statement": "In addition to our focused direct sales efforts, we maintain an extensive global network of distributors and agents that also sell our products.",
        "start_character": 26660,
        "end_character": 26804
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-004524",
