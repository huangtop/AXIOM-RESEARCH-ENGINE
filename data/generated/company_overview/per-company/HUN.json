        "end_character": 387
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-004524",
        "provenance_id": "provenance:SEC-FILING-0001437749-26-004524-47b5585a6e04fee3",
        "accession_number": "0001437749-26-004524",
        "filing_date": "2026-02-18",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a global manufacturer of diversified organic chemical products.",
