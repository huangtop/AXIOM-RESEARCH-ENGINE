        "provenance_id": "provenance:SEC-FILING-0001193125-26-108632-54852e5ba3d5125c",
        "accession_number": "0001193125-26-108632",
        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We may resume internal development, seek partners or pursue other strategic alternatives for selected assets depending on capital availability and portfolio priorities.",
        "start_character": 15794,
