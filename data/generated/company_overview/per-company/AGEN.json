        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For each royalty-bearing product, we were eligible to receive (i) up to $155.0 million in future contingent development, regulatory, and commercialization milestones and (ii) tiered royalties on global net sales generally ranging from 6% to 12%.",
        "start_character": 18314,
        "end_character": 18559
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-108632",
