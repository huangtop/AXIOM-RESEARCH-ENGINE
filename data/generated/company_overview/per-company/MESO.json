        "filing_date": "2025-08-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Before we can begin commercial manufacture of our products for sale in the United States, we must obtain FDA regulatory approval for the product.",
        "start_character": 38032,
        "end_character": 38177
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001345099-25-000067",
