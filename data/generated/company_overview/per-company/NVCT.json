        "provenance_id": "provenance:SEC-FILING-0001104659-26-013044-3f24d2ba96d941f0",
        "accession_number": "0001104659-26-013044",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "There is no assurance that we will be able to successfully manufacture drug substance and/or drug product for NXP900.",
