        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We plan to continue to rely on third-party manufacturers for the supply of NXP900, and any future additional product candidates we may acquire or license, for preclinical testing, clinical trials and commercialization if our current or future product candidates receive marketing approval.",
        "start_character": 26328,
        "end_character": 26617
      },
      {
