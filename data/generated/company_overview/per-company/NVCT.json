        "accession_number": "0001104659-26-013044",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we may need to develop our current or future product candidates in collaboration with diagnostic companies, and we will face competition from other companies in establishing these collaborations.",
        "start_character": 24136,
        "end_character": 24344
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-013044",
