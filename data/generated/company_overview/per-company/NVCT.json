        "accession_number": "0001104659-26-013044",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our business operations and any current or future arrangements with third-party payors, healthcare providers and physicians may expose us to broadly applicable fraud and abuse and other healthcare laws and regulations that may constrain the business or financial arrangements and relationships through which we develop, market, sell and distribute any drugs for which we obtain marketing approval.",
        "start_character": 38919,
        "end_character": 39316
      },
      {
