    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In certain states, we contract with physicians to provide healthcare services that are required to be provided by licensed physicians to comply with such requirements.",
        "start_character": 40719,
        "end_character": 40886
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Specifically, in some of the states in which we operate, we are required to maintain licensure or certification as an adult day health center, home health or home care provider, diagnostic and treatment center, pharmacy provider, clinical laboratory and/or other type of facility, and our affiliated physicians and other clinicians also must be licensed or certified, as applicable, in the states in which they are providing services.",
        "start_character": 38065,
        "end_character": 38499
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "The laws and regulations relating to our operations vary from state to state, and some states in which we operate prohibit general business corporations, such as us, from practicing medicine, directly employing physicians, controlling physicians’ or other clinicians’ medical decisions, or engaging in some practices such as splitting professional fees with physicians or other clinicians.",
        "start_character": 40329,
        "end_character": 40718
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "As a PACE provider that provides qualified prescription drug coverage, we are also subject to Medicare laws, regulations, and requirements applicable to Medicare Part D plan sponsors.",
        "start_character": 35849,
        "end_character": 36032
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "As a result, our capabilities are not limited to what we are able to offer inside of our centers.",
        "start_character": 20919,
        "end_character": 21016
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "For example, we believe that these investments are offered and made by us on a fair market value basis and provide returns to the investors in proportion to their actual investment in the venture.",
        "start_character": 46923,
        "end_character": 47119
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Given our scale across geographies, we believe we are positioned to capitalize on a significant market opportunity to provide care to frail, high-cost, dual-eligible seniors.",
        "start_character": 14607,
        "end_character": 14781
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition to the FCA, the various states in which we operate have adopted their own analogs of the FCA.",
        "start_character": 55714,
        "end_character": 55819
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition to the Stark Law, various states in which we operate have adopted similar self-referral prohibition statutes.",
        "start_character": 51160,
        "end_character": 51281
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In addition, new centers that we may acquire in the future may have less developed compliance and quality infrastructures, which may require us to allocate additional resources to making any required enhancements.",
        "start_character": 36454,
        "end_character": 36667
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, we manage transportation not only to and from our centers, but also to all third-party medical appointments.",
        "start_character": 22469,
        "end_character": 22590
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001834376-25-000062",
        "provenance_id": "provenance:SEC-FILING-0001834376-25-000062-c0195bfe91339a89",
        "accession_number": "0001834376-25-000062",
        "filing_date": "2025-09-09",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Scrutiny through federal and state government audits, oversight and enforcement and the highly technical regulatory scheme in which we operate require us to allocate significant resources to our compliance efforts.",
