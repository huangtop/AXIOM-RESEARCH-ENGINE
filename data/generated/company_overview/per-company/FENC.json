        "end_character": 8182
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-036182",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-036182-9ac8ef82e0dddea4",
        "accession_number": "0001104659-26-036182",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a result of these factors, we are unable to accurately estimate the nature, timing and future costs necessary to complete future development of PEDMARK®.",
