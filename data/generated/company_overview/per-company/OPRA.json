      {
        "business_evidence_id": "business-evidence:SEC-0001737450-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001737450-26-000005-e7b82c8ff696cf7a",
        "accession_number": "0001737450-26-000005",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Since that time, we have been focused on developing consumer internet products centered on web browsing, content discovery and related services for a global user base.",
        "start_character": 177,
        "end_character": 344
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001737450-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001737450-26-000005-e7b82c8ff696cf7a",
        "accession_number": "0001737450-26-000005",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We acquired Opera Norway AS and its subsidiaries in November 2016, which included the business of developing and distributing Opera’s mobile and PC web browsers and certain related products and services.",
        "start_character": 718,
        "end_character": 921
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001737450-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001737450-26-000005-e7b82c8ff696cf7a",
        "accession_number": "0001737450-26-000005",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We anticipate continued developments in data protection, privacy and data localization rules in various countries, which will continue to affect our business and impact our products and services.",
        "start_character": 30171,
        "end_character": 30366
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001737450-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001737450-26-000005-e7b82c8ff696cf7a",
        "accession_number": "0001737450-26-000005",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We leverage our existing user base and cutting-edge technologies, such as LLMs and AIGC, to develop our AI-powered content discovery and a multi-scenario/multi-modal/multi-objective recommendation platform that we integrate into a variety of our products and services.",
        "start_character": 19307,
        "end_character": 19575
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001737450-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001737450-26-000005-e7b82c8ff696cf7a",
        "accession_number": "0001737450-26-000005",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We partner with ad agencies, influencers, game affiliation networks, device manufacturers, mobile network operators and others to promote and distribute our products.",
        "start_character": 14836,
        "end_character": 15002
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001737450-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001737450-26-000005-e7b82c8ff696cf7a",
        "accession_number": "0001737450-26-000005",
        "filing_date": "2026-03-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We use automated provisioning and orchestration tools to manage capacity and support service availability across different devices, operating systems, carriers and network environments.",
        "start_character": 20547,
        "end_character": 20732
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001737450-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001737450-26-000005-e7b82c8ff696cf7a",
        "accession_number": "0001737450-26-000005",
        "filing_date": "2026-03-27",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "With the growth of high value users and the scale of our audience extension offering, we are becoming an increasingly relevant partner for advertisers.",
        "start_character": 7593,
        "end_character": 7744
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001737450-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001737450-26-000005-e7b82c8ff696cf7a",
        "accession_number": "0001737450-26-000005",
        "filing_date": "2026-03-27",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In late 2025, we introduced Opera Neon, a premium, subscription-based agentic AI browser designed for productivity-oriented users, which automates complex web-based tasks.",
        "start_character": 5961,
        "end_character": 6132
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001737450-26-000005",
        "provenance_id": "provenance:SEC-FILING-0001737450-26-000005-e7b82c8ff696cf7a",
