        "filing_date": "2026-03-27",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "MiniPay Fund, a venture fund managed by Verda Ventures established to invest in MiniPay ecosystem companies and projects, where we are one of several investors, holding a 27.4% ownership interest as of December 31, 2025.",
        "start_character": 21666,
        "end_character": 21886
