    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Among our other middleware software license offerings, we license development tools, such as Oracle WebLogic Server for Java application development and Oracle Identity Manager, which automates user identity provisioning and allows enterprises to manage the end-to-end lifecycle of user identities across all enterprise resources.",
        "start_character": 29484,
        "end_character": 29814
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we also believe we can market our Oracle Cloud offerings to a broader ecosystem of small and medium-sized businesses, non-IT lines of business purchasers, developers and partners due to the highly performant and available, intuitive design, ease-of-access, low touch and cost-effective characteristics of the Oracle Cloud.",
        "start_character": 7953,
        "end_character": 8288
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In fiscal 2026, 2025 and 2024, we invested $10.3 billion, $9.9 billion and $8.9 billion, respectively, in research and development to enhance our existing portfolio of offerings and to develop new technologies and services.",
        "start_character": 4041,
        "end_character": 4264
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our investments in and innovation with respect to Oracle products and services that we offer through our three businesses (cloud and software, hardware and services businesses, described further below) are another important element of our corporate strategy.",
        "start_character": 3782,
        "end_character": 4040
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The applications technologies that we offer are generally designed using industry standard architectures to manage and automate core business functions across the enterprise and a broad range of industries, as well as to help customers differentiate and innovate in those processes unique to their industries or organizations.",
        "start_character": 9846,
        "end_character": 10172
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "To complement the full suite of OCI offerings delivered by Oracle public cloud regions across the globe, we provide our customers with additional flexibility by offering certain OCI services in a number of deployment options, such as:",
        "start_character": 22121,
        "end_character": 22355
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also market and sell our offerings globally through indirect channels.",
        "start_character": 36586,
        "end_character": 36659
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also market our product offerings worldwide through indirect channels.",
        "start_character": 37592,
        "end_character": 37665
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that we can market and sell our Oracle Cloud offerings together to help new and existing customers migrate their extensive installed base of on-premise and cloud-based applications and infrastructure technologies to the Oracle Cloud and we believe we are in the early stages of what we expect will be a material migration of our existing Oracle customer base from on-premise applications and infrastructure products and services to the Oracle Cloud.",
        "start_character": 7038,
        "end_character": 7498
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We develop the substantial majority of our products and services offerings internally utilizing the skills and diversity of a global workforce.",
        "start_character": 38438,
        "end_character": 38581
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We directly market and sell our cloud, software, hardware, support and services offerings globally to businesses of many sizes and in many industries, government agencies and educational institutions.",
        "start_character": 36385,
        "end_character": 36585
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-277521",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-277521-6cd094af28aa1609",
        "accession_number": "0001193125-26-277521",
        "filing_date": "2026-06-22",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We focus our development efforts on improving the performance, security, reliability, operation, integration and cost-effectiveness of our offerings relative to our competitors;",
        "start_character": 4491,
        "end_character": 4668
      }
    ]
