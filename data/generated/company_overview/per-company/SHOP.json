        "accession_number": "0001594805-26-000007",
        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that by deepening and expanding the range of solutions we offer to merchants and by offering new and better ways to market and sell their products, we will be able to grow our addressable market and meet the needs of merchants in years ahead.",
        "start_character": 7928,
        "end_character": 8181
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001594805-26-000007",
