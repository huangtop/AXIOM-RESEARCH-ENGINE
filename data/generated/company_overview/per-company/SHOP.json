        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Key elements of our growth strategy include growing and expanding our merchant base and the types of merchants we serve and helping our existing merchants continue to grow through continued innovation in our platform and the products we offer to our merchants as well as further growing and developing our ecosystem of partners.",
        "start_character": 8517,
        "end_character": 8845
