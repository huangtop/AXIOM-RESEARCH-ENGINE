    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "During the 2025-2026 school year, we provided our school-as-a-service offering to 92 schools in 31 states and the District of Columbia in the General Education market, and 57 schools or programs in 25 states and the District of Columbia in the Career Learning market.",
        "start_character": 3510,
        "end_character": 3777
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition to providing a comprehensive course catalog, related books and physical materials, a learning management system (“LMS”) for online learning, and, in certain cases, student computers, we also provide these schools a variety of administrative support, technology and academic support services.",
        "start_character": 10737,
        "end_character": 11040
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "There are also other federal laws and regulations that affect other aspects of our business such as the Children’s Online Privacy Protection Act (“COPPA”), which imposes certain parental notice and other requirements for children under 13 years of age who access the web-based schools we manage.",
        "start_character": 48861,
        "end_character": 49156
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "To meet this need, we offer full-service programs and stand-alone products and services that appeal to parents and students across the K-12 market.",
        "start_character": 6581,
        "end_character": 6728
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We are responsible for the sourcing, assembly and delivery of school supplies and materials for our school-as-a-service offerings.",
        "start_character": 20459,
        "end_character": 20589
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We compete primarily with companies that provide online curriculum and school support services to K-12 virtual and blended public schools, including Pearson PLC (Connections Academy), Lincoln Learning Solutions, StrongMind, Pansophic Learning, Inspire Charter Schools, and Charter Schools USA, and state administered online programs, among others.",
        "start_character": 22015,
        "end_character": 22362
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide a broad range of instructional services that include customer support for instructional teams, including recruitment of state certified teachers, training in research-based online instruction methods and systems, oversight and evaluation services, and ongoing professional development.",
        "start_character": 18159,
        "end_character": 18455
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide a broad range of support services, including marketing and enrollment (e.g., supporting prospective students through the admission process), assessment management, administrative support (e.g., budget proposals, financial reporting, and student data reporting), and technology and materials support (e.g., providing student computers, offline learning kits, internet access and technology support services).",
        "start_character": 18762,
        "end_character": 19180
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide a wide range of products and services across our platform with the ability to deliver customized solutions.",
        "start_character": 675,
        "end_character": 793
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We, the virtual public school or the blended school could be required to provide additional staff, related services, supplemental aids and services or a private school option at our own cost to comply with the requirement to provide a free appropriate public education to each child covered under the IDEA.",
        "start_character": 43640,
        "end_character": 43946
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In total, we manage approximately 9,600 teachers, 5,900 of whom are employees and 3,700 who are employed by virtual or blended public schools that we manage under contracts with those schools but are not direct employees of Stride.",
        "start_character": 27568,
        "end_character": 27799
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-090515",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-090515-ade1e7c3a469178b",
        "accession_number": "0001104659-26-090515",
        "filing_date": "2026-08-05",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "The schools we manage are responsible for helping ensure the requirements of IDEA are met.",
        "start_character": 43398,
        "end_character": 43488
      }
    ]
  },
