        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "A portion of our business consists of manufacturing defense and defense-related items for various departments and agencies of the USG, including the DoW, which requires that we maintain facility security clearances under the NISPOM.",
        "start_character": 37152,
        "end_character": 37384
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Along with supply of traditional and RF PCBs, we offer a variety of RF components and subassemblies, engineered systems, engineering services, and assembly capabilities to provide additional value to our customers.",
        "start_character": 35117,
        "end_character": 35331
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By aiming to provide a one-stop solution, we work to service our customers’ needs from the earliest stages of product design and development through volume production.",
        "start_character": 8662,
        "end_character": 8829
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "By offering this wide range of engineered systems, RF components and subsystems, advanced interconnect products, and complementary value-added services, we provide our customers with a “one-stop” manufacturing solution for their hardware technology and integration requirements.",
        "start_character": 11096,
        "end_character": 11374
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In circumstances where our customers require time critical engineering and manufacturing services, we are able to react to our customers’ needs with our quick-turn manufacturing capabilities.",
        "start_character": 24871,
        "end_character": 25062
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also offer certain value-added services to support our customers’ needs for RF design-to-specification capability, DFM, PCB layout design, simulation and testing services, and QTA services.",
        "start_character": 33554,
        "end_character": 33746
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer specialized radio frequency assembly, test services, and integrated solutions to provide sophisticated integrated electronics for numerous platforms.",
        "start_character": 13536,
        "end_character": 13699
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also offer value-added services including DFM, PCB layout design, simulation and testing, QTA production, and specialized RF assembly and testing.",
        "start_character": 10946,
        "end_character": 11095
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are a leading global manufacturer of technology products, including mission systems, RF components, RF microwave/microelectronic assemblies, and technologically advanced interconnect products, including PCBs and substrates.",
        "start_character": 25,
        "end_character": 251
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe our facility specialization strategy allows us to reduce the time required to develop new products by directing each customer to the facility best suited to their product type, delivery time, complexity, and volume needs.",
        "start_character": 33945,
        "end_character": 34177
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe our technological capabilities allow us to address the needs of manufacturers to bring complicated electronic products to market faster.",
        "start_character": 19717,
        "end_character": 19864
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-051976",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-051976-a9aedc8048051d12",
        "accession_number": "0001193125-26-051976",
        "filing_date": "2026-02-17",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that by engaging with our customers early in the development process, we are better able to develop solutions for our customers’ needs and establish an incumbent position early in the product development cycle, which translates into additional opportunities as our customers move into volume production.",
        "start_character": 8830,
        "end_character": 9144
      }
