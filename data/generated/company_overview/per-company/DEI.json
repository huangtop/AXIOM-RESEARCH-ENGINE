        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Once we select a submarket, we follow a disciplined strategy of gaining substantial market share to provide us with extensive local transactional market information, pricing power in lease and vendor negotiations and an enhanced ability to identify and negotiate investment opportunities.",
        "start_character": 3170,
        "end_character": 3458
