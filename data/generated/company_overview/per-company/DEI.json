        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We are committed to selecting development sites that are not in environmentally protected areas or areas of high biodiversity, and strive to use brownfield sites instead of greenfield sites.",
        "start_character": 23285,
        "end_character": 23475
