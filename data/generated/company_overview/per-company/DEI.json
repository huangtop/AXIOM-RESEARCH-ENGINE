        "filing_date": "2026-02-20",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are one of the largest owners and operators of high-quality office and multifamily properties located in premier coastal submarkets in Los Angeles and Honolulu.",
        "start_character": 111,
        "end_character": 274
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001364250-26-000011",
