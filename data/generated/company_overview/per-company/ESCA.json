        "provenance_id": "provenance:SEC-FILING-0001437749-26-006094-062b3efdc09a6872",
        "accession_number": "0001437749-26-006094",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.88,
        "statement": "The resulting enterprise, renamed as Escalade, Incorporated, became a diversified manufacturer of sporting goods, recreational products, office products, graphic arts products, hobby and craft items, toys, and footwear.",
