        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.88,
        "statement": "In 1972, Williams Manufacturing acquired Martin-Yale Industries, Inc., an Illinois-based manufacturer of office and graphic arts products, and crafts and toys.",
        "start_character": 3062,
        "end_character": 3221
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001437749-26-006094",
