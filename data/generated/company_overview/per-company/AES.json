        "confidence": 0.96,
        "statement": "AES also provides development services, where we enter into contracts to fully develop customized assets to meet customers' needs.",
        "start_character": 18867,
        "end_character": 18997
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000874761-26-000063",
