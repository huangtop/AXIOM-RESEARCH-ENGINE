        "filing_date": "2026-02-20",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "While specialty market exposures may have higher insurance risks than their standard admitted market counterparts, we manage these risks to achieve superior financial returns.",
        "start_character": 2812,
        "end_character": 2987
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-018013",
