        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "Consistent with this approach, we have a history of exiting markets when conditions become overly adverse and introducing new coverages and programs when opportunities exist to deliver needed risk transfer with exceptional service on a profitable basis.",
        "start_character": 16585,
        "end_character": 16838
      },
