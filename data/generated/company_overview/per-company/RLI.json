        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Given the complex nature of our products and the niche markets in which we operate, we prefer to utilize our own underwriting, claims and support staff, as these businesses require specialized experience and deep industry knowledge to appropriately select risks and effectively serve customers.",
        "start_character": 54188,
        "end_character": 54482
      },
      {
