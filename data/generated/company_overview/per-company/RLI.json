        "filing_date": "2026-02-20",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "In the normal course of business, we manage our concentrations of exposures to catastrophic events, primarily by limiting concentrations of locations insured to acceptable levels and by purchasing reinsurance.",
        "start_character": 27337,
        "end_character": 27546
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-018013",
