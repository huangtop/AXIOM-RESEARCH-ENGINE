        "end_character": 57075
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-018013",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-018013-a01661c1abfb9880",
        "accession_number": "0001104659-26-018013",
        "filing_date": "2026-02-20",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "As a specialty insurance company with a niche focus, we offer insurance coverages in the specialty admitted and excess and surplus markets.",
        "start_character": 1097,
        "end_character": 1236
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-018013",
