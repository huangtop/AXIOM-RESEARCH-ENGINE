        "accession_number": "0001193125-26-149722",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Highly compatible charging solutions: Our equipment is compatible with all hybrid and electric car manufacturers across the globe, and we sell our products in countries across six continents.",
