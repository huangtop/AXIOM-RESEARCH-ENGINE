        "accession_number": "0001193125-26-149722",
        "filing_date": "2026-04-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "One of the many ways in which we differentiate ourselves in the EV charging market is the consumer‑focused approach of our product offering.",
        "start_character": 29291,
        "end_character": 29431
      },
      {
