        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "To inspire customers, we produce beautiful imagery and highly-tailored editorial content both in-house and through third parties.",
        "start_character": 9364,
        "end_character": 9493
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001616707-26-000027",
        "provenance_id": "provenance:SEC-FILING-0001616707-26-000027-16ccd68910a37798",
        "accession_number": "0001616707-26-000027",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "We also partner selectively with marketing partners where we find solutions that meet our marketing objectives and are expected to deliver a strong return on investment.",
