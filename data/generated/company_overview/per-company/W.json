        "end_character": 22660
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001616707-26-000027",
        "provenance_id": "provenance:SEC-FILING-0001616707-26-000027-16ccd68910a37798",
        "accession_number": "0001616707-26-000027",
        "filing_date": "2026-02-19",
        "offering_role": "product",
        "confidence": 0.9,
        "statement": "We believe that the primary competitive factors in the mass market are vast selection, visually inspiring browsing, compelling merchandising, ease of product discovery, price, convenience, reliability, speed of fulfillment and customer service.",
        "start_character": 18326,
        "end_character": 18570
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001616707-26-000027",
        "provenance_id": "provenance:SEC-FILING-0001616707-26-000027-16ccd68910a37798",
