        "end_character": 13906
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001616707-26-000027",
        "provenance_id": "provenance:SEC-FILING-0001616707-26-000027-16ccd68910a37798",
        "accession_number": "0001616707-26-000027",
        "filing_date": "2026-02-19",
        "offering_role": "operator_business",
        "confidence": 0.86,
        "statement": "We are focused on bringing our customers an experience that is at the forefront of shopping for the home online.",
        "start_character": 388,
        "end_character": 500
      },
      {
