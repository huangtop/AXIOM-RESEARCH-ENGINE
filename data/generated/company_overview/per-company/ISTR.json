        "filing_date": "2026-03-16",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, as a smaller institution, we think we can be flexible in developing and implementing new products and services.",
        "start_character": 19610,
        "end_character": 19734
