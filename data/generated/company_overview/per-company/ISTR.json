        "filing_date": "2026-03-16",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "For our business clients, we offer a competitive suite of treasury management products which include, but are not limited to, remote deposit capture, virtual vaults, positive pay, Automated Clearing House origination, credit card processing, wire transfer, investment sweep accounts, and enhanced business internet banking.",
        "start_character": 14042,
        "end_character": 14365
      },
      {
