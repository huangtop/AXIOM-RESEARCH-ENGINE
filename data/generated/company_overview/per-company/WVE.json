        "accession_number": "0001193125-26-073472",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For some of our product candidates, we plan to work with collaborators to develop or obtain access to in vitro companion diagnostic tests to identify appropriate patients for these targeted therapies.",
        "start_character": 124630,
        "end_character": 124830
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-073472",
