    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In connection with the PIPE Transaction, on August 5, 2025, we entered into an asset management agreement (the \"AMA\") with 10X Capital Partners LLC (the \"Asset Manager\") pursuant to which we appointed the Asset Manager to provide asset management and related services with respect to our digital assets in accordance with the DAT Strategy.",
        "start_character": 13345,
        "end_character": 13684
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Upon completion of our Strategic Transformation, we operate our business under two segments: our BNB treasury management (\"BNB Treasury Management\") segment, within which we operate our DAT Strategy, and our retail and industry (\"Retail and Industry\") segment attributable to our Fat Panda and industrial climate control systems operating businesses.",
        "start_character": 3775,
        "end_character": 4125
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We aim to provide our services and products to customers who are building, upgrading, or expanding an indoor cultivation facility for any crop.",
        "start_character": 21996,
        "end_character": 22139
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We provide a comprehensive range of service solutions that include assistance with facility design and budgeting in cooperation with the customers' engineering, architectural and construction teams, equipment selection and specification, and support for equipment installation and start up.",
        "start_character": 21607,
        "end_character": 21897
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "In June 2025, we acquired Fat Panda, a retailer and manufacturer of e-cigarettes, vape devices and e-liquids.",
        "start_character": 16665,
        "end_character": 16774
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "The assets subject to the AMA consist of the net proceeds from the PIPE Transaction as well as any other cash or digital assets we designate as part of our DAT treasury and are held in cryptocurrency wallets, with custody maintained by a custodian acceptable to the Company's Strategic Committee of our board of directors (the\"Board\").",
        "start_character": 13685,
        "end_character": 14020
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Under the terms of the AMA, for which we've sought relief as an unenforceable penalty, we are required to pay the Asset Manager all fees and other compensation that would have accrued through the end of the term as liquidated damages, paid monthly, if we terminate the AMA prior to the end of the term for any reason, including termination for breach, or if the Asset Manager terminates due to a material breach by us.",
        "start_character": 15311,
        "end_character": 15729
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that our disciplined approach to treasury management positions us to benefit from market recoveries while managing risk through custody, yield optimization, and strategic capital allocation.",
        "start_character": 6448,
        "end_character": 6649
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We operate the DAT Strategy through our wholly-owned subsidiary, CEA BRS LLC, a Delaware limited liability company, as a special purpose entity to hold and manage certain cryptocurrency assets in accordance with the DAT Strategy.",
        "start_character": 4155,
        "end_character": 4384
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We seek to provide public equity market investors with exposure to BNB through a Nasdaq-listed, SEC-reporting company that combines direct BNB ownership, public company governance, audited financial reporting, treasury controls, custody infrastructure, and capital markets access.",
        "start_character": 1393,
        "end_character": 1673
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "Because we hold a significant quantity of BNB, changes in the market price of BNB had, and will continue to have, a substantial impact on our balance sheet and results of operations.",
        "start_character": 7111,
        "end_character": 7293
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001482541-26-000019",
        "provenance_id": "provenance:SEC-FILING-0001482541-26-000019-b539b30ea7778db5",
        "accession_number": "0001482541-26-000019",
        "filing_date": "2026-06-23",
        "offering_role": "product",
        "confidence": 0.86,
        "statement": "Because we hold a substantial quantity of digital assets, particularly BNB, changes in the market price of BNB may significantly affect our reported earnings.",
        "start_character": 5623,
        "end_character": 5781
      }
    ]
