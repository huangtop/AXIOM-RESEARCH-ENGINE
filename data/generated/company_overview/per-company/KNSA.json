      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019168",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019168-c0447b62a33ebc5d",
        "accession_number": "0001104659-26-019168",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The Regeneron Agreement will expire on the date on which we, our affiliates or sublicensees are no longer developing or commercializing any product containing ARCALYST.",
        "start_character": 50153,
        "end_character": 50321
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019168",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019168-c0447b62a33ebc5d",
        "accession_number": "0001104659-26-019168",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also may elect to pursue additional CDMOs for manufacturing supplies of drug substance and finished drug product in the future.",
        "start_character": 31172,
        "end_character": 31302
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-019168",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-019168-c0447b62a33ebc5d",
        "accession_number": "0001104659-26-019168",
        "filing_date": "2026-02-24",
