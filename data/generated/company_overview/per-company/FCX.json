    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that we are well positioned for the future as a leading producer of copper with significant copper reserves and resources and a high-quality portfolio of growth projects to provide additional supplies of copper to a growing market.",
        "start_character": 2413,
        "end_character": 2655
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We continue to focus our training and development on the skills required for safe production and to build a more agile workforce with the ability to respond to evolving business needs.",
        "start_character": 113438,
        "end_character": 113622
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We further invest in training and development to support internal talent and strengthen our management pipeline reflecting our commitment to our people and our business.",
        "start_character": 112969,
        "end_character": 113138
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Based on Wood Mackenzie’s December 2025 estimates, we ranked third among those producers for the year 2025, with approximately 5% of estimated total worldwide mined copper production based on net equity ownership.",
        "start_character": 38555,
        "end_character": 38768
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "For example, carbon tax legislation has been adopted in jurisdictions where we operate, including Indonesia, Chile and the European Union (EU).",
        "start_character": 34356,
        "end_character": 34499
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Headquartered in Phoenix, Arizona, we operate large, long-lived, geographically diverse assets with significant proven and probable mineral reserves of copper, gold and molybdenum.",
        "start_character": 1572,
        "end_character": 1752
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In South America, we manage two copper operations – Cerro Verde in Peru and El Abra in Chile.",
        "start_character": 5842,
        "end_character": 5935
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In the U.S., we manage seven copper operations – Morenci, Bagdad, Safford (including Lone Star), Sierrita and Miami in Arizona, and Chino and Tyrone in New Mexico, and two molybdenum mines - Henderson and Climax in Colorado.",
        "start_character": 5388,
        "end_character": 5612
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Specifically, we are carefully managing operating costs and near-term capital expenditures in connection with revised operating plans at the Grasberg minerals district to manage cash flow and liquidity during the phased ramp-up period after the September 2025 mud rush incident.",
        "start_character": 102533,
        "end_character": 102811
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "The El Paso refinery has the potential to operate at an annual production capacity of approximately 410,000 metric tons of copper cathode, which is sufficient to refine all of the copper anode we produce at our Miami smelter.",
        "start_character": 100027,
        "end_character": 100252
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We are working with federal and state agencies to understand possible ramifications to our projects from these developments and will monitor any additional regulatory guidance, rulemaking and other regulatory activities.",
        "start_character": 27768,
        "end_character": 27988
      },
      {
        "business_evidence_id": "business-evidence:SEC-0000831259-26-000012",
        "provenance_id": "provenance:SEC-FILING-0000831259-26-000012-246e0f9b242211ff",
        "accession_number": "0000831259-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We believe that our social and economic development programs are responsive to the issues raised by the local communities near our areas of operation and help us maintain good relations with the surrounding communities and avoid disruptions of mining operations.",
        "start_character": 116245,
        "end_character": 116507
      }
    ]
  },
