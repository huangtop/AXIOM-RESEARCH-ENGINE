        "filing_date": "2026-02-11",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We focus on the acquisition of royalties on approved products or development-stage product candidates that have generated strong proof of concept data, avoiding the risks associated with early-stage R&D.",
