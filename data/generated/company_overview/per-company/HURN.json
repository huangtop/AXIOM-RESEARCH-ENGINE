        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide our services and products and manage our business under three operating segments - Healthcare, Education, and Commercial - which aligns our business by industry.",
        "start_character": 3313,
        "end_character": 3485
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011093",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011093-c041168d8ae9db32",
        "accession_number": "0001628280-26-011093",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We provide services to both financially sound organizations and organizations in transition across industries, including healthcare, education, financial services, industrials and manufacturing, energy and utilities, public sector and other commercial industries.",
