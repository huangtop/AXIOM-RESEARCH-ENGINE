        "provenance_id": "provenance:SEC-FILING-0001628280-26-011093-c041168d8ae9db32",
        "accession_number": "0001628280-26-011093",
        "filing_date": "2026-02-24",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Within each of our operating segments, we provide our offerings under two principal capabilities: i) Consulting and Managed Services and ii) Digital.",
        "start_character": 8627,
        "end_character": 8776
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011093",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011093-c041168d8ae9db32",
