        "accession_number": "0001628280-26-011093",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have a deep focus on serving organizations in the financial services, industrials and manufacturing, and energy and utilities industries and the public sector while opportunistically serving commercial industries more broadly, including professional and business services, life sciences, consumer products, and retail.",
        "start_character": 7424,
        "end_character": 7745
