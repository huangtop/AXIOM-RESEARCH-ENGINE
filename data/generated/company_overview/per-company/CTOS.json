        "filing_date": "2026-03-10",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "Integrated Business Model with Large-Scale Production and Customization Capabilities – We are able to provide our customers with highly tailored solutions on an expedited basis, enabled by our extensive internal production and customization operations.",
        "start_character": 25183,
        "end_character": 25435
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001709682-26-000008",
