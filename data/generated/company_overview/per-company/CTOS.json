        "end_character": 1735
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001709682-26-000008",
        "provenance_id": "provenance:SEC-FILING-0001709682-26-000008-70bc3e47b2b89216",
        "accession_number": "0001709682-26-000008",
        "filing_date": "2026-03-10",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We see an opportunity to grow the size of the internal service organization and external service provider network to increase our ability to service customer-owned equipment.",
