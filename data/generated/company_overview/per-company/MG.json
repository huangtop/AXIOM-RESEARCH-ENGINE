        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "The Company provides a diversified portfolio of products and services, ranging from advanced non-destructive testing (\"NDT\") and pipeline inspections to real-time condition monitoring, maintenance planning, and specialized engineering, powered by a proprietary management software suite that centralizes integrity data for predictive analytics and benchmark analysis.",
        "start_character": 2740,
        "end_character": 3107
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-016765",
