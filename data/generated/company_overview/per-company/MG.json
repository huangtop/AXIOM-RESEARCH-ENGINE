        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Another differentiator in our business model is our Centers of Excellence (\"COEs\"), which offer support for asset, technology or industry-specific solutions.",
        "start_character": 15993,
        "end_character": 16150
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-016765",
