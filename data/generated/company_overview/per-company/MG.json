        "end_character": 29044
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-016765",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-016765-979af3b61d29ffd4",
        "accession_number": "0001628280-26-016765",
        "filing_date": "2026-03-11",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer solutions for inspection, maintenance, monitoring and data services for wind turbines and their components.",
        "start_character": 47373,
        "end_character": 47494
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-016765",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-016765-979af3b61d29ffd4",
