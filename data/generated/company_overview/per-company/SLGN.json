        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Through our custom container facilities, we have the capacity to manufacture customized products across the entire spectrum of resin materials, decorating techniques and molding processes required by our customers.",
        "start_character": 14910,
        "end_character": 15124
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012202",
