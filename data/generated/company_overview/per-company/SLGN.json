        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our products are used for a wide variety of end markets and we operate 121 manufacturing plants in North America, Europe, Asia and South America.",
        "start_character": 217,
        "end_character": 362
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-012202",
