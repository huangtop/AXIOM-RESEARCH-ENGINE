    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As an organization built on talent and skills development, we recognize the importance of providing our employees with ongoing professional development and leadership opportunities to support career progression and business performance.",
        "start_character": 16583,
        "end_character": 16819
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we generate Enterprise revenue through Lifted, which offers Enterprise workforce solutions, including client subscriptions and services fees and Managed Services offerings.",
        "start_character": 4577,
        "end_character": 4762
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Knowing our employees have diverse needs and life priorities, we also provide comprehensive benefits and services to those eligible, which include core benefits such as medical, dental, vision, and disability insurance, in addition to benefits tailored to the specific needs of our employees, such as mental health, fertility, family back-up care, and adoption support.",
        "start_character": 18025,
        "end_character": 18394
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Moreover, we provide escrow services to our customers and maintain a subsidiary licensed as an internet escrow agent by the California Department of Financial Protection and Innovation, which we refer to as the DFPI.",
        "start_character": 35934,
        "end_character": 36150
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We employ a holistic and integrated marketing strategy aimed at attracting clients to our platforms and workforce solutions and guiding them toward the right product offerings to meet their business needs.",
        "start_character": 23464,
        "end_character": 23669
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have engineered and implemented a modern, distributed core infrastructure design intended to provide for failures to occur at the individual system level without disrupting service or impacting the customer experience.",
        "start_character": 25985,
        "end_character": 26206
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have focused on building a services-oriented architecture hosted on Amazon Web Services, which we refer to as AWS, designed to independently scale, or failover, as needed, by leveraging the capabilities of the AWS platform.",
        "start_character": 26241,
        "end_character": 26467
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We invest substantial resources in research and development to enhance our platforms and workforce solutions, develop new products and features, and improve our infrastructure.",
        "start_character": 25238,
        "end_character": 25414
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Across our platforms and workforce solutions, we implement layered information security controls designed to detect, prevent, and mitigate cybersecurity threats, including industry-standard encryption for data in transit and customer-available account security features, such as multi-factor authentication.",
        "start_character": 27597,
        "end_character": 27904
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "In addition, the application and interpretation of these laws and regulations often are uncertain, particularly in the industry in which we operate.",
        "start_character": 36351,
        "end_character": 36499
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Led by our Learning and Development team, we offer a range of learning and development programs designed to establish clear performance expectations, support employee growth and mobility, and build leadership capabilities across the organization.",
        "start_character": 16820,
        "end_character": 17066
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001627475-26-000012",
        "provenance_id": "provenance:SEC-FILING-0001627475-26-000012-cb268968fc60bb4c",
        "accession_number": "0001627475-26-000012",
        "filing_date": "2026-02-13",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Through these programs, we seek to maintain consistent standards for performance and development and to support an effective, skilled, and adaptable workforce.",
        "start_character": 17359,
        "end_character": 17518
      }
    ]
  },
