        "end_character": 67722
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-022067",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-022067-fd8ec256d840edd6",
        "accession_number": "0001104659-26-022067",
        "filing_date": "2026-03-02",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We aim to empower our team members worldwide, providing them opportunities to grow and develop, and comprehensive benefits that support them to thrive both physically and mentally.",
        "start_character": 60189,
        "end_character": 60369
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-022067",
        "provenance_id": "provenance:SEC-FILING-0001104659-26-022067-fd8ec256d840edd6",
