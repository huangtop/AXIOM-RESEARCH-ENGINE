        "accession_number": "0001104659-26-020540",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, we are aware of a number of companies developing and conducting clinical trials for investigational product candidates that could compete with bosakitug and ATI-052 in each case if approved, for the treatment of atopic dermatitis.",
        "start_character": 24133,
        "end_character": 24376
      },
