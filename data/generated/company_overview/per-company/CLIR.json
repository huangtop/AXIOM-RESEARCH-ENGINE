        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Accordingly, we continuously seek to collaborate with strategic partners to the extent possible to sell our products and maximize the profitability of those sales.",
        "start_character": 45754,
        "end_character": 45917
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001104659-26-037699",
