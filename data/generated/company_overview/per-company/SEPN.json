        "filing_date": "2026-03-09",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Competitive products may make any products we develop obsolete or noncompetitive before we recover the expense of developing and commercializing our product candidates.",
        "start_character": 54442,
        "end_character": 54610
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-098507",
