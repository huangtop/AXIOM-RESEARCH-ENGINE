    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "For additional information, please refer to the risk factor captioned “We are subject to restrictions imposed by, and significant influence from, vehicle manufacturers that may adversely impact our business, financial condition, results of operations, cash flows, and prospects, including our ability to acquire additional stores” in Part I, Item 1A of this Form 10-K.",
        "start_character": 23680,
        "end_character": 24048
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to our retail business, we also have wholesale parts operations, which sell automotive parts to both collision repair shops and independent vehicle repair providers.",
        "start_character": 16371,
        "end_character": 16548
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In addition, we offer AutoNation-branded Customer Financial Services products (including extended service and maintenance contracts and other vehicle protection products) and parts and accessories, as well as collision repair services at AutoNation-branded collision centers, and auction services at AutoNation-branded automotive auctions.",
        "start_character": 10348,
        "end_character": 10687
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also compete with other dealers for qualified employees, including general managers and sales and service personnel.",
        "start_character": 33106,
        "end_character": 33225
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer our customers various vehicle protection products, including extended service contracts, maintenance programs, guaranteed auto protection (known as “GAP,” this protection covers the shortfall between a customer’s loan balance and insurance payoff in the event of a casualty), “tire and wheel” protection, and theft protection products, some of which are AutoNation-branded.",
        "start_character": 17420,
        "end_character": 17807
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also offer product and accessory lines that are integrated into our parts and service operations.",
        "start_character": 16093,
        "end_character": 16193
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We offer After-sales products and services at our franchised dealerships, AutoNation USA used vehicle stores, collision centers, automotive auctions, parts distribution centers, and through our mobile automotive repair and maintenance business and online platforms.",
        "start_character": 5874,
        "end_character": 6139
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We seek to create long-term value for our stockholders and to be the best-run, most profitable automotive retailer and provider of personalized transportation services in the United States.",
        "start_character": 4377,
        "end_character": 4566
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We seek to deliver a consistently superior customer experience by offering a broad selection of inventory, customer-friendly, transparent sales and service processes, vehicle financing, and competitive pricing.",
        "start_character": 7794,
        "end_character": 8004
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We sell the products on a commission basis, and we also participate in future underwriting profit for certain products pursuant to retrospective commission arrangements with the issuers of those products.",
        "start_character": 17972,
        "end_character": 18176
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "•We strive to be the nation’s most comprehensive provider of innovative products and exceptional services to meet the automotive needs of our current and future customers.",
        "start_character": 4840,
        "end_character": 5011
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-007800",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-007800-7b1ec5cf2160eb58",
        "accession_number": "0001628280-26-007800",
        "filing_date": "2026-02-12",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "Additionally, these agreements set limits (nationally, regionally, and in local markets) on the number of stores that we may acquire of the particular manufacturer and contain certain restrictions on our ability to name and brand our stores.",
