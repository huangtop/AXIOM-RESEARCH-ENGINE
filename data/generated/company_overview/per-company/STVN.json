        "accession_number": "0001193125-26-091540",
        "filing_date": "2026-03-04",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "As the needs of our clients evolve, we drive innovation within our proprietary products and processes to develop specialized or customized solutions.",
