        "accession_number": "0001819790-26-000019",
        "filing_date": "2026-02-23",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We do not currently own or operate and currently have no plans to establish facilities for manufacturing, storing, distributing or testing our product or product candidates.",
