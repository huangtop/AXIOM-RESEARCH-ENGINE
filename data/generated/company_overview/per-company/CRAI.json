        "accession_number": "0001053706-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "This industry expertise, which we developed over decades of providing sophisticated consulting services to a diverse group of clients in many industries, differentiates us from many of our competitors.",
        "start_character": 26689,
        "end_character": 26890
      },
      {
