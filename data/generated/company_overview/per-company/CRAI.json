        "accession_number": "0001053706-26-000006",
        "filing_date": "2026-02-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Since our inception in 1965, we have been a leader in providing sophisticated economic analysis and original, authoritative advice to clients involved in complex litigation and regulatory proceedings, and we also provide management consulting services to companies facing strategic, organizational, and operational challenges.",
        "start_character": 8441,
        "end_character": 8767
      },
      {
