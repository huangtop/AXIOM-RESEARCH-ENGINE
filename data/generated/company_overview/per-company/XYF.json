        "accession_number": "0001104659-26-052016",
        "filing_date": "2026-04-30",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In 2025, to further enhance service efficiency and user experience, we upgraded our user service system with self-developed AI technologies.",
