        "accession_number": "0001628280-26-045886",
        "filing_date": "2026-06-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We believe that our development approach of further enhancing our product candidates with additional therapeutic proteins reduces clinical risk, as we are able to study the safety profile of each therapeutic protein that is intended to provide more potent anti-tumor immune effects.",
        "start_character": 20909,
        "end_character": 21191
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-045886",
