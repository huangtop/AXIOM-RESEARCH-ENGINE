        "accession_number": "0001628280-26-045886",
        "filing_date": "2026-06-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have designed our RP2 product candidate to express an anti-CTLA-4 antibody-like protein intended to block the inhibition of the immune response otherwise caused by CTLA-4.",
