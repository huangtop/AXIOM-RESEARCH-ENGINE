        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "The key competitive factors affecting the success of JNJ-1900 (NBTXR3) and any other product candidates that we develop, if approved, are likely to include efficacy, safety, convenience, price, and the availability of reimbursement from government and other third-party payors.",
        "start_character": 86014,
        "end_character": 86291
