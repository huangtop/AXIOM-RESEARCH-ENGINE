        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Our commercial opportunity could be reduced if our competitors develop and commercialize products that are more effective or demonstrate a more favorable safety profile than any products that we may develop.",
