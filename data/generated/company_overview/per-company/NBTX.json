        "filing_date": "2026-03-31",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Many of our competitors, either alone or in collaboration with their partners, may have significantly greater financial resources and expertise in research and development, preclinical testing, clinical trials, manufacturing, and marketing than we, or our partners, do, enabling accelerated development or commercialization of their product candidates.",
        "start_character": 85074,
        "end_character": 85426
