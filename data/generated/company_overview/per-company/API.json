        "filing_date": "2026-04-15",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We empower developers with real-time engagement capabilities to create innovative products, elevate end user experience and differentiate themselves from their competition.",
        "start_character": 38787,
        "end_character": 38959
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-155920",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-155920-3ab1089dab5fae1d",
