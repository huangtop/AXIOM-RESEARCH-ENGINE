        "accession_number": "0001193125-26-283791",
        "filing_date": "2026-06-26",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition, in various product fields, we are focusing on developing and offering products through collaboration with BlackRock, Inc., Partner Group AG and Golub Capital.",
