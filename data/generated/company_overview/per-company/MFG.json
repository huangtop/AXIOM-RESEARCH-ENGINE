        "accession_number": "0001193125-26-283791",
        "filing_date": "2026-06-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "For example, we are engaging in collaboration with other companies and are utilizing advanced technologies to offer new financial and other services and to enhance the quality of our internet and smart phone services, in light of changing customer needs due to ongoing digitalization.",
        "start_character": 49027,
        "end_character": 49311
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-283791",
