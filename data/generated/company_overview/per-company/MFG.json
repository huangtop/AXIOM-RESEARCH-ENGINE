        "accession_number": "0001193125-26-283791",
        "filing_date": "2026-06-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "For financial institutions, we offer advisory services and solutions, such as advice on financial strategy and proposals on various investment products, by concentrating our diverse financial expertise from each group company to meet the increasingly sophisticated and diversified needs of customers.",
        "start_character": 55602,
        "end_character": 55902
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-283791",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-283791-b6d9dd523c3e9fab",
        "accession_number": "0001193125-26-283791",
        "filing_date": "2026-06-26",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "For institutional investors such as pension funds, we make our asset management capabilities more sophisticated and offer comprehensive solution services to meet their diversified and sophisticated asset management needs.",
        "start_character": 65094,
        "end_character": 65315
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-283791",
