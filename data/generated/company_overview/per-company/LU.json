        "end_character": 95129
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-194102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-194102-64c3b10e90ab8d3b",
        "accession_number": "0001193125-26-194102",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide a repayment reminder service to our borrowers, including text message reminders for low-risk borrowers and AI-enabled contact for medium- and high-risk borrowers.",
        "start_character": 66509,
        "end_character": 66687
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-194102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-194102-64c3b10e90ab8d3b",
        "accession_number": "0001193125-26-194102",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also provide post-loan and collection services to our institutional partners to further manage their credit risk.",
