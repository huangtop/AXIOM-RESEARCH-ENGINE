        "end_character": 82959
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-194102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-194102-64c3b10e90ab8d3b",
        "accession_number": "0001193125-26-194102",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "The credit enhancement provider acquires the creditor rights after reimbursing the funding provider and we continue to provide post-loan services to the credit enhancement provider.",
        "start_character": 71921,
        "end_character": 72102
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-194102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-194102-64c3b10e90ab8d3b",
        "accession_number": "0001193125-26-194102",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Under our business model where our licensed financing guarantee subsidiary provides a guarantee for nearly every new loan transaction (excluding certain consumer finance loan products and referral products) without the use of third-party credit enhancement, we enter into agreements with each funding partner and our licensed financing guarantee subsidiary.",
        "start_character": 53717,
        "end_character": 54074
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-194102",
        "provenance_id": "provenance:SEC-FILING-0001193125-26-194102-64c3b10e90ab8d3b",
        "accession_number": "0001193125-26-194102",
        "filing_date": "2026-04-30",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We also compete with providers of consumer finance services.",
