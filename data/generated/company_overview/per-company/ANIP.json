        "accession_number": "0001023024-26-000014",
        "filing_date": "2026-02-27",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "This ability to manufacture a variety of differentiated products is a competitive strength that we intend to leverage in selecting products to develop and commercialize.",
