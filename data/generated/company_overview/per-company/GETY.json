        "filing_date": "2026-03-16",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We operate multiple websites which are available on a global basis, maintained in 23 different languages, localized for their respective markets, and which provide for e-commerce transactions in 34 local currencies.",
