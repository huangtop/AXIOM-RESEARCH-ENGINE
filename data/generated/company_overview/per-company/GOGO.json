        "accession_number": "0001193125-26-082487",
        "filing_date": "2026-02-27",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "For example, we provide some of our voice and data services (not including ATG) by reselling the services of satellite operators.",
        "start_character": 27415,
        "end_character": 27544
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001193125-26-082487",
