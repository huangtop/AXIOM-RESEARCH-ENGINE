        "filing_date": "2026-03-12",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We pay close attention to the product design process and carefully consider quality and choice of materials to minimize building deficiencies and reduce warranty expenses.",
        "start_character": 58110,
        "end_character": 58281
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-017245",
