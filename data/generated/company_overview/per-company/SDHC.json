        "provenance_id": "provenance:SEC-FILING-0001628280-26-017245-e2f6f0410925478b",
        "accession_number": "0001628280-26-017245",
        "filing_date": "2026-03-12",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "Although we are more cost-effective than most of our competitors, we believe we offer our homebuyers an affordable luxury homebuying experience that is unique compared to our peers and the resale homes with which we compete.",
        "start_character": 26586,
        "end_character": 26810
      },
      {
