    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In July 2021, we entered into a collaboration agreement with Pfizer, or the Vepdegestrant (ARV-471) Collaboration Agreement, pursuant to which we granted Pfizer worldwide co-exclusive rights to develop and commercialize products containing our proprietary compound vepdegestrant (ARV-471), or the Licensed Products.",
        "start_character": 87234,
        "end_character": 87549
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In addition to competition from other protein degradation therapies, any products that we develop may also face competition from other types of therapies, such as small molecule, antibody, or gene therapies.",
        "start_character": 109388,
        "end_character": 109595
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "In past years, we had begun the process of establishing our own focused, specialized sales, marketing, and market access organization to support the commercialization of our product candidates, including vepdegestrant, in the United States.",
        "start_character": 115116,
        "end_character": 115356
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Not only must we compete with other companies that are focused on protein degradation, but any product candidates that we successfully develop and commercialize will compete with existing therapies and new therapies that may become available in the future.",
        "start_character": 108095,
        "end_character": 108351
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Subject to specified exceptions, we and Pfizer have each agreed not to directly or indirectly research, develop, or commercialize any competing products outside of the Vepdegestrant (ARV-471) Collaboration Agreement anywhere in the world during the term of the Vepdegestrant (ARV-471) Collaboration Agreement.",
        "start_character": 89150,
        "end_character": 89459
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "To the extent that any product candidates we may develop, once approved, are sold in a foreign country, we may be subject to similar foreign laws.",
        "start_character": 201142,
        "end_character": 201288
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We and Pfizer share equally (50/50) all development costs (including costs for conducting any clinical trials) for the Licensed Products, subject to certain exceptions.",
        "start_character": 88016,
        "end_character": 88184
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are also entitled to receive up to $225.0 million in development milestone payments and up to $550.0 million in sales-based milestone payments for all designated targets under the Pfizer Research Collaboration Agreement, as well as mid- to high-single digit tiered royalties, which may be subject to reductions, on net sales of PROTAC targeted protein degrader-related products.",
        "start_character": 93275,
        "end_character": 93656
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We are currently progressing the following product candidates through clinical development programs:",
        "start_character": 1967,
        "end_character": 2067
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We expect to continue to develop product candidates that can be produced cost-effectively at contract manufacturing facilities or with partners.",
        "start_character": 118421,
        "end_character": 118565
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have engaged third-party manufacturers to supply the building blocks and drug substances for ARV-102, ARV-806, ARV-393, and vepdegestrant, as well as ARV-027, and we have also engaged third-party manufacturers to develop and manufacture finished drug product for ARV-102, ARV-393, ARV-806 and vepdegestrant, as well as ARV-027, that we are using and plan to use in our ongoing and planned Phase 1/2 and pivotal clinical trials, as well as for part of our IND-enabling plan.",
        "start_character": 116814,
        "end_character": 117290
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001628280-26-011226",
        "provenance_id": "provenance:SEC-FILING-0001628280-26-011226-97bdd7f4e676a539",
        "accession_number": "0001628280-26-011226",
        "filing_date": "2026-02-24",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We rely on and expect to continue to rely on third-party contract manufacturing organizations, or CMOs, and contract development and manufacturing organizations, or CDMOs, for both drug substance and finished drug product as well as for the synthesis of compounds in our preclinical research and development activities.",
        "start_character": 116494,
        "end_character": 116813
      }
    ]
