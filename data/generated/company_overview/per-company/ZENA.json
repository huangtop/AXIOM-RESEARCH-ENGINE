    "offering_evidence_count": 12,
    "offering_evidence": [
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "(DaaS) under which we plan to provide turnkey drone enabled services to innovate and speed up processes by using drones, as well as provide enhanced data and precision over what is currently available in legacy low-tech or manual services.",
        "start_character": 37649,
        "end_character": 37888
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "DaaS services will be offered at branded business offices in the cities/locations where we have made acquisitions and we are currently planning and implementing our DaaS office branding.",
        "start_character": 38612,
        "end_character": 38798
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "Our acquisition of Ecker Capital and ZooOffice added four revenue-generating companies to our business, two of which are software inventory management entities, one of which provides smart desk booking and office hoteling software solutions and another one of which provides complete solutions for management compliance.",
        "start_character": 87060,
        "end_character": 87380
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "There can be no assurance that we will be successful in developing our business through these or any other acquisitions we may undertake or that any of these or other acquisitions we may undertake will be successful, as currently contemplated or at all, which may have a material adverse effect on our business.",
        "start_character": 40352,
        "end_character": 40663
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "Under the agreement, we receive the benefits of various services, including a software development team, office space, project management and hosting services.",
        "start_character": 6192,
        "end_character": 6351
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also plan to offer DaaS centralized services and marketing campaigns and lead generation via our teams located at our Dublin, Toronto, Vancouver locations.",
        "start_character": 147991,
        "end_character": 148149
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We also plan to sell our services via our Drone as a Service.com website.",
        "start_character": 148150,
        "end_character": 148223
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are currently in the process of integrating our ZenaDrone drones into the workflows, setting up centralized data management services for the drone data, and providing drone pilot training to the staff of our acquired companies.",
        "start_character": 38381,
        "end_character": 38611
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "operator_business",
        "confidence": 0.96,
        "statement": "We are planning to do workplace management and scheduling applications via our enterprise SaaS business area utilizing Quantum in the future.",
        "start_character": 54316,
        "end_character": 54457
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "We have 260 employees in varying jurisdictions via our subsidiaries and also operate our business through a management services agreement with Epazz.",
        "start_character": 6401,
        "end_character": 6550
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have acquired software from Epazz that has been used to develop products offered or to be offered by Workaware.",
        "start_character": 148448,
        "end_character": 148562
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001376474-26-000319",
        "provenance_id": "provenance:SEC-FILING-0001376474-26-000319-3da96897b9372577",
        "accession_number": "0001376474-26-000319",
        "filing_date": "2026-04-29",
        "offering_role": "product",
        "confidence": 0.96,
        "statement": "We have also developed our second drone product line- the IQ Series.",
        "start_character": 102545,
        "end_character": 102613
