        "provenance_id": "provenance:SEC-FILING-0001193125-26-088095-dba228d6bafb2111",
        "accession_number": "0001193125-26-088095",
        "filing_date": "2026-03-03",
        "offering_role": "service",
        "confidence": 0.96,
        "statement": "In certain countries we are prepared to provide payment services in relation to a particular industry but subject to certain requirements or restrictions (e.g., we accept online gambling business in these types of countries provided the merchant is licensed).",
