      "observed_at": "2026-08-19T10:24:45.834543+00:00",
      "provenance_ids": [
        "provenance:SEC-SUBMISSIONS-0001088034-268c59eecf0bbe88"
      ]
    },
    "offering_roles": [
      "operator_business",
      "product",
