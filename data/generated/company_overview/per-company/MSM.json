        "end_character": 1804
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001003078-25-000123",
        "provenance_id": "provenance:SEC-FILING-0001003078-25-000123-26f8b8ede796db19",
        "accession_number": "0001003078-25-000123",
        "filing_date": "2025-10-23",
        "offering_role": "product",
