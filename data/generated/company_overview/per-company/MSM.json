        "end_character": 344
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001003078-25-000123",
        "provenance_id": "provenance:SEC-FILING-0001003078-25-000123-26f8b8ede796db19",
        "accession_number": "0001003078-25-000123",
        "filing_date": "2025-10-23",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "As part of its efforts in these areas, the Company offers competitive compensation and benefits to meet the diverse needs of team members and support their health and well-being, financial future and work-life balance.",
        "start_character": 40432,
        "end_character": 40650
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001003078-25-000123",
        "provenance_id": "provenance:SEC-FILING-0001003078-25-000123-26f8b8ede796db19",
        "accession_number": "0001003078-25-000123",
        "filing_date": "2025-10-23",
        "offering_role": "product",
        "confidence": 0.92,
        "statement": "We have invested resources to maximize seller potential through an enhanced data-driven territory model to optimize field seller portfolios.",
        "start_character": 18812,
        "end_character": 18952
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001003078-25-000123",
        "provenance_id": "provenance:SEC-FILING-0001003078-25-000123-26f8b8ede796db19",
        "accession_number": "0001003078-25-000123",
        "filing_date": "2025-10-23",
        "offering_role": "operator_business",
        "confidence": 0.92,
        "statement": "We manage our primary customer fulfillment centers via computer-based SKU tracking systems and radio frequency devices that locate specific stock items to make the selection process more efficient.",
        "start_character": 23392,
        "end_character": 23589
      },
      {
        "business_evidence_id": "business-evidence:SEC-0001003078-25-000123",
        "provenance_id": "provenance:SEC-FILING-0001003078-25-000123-26f8b8ede796db19",
