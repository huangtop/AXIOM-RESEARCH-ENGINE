{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-multiple-statistics.v030.13.2",
  "title": "AXIOM Historical Multiple Statistics",
  "type": "object",
  "required": ["schema_version", "version", "generated_at", "policy", "summary", "statistics"],
  "properties": {
    "schema_version": {"const": "historical-multiple-statistics.v030.13.2"},
    "version": {"const": "V030.13.2"},
    "generated_at": {"type": "string"},
    "as_of_date": {"type": ["string", "null"]},
    "policy": {"type": "object"},
    "summary": {"type": "object"},
    "statistics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company_id", "method", "statistics_state", "windows"],
        "properties": {
          "company_id": {"type": "string"},
          "method": {"enum": ["forward_pe", "trailing_pe", "price_to_sales", "ev_to_sales", "ev_to_ebitda", "fcf_yield"]},
          "statistics_state": {"enum": ["ready", "insufficient_history"]},
          "windows": {"type": "array"}
        }
      }
    }
  }
}
