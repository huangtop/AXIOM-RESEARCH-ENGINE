{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXIOM Knowledge Valuation Assumptions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["company_id", "policy_version", "evidence_ids", "assumptions"],
    "properties": {
      "company_id": {"type": "string", "minLength": 1},
      "policy_version": {"type": "string", "minLength": 1},
      "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "assumptions": {
        "type": "object",
        "properties": {
          "target_forward_pe": {"type": "number", "exclusiveMinimum": 0},
          "target_peg": {"type": "number", "exclusiveMinimum": 0},
          "target_forward_ps": {"type": "number", "exclusiveMinimum": 0},
          "target_ev_ebitda": {"type": "number", "exclusiveMinimum": 0},
          "target_forward_pb": {"type": "number", "exclusiveMinimum": 0},
          "milestone_success_probability": {"type": "number", "minimum": 0, "maximum": 1},
          "milestone_success_value_per_share": {"type": "number", "minimum": 0},
          "milestone_failure_value_per_share": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
