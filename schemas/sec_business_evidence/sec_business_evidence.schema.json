{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.local/schemas/sec-business-evidence.v031.2b.json",
  "title": "SEC Filing Business Evidence",
  "type": "object",
  "required": ["schema_version", "version", "generated_at", "summary", "business_evidence", "diagnostics"],
  "properties": {
    "schema_version": {"const": "sec-business-evidence.v031.2b"},
    "version": {"const": "V031.2B"},
    "generated_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "object", "required": ["source_filing_manifest_count", "batch_offset", "filings_requested", "documents_downloaded", "business_evidence_available", "business_evidence_unavailable", "availability_ratio"]},
    "business_evidence": {"type": "array", "items": {"type": "object", "required": ["business_evidence_id", "company_id", "evidence_type", "form", "accession_number", "document_url", "document_sha256", "text", "text_sha256", "provenance_id"]}},
    "diagnostics": {"type": "array", "items": {"type": "object", "required": ["company_id", "filing_document_id", "status", "reason_code"]}}
  }
}
