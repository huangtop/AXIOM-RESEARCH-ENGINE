{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXIOM V031 Full Market Coverage",
  "type": "object",
  "required": ["schema_version", "version", "summary", "cards", "indexes"],
  "properties": {
    "schema_version": {"const": "full-market-coverage.v031.0"},
    "version": {"const": "V031.0"},
    "summary": {
      "type": "object",
      "required": ["company_count", "security_count", "status_counts", "model_calculated_counts"]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "company", "primary_security", "status", "market", "financials", "estimates", "valuation"],
        "properties": {
          "schema_version": {"const": "full-market-valuation-card.v031.0"},
          "status": {"enum": ["ready", "partial", "unavailable"]},
          "valuation": {
            "type": "object",
            "required": ["status", "calculated_model_count", "total_model_count", "fair_value", "aggregation_version", "reason_code", "models"],
            "properties": {
              "total_model_count": {"const": 7},
              "models": {
                "type": "object",
                "required": ["dcf", "forward_pe", "peg", "forward_ps", "ev_ebitda", "forward_pb", "milestone"]
              }
            }
          }
        }
      }
    },
    "indexes": {"type": "object", "required": ["ticker_to_position", "company_id_to_position"]}
  }
}
